    },
    "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはSteamCMDのセキュリティ評価を完了できませんでした。システムのセキュリティエラーを解決してから再試行してください。明示的に承認しても、評価の失敗を回避することはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未能完成对 SteamCMD 的安全评估。请先解决系统安全错误再重试；手动批准无法跳过评估失败。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 無法完成 SteamCMD 的安全性評估。請先解決系統安全性錯誤再重試；即使手動核准，也無法略過評估失敗。"}}}
    },
    "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSは%@にあるSteamCMDを承認していません。このSteamCMDのコピーを確認して承認するか、Appleのアプリのセキュリティに関するガイダンスに従ってから、「再試行」をクリックしてください。システムのセキュリティ設定は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准位于 %@ 的 SteamCMD。请检查并批准这份副本，或按照 Apple 的安全指引操作，然后重试。系统安全设置没有被修改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未核准位於 %@ 的 SteamCMD。請檢查並核准這份 SteamCMD 副本，或依照 Apple 的 App 安全性指引操作，然後重試。系統安全性設定未經變更。"}}}
    },
    "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "承認対象のSteamCMD、または非公開の承認記録が変更されたか、安全ではありません。現在のコピーをもう一度確認してください。承認は保存されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "待批准的 SteamCMD 或批准记录已变化或不安全，本次没有保存批准。请重新检查当前副本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "待核准的 SteamCMD 或私人核准記錄已變更或不安全。請重新檢查目前的副本；未儲存任何核准。"}}}
    },
    "The retained SteamCMD candidate changed. Review it again before approving." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The retained SteamCMD candidate changed. Review it again before approving."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されているSteamCMDの候補が変更されました。承認する前にもう一度確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留的 SteamCMD 已发生变化，请重新检查后再批准。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留的待核准 SteamCMD 已變更。核准前請重新檢查。"}}}
