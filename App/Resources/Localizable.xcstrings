    "Installation changes are unavailable while downloads are running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível alterar a instalação enquanto há downloads em andamento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드가 진행 중일 때는 설치를 변경할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード中はインストールを変更できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载进行期间无法更改安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載進行期間無法變更安裝。"}}}
    },
    "Installed. Scene wallpapers can play." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Instalado. Papéis de parede de cena podem ser reproduzidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치되었습니다. 장면 배경화면을 재생할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済み。シーン壁紙を再生できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装。场景壁纸可以播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝。場景桌布可以播放。"}}}
    },
    "Not installed. Scene wallpapers cannot play yet." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não instalado. Papéis de parede de cena ainda não podem ser reproduzidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치되지 않았습니다. 아직 장면 배경화면을 재생할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "未インストール。シーン壁紙はまだ再生できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未安装。场景壁纸暂时无法播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未安裝。場景桌布暫時無法播放。"}}}
    },
    "Shared resources download progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso do download dos recursos compartilhados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 리소스 다운로드 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有リソースのダウンロードの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享资源下载进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用資源下載進度"}}}
    },
    "Finish sign-in…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Concluir início de sessão…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 완료…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインを完了…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "完成登录…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "完成登入…"}}}
    },
    "Cancel queued download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar download na fila"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대기 중인 다운로드 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "待機中のダウンロードをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消排队下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消佇列中的下載"}}}
    },
    "Cancel download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消下載"}}}
    },
    "Continue setup…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Continuar configuração…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "초기 설정 계속…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップを続ける…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续设置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續設定…"}}}
    },
    "Remove request" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover solicitação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "요청 제거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リクエストを削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移除请求"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "移除請求"}}}
    },
    "Download again…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar novamente…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 다운로드…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再ダウンロード…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新下载…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新下載…"}}}
    },
    "Download from Steam…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar da Steam…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 다운로드…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからダウンロード…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从 Steam 下载…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從 Steam 下載…"}}}
    },
    "Locate an installation…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Localizar uma instalação…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기존 설치 찾기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "既存のインストールを選択…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择已有安装…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選取現有安裝…"}}}
    },
    "Steam downloads the full Windows version to a temporary folder, and only the shared resources are kept. No Windows programs are run. You need several GB of free space and a Steam account that owns Wallpaper Engine." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam baixa a versão completa para Windows em uma pasta temporária, e apenas os recursos compartilhados são mantidos. Nenhum programa do Windows é executado. Você precisa de vários GB de espaço livre e de uma conta Steam que possua o Wallpaper Engine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 전체 Windows 버전을 임시 폴더에 다운로드한 후 공유 리소스만 보관합니다. Windows 프로그램은 실행하지 않습니다. 수 GB의 여유 공간과 Wallpaper Engine을 소유한 Steam 계정이 필요합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWindows版全体を一時フォルダにダウンロードし、共有リソースだけを保持します。Windowsプログラムは実行されません。数GBの空き容量と、Wallpaper Engineを所有するSteamアカウントが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 会把完整的 Windows 版下载到临时文件夹，之后只保留共享资源，不会运行任何 Windows 程序。需要预留数 GB 空间，并使用拥有 Wallpaper Engine 的 Steam 账户。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 會將完整的 Windows 版本下載到暫存資料夾，之後只保留共用資源，不會執行任何 Windows 程式。你需要數 GB 的可用空間，以及擁有 Wallpaper Engine 的 Steam 帳號。"}}}
    },
    "Steam account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Conta Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 계정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 帳號"}}}
    },
    "Log out…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sair…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그아웃…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログアウト…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "退出登录…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登出…"}}}
    },
    "Not signed in" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão não iniciada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 안 됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未登入"}}}
    },
    "Signed in as %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada como %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 계정으로 로그인됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@としてサインイン中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已以 %@ 登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已使用 %@ 登入"}}}
    },
    "You sign in when a download starts." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você inicia a sessão quando um download começa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드를 시작할 때 로그인합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの開始時にサインインします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "开始下载时再登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開始下載時才需要登入。"}}}
    },
    "Welcome guide" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Guia de boas-vindas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시작 가이드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ようこそガイド"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "欢迎指南"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "歡迎指南"}}}
    },
    "Shown on first launch: language and appearance, Steam sign-in, preferences and tips." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Exibido na primeira abertura: idioma e aparência, início de sessão na Steam, preferências e dicas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "처음 실행할 때 언어와 모양, Steam 로그인, 환경설정 및 팁이 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "初回起動時に表示されます：言語と外観、Steamへのサインイン、環境設定、ヒント。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "首次启动时显示：语言与外观、Steam 登录、偏好设置和使用提示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "首次啟動時顯示：語言與外觀、Steam 登入、偏好設定和使用提示。"}}}
    },
    "Show again" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "もう一度表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "再次显示"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "再次顯示"}}}
    },
    "Setup, compatibility & account privacy" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Configuração, compatibilidade e privacidade da conta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정, 호환성 및 계정 개인정보 보호"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップ、互換性、アカウントのプライバシー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置、兼容性与账户隐私"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定、相容性與帳號隱私"}}}
    },
    "Scene wallpapers need shared resources from a purchased Wallpaper Engine installation. Videos do not. Locate its assets folder or download the shared assets once through Steam. Scene support is experimental; effects and scripts may differ from Windows." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede de cena precisam de recursos compartilhados de uma instalação comprada do Wallpaper Engine. Vídeos não precisam. Localize a pasta assets da instalação ou baixe os recursos compartilhados uma vez pela Steam. O suporte a cenas é experimental; efeitos e scripts podem ser diferentes do Windows."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 배경화면에는 구매하여 설치한 Wallpaper Engine의 공유 리소스가 필요합니다. 비디오에는 필요하지 않습니다. 해당 assets 폴더를 지정하거나 Steam에서 공유 에셋을 한 번 다운로드하세요. 장면 지원은 실험적 기능으로, 효과와 스크립트가 Windows와 다르게 작동할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン壁紙には、購入済みのWallpaper Engineのインストールに含まれる共有リソースが必要です。ビデオには必要ありません。そのassetsフォルダを指定するか、Steamから共有リソースを一度だけダウンロードしてください。シーンのサポートは試験的なもので、エフェクトやスクリプトの動作がWindows版と異なる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景壁纸需要已购买的 Wallpaper Engine 中的共享资源，视频壁纸不需要。可以选择它的 assets 文件夹，或通过 Steam 下载一次。场景支持仍是实验性的，效果和脚本可能与 Windows 版不同。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景桌布需要已購買的 Wallpaper Engine 安裝中的共用資源，影片桌布則不需要。你可以選取它的 assets 資料夾，或透過 Steam 下載一次共用資源。場景支援仍屬實驗性質，效果和指令碼可能與 Windows 版不同。"}}}
    },
    "Steam downloads the Windows version to temporary storage; only shared assets are kept. Windows programs are never run. Allow several GB of temporary space. Imports are copied; original files and your Steam library stay untouched." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam baixa a versão para Windows em um armazenamento temporário; apenas os recursos compartilhados são mantidos. Programas do Windows nunca são executados. Reserve vários GB de espaço temporário. As importações são copiadas; os arquivos originais e sua biblioteca da Steam permanecem intactos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 Windows 버전을 임시 저장 공간에 다운로드한 후 공유 에셋만 보관합니다. Windows 프로그램은 절대 실행하지 않습니다. 수 GB의 임시 공간을 확보하세요. 가져온 항목은 복사되며, 원본 파일과 Steam 보관함은 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWindows版を一時領域にダウンロードし、共有リソースだけを保持します。Windowsプログラムが実行されることはありません。数GBの一時的な空き容量を確保してください。読み込むファイルはコピーされ、元のファイルやSteamライブラリは変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 会把 Windows 版下载到临时位置，只保留共享资源，不会运行 Windows 程序。请预留数 GB 临时空间。导入时会复制文件，原文件和 Steam 库不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 會將 Windows 版本下載到暫存位置，只保留共用資源，絕不會執行 Windows 程式。請預留數 GB 的暫存空間。匯入時會拷貝檔案，原始檔案和你的 Steam 收藏庫都不會受到影響。"}}}
    },
    "SteamCMD is Valve’s download tool; installing it doesn’t require signing in. Downloading requires a Steam account that owns Wallpaper Engine. Your password and Steam Guard codes go straight to SteamCMD and are not saved by this app. “Keep me signed in” stores Steam’s sign-in on this Mac. Logging out only affects this Mac; other devices stay signed in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD é a ferramenta de download da Valve; instalá-lo não exige iniciar sessão. Baixar exige uma conta Steam que possua o Wallpaper Engine. Sua senha e os códigos do Steam Guard vão direto para o SteamCMD e não são salvos por este app. “Manter sessão iniciada” guarda o início de sessão da Steam neste Mac. Sair afeta apenas este Mac; outros dispositivos continuam com a sessão iniciada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD는 Valve의 다운로드 도구이며, 설치할 때는 로그인이 필요하지 않습니다. 다운로드하려면 Wallpaper Engine을 소유한 Steam 계정이 필요합니다. 암호와 Steam Guard 코드는 SteamCMD로 직접 전달되며 이 앱에 저장되지 않습니다. ‘로그인 상태 유지’를 선택하면 이 Mac에 Steam 로그인 정보가 저장됩니다. 로그아웃은 이 Mac에만 적용되며 다른 기기는 로그인 상태를 유지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveのダウンロードツールで、インストールにサインインは必要ありません。ダウンロードには、Wallpaper Engineを所有するSteamアカウントが必要です。パスワードとSteam GuardコードはSteamCMDに直接渡され、このAppには保存されません。「サインインしたままにする」を選ぶと、SteamのサインインがこのMacに保存されます。サインアウトはこのMacにのみ影響し、ほかのデバイスはサインインしたままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下载工具，安装时不需要登录。下载需要拥有 Wallpaper Engine 的 Steam 账户。密码和 Steam 令牌验证码直接交给 SteamCMD，本应用不保存。“保持登录”会在这台 Mac 上保存 Steam 的登录状态。退出登录只影响这台 Mac，其他设备仍保持登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下載工具，安裝時不需要登入。下載則需要擁有 Wallpaper Engine 的 Steam 帳號。你的密碼和 Steam Guard 驗證碼會直接傳給 SteamCMD，此 App 不會儲存。「在這台 Mac 上保持登入」會在這台 Mac 上儲存 Steam 的登入狀態。登出只會影響這台 Mac，其他裝置仍會保持登入。"}}}
    },
    "Approve Steam Guard in the Steam mobile app, or enter the fresh code when requested. Steam may require a new sign-in after expiry or security changes. If Steam reports too many attempts, wait before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aprove o Steam Guard no app Steam para celular ou digite o novo código quando solicitado. A Steam pode exigir um novo início de sessão após a expiração ou alterações de segurança. Se a Steam informar tentativas demais, aguarde antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 모바일 앱에서 Steam Guard를 승인하거나 요청 시 새 코드를 입력하세요. 유효 기간이 만료되거나 보안 설정이 변경되면 Steam에서 다시 로그인을 요구할 수 있습니다. 시도 횟수가 너무 많다는 메시지가 표시되면 잠시 기다린 후 다시 시도하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamモバイルアプリでSteam Guardを承認するか、求められたときに新しいコードを入力してください。有効期限が切れたりセキュリティ設定が変更されたりすると、Steamから再度サインインを求められることがあります。試行回数が多すぎるとSteamに表示された場合は、しばらく待ってから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 手机应用中批准登录，或在需要时输入最新的验证码。登录过期或安全设置变更后，Steam 可能要求重新登录。如果提示尝试次数过多，请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請在 Steam 行動應用程式中核准 Steam Guard，或在要求時輸入最新的驗證碼。登入過期或安全性設定變更後，Steam 可能會要求重新登入。如果 Steam 回報嘗試次數過多，請稍候再重試。"}}}
    },
    "Allowing SteamCMD applies only to the downloaded copy you confirmed. Gatekeeper and signature checks stay on." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permitir o SteamCMD se aplica apenas à cópia baixada que você confirmou. O Gatekeeper e as verificações de assinatura continuam ativados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 허용은 확인한 다운로드 사본에만 적용됩니다. Gatekeeper 및 서명 검사는 계속 활성화됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの許可は、確認したダウンロード済みのコピーにのみ適用されます。Gatekeeperと署名の検査は有効なままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "批准只对你确认过的那份 SteamCMD 有效，不会关闭 Gatekeeper 或签名检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "允許 SteamCMD 只對你確認過的那份下載副本有效。Gatekeeper 和簽章檢查會保持開啟。"}}}
    },
    "Wallpaper Engine on Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine na Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam의 Wallpaper Engine"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamのWallpaper Engine"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 上的 Wallpaper Engine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 上的 Wallpaper Engine"}}}
    },
    "macOS app security" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Segurança de apps no macOS"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS 앱 보안"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOS Appのセキュリティ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 应用安全"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS App 安全性"}}}
    },
    "Wallpaper files you chose" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivos de papel de parede que você escolheu"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 배경화면 파일"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した壁紙ファイル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你选择的壁纸文件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你選擇的桌布檔案"}}}
    },
    "Clear unused caches…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar caches não usados…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용하지 않는 캐시 지우기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "未使用のキャッシュを消去…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除未使用的缓存…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除未使用的快取…"}}}
    },
    "Files you pick in a wallpaper’s settings are copied here. “Clear unused caches” only removes caches that can be rebuilt, never files you added." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os arquivos que você escolhe nos ajustes de um papel de parede são copiados para cá. “Limpar caches não usados” remove apenas caches que podem ser recriados, nunca arquivos que você adicionou."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 설정에서 선택한 파일은 여기에 복사됩니다. ‘사용하지 않는 캐시 지우기’는 다시 생성할 수 있는 캐시만 삭제하며, 추가한 파일은 절대 삭제하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の設定で選択したファイルはここにコピーされます。「未使用のキャッシュを消去」では再構築できるキャッシュだけが削除され、追加したファイルが削除されることはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在壁纸设置中选择的文件会复制到这里。“清除未使用的缓存”只删除可以重新生成的缓存，不会删除你添加的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你在桌布設定中選擇的檔案會拷貝到這裡。「清除未使用的快取」只會移除可重新建立的快取，絕不會移除你加入的檔案。"}}}
    },
    "Last clear released %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A última limpeza liberou %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "마지막 정리로 %@의 공간을 확보했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "前回の消去で%@を解放しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上次清除释放了 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上次清除釋放了 %@。"}}}
    },
    "Shader cache" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cache de shaders"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "셰이더 캐시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダキャッシュ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "着色器缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "著色器快取"}}}
    },
    "Clear…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지우기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消去…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除…"}}}
    },
    "Logs" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Registros"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "記錄檔"}}}
    },
    "Completed downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Downloads concluídos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완료된 다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "完了したダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已完成的下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已完成的下載"}}}
    },
    "Clear history" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar histórico"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기록 지우기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "履歴を消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除历史"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除歷史記錄"}}}
    },
    "What gets removed" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O que é removido"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제거되는 항목"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除される内容"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "会删除哪些内容"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "會移除哪些內容"}}}
    },
    "Clearing the shader cache removes compiled shaders and render pipelines. They are rebuilt as wallpapers load, which can briefly slow playback. Clearing logs doesn’t affect wallpapers or settings. Clearing download history keeps the downloaded files." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar o cache de shaders remove os shaders compilados e os pipelines de renderização. Eles são recriados à medida que os papéis de parede carregam, o que pode deixar a reprodução lenta por alguns instantes. Limpar os registros não afeta papéis de parede nem ajustes. Limpar o histórico de downloads mantém os arquivos baixados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "셰이더 캐시를 지우면 컴파일된 셰이더와 렌더링 파이프라인이 제거됩니다. 배경화면을 불러올 때 다시 생성되므로 재생이 일시적으로 느려질 수 있습니다. 로그를 지워도 배경화면이나 설정에는 영향을 주지 않습니다. 다운로드 기록을 지워도 다운로드한 파일은 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダキャッシュを消去すると、コンパイル済みのシェーダとレンダリングパイプラインが削除されます。これらは壁紙の読み込み時に再構築されるため、一時的に再生が遅くなることがあります。ログを消去しても、壁紙や設定には影響しません。ダウンロード履歴を消去しても、ダウンロード済みのファイルは残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除着色器缓存会删除已编译的着色器和渲染管线，壁纸加载时会重新生成，播放可能短暂变慢。清除日志不会影响壁纸和设置。清除下载历史不会删除已下载的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除著色器快取會移除已編譯的著色器和渲染管線，這些內容會在桌布載入時重新建立，播放可能會短暫變慢。清除記錄檔不會影響桌布或設定。清除下載歷史記錄會保留已下載的檔案。"}}}
    },
    "Files you chose in a wallpaper’s settings are copied to the folder above, so clearing caches or updating the wallpaper won’t remove them. To remove one, clear that setting on the wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os arquivos que você escolheu nos ajustes de um papel de parede são copiados para a pasta acima, então limpar caches ou atualizar o papel de parede não os remove. Para remover um, limpe esse ajuste no papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 설정에서 선택한 파일은 위 폴더에 복사되므로 캐시를 지우거나 배경화면을 업데이트해도 삭제되지 않습니다. 파일을 삭제하려면 해당 배경화면의 관련 설정을 지우세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の設定で選択したファイルは上のフォルダにコピーされるため、キャッシュを消去したり壁紙をアップデートしたりしても削除されません。ファイルを削除するには、その壁紙で該当する設定を消去してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在壁纸设置中选择的文件会复制到上方的文件夹，清除缓存或更新壁纸都不会删除它们。要删除某个文件，请在对应壁纸中清除该设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你在桌布設定中選擇的檔案會拷貝到上方的資料夾，因此清除快取或更新桌布都不會移除它們。若要移除某個檔案，請在該桌布上清除對應的設定。"}}}
    },
    "Troubleshooting" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Solução de Problemas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "문제 해결"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "トラブルシューティング"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "故障排查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "疑難排解"}}}
    },
    "Detailed logging" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Registro detalhado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "상세 로그 기록"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "詳細なログ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "详细日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "詳細記錄"}}}
    },
    "Records extra detail from now on, including after a restart. Turn it off when you are done." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Grava detalhes extras a partir de agora, inclusive após reiniciar. Desative quando terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이제부터 재시작 후에도 더 자세한 정보를 기록합니다. 작업을 마치면 끄세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "今後は再起動後も含めて、より詳細な情報を記録します。作業が終わったらオフにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从现在起记录更多细节，重启后仍然有效。排查完毕后请关闭。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從現在起記錄更多細節，重新啟動後仍會持續。完成後請將其關閉。"}}}
    },
    "Allow inspecting web wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permitir inspecionar papéis de parede web"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면 검사 허용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のインスペクトを許可"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许检查网页壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "允許檢查網頁桌布"}}}
    },
    "Lets Safari’s Develop menu attach to the web wallpapers running on this Mac so you can debug a page. Turn it off when you are done." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permite que o menu Desenvolvedor do Safari se conecte aos papéis de parede web em execução neste Mac para que você possa depurar uma página. Desative quando terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Safari의 ‘개발자용’ 메뉴에서 이 Mac에서 실행 중인 웹 배경화면에 연결하여 페이지를 디버그할 수 있도록 합니다. 작업이 끝나면 끄세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Safariの「開発」メニューから、このMacで実行中のWeb壁紙に接続してページをデバッグできるようにします。作業が終わったらオフにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许 Safari 的“开发”菜单连接到此 Mac 上运行的网页壁纸，以便调试页面。调试完毕后请关闭。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "允許 Safari 的「開發」選單連接到此 Mac 上執行的網頁桌布，以便除錯頁面。完成後請將其關閉。"}}}
    },
    "Diagnostics report" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Relatório de diagnóstico"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진단 보고서"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "診断レポート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "诊断报告"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "診斷報告"}}}
    },
    "Export…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Exportar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "내보내기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "書き出す…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导出…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯出…"}}}
    },
    "Saves recent logs, the lock screen log, macOS crash, resource, spin and hang reports, which wallpapers were loading when WallpaperMachine quit unexpectedly, and a system summary as one .zip file to attach to a bug report. Home folder paths, your Mac user name and Steam account names are replaced." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva os registros recentes, o registro da tela bloqueada, os relatórios de falha, recursos, spin e travamento do macOS, quais papéis de parede estavam carregando quando o WallpaperMachine encerrou inesperadamente e um resumo do sistema em um único arquivo .zip para anexar a um relatório de bug. Os caminhos da pasta pessoal, seu nome de usuário do Mac e os nomes de conta Steam são substituídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "최근 로그, 잠금 화면 로그, macOS 충돌·리소스·스핀·멈춤 보고서, WallpaperMachine이 예기치 않게 종료될 때 불러오고 있던 배경화면 기록 및 시스템 요약을 버그 보고서에 첨부할 수 있도록 하나의 .zip 파일로 저장합니다. 홈 폴더 경로, Mac 사용자 이름 및 Steam 계정 이름은 다른 값으로 대체됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最近のログ、ロック画面のログ、macOSのクラッシュ・リソース・スピン・ハングのレポート、WallpaperMachineが予期せず終了したときに読み込み中だった壁紙の記録、システムの概要を1つの.zipファイルに保存し、不具合報告に添付できるようにします。ホームフォルダのパス、Macのユーザ名、Steamのアカウント名は置き換えられます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将最近的日志、锁屏日志、macOS 的崩溃、资源占用、卡顿（spin）和无响应（hang）报告、WallpaperMachine 意外退出时正在加载的壁纸记录，以及系统摘要存为一个 .zip 文件，可附在问题报告中。个人文件夹路径、Mac 用户名和 Steam 账户名会被替换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將最近的記錄檔、鎖定畫面記錄、macOS 的當機、資源、卡頓（spin）與無回應（hang）報告、WallpaperMachine 意外結束時正在載入的桌布記錄，以及系統摘要儲存為單一 .zip 檔案，方便附加到錯誤回報中。個人專屬資料夾路徑、你的 Mac 使用者名稱和 Steam 帳號名稱都會被替換。"}}}
    },
    "Independent macOS client" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cliente independente para macOS"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "독립 macOS 클라이언트"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "独立したmacOSクライアント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "独立的 macOS 客户端"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "獨立的 macOS 用戶端"}}}
    },
    "App version" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Versão do app"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 버전"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appのバージョン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用版本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 版本"}}}
    },
    "Git revision" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Revisão do Git"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Git 리비전"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Gitリビジョン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Git 修订版本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Git 修訂版本"}}}
    },
    "Updates" : {
