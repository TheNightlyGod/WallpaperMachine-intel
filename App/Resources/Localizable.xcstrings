      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Log Out"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログアウト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "退出登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登出"}}}
    },
