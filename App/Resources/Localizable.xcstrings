      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma ilustração encontrada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일러스트를 찾지 못했습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "イラストが見つかりません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未找到插画"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "找不到插畫"}}}
    },
    "Try other tags. pixiv matches tags, not titles." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tente outras etiquetas. O pixiv busca por etiquetas, não por títulos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 태그를 사용하세요. pixiv는 제목이 아닌 태그로 검색합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのタグを試してください。pixivはタイトルではなくタグで照合します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "换个标签试试。pixiv 按标签匹配，而不是标题。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "試試其他標籤。pixiv 是依標籤比對，而非標題。"}}}
    },
    "pixiv returned an empty ranking." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv retornou um ranking vazio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 빈 랭킹을 반환했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから空のランキングが返されました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回了空的排行榜。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回了空白的排行榜。"}}}
