    },
    "Configure child process" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Configurar processo filho"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "하위 프로세스 구성"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Configure child process"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "子プロセスの構成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "配置子进程"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定子程序"}}}
    },
