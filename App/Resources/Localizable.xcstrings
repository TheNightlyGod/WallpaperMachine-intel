    },
    "Show in downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar nos downloads"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드에서 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードに表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在下载中显示"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在下載項目中顯示"}}}
    },
    "Shared scene resources are required before playback." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recursos compartilhados de cena são necessários antes da reprodução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생하려면 공유 장면 리소스가 필요합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生するには共有シーンリソースが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要先安装共享场景资源才能播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放前需要先取得共用場景資源。"}}}
    },
    "Get shared resources" : {
