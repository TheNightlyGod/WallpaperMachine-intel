    },
    "Uses %@ files from the chosen folder." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したフォルダ内の%@ファイルを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用所选文件夹中的 %@ 文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用所選資料夾中的 %@ 檔案。"}}}
    },
    "Accepts %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に対応しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "接受 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可接受 %@。"}}}
    },
    "More than %lld files match; only the first %lld are used." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "一致するファイルが%1$lld個を超えています。最初の%1$lld個のみ使用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "匹配的文件超过 %1$lld 个，仅使用前 %1$lld 个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "符合的檔案超過 %1$lld 個，只會使用前 %1$lld 個。"}}}
    },
    "%lld matching file in this folder." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ内に一致するファイルが%lld個あります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹中有 %lld 个匹配的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾中有 %lld 個符合的檔案。"}}}
    },
    "%lld matching files in this folder." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ内に一致するファイルが%lld個あります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹中有 %lld 个匹配的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾中有 %lld 個符合的檔案。"}}}
    },
    "This folder could not be read. Choose it again, or pick another." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダを読み取れませんでした。もう一度選択するか、別のフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取此文件夹。请重新选择，或换一个文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取此資料夾。請重新選擇，或改選其他資料夾。"}}}
    },
    "The wallpaper receives the whole list of files." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙にはファイルの一覧全体が渡されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会收到完整的文件列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布會取得完整的檔案清單。"}}}
    },
    "The wallpaper picks files from the folder itself." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙がフォルダから自分でファイルを選びます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会自行从文件夹中挑选文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布會自行從資料夾中挑選檔案。"}}}
    },
    "Copied into this app’s managed folder, so it survives cache cleans and wallpaper updates." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このアプリが管理するフォルダにコピーされるため、キャッシュの消去や壁紙のアップデート後も残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已复制到应用自己的文件夹，清除缓存或更新壁纸都不会丢失。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已拷貝到此 App 管理的資料夾，清除快取或更新桌布後仍會保留。"}}}
    },
    "Used in place from %@. Moving or deleting it there breaks the wallpaper." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にあるものをそのまま使用します。そこから移動したり削除したりすると、壁紙が正しく動作しなくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接使用 %@ 处的原文件。移动或删除它会导致壁纸失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接使用 %@ 中的原始檔案。在該處移動或刪除它會導致桌布無法運作。"}}}
    },
    "Used in place from where you chose it. Moving or deleting it there breaks the wallpaper." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した場所にあるものをそのまま使用します。そこから移動したり削除したりすると、壁紙が正しく動作しなくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接使用你所选位置的原文件。移动或删除它会导致壁纸失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接使用你所選位置的原始檔案。在該處移動或刪除它會導致桌布無法運作。"}}}
    },
