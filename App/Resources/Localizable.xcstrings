    },
    "%lld hidden by your filters on this page" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このページの%lld件がフィルタで非表示になっています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "本页有 %lld 个被筛选隐藏"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此頁有 %lld 件作品被篩選條件隱藏"}}}
    },
    "No matching illustrations" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "一致するイラストはありません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有符合条件的插画"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有符合條件的插畫"}}}
    },
    "Your filters hide the only work on this page." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このページにある唯一の作品がフィルタで非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "筛选条件隐藏了本页唯一的作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "篩選條件隱藏了此頁唯一的作品。"}}}
    },
    "Your filters hide all %lld works on this page." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このページの%lld件の作品すべてがフィルタで非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "筛选条件隐藏了本页全部 %lld 个作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "篩選條件隱藏了此頁全部 %lld 件作品。"}}}
    },
    "No illustrations found" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "イラストが見つかりません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未找到插画"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "找不到插畫"}}}
    },
    "Try other tags. pixiv matches tags, not titles." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのタグを試してください。pixivはタイトルではなくタグで照合します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "换个标签试试。pixiv 按标签匹配，而不是标题。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "試試其他標籤。pixiv 是依標籤比對，而非標題。"}}}
    },
    "pixiv returned an empty ranking." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから空のランキングが返されました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回了空的排行榜。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回了空白的排行榜。"}}}
    },
    "by %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "作者：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "作者：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "作者：%@"}}}
    },
    "Ranked #%lld" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld位"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "排名第 %lld"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "排名第 %lld"}}}
    },
    "%lld pages" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lldページ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 頁"}}}
    },
    "Saving to your library…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリに保存中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在保存到壁纸库…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在儲存到桌布庫…"}}}
    },
    "Select an illustration" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "イラストを選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择一幅插画"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選取一幅插畫"}}}
    },
    "Its preview, pages and download appear here." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "イラストのプレビュー、ページ、ダウンロードがここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "插画的预览、分页和下载会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "插畫的預覽、頁面和下載選項會顯示在這裡。"}}}
    },
    "Download page %lld" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lldページ目をダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载第 %lld 页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載第 %lld 頁"}}}
    },
    "View on pixiv" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivで表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 pixiv 上查看"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 pixiv 上檢視"}}}
    },
    "A still illustration saved from pixiv. Choose how it fits the screen under Image fit." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから保存した静止画のイラストです。画面への収め方は「画像の表示方法」で選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从 pixiv 保存的静态插画。可在“图片适配”中选择它在屏幕上的显示方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從 pixiv 儲存的靜態插畫。可在「圖片顯示方式」中選擇它在螢幕上的呈現方式。"}}}
    },
    "A still image imported from your Mac. Choose how it fits the screen under Image fit." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacから読み込んだ静止画です。画面への収め方は「画像の表示方法」で選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从这台 Mac 导入的静态图片。可在“图片适配”中选择它在屏幕上的显示方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從你的 Mac 匯入的靜態圖片。可在「圖片顯示方式」中選擇它在螢幕上的呈現方式。"}}}
    },
    "Pages of this work" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "この作品のページ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此作品的分页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此作品的頁面"}}}
    },
    "Page %lld of %lld" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%2$lldページ中%1$lldページ目"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "第 %1$lld 页，共 %2$lld 页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "第 %1$lld 頁，共 %2$lld 頁"}}}
    },
    "Loading pages…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ページを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在加载分页…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入頁面…"}}}
    },
    "pixiv: %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロード：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv：%@"}}}
    },
    "%lld pixiv downloads" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロード%lld件"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个 pixiv 下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個 pixiv 下載項目"}}}
    },
    "Saved to your library as a still wallpaper that applies like any other. The artwork belongs to its artist." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "静止画の壁紙としてライブラリに保存され、ほかの壁紙と同じように適用できます。作品の著作権は作者に帰属します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以静态壁纸保存到壁纸库，可像其他壁纸一样应用。作品版权归原作者所有。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已作為靜態桌布儲存到桌布庫，可像其他桌布一樣套用。作品版權歸原作者所有。"}}}
    },
    "Image fit" : {
      "extractionState" : "manual",
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の表示方法"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片适配"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片顯示方式"}}}
    },
    "Background color" : {
      "extractionState" : "manual",
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "背景色"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "背景颜色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "背景顏色"}}}
    },
    "Fill, keep the top" : {
      "extractionState" : "manual",
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画面全体に表示（上部を維持）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "填充（保留顶部）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "填滿（保留頂部）"}}}
    },
    "Fit with blurred backdrop" : {
      "extractionState" : "manual",
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画面に合わせる（背景をぼかす）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "适应（模糊背景）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "符合大小（模糊背景）"}}}
    },
    "When the battery is low" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時"}}}
    },
    "Low battery level" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量の基準"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量阈值"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低電量門檻"}}}
    },
    "Applies only while the Mac runs on battery. It ends 5 points above the level you choose, or when you plug in. The battery is at %lld%% now." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macがバッテリー駆動の間だけ有効です。選んだ残量より5ポイント上がるか、電源に接続すると終了します。現在のバッテリー残量は%lld%%です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在 Mac 使用电池供电时生效。电量回升到所选阈值再高 5 个百分点，或接上电源后结束。目前电量为 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在 Mac 使用電池供電時生效。電量回升到所選門檻再高 5 個百分點，或接上電源後結束。目前電量為 %lld%%。"}}}
    },
    "When the battery is low, wallpapers pause or stop once the charge falls to the level you chose, and resume when you plug in or the charge recovers." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないときは、残量が選んだレベルまで下がると壁紙が一時停止または停止し、電源に接続するか残量が回復すると再開します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时，壁纸会在电量降到你所选的阈值后暂停或停止，并在你接上电源或电量回升后恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時，桌布會在電量降到你所選的門檻後暫停或停止，並在你接上電源或電量回升後恢復。"}}}
    },
    "Mute all wallpapers" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての壁紙を消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有桌布靜音"}}}
    },
    "Silences every wallpaper without changing their saved sound or volume. It works together with the rules below." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているサウンドや音量の設定は変えずに、すべての壁紙を消音します。下のルールとあわせて機能します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音，不更改它们已保存的声音或音量。它与下方的规则共同生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音，不更改它們已儲存的聲音或音量。它會與下方的規則一併生效。"}}}
    },
    "Only play on the display I’m using" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "使用中のディスプレイでのみ再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在我正在使用的显示器上播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在我正在使用的顯示器上播放"}}}
    },
    "The display your pointer is on keeps playing. The others pause a few seconds after you leave them and resume the moment you return. Your own Play and Pause are not changed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ポインタがあるディスプレイは再生を続けます。ほかのディスプレイは、ポインタが離れて数秒後に一時停止し、戻るとすぐに再開します。手動での再生と一時停止は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "鼠标指针所在的显示器会继续播放。其他显示器会在指针离开几秒后暂停，指针回来后立即恢复。不会改动你自己的播放和暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "游標所在的顯示器會繼續播放。其他顯示器會在游標離開幾秒後暫停，游標回來時立即恢復。不會變更你自己的播放與暫停操作。"}}}
    },
    "With two or more displays, Only play on the display I’m using pauses the others a few seconds after your pointer leaves them." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイが2台以上あるとき、「使用中のディスプレイでのみ再生」をオンにすると、ポインタが離れてから数秒後にほかのディスプレイが一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "有两台或更多显示器时，“仅在我正在使用的显示器上播放”会在指针离开几秒后暂停其他显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "有兩台或更多顯示器時，「僅在我正在使用的顯示器上播放」會在游標離開幾秒後暫停其他顯示器。"}}}
    },
    "In Low Power Mode" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式時"}}}
    },
    "Low Power Mode is on now." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードは現在オンです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式现已开启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式目前已開啟。"}}}
    },
    "Low Power Mode is off now." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードは現在オフです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式现已关闭。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式目前已關閉。"}}}
    },
    "When the Mac is hot" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温のとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱時"}}}
    },
    "Applies while macOS reports the Mac as hot or very hot, which is when it starts slowing itself down. Right now it is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがMacを高温または非常に高温と報告している間に適用されます。これはMacが自ら動作を抑え始める状態です。現在は%@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 macOS 报告 Mac 发热或严重发热时生效，这也是它开始自行降速的时候。目前状态为%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "會在 macOS 回報 Mac 過熱或嚴重過熱時生效，此時 Mac 會開始自行降速。目前為%@狀態。"}}}
    },
    "Reduced quality applies while the Mac is hot, and wallpapers pause if it becomes very hot. Right now it is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「画質を下げる」はMacが高温の間に適用されます。非常に高温になった場合、壁紙は一時停止します。現在は%@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“降低画质”在 Mac 发热期间生效；如果 Mac 变得严重发热，壁纸会暂停。目前状态为%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「降低畫質」會在 Mac 過熱期間生效；如果 Mac 變得嚴重過熱，桌布會暫停。目前為%@狀態。"}}}
    },
    "normal" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}}
    },
    "warm" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "やや高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "偏热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "偏熱"}}}
    },
    "hot" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "发热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "過熱"}}}
    },
    "very hot" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "非常に高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "严重发热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "嚴重過熱"}}}
    },
    "Focus" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "集中モード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "专注模式"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專注模式"}}}
    },
    "Open Focus Settings…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "集中モード設定を開く…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开专注模式设置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開專注模式設定…"}}}
    },
    "A Focus filter is in effect now: %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、集中モードフィルタが有効です：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "专注模式过滤器正在生效：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專注模式過濾條件目前生效中：%@。"}}}
    },
    "Low Power Mode, a hot Mac and a Focus filter work the same way: while they hold, wallpapers pause, mute or stop as you chose, and resume when they end. Stop frees renderer memory and reloads wallpapers afterwards." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード、Macの高温、集中モードフィルタはどれも同じように働きます。条件が続いている間は壁紙が選択どおりに一時停止、消音、または停止し、条件が終わると再開します。「停止」はレンダラのメモリを解放し、その後で壁紙を再読み込みします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式、Mac 过热和专注模式过滤器的作用方式相同：条件成立期间，壁纸按你的选择暂停、静音或停止，条件结束后恢复。“停止”会释放渲染器内存，之后重新加载壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式、Mac 過熱和專注模式過濾條件的運作方式相同：在條件持續期間，桌布會依你的選擇暫停、靜音或停止，條件結束後再恢復。「停止」會釋放渲染器記憶體，並在之後重新載入桌布。"}}}
    },
    "In Low Power Mode, when the Mac is hot or when the battery is low, Reduced quality keeps wallpapers running at the lower render scale and frame rate instead of pausing them, and never goes above your own quality settings. If the Mac gets very hot, wallpapers pause instead. It promises no measured power saving." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード中、Macが高温のとき、またはバッテリー残量が少ないときに「画質を下げる」を選ぶと、壁紙を一時停止せず、より低いレンダリングスケールとフレームレートで実行を続けます。ご自身の画質設定を超えることはありません。Macが非常に高温になった場合は、壁紙が一時停止します。実測に基づく省電力効果を保証するものではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在低电量模式下、Mac 过热时或电量低时，“降低画质”会让壁纸以较低的渲染比例和帧率继续运行，而不是暂停，并且不会超过你自己的画质设置。如果 Mac 严重发热，壁纸会暂停。这并不承诺经过测量的省电效果。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在低耗電模式下、Mac 過熱時或電量低時，「降低畫質」會讓桌布以較低的渲染比例與影格率繼續執行，而不是暫停，且不會超過你自己的畫質設定。如果 Mac 嚴重過熱，桌布會暫停。這並不保證經過測量的省電效果。"}}}
    },
    "Playlist" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリスト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表"}}}
    },
    "Playlist: %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリスト：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表：%@"}}}
    },
    "Changes on its own" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动更换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動更換"}}}
    },
    "Rotate wallpapers" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をローテーション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "轮换壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "輪播桌布"}}}
    },
    "Day and night" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "昼と夜"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日夜切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日夜切換"}}}
    },
    "Only while wallpapers play. A change that falls due while they are paused, the screen is locked or the displays sleep happens once they play again." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生中にのみ切り替わります。一時停止中、画面のロック中、またはディスプレイのスリープ中に予定時刻になった切り替えは、再生が再開したときに一度だけ行われます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在壁纸播放时进行。在暂停、锁屏或显示器睡眠期间到期的更换，会在壁纸恢复播放后执行一次。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在桌布播放時進行。若更換時間落在桌布暫停、螢幕鎖定或顯示器睡眠期間，會在桌布恢復播放後執行一次。"}}}
    },
    "This display’s list (%lld)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイのリスト（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器的列表（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器的列表（%lld）"}}}
    },
    "Order" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "順序"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "顺序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "順序"}}}
    },
    "In order" : {
