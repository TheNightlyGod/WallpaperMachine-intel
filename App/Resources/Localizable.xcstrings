    },
    "Remove from display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover do monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이에서 제거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイから取り除く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从显示器移除"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從顯示器移除"}}}
    },
    "Apply this wallpaper to a display to configure playback." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplique este papel de parede a um monitor para configurar a reprodução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생을 설정하려면 이 배경화면을 디스플레이에 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生を設定するには、この壁紙をディスプレイに適用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将此壁纸应用到显示器后即可配置播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將此桌布套用到顯示器後，即可設定播放選項。"}}}
    },
    "Wallpaper properties" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Propriedades do papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 속성"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のプロパティ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸属性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布屬性"}}}
    },
    "You have unapplied changes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você tem alterações não aplicadas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용하지 않은 변경 사항이 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用されていない変更があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "有尚未应用的修改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你有尚未套用的變更。"}}}
    },
    "Audio, scaling mode and frame rate update immediately." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Áudio, modo de escala e taxa de quadros são atualizados imediatamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오디오, 크기 조절 모드, 프레임률은 즉시 반영됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオ、スケーリングモード、フレームレートはすぐに反映されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频、缩放模式和帧率会立即生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊、縮放模式和影格率會立即更新。"}}}
    },
    "Revert" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reverter"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "되돌리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "元に戻す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还原"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原"}}}
    },
    "Apply changes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar alterações"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 사항 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用修改"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用變更"}}}
    },
    "No folder chosen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma pasta escolhida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 폴더 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フォルダが選択されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未选择文件夹"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未選擇資料夾"}}}
    },
    "No file chosen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum arquivo escolhido"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 파일 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ファイルが選択されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未选择文件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未選擇檔案"}}}
    },
    "Uses %@ files from the chosen folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usa arquivos %@ da pasta escolhida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 폴더의 %@ 파일을 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したフォルダ内の%@ファイルを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用所选文件夹中的 %@ 文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用所選資料夾中的 %@ 檔案。"}}}
    },
    "Accepts %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aceita %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@을(를) 지원합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に対応しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "接受 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可接受 %@。"}}}
    },
    "More than %lld files match; only the first %lld are used." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mais de %lld arquivos correspondem; apenas os primeiros %lld são usados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일치하는 파일이 %lld개를 초과합니다. 처음 %lld개만 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一致するファイルが%1$lld個を超えています。最初の%1$lld個のみ使用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "匹配的文件超过 %1$lld 个，仅使用前 %1$lld 个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "符合的檔案超過 %1$lld 個，只會使用前 %1$lld 個。"}}}
    },
    "%lld matching file in this folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld arquivo correspondente nesta pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 폴더에 일치하는 파일이 %lld개 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ内に一致するファイルが%lld個あります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹中有 %lld 个匹配的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾中有 %lld 個符合的檔案。"}}}
    },
    "%lld matching files in this folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld arquivos correspondentes nesta pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 폴더에 일치하는 파일이 %lld개 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ内に一致するファイルが%lld個あります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹中有 %lld 个匹配的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾中有 %lld 個符合的檔案。"}}}
    },
    "This folder could not be read. Choose it again, or pick another." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler esta pasta. Escolha-a novamente ou escolha outra."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 폴더를 읽을 수 없습니다. 다시 선택하거나 다른 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダを読み取れませんでした。もう一度選択するか、別のフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取此文件夹。请重新选择，或换一个文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取此資料夾。請重新選擇，或改選其他資料夾。"}}}
    },
    "The wallpaper receives the whole list of files." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede recebe a lista completa de arquivos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전체 파일 목록이 배경화면에 전달됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙にはファイルの一覧全体が渡されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会收到完整的文件列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布會取得完整的檔案清單。"}}}
    },
    "The wallpaper picks files from the folder itself." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede escolhe os arquivos da própria pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 폴더에서 직접 파일을 선택합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙がフォルダから自分でファイルを選びます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会自行从文件夹中挑选文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布會自行從資料夾中挑選檔案。"}}}
    },
    "Copied into this app’s managed folder, so it survives cache cleans and wallpaper updates." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiado para a pasta gerenciada deste app, então sobrevive a limpezas do cache e atualizações do papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 앱이 관리하는 폴더에 복사되므로 캐시를 지우거나 배경화면을 업데이트해도 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアプリが管理するフォルダにコピーされるため、キャッシュの消去や壁紙のアップデート後も残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已复制到应用自己的文件夹，清除缓存或更新壁纸都不会丢失。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已拷貝到此 App 管理的資料夾，清除快取或更新桌布後仍會保留。"}}}
    },
    "Used in place from %@. Moving or deleting it there breaks the wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usado no local a partir de %@. Mover ou apagar o item ali quebra o papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 원래 위치에서 그대로 사용합니다. 그곳에서 이동하거나 삭제하면 배경화면이 작동하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にあるものをそのまま使用します。そこから移動したり削除したりすると、壁紙が正しく動作しなくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接使用 %@ 处的原文件。移动或删除它会导致壁纸失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接使用 %@ 中的原始檔案。在該處移動或刪除它會導致桌布無法運作。"}}}
    },
    "Used in place from where you chose it. Moving or deleting it there breaks the wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usado no local onde você o escolheu. Mover ou apagar o item ali quebra o papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 원래 위치에서 그대로 사용합니다. 그곳에서 이동하거나 삭제하면 배경화면이 작동하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した場所にあるものをそのまま使用します。そこから移動したり削除したりすると、壁紙が正しく動作しなくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接使用你所选位置的原文件。移动或删除它会导致壁纸失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接使用你所選位置的原始檔案。在該處移動或刪除它會導致桌布無法運作。"}}}
    },
    "Reselect…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher Novamente…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 선택…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択し直す…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新选择…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新選取…"}}}
    },
