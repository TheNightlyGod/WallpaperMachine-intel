    },
    "Valve’s SteamCMD package manifest is malformed or incomplete. Try again later; nothing was installed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Valve’s SteamCMD package manifest is malformed or incomplete. Try again later; nothing was installed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ValveのSteamCMDパッケージマニフェストが不正か不完全です。後でもう一度お試しください。何もインストールされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 安装包清单格式错误或不完整。请稍后重试；未安装任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 套件清單格式錯誤或不完整。請稍後重試；未安裝任何內容。"}}}
