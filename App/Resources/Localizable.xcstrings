    },
    "Workshop updates" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップのアップデート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创意工坊更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "工作坊更新"}}}
    },
    "Check once a day" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "1日に1回確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每天检查一次"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每天檢查一次"}}}
    },
    "Asks Steam which of your installed Workshop wallpapers have changed since you got them. Only their ids are sent, and no sign-in is needed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みのワークショップ壁紙のうち、入手後に変更されたものをSteamに問い合わせます。送信されるのは壁紙のIDだけで、サインインは必要ありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "向 Steam 询问已安装的创意工坊壁纸中，哪些在你获取后有过更改。只会发送它们的 ID，无需登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "向 Steam 查詢已安裝的工作坊桌布中，有哪些在你取得後有所變更。只會傳送它們的 ID，且不需要登入。"}}}
    },
    "Last check" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "前回の確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上次检查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上次檢查"}}}
    },
