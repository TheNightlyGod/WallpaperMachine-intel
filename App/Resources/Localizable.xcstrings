      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "não desenhado — %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "그려지지 않음 — %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "描画されていません — %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未绘制 — %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未繪製 — %@"}}}
    },
