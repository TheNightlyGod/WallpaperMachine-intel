      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Log out of Steam?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要退出 Steam 登录吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要登出 Steam 嗎？"}}}
    },
    "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again." : {
      "extractionState" : "manual",
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されている%@のサインイン情報がこのMacから削除されます。ほかのSteamデバイスはサインインしたままで、次回のダウンロード時に再度サインインを求められます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将从这台 Mac 移除 %@ 的已保存登录。其他 Steam 设备保持登录，下次下载时需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將從這部 Mac 移除 %@ 已儲存的登入資訊。其他 Steam 裝置會維持登入狀態，下次下載時會要求你重新登入。"}}}
    },
