    "The Mac is inactive. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mac está inativo. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 비활성 상태입니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが操作されていません。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 闲置，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 閒置，桌布已暫停。"}}}
    },
    "The Mac is inactive. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mac está inativo. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 비활성 상태입니다. 배경화면이 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが操作されていません。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 闲置，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 閒置，桌布已停止。"}}}
    },
    "In effect now. Reduced quality is in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em vigor agora. Qualidade reduzida em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 적용 중입니다. 화질을 낮춰 실행하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，已啟用「降低畫質」。"}}}
    },
    "In effect now. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em vigor agora. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 적용 중입니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，桌布已暫停。"}}}
