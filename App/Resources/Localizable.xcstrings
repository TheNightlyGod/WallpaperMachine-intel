    "Move %lld to Trash" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover %lld para o Lixo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld개 휴지통으로 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個をゴミ箱に入れる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将 %lld 项移到废纸篓"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將 %lld 項丟到垃圾桶"}}}
    },
    "Click or drag across tiles to select them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Clique ou arraste sobre os blocos para selecioná-los."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "타일을 클릭하거나 여러 타일 위로 드래그하여 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "タイルをクリックするか、複数のタイルの上をドラッグして選択します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点击卡片，或按住拖过多张卡片来选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下縮圖，或拖過多張縮圖來選取。"}}}
    },
    "Tip: hold a tile, then drag across others to select them all at once." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dica: mantenha um bloco pressionado e arraste sobre outros para selecionar todos de uma vez."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "팁: 타일을 누른 채 다른 타일 위로 드래그하면 한꺼번에 선택할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ヒント：タイルを押したまま他のタイルの上をドラッグすると、まとめて選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "小技巧：按住一张卡片，再拖过其他卡片，即可一次全部选中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "提示：按住一張縮圖，再拖過其他縮圖，即可一次全部選取。"}}}
    },
    "Got it" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Entendi"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "OK"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "知道了"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "知道了"}}}
    },
    "Click to select, or drag from here across other tiles to select them too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Clique para selecionar ou arraste daqui sobre outros blocos para selecioná-los também."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "클릭하여 선택하거나 여기에서 다른 타일 위로 드래그하여 함께 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "クリックして選択します。ここから他のタイルの上をドラッグすると、それらもまとめて選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点击即可选择；从这里拖过其他卡片，可一并选中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下即可選取；從這裡拖過其他縮圖，也能一併選取。"}}}
