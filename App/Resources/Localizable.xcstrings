      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld baixando"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld개 다운로드 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld件をダウンロード中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 项下载中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 項下載中"}}}
