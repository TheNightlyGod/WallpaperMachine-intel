    },
    "Neither Music nor Spotify reported what is playing." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Neither Music nor Spotify reported what is playing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ミュージック」とSpotifyのどちらからも再生中の情報を取得できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“音乐”和 Spotify 都没有提供正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「音樂」App 和 Spotify 都未回報正在播放的內容。"}}}
    },
    "No music player this app can read is running." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No music player this app can read is running."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このAppで読み取れる音楽プレーヤーが実行されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的、本应用可读取的音乐播放器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前沒有執行中且此 App 可讀取的音樂播放程式。"}}}
    },
    "Web wallpaper “%@” could not load: its entry file is outside the project folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Web wallpaper “%@” could not load: its entry file is outside the project folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙「%@」を読み込めませんでした：エントリファイルがプロジェクトフォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸“%@”无法加载：入口文件不在项目文件夹内。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法載入網頁桌布「%@」：其入口檔案位於專案資料夾之外。"}}}
    },
    "This wallpaper has an identifier that cannot be used as a folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper has an identifier that cannot be used as a folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙の識別子はフォルダ名として使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸的标识符无法用作文件夹名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布的識別碼無法用作資料夾名稱。"}}}
    },
    "%@ could not be copied into the app's asset folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ could not be copied into the app's asset folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」をAppのアセットフォルダにコピーできませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法将 %@ 复制到应用的资源文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法將 %@ 拷貝到 App 的資源資料夾。"}}}
    },
    "Importing %@…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Importing %@…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在导入 %@…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在匯入 %@…"}}}
    },
    "Downloading SteamCMD…" : {
