    },
    "They work whichever app is in front. Hold ⌘, ⌥ or ⌃ with the key; F13 to F20 work alone. No permission is needed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "どのAppが前面にあっても機能します。キーと一緒に⌘、⌥、または⌃を押してください。F13〜F20は単独で使えます。アクセス権は必要ありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无论哪个应用在前台都可使用。请与 ⌘、⌥ 或 ⌃ 一起按下按键；F13 到 F20 可单独使用。无需任何权限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無論前景是哪個 App 都能使用。請按住 ⌘、⌥ 或 ⌃ 再按按鍵；F13 至 F20 可單獨使用。不需要任何權限。"}}}
    },
    "Shortcuts app and links" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ショートカットAppとリンク"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“快捷指令”与链接"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「捷徑」App 與連結"}}}
    },
