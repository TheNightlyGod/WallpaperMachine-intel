    "Sign in to pixiv to show R-18 works. R-18G works are never shown." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inicie sessão no pixiv para mostrar obras R-18. Obras R-18G nunca são mostradas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "R-18 작품을 보려면 pixiv에 로그인하세요. R-18G 작품은 절대 표시되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "R-18作品を表示するにはpixivにサインインしてください。R-18G作品が表示されることはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 pixiv 后才能显示 R-18 作品。R-18G 作品始终不会显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 pixiv 才能顯示 R-18 作品。R-18G 作品一律不會顯示。"}}}
    },
    "This pixiv account hides R-18 works. Turn them on in pixiv’s settings under Viewing restrictions." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta conta do pixiv oculta obras R-18. Ative-as nos ajustes do pixiv, em Restrições de visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 pixiv 계정은 R-18 작품을 숨깁니다. pixiv 설정의 ‘열람 제한’에서 표시하도록 설정하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このpixivアカウントではR-18作品が非表示になっています。pixivの設定の「閲覧制限」でオンにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 pixiv 账户隐藏了 R-18 作品。请在 pixiv 设置的“浏览限制”中开启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 pixiv 帳號隱藏了 R-18 作品。請在 pixiv 設定的「瀏覽限制」中開啟。"}}}
    },
    "R-18G works are never shown." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Obras R-18G nunca são mostradas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "R-18G 작품은 절대 표시되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "R-18G作品が表示されることはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "R-18G 作品始终不会显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "R-18G 作品一律不會顯示。"}}}
