    },
    "Choose a .wmbackup package. No current settings will change until you confirm and launch the app again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a .wmbackup package. No current settings will change until you confirm and launch the app again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : ".wmbackup パッケージを選択してください。確定してアプリを再起動するまで、現在の設定は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 .wmbackup 包。确认并重新启动应用前，当前设置不会改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 .wmbackup 套件。確認並重新啟動應用程式前，目前設定不會變更。"}}}
