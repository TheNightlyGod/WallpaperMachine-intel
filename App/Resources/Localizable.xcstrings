    "GitHub's hourly limit for anonymous update checks is used up." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O limite por hora do GitHub para verificações anônimas de atualização foi atingido."}},
        "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub의 시간당 익명 업데이트 확인 한도에 도달했습니다."}},
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub's hourly limit for anonymous update checks is used up."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubの匿名アップデート確認の1時間あたりの上限に達しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 免登录检查更新的每小时额度已用完。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 匿名檢查更新的每小時次數上限已用完。"
          }
        }
      }
    },
    "GitHub's hourly limit for anonymous update checks is used up on this network (60 requests an hour, shared by every app and device on the same public IP). Try again after %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O limite por hora do GitHub para verificações anônimas de atualização foi atingido nesta rede (60 solicitações por hora, compartilhadas por todos os apps e dispositivos no mesmo IP público). Tente novamente após %@."}},
        "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 네트워크에서 GitHub의 시간당 익명 업데이트 확인 한도에 도달했습니다(시간당 요청 60회, 같은 공인 IP를 사용하는 모든 앱과 기기가 공유). %@ 이후에 다시 시도하세요."}},
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub's hourly limit for anonymous update checks is used up on this network (60 requests an hour, shared by every app and device on the same public IP). Try again after %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークで、GitHubの匿名アップデート確認の1時間あたりの上限に達しました（1時間あたり60リクエスト。同じパブリックIPを使用するすべてのAppとデバイスで共有）。%@以降にもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前网络的 GitHub 免登录每小时访问额度已用完（同一公网 IP 下的所有设备和应用共享 60 次/小时）。请在 %@ 之后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此網路的 GitHub 匿名檢查更新每小時次數上限已用完（每小時 60 次，由同一公用 IP 上的所有 App 與裝置共用）。請於 %@ 後再試一次。"
          }
        }
      }
    },
    "GitHub's hourly limit for anonymous update checks is used up on this network (60 requests an hour, shared by every app and device on the same public IP). Try again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O limite por hora do GitHub para verificações anônimas de atualização foi atingido nesta rede (60 solicitações por hora, compartilhadas por todos os apps e dispositivos no mesmo IP público). Tente novamente mais tarde."}},
        "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 네트워크에서 GitHub의 시간당 익명 업데이트 확인 한도에 도달했습니다(시간당 요청 60회, 같은 공인 IP를 사용하는 모든 앱과 기기가 공유). 나중에 다시 시도하세요."}},
