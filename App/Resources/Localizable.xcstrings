    },
    "Scene renderer is experimental." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador de cenas é experimental."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 렌더러는 실험적 기능입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダラは試験運用中です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染器仍处于实验阶段。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染器仍屬實驗性功能。"}}}
    },
    "Playback depends on the video codec." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A reprodução depende do codec do vídeo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 가능 여부는 비디오 코덱에 따라 다릅니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生できるかどうかはビデオコーデックによって異なります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能否播放取决于视频编码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能否播放取決於視訊編解碼器。"}}}
    },
    "Runs in a built-in web view. Mouse input and audio response reach the page; keyboard input does not." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Roda em uma visualização web integrada. A entrada do mouse e a resposta ao áudio chegam à página; a entrada do teclado não."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "내장 웹 뷰에서 실행됩니다. 마우스 입력과 오디오 반응은 페이지에 전달되지만 키보드 입력은 전달되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "内蔵のWebビューで実行されます。マウス入力とオーディオ反応はページに届きますが、キーボード入力は届きません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在内置网页视图中运行。支持鼠标和音频响应，不支持键盘输入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在內建的網頁檢視中執行。網頁可接收滑鼠輸入與音訊回應，但無法接收鍵盤輸入。"}}}
    },
    "Application wallpapers cannot run on macOS." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede do tipo Aplicativo não rodam no macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "응용 프로그램 배경화면은 macOS에서 실행할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アプリケーション壁紙はmacOSでは実行できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用程序类壁纸无法在 macOS 上运行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "應用程式類桌布無法在 macOS 上執行。"}}}
    },
    "This wallpaper type is not supported." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este tipo de papel de parede não é compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 유형은 지원되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この種類の壁紙には対応していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持此壁纸类型。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援此桌布類型。"}}}
    },
    "Reapply wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reaplicar papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 다시 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新套用桌布"}}}
    },
    "Apply wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用桌布"}}}
    },
    "Apply to all displays" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar a todos os monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 디스플레이에 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてのディスプレイに適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用到所有显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用到所有顯示器"}}}
    },
