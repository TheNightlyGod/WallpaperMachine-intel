    },
    "Negative offsets run before the sun event; positive offsets run after it. Set your location below." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Valores negativos ocorrem antes do evento solar; valores positivos, depois. Defina sua localização abaixo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음수 오프셋은 일출·일몰 전, 양수 오프셋은 그 후에 실행합니다. 아래에서 위치를 설정하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "負の値は日の出・日の入りの前、正の値は後を指定します。下で位置を設定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "负数表示提前，正数表示延后。请在下方设置位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "負數表示提前，正數表示延後。請在下方設定位置。"}}}
    },
    "Save rule" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar regra"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "규칙 저장"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ルールを保存"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存規則"}}}
    },
    "Automatic changes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mudanças automáticas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자동 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動切換"}}}
    },
    "Automatic changes for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mudanças automáticas para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 자동 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的自動切換"}}}
    },
    "Manual choices stay until the next rule changes them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolhas manuais permanecem até a próxima regra alterá-las."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "수동으로 선택한 항목은 다음 규칙으로 변경될 때까지 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "手動で選んだ内容は、次のルールが実行されるまで維持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "手动选择会保留到下一条规则触发。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "手動選擇會保留到下一條規則觸發。"}}}
    },
    "In light appearance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na aparência clara"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "라이트 모드일 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライトモード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "浅色外观时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "淺色外觀時"}}}
    },
    "In dark appearance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na aparência escura"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다크 모드일 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダークモード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "深色外观时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "深色外觀時"}}}
    },
    "No time rules yet. Add one to choose when this display changes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma regra de horário ainda. Adicione uma para escolher quando este monitor muda."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 시간 규칙이 없습니다. 규칙을 추가하여 이 디스플레이의 배경화면을 변경할 시각을 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻のルールはまだありません。追加して、このディスプレイを切り替える時刻を設定できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有时间规则。添加规则，设置此显示器的切换时间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還沒有時間規則。新增規則，設定此顯示器的切換時間。"}}}
    },
    "Add time rule" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adicionar regra de horário"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시간 규칙 추가"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻ルールを追加"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "添加时间规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "新增時間規則"}}}
    },
    "If times coincide, the later rule in this list wins. Missed changes wait until this display can play." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Se os horários coincidirem, vale a regra que estiver mais abaixo nesta lista. Mudanças perdidas aguardam até que este monitor possa reproduzir."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시각이 겹치면 목록에서 더 아래에 있는 규칙이 우선합니다. 실행하지 못한 변경은 이 디스플레이에서 재생할 수 있을 때까지 대기합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻が重なる場合は、リストの後のルールが優先されます。実行できなかった切り替えは、このディスプレイが再生可能になるまで待機します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "时间相同时，列表中靠后的规则优先。错过的切换会等到此显示器恢复播放时执行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "時間相同時，列表中較後的規則優先。錯過的切換會等到此顯示器恢復播放時執行。"}}}
    },
    "Next: %@ at %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Próxima: %@ às %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음: %@, %@에 실행"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回：%2$@に%1$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下次：%2$@ 切换为 %1$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下次：%2$@ 切換為 %1$@"}}}
    },
    "A Focus filter is active for this display. Manual choices remain available." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um filtro de Foco está ativo para este monitor. As escolhas manuais continuam disponíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에 집중 모드 필터가 활성화되어 있습니다. 수동으로도 선택할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイでは集中モードフィルタが有効です。手動での選択も可能です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器正在使用专注模式过滤条件。你仍可手动选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器正在使用專注模式過濾條件。你仍可手動選擇。"}}}
    },
    "Retry automatic change" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tentar mudança automática novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자동 변경 다시 시도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替えを再試行"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重试自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重試自動切換"}}}
    },
    "Automatic wallpaper selection" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seleção automática de papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 자동 선택"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の自動選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动选择壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動選擇桌布"}}}
    },
    "Choosing a wallpaper stops this display’s playlist. Choosing a saved playlist starts that plan. Focus choices temporarily override these rules." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher um papel de parede interrompe a playlist deste monitor. Escolher uma playlist salva inicia esse plano. As escolhas de Foco substituem temporariamente estas regras."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 선택하면 이 디스플레이의 재생목록이 정지합니다. 저장된 재생목록을 선택하면 해당 설정으로 재생을 시작합니다. 집중 모드에서 선택한 항목은 이 규칙보다 일시적으로 우선 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を選ぶと、このディスプレイのプレイリストが停止します。保存済みプレイリストを選ぶと、その設定が有効になります。集中モードの選択は一時的にこれらのルールより優先されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸会停止此显示器的播放列表；选择已存播放列表会启用该方案。专注模式的选择会暂时优先于这些规则。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布會停止此顯示器的播放列表；選擇已存播放列表會啟用該方案。專注模式的選擇會暫時優先於這些規則。"}}}
    },
    "Sunrise and sunset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nascer e pôr do sol"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일출 및 일몰"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "日の出と日の入り"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日出与日落"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日出與日落"}}}
    },
    "Enter your coordinates. North and east are positive; south and west are negative. Times use your Mac’s time zone and are calculated locally." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Insira suas coordenadas. Norte e leste são positivos; sul e oeste são negativos. Os horários usam o fuso horário do seu Mac e são calculados localmente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "좌표를 입력하세요. 북위와 동경은 양수, 남위와 서경은 음수입니다. 시간은 Mac의 시간대를 사용하여 기기 내에서 계산합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "緯度と経度を入力してください。北緯と東経は正、南緯と西経は負の値です。Macの時間帯を使ってローカルで計算します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入经纬度。北纬和东经为正数，南纬和西经为负数。时间按 Mac 的时区在本机计算。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入經緯度。北緯和東經為正數，南緯和西經為負數。時間依 Mac 的時區在本機計算。"}}}
    },
    "Latitude" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Latitude"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "위도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "緯度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "纬度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "緯度"}}}
    },
    "Longitude" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Longitude"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "경도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "経度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "经度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "經度"}}}
    },
    "Save location" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar localização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "위치 저장"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "位置を保存"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存位置"}}}
    },
    "Clear location" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar localização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "위치 지우기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "位置を消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除位置"}}}
    },
    "Solar times are approximate. Near the poles, a day may have no sunrise or sunset." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os horários solares são aproximados. Perto dos polos, um dia pode não ter nascer ou pôr do sol."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일출 및 일몰 시각은 대략적인 값입니다. 극지방 부근에서는 일출이나 일몰이 없는 날이 있을 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "日の出・日の入りの時刻は概算です。極地付近では、日の出や日の入りがない日もあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日出日落时间为估算值。极地附近可能出现全天无日出或日落的情况。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日出日落時間為估算值。極地附近可能出現全天無日出或日落的情況。"}}}
    },
    "Choose at least one weekday." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha pelo menos um dia da semana."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "요일을 하나 이상 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "曜日を少なくとも1つ選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请至少选择一周中的一天。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請至少選擇一週中的一天。"}}}
    },
    "The Shortcuts app can control playback, mute or unmute wallpapers, go to the previous or next wallpaper, apply a wallpaper, saved playlist or property preset, and open this window. Siri and Spotlight can run these actions too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O app Atalhos pode controlar a reprodução, silenciar ou ativar o som dos papéis de parede, ir para o papel de parede anterior ou o seguinte, aplicar um papel de parede, uma playlist salva ou uma predefinição de propriedades e abrir esta janela. A Siri e o Spotlight também podem executar essas ações."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "단축어 앱으로 재생을 제어하고, 배경화면의 소리를 끄거나 켜고, 이전 또는 다음 배경화면으로 전환하고, 배경화면이나 저장된 재생목록 또는 속성 프리셋을 적용하고, 이 윈도우를 열 수 있습니다. Siri와 Spotlight에서도 이러한 동작을 실행할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ショートカットで再生の操作、壁紙の消音と消音解除、前後の壁紙への切り替え、壁紙・保存済みプレイリスト・プロパティプリセットの適用、このウインドウの表示ができます。SiriとSpotlightからも実行できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“快捷指令”可以控制播放、让壁纸静音或取消静音、切换上一张或下一张壁纸、应用壁纸、已存播放列表或属性预设，以及打开此窗口。Siri 和聚焦也能运行这些操作。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「捷徑」可以控制播放、讓桌布靜音或取消靜音、切換上一張或下一張桌布、套用桌布、已存播放列表或屬性預設，以及開啟此視窗。Siri 和 Spotlight 也能執行這些操作。"}}}
    },
    "Links can run the same actions. Wallpaper and playlist actions accept display= for a specific screen; otherwise they use the target display. An apply link also accepts display=all, and Apply Wallpaper has an On all displays option, to use every display at once. Property presets affect their wallpaper on every display. Choose saved items by name in Shortcuts." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Links podem executar as mesmas ações. As ações de papel de parede e de playlist aceitam display= para uma tela específica; caso contrário, usam o monitor de destino. Um link de aplicação também aceita display=all, e Aplicar Papel de Parede tem a opção Em todos os monitores, para usar todos os monitores de uma vez. Predefinições de propriedades afetam o papel de parede delas em todos os monitores. No Atalhos, escolha os itens salvos pelo nome."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "링크로도 같은 동작을 실행할 수 있습니다. 배경화면 및 재생목록 동작은 display=로 특정 화면을 지정할 수 있으며, 지정하지 않으면 대상 디스플레이를 사용합니다. 적용 링크는 display=all도 지원하며, ‘배경화면 적용’의 ‘모든 디스플레이에서’ 옵션으로도 모든 디스플레이를 한 번에 사용할 수 있습니다. 속성 프리셋은 모든 디스플레이에서 해당 배경화면에 적용됩니다. 단축어에서 저장된 항목을 이름으로 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リンクからも同じ操作を実行できます。壁紙とプレイリストはdisplay=で画面を指定でき、省略すると対象ディスプレイを使います。適用リンクはdisplay=allにも対応し、「壁紙を適用」には「すべてのディスプレイ」オプションがあり、どちらもすべてのディスプレイをまとめて使います。プロパティプリセットは、同じ壁紙を使うすべてのディスプレイに適用されます。保存した項目はショートカットで名前から選べます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "链接可执行相同操作。壁纸和播放列表操作可用 display= 指定屏幕，省略时使用目标显示器。应用链接还支持 display=all，“应用壁纸”也有“所有显示器”选项，二者都会一次性使用所有显示器。属性预设会影响所有显示器上的对应壁纸。在“快捷指令”中可按名称选择已存项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "連結可執行相同操作。桌布和播放列表操作可用 display= 指定螢幕，省略時使用目標顯示器。套用連結還支援 display=all，「套用桌布」也有「所有顯示器」選項，兩者都會一次使用所有顯示器。屬性預設會影響所有顯示器上的對應桌布。在「捷徑」中可依名稱選擇已存項目。"}}}
    },
    "In System Settings → Focus, add the WallpaperMachine filter to pause, mute, stop or temporarily switch wallpapers. No Focus filter is in effect now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em Ajustes do Sistema → Foco, adicione o filtro do WallpaperMachine para pausar, silenciar, parar ou trocar temporariamente os papéis de parede. Nenhum filtro de Foco está em vigor agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 설정 → 집중 모드에서 WallpaperMachine 필터를 추가하면 배경화면을 일시 정지, 음소거, 정지하거나 일시적으로 전환할 수 있습니다. 현재 적용 중인 집중 모드 필터는 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム設定 → 集中モードでWallpaperMachineフィルタを追加すると、一時停止・消音・停止・壁紙の一時切り替えができます。現在有効なフィルタはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“系统设置 → 专注模式”中添加 WallpaperMachine 过滤条件，即可暂停、静音、停止或临时切换壁纸。目前没有生效的专注模式过滤条件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「系統設定 → 專注模式」中新增 WallpaperMachine 過濾條件，即可暫停、靜音、停止或暫時切換桌布。目前沒有生效的專注模式過濾條件。"}}}
    },
    "%@ moved to position %lld of %lld." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ movido para a posição %lld de %lld."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@을(를) %3$lld개 중 %2$lld번째로 이동했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@を%3$lld件中%2$lld番目に移動しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已将 %1$@ 移至第 %2$lld 项，共 %3$lld 项。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已將 %1$@ 移至第 %2$lld 項，共 %3$lld 項。"}}}
    },
    "The age rating filters hide every collection found for this page." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os filtros de classificação etária ocultam todas as coleções encontradas nesta página."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연령 등급 필터가 이 페이지에서 찾은 모든 컬렉션을 가리고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "年齢区分のフィルタによって、このページで見つかったコレクションがすべて非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "年龄分级筛选隐藏了为本页找到的所有合集。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "年齡分級篩選隱藏了為本頁找到的所有合集。"}}}
    },
    "Open on Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir na Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 열기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamで開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上打开"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上開啟"}}}
    },
    "The age rating and type filters hide every wallpaper on this page." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os filtros de classificação etária e de tipo ocultam todos os papéis de parede desta página."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연령 등급 및 유형 필터가 이 페이지의 모든 배경화면을 가리고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "年齢区分と種類のフィルタによって、このページの壁紙がすべて非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "年龄分级和类型筛选隐藏了本页的所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "年齡分級和類型篩選隱藏了本頁的所有桌布。"}}}
    },
    "pixiv downloads run two at a time; paused downloads stay in the queue." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os downloads do pixiv são feitos dois por vez; downloads pausados permanecem na fila."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 다운로드는 한 번에 2개씩 진행하며, 일시 정지된 다운로드는 대기열에 남습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロードは同時に2件まで実行され、一時停止した項目はキューに残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 下载每次同时运行两个；已暂停的下载会保留在队列中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 下載每次同時執行兩個；已暫停的下載會保留在佇列中。"}}}
    },
    "On. Waiting for an audio frame." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. Aguardando um quadro de áudio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 오디오 프레임을 기다리고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。音声フレームを待っています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，正在等待音频数据。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，正在等待音訊資料。"}}}
    },
    "On. Connecting to audio…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. Conectando ao áudio…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 오디오에 연결 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。音声に接続中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，正在连接音频…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，正在連接音訊…"}}}
    },
    "Audio could not be connected. Turn Audio response off and on to retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível conectar o áudio. Desative e ative a Resposta ao áudio para tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오디오에 연결하지 못했습니다. ‘오디오 반응’을 껐다가 켜서 다시 시도하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "音声に接続できませんでした。「音声に反応」をオフにしてからオンにすると再試行できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频连接失败。关闭再开启“音频响应”以重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊連接失敗。關閉再開啟「音訊回應」以重試。"}}}
    },
    "Wallpaper could not load" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível carregar o papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 불러올 수 없습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を読み込めませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸无法加载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布無法載入"}}}
    },
    "Wallpaper content is ready" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O conteúdo do papel de parede está pronto"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 콘텐츠가 준비되었습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のコンテンツが準備できました"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸内容已就绪"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布內容已就緒"}}}
    },
    "Loading wallpaper content…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Carregando o conteúdo do papel de parede…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 콘텐츠 불러오는 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のコンテンツを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在加载壁纸内容…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入桌布內容…"}}}
    },
    "Retry wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tentar papel de parede novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 다시 시도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再試行"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重试壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重試桌布"}}}
    },
    "Wallpaper Engine ownership confirmed. You can download its Workshop wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Propriedade do Wallpaper Engine confirmada. Você pode baixar os papéis de parede do Workshop dele."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine 소유가 확인되었습니다. 창작마당 배경화면을 다운로드할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認しました。Workshopの壁紙をダウンロードできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已确认拥有 Wallpaper Engine。你可以下载其创意工坊壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已確認擁有 Wallpaper Engine。你可以下載其工作坊桌布。"}}}
    },
    "This Steam account does not own Wallpaper Engine. Please purchase it on Steam to download Wallpaper Engine wallpapers. You can still download from Pixiv, browse the Workshop, and view Wallpaper Engine wallpapers you already have." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta conta Steam não possui o Wallpaper Engine. Compre-o na Steam para baixar papéis de parede do Wallpaper Engine. Você ainda pode baixar do pixiv, navegar pelo Workshop e ver os papéis de parede do Wallpaper Engine que já tem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Steam 계정은 Wallpaper Engine을 소유하고 있지 않습니다. Wallpaper Engine 배경화면을 다운로드하려면 Steam에서 구매하세요. Pixiv에서 다운로드하거나 창작마당을 둘러보거나 이미 가지고 있는 Wallpaper Engine 배경화면을 보는 것은 계속 가능합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamアカウントはWallpaper Engineを所有していません。Wallpaper Engineの壁紙をダウンロードするには、Steamで購入してください。Pixivからのダウンロード、Workshopの閲覧、お持ちのWallpaper Engineの壁紙の表示は引き続き利用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 账户未拥有 Wallpaper Engine。请在 Steam 上购买后再下载 Wallpaper Engine 壁纸。你仍可从 Pixiv 下载、浏览创意工坊，以及查看已有的 Wallpaper Engine 壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 帳號未擁有 Wallpaper Engine。請在 Steam 上購買後再下載 Wallpaper Engine 桌布。你仍可從 Pixiv 下載、瀏覽工作坊，以及檢視已有的 Wallpaper Engine 桌布。"}}}
    },
    "Wallpaper Engine ownership has not been confirmed. Check again to verify this account can download its Workshop wallpapers. You can still download from Pixiv, browse the Workshop, and view wallpapers you already have." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A propriedade do Wallpaper Engine não foi confirmada. Verifique novamente para confirmar que esta conta pode baixar os papéis de parede do Workshop dele. Você ainda pode baixar do pixiv, navegar pelo Workshop e ver os papéis de parede que já tem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine 소유가 확인되지 않았습니다. 이 계정으로 창작마당 배경화면을 다운로드할 수 있는지 다시 확인하세요. Pixiv에서 다운로드하거나 창작마당을 둘러보거나 이미 가지고 있는 배경화면을 보는 것은 계속 가능합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認できていません。再確認して、このアカウントでWorkshopの壁紙をダウンロードできるか確認してください。Pixivからのダウンロード、Workshopの閲覧、お持ちの壁紙の表示は引き続き利用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未确认是否拥有 Wallpaper Engine。请重新检查此账户能否下载其创意工坊壁纸。你仍可从 Pixiv 下载、浏览创意工坊，以及查看已有的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未確認是否擁有 Wallpaper Engine。請重新檢查此帳號能否下載其工作坊桌布。你仍可從 Pixiv 下載、瀏覽工作坊，以及檢視已有的桌布。"}}}
    },
    "Check ownership again" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificar propriedade novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "소유 여부 다시 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "所有状況を再確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新检查拥有状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新檢查擁有狀態"}}}
    },
    "Checking Wallpaper Engine ownership…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificando a propriedade do Wallpaper Engine…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine 소유 여부 확인 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在检查是否拥有 Wallpaper Engine…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在檢查是否擁有 Wallpaper Engine…"}}}
    },
    "You can browse without an account. Steam Workshop downloads require an account that owns Wallpaper Engine. Sign in now, or skip and sign in at your first download." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você pode navegar sem uma conta. Downloads do Workshop da Steam exigem uma conta que possua o Wallpaper Engine. Inicie sessão agora ou pule e inicie sessão no seu primeiro download."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계정 없이도 둘러볼 수 있습니다. Steam 창작마당에서 다운로드하려면 Wallpaper Engine을 소유한 계정이 필요합니다. 지금 로그인하거나 건너뛴 후 처음 다운로드할 때 로그인하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アカウントなしでも閲覧できます。Steam Workshopからのダウンロードには、Wallpaper Engineを所有するアカウントが必要です。今サインインするか、スキップして初回ダウンロード時にサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无需账户即可浏览。从 Steam 创意工坊下载需要拥有 Wallpaper Engine 的账户。现在登录，或跳过并在首次下载时登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無需帳號即可瀏覽。從 Steam 工作坊下載需要擁有 Wallpaper Engine 的帳號。現在登入，或略過並在首次下載時登入。"}}}
    },
