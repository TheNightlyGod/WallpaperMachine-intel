    },
    "Discard it" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Descartar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "폐기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "破棄"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "丟棄"}}}
    },
    "Approval applies only to the exact copy you allow. Gatekeeper and signature checks stay in force." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A aprovação vale apenas para a cópia exata que você permitir. O Gatekeeper e as verificações de assinatura continuam valendo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "승인은 허용한 바로 그 사본에만 적용됩니다. Gatekeeper 및 서명 검사는 계속 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "承認は許可したコピーにのみ適用されます。Gatekeeperと署名の確認は引き続き有効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "批准只对这一份副本有效，Gatekeeper 和签名检查照常生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "核准只適用於你允許的這一份副本。Gatekeeper 與簽章檢查仍會照常生效。"}}}
    },
    "Steam account name" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nome da conta Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 계정 이름"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウント名"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 账户名"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 帳號名稱"}}}
    },
    "Steam password" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Senha da Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 암호"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamパスワード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 密码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 密碼"}}}
    },
    "Steam Guard code" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Código do Steam Guard"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard 코드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guardコード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 令牌验证码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard 驗證碼"}}}
    },
    "Keep me signed in on this Mac" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Manter a sessão iniciada neste Mac"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서 로그인 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでサインインしたままにする"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在这台 Mac 上保持登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在這台 Mac 上保持登入"}}}
    },
    "Saved sign-in on this Mac: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão salva neste Mac: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에 저장된 로그인 정보: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacに保存されているサインイン：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台 Mac 上已保存的登录：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這台 Mac 上已儲存的登入：%@"}}}
    },
    "Continue" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Continuar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계속"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "続ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續"}}}
    },
    "Your password and any Steam Guard code come next. This app never saves them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sua senha e qualquer código do Steam Guard vêm a seguir. Este app nunca os salva."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음으로 암호와 필요한 Steam Guard 코드를 입력합니다. 이 앱은 해당 정보를 저장하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次にパスワードと、必要に応じてSteam Guardコードを入力します。このアプリがこれらを保存することはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "接下来输入密码和 Steam 令牌验证码，应用不会保存它们。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "接下來會輸入密碼及 Steam Guard 驗證碼（若需要）。此 App 絕不會儲存它們。"}}}
    },
    "Shared resources are already installed. Downloading again replaces them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os recursos compartilhados já estão instalados. Baixar novamente os substitui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 리소스가 이미 설치되어 있습니다. 다시 다운로드하면 대치됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有リソースはすでにインストールされています。もう一度ダウンロードすると置き換えられます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享资源已安装。重新下载会将其替换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用資源已安裝。重新下載會加以取代。"}}}
    },
    "Scene wallpapers need shaders and materials from Wallpaper Engine. This is a one-time setup." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede de cena precisam de shaders e materiais do Wallpaper Engine. Esta configuração é feita uma única vez."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 배경화면에는 Wallpaper Engine의 셰이더와 머티리얼이 필요합니다. 이 설정은 한 번만 하면 됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン壁紙にはWallpaper Engineのシェーダとマテリアルが必要です。このセットアップは1回だけです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景壁纸需要 Wallpaper Engine 的着色器和材质，只需设置一次。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景桌布需要 Wallpaper Engine 的著色器與材質。只需設定一次。"}}}
    },
    "Download from Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar da Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从 Steam 下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從 Steam 下載"}}}
    },
    "Needs a Steam account that owns Wallpaper Engine and several gigabytes free while downloading." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Requer uma conta Steam que possua o Wallpaper Engine e vários gigabytes livres durante o download."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine을 소유한 Steam 계정이 필요하며, 다운로드 중 수 GB의 여유 공간이 필요합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineを所有しているSteamアカウントと、ダウンロード中に数GBの空き容量が必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要拥有 Wallpaper Engine 的 Steam 账户，下载时需预留数 GB 空间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要擁有 Wallpaper Engine 的 Steam 帳號，下載期間需保留數 GB 的可用空間。"}}}
    },
    "Use an existing installation" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar uma instalação existente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기존 설치 사용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "既存のインストールを使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用已有安装"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用現有的安裝"}}}
    },
    "Already have Wallpaper Engine installed? Choose its folder instead of downloading." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Já tem o Wallpaper Engine instalado? Escolha a pasta dele em vez de baixar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine이 이미 설치되어 있나요? 다운로드하는 대신 해당 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineをすでにインストール済みですか？ダウンロードする代わりに、そのフォルダを選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已经装了 Wallpaper Engine？选择它的文件夹即可，不用下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已經安裝 Wallpaper Engine？選擇它的資料夾即可，不必下載。"}}}
    },
    "Signing in as %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciando sessão como %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 계정으로 로그인 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@としてサインインしています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正以 %@ 登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在以 %@ 登入"}}}
    },
    "an unnamed account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "uma conta sem nome"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이름 없는 계정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "名前のないアカウント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未命名账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未命名的帳號"}}}
    },
    "your account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "sua conta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용자 계정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "あなたのアカウント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你的账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你的帳號"}}}
    },
    "Change account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trocar de conta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계정 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アカウントを変更"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更换账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更換帳號"}}}
    },
    "Contacting Steam. Password and Steam Guard prompts appear here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Contatando a Steam. Pedidos de senha e do Steam Guard aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에 연결하고 있습니다. 암호 및 Steam Guard 입력 요청이 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamに接続しています。パスワードとSteam Guardの入力要求はここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在连接 Steam。需要输入密码或 Steam 令牌时会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在連線至 Steam。需要輸入密碼或 Steam Guard 驗證時會顯示在這裡。"}}}
    },
    "Get the Steam mobile app" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Obter o app Steam para celular"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 모바일 앱 받기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamモバイルアプリを入手"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "获取 Steam 手机应用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取得 Steam 行動 App"}}}
    },
    "Help with emailed codes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ajuda com códigos por e-mail"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이메일로 받은 코드 도움말"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メールで届くコードについてのヘルプ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "邮件验证码帮助"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電子郵件驗證碼說明"}}}
    },
    "Submit" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Enviar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제출"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "送信"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "提交"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "送出"}}}
    },
    "Cancel this download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar este download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 다운로드 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このダウンロードをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消此下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消此下載"}}}
    },
    "Only approve sign-ins you started yourself. Never share your password or recovery codes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Só aprove inícios de sessão que você mesmo iniciou. Nunca compartilhe sua senha ou códigos de recuperação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "직접 시작한 로그인만 승인하세요. 암호나 복구 코드는 절대 다른 사람에게 알려주지 마세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自分で開始したサインインのみを承認してください。パスワードやリカバリーコードは絶対に他人に教えないでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只批准你自己发起的登录。切勿分享密码或恢复代码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只核准你自己發起的登入。切勿分享你的密碼或復原碼。"}}}
    },
    "Approve the sign-in on your phone" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aprove o início de sessão no seu celular"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "휴대전화에서 로그인 승인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スマートフォンでサインインを承認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在手机上批准登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在手機上核准登入"}}}
    },
    "Steam Guard" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 令牌"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard"}}}
    },
    "Where are you trying to sign in?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Onde você está tentando iniciar sessão?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "어디에 로그인하려고 하시나요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "どこでサインインしようとしていますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你要在哪里登录？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你要在哪裡登入？"}}}
    },
    "Steam Client" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cliente Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 클라이언트"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamクライアント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 客户端"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 用戶端"}}}
    },
    "Open the Steam app on your phone and tap %@, the shield tab at the bottom." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abra o app Steam no seu celular e toque em %@, a aba com o escudo na parte inferior."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "휴대전화에서 Steam 앱을 열고 %@ 탭(하단의 방패 모양)을 탭하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スマートフォンでSteamアプリを開き、下部にある盾のタブ%@をタップします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开手机上的 Steam 应用，点按底部的盾牌标签 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟手機上的 Steam App，點一下底部的盾牌標籤頁 %@。"}}}
    },
    "A request to sign in as %@ is waiting there. Approve it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma solicitação para iniciar sessão como %@ está aguardando ali. Aprove-a."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 계정의 로그인 요청이 대기 중입니다. 승인하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@としてサインインするリクエストが届いているので、承認します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "那里有一条以 %@ 登录的请求，请批准。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "那裡會有一則以 %@ 登入的請求，請核准。"}}}
    },
    "If Steam asks %@, choose %@. This app signs in through Valve’s SteamCMD, which counts as the Steam client." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Se a Steam perguntar %@, escolha %@. Este app inicia sessão pelo SteamCMD da Valve, que conta como o cliente Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 %@ 질문이 표시되면 %@ 항목을 선택하세요. 이 앱은 Steam 클라이언트로 취급되는 Valve의 SteamCMD를 통해 로그인합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから「%1$@」と尋ねられたら、%2$@を選択します。このアプリはValveのSteamCMDを使ってサインインするため、Steamクライアントとして扱われます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "如果 Steam 询问 %1$@，请选择 %2$@。本应用通过 Valve 的 SteamCMD 登录，它属于 Steam 客户端。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "如果 Steam 詢問 %1$@，請選擇 %2$@。此 App 透過 Valve 的 SteamCMD 登入，屬於 Steam 用戶端。"}}}
    },
    "Then come back here. The dialog continues once Steam confirms." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Depois volte aqui. A caixa de diálogo continua assim que a Steam confirmar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "그런 다음 여기로 돌아오세요. Steam에서 확인하면 대화상자가 계속 진행됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "その後、ここに戻ってください。Steamで確認されると、ダイアログが続行されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "然后回到这里，Steam 确认后会自动继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "然後回到這裡。Steam 確認後，對話框會自動繼續。"}}}
    },
    "Only approve a request you just started. Deny anything you do not recognise." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Só aprove uma solicitação que você acabou de iniciar. Recuse qualquer coisa que você não reconheça."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "방금 직접 시작한 요청만 승인하세요. 모르는 요청은 모두 거부하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自分で開始したばかりのリクエストのみを承認してください。心当たりのないものは拒否してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只批准你刚刚发起的请求。拒绝任何你不认识的请求。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只核准你剛剛發起的請求。拒絕任何你不認得的請求。"}}}
    },
    "Enter the code from the Steam app" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite o código do app Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 앱의 코드를 입력하세요"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアプリに表示されたコードを入力"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "输入 Steam 应用中的验证码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "輸入 Steam App 中的驗證碼"}}}
    },
    "Read the five-character code shown at the top. It changes every 30 seconds." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Leia o código de cinco caracteres exibido no topo. Ele muda a cada 30 segundos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "상단에 표시된 5자리 코드를 확인하세요. 코드는 30초마다 바뀝니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "上部に表示されている5文字のコードを確認します。コードは30秒ごとに変わります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "顶部显示的是五位验证码，每 30 秒更换一次。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "查看頂端顯示的五位字元驗證碼，它每 30 秒會變更一次。"}}}
    },
    "Type it below and submit before it changes. If it has already changed, use the new one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite-o abaixo e envie antes que ele mude. Se já tiver mudado, use o novo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "코드가 바뀌기 전에 아래에 입력하고 제출하세요. 이미 바뀌었다면 새 코드를 사용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コードが変わる前に下に入力して送信します。すでに変わっている場合は、新しいコードを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在它更换前填入下方并提交。如果已经换了，就用新的。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在驗證碼變更前於下方輸入並送出。如果已經變更，請使用新的驗證碼。"}}}
    },
    "Don’t share this code with anyone. Enter it only here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não compartilhe este código com ninguém. Digite-o apenas aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 코드를 누구에게도 알려주지 마세요. 이곳에만 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコードは誰にも教えないでください。入力するのはここだけにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不要把验证码告诉任何人，只在这里输入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請勿將此驗證碼告訴任何人，只在這裡輸入。"}}}
    },
    "Enter the code Steam emailed you" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite o código que a Steam enviou por e-mail"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이메일로 보낸 코드를 입력하세요"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからメールで届いたコードを入力"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "输入 Steam 发送到邮箱的验证码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "輸入 Steam 透過電子郵件寄給你的驗證碼"}}}
    },
    "Check the inbox of the email address registered to this Steam account. Look in spam or junk too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verifique a caixa de entrada do e-mail cadastrado nesta conta Steam. Procure também no spam ou lixo eletrônico."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Steam 계정에 등록된 이메일 주소의 받은 편지함을 확인하세요. 스팸 또는 정크 메일함도 확인하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamアカウントに登録されているメールアドレスの受信ボックスを確認します。迷惑メールフォルダも確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "查看此 Steam 账户所绑定邮箱的收件箱，也请检查垃圾邮件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "查看此 Steam 帳號所註冊電子郵件地址的收件匣，也請檢查垃圾郵件。"}}}
    },
    "Open the newest Steam Guard message. Every sign-in attempt sends a fresh code, so older ones no longer work." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abra a mensagem mais recente do Steam Guard. Cada tentativa de início de sessão envia um código novo, então os antigos não funcionam mais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가장 최근의 Steam Guard 메시지를 여세요. 로그인을 시도할 때마다 새 코드가 전송되므로 이전 코드는 더 이상 사용할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最新のSteam Guardメールを開きます。サインインを試みるたびに新しいコードが送信されるため、古いコードは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开最新的 Steam 令牌邮件。每次登录都会发送新验证码，旧的会失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟最新的 Steam Guard 郵件。每次嘗試登入都會寄出新的驗證碼，較舊的驗證碼將無法使用。"}}}
    },
    "Type the five-character code below and submit it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite o código de cinco caracteres abaixo e envie-o."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아래에 5자리 코드를 입력하고 제출하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "5文字のコードを下に入力して送信します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在下方输入五位验证码并提交。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在下方輸入五位字元的驗證碼並送出。"}}}
    },
    "Steam never asks for your password by email. Enter the code only here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam nunca pede sua senha por e-mail. Digite o código apenas aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam은 이메일로 암호를 요청하지 않습니다. 코드는 여기에만 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがメールでパスワードを尋ねることはありません。コードはここにだけ入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 不会通过邮件索要密码。验证码只在这里输入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 絕不會透過電子郵件索取你的密碼。驗證碼只在這裡輸入。"}}}
    },
    "Verify with the method Steam requested" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verifique com o método que a Steam solicitou"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 요청한 방법으로 인증"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamが指定した方法で確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "按 Steam 要求的方式完成验证"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "依 Steam 要求的方式完成驗證"}}}
    },
    "Follow the verification Steam asked for in its app or email, then continue here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Siga a verificação que a Steam pediu no app ou por e-mail e depois continue aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 앱 또는 이메일에서 요청한 인증을 마친 다음 여기에서 계속하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのアプリまたはメールで求められた確認を済ませてから、ここで続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "按照 Steam 应用或邮件中的要求完成验证，然后回到这里继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "依照 Steam 在其 App 或電子郵件中要求的方式完成驗證，然後回到這裡繼續。"}}}
    },
    "Never disable Steam Guard or share passwords or recovery codes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nunca desative o Steam Guard nem compartilhe senhas ou códigos de recuperação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard를 끄거나 비밀번호 또는 복구 코드를 다른 사람에게 알려주지 마세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guardを無効にしたり、パスワードやリカバリーコードを他人に教えたりしないでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "切勿停用 Steam 令牌，也不要分享密码或恢复代码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "切勿停用 Steam Guard，也不要分享密碼或復原碼。"}}}
    },
    "Signed in. Shared resources are downloading first" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada. Os recursos compartilhados estão sendo baixados primeiro"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인했습니다. 공유 리소스를 먼저 다운로드 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしました。まず共有リソースをダウンロードしています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已登录。正在先下载共享资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已登入。正在先下載共用資源"}}}
    },
    "Signed in. %@ is downloading" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada. %@ está sendo baixado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인했습니다. %@ 다운로드 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしました。%@をダウンロードしています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已登录。%@ 正在下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已登入。正在下載 %@"}}}
    },
    "%@ starts automatically once they are installed. You can keep using the app meanwhile." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ começa automaticamente assim que eles forem instalados. Enquanto isso, você pode continuar usando o app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치가 완료되면 %@ 다운로드가 자동으로 시작됩니다. 그동안 앱을 계속 사용할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有リソースのインストールが完了すると、%@のダウンロードが自動的に開始されます。その間もアプリは引き続き使用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享资源装好后，%@ 会自动开始下载。这期间可以照常使用应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用資源安裝完成後，%@ 會自動開始下載。這段期間你可以繼續使用此 App。"}}}
    },
    "You can keep using the app. Progress shows on the wallpaper and in the downloads list." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você pode continuar usando o app. O progresso aparece no papel de parede e na lista de downloads."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱을 계속 사용할 수 있습니다. 진행 상황은 배경화면과 다운로드 목록에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アプリは引き続き使用できます。進行状況は壁紙とダウンロードリストに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可以继续使用应用。进度会显示在壁纸卡片和下载列表中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你可以繼續使用此 App。進度會顯示在桌布上及下載列表中。"}}}
    },
    "Download progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso do download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載進度"}}}
    },
    "Download in progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Download em andamento"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載"}}}
    },
    "Show downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar downloads"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示下載項目"}}}
    },
    "Setup progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso da configuração"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定進度"}}}
    },
    "Language & appearance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Idioma e aparência"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "언어 및 모양"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "言語と外観"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "语言与外观"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "語言與外觀"}}}
    },
    "Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam"}}}
    },
    "Preferences" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preferências"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "환경설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "環境設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "偏好设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "偏好設定"}}}
    },
    "Tips" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dicas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "팁"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ヒント"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用提示"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用提示"}}}
    },
    "Start" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Começar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시작"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "開始"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "开始"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開始"}}}
    },
    "Back" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Voltar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "뒤로"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "戻る"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上一步"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上一步"}}}
    },
    "Skip" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pular"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "건너뛰기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スキップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過"}}}
    },
    "Skip for now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pular por enquanto"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금은 건너뛰기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "今はスキップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂时跳过"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫時略過"}}}
    },
    "Skip and cancel sign-in" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pular e cancelar início de sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "건너뛰고 로그인 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スキップしてサインインをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过并取消登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過並取消登入"}}}
    },
    "Start using the app" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Começar a usar o app"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 사용 시작"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アプリを使い始める"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "开始使用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開始使用"}}}
    },
    "Welcome to WallpaperMachine" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Bem-vindo ao WallpaperMachine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine에 오신 것을 환영합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineへようこそ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "欢迎使用 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "歡迎使用 WallpaperMachine"}}}
    },
    "Use Steam Workshop wallpapers on your Mac desktop. Choose a language and appearance to start. You can change both later in Settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Use papéis de parede do Workshop da Steam na mesa do seu Mac. Escolha um idioma e uma aparência para começar. Você pode alterar ambos depois nos Ajustes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac 데스크탑에서 Steam 창작마당 배경화면을 사용하세요. 시작하려면 언어와 화면 모드를 선택하세요. 나중에 설정에서 둘 다 변경할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamワークショップの壁紙をMacのデスクトップで使用できます。まず言語と外観を選択してください。どちらも後で「設定」で変更できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Mac 桌面上使用 Steam 创意工坊的壁纸。先选择语言和外观，之后可以在“设置”中更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Mac 桌面上使用 Steam 工作坊的桌布。請先選擇語言與外觀，之後可以在「設定」中更改。"}}}
    },
    "Follows the macOS language" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Segue o idioma do macOS"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS의 언어를 따릅니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSの言語に合わせる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跟随 macOS 的语言"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "跟隨 macOS 語言"}}}
    },
    "Follows macOS light and dark" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Segue o claro e escuro do macOS"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS의 라이트 및 다크 모드를 따릅니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSのライト/ダークに合わせる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跟随 macOS 的浅色 / 深色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "跟隨 macOS 的淺色與深色"}}}
    },
    "No Steam account yet?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ainda não tem uma conta Steam?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 Steam 계정이 없으신가요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウントをまだお持ちでないですか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有 Steam 账户？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還沒有 Steam 帳號？"}}}
    },
    "Creating one is free." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Criar uma é grátis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계정은 무료로 만들 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アカウントは無料で作成できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "注册免费。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "註冊完全免費。"}}}
    },
    "Create a Steam account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Criar uma conta Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 계정 생성"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウントを作成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "注册 Steam 账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "建立 Steam 帳號"}}}
    },
    "Don’t own Wallpaper Engine?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não tem o Wallpaper Engine?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine이 없으신가요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineをお持ちでないですか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有 Wallpaper Engine？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還沒有 Wallpaper Engine？"}}}
    },
    "It is a one-time purchase on Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "É uma compra única na Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 한 번만 구매하면 됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamで一度購入するだけで使えます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上一次性买断。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只需在 Steam 上購買一次。"}}}
    },
    "Buy Wallpaper Engine" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Comprar o Wallpaper Engine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine 구입"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineを購入"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "购买 Wallpaper Engine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "購買 Wallpaper Engine"}}}
    },
    "The name you log in with" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O nome que você usa para entrar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인에 사용하는 이름"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインに使用する名前"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你登录时用的名称"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你登入時使用的名稱"}}}
    },
    "Your login name, not the profile name other players see." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seu nome de usuário, não o nome de perfil que outros jogadores veem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 플레이어에게 표시되는 프로필 이름이 아니라 로그인 이름입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのプレイヤーに表示されるプロフィール名ではなく、ログイン名です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "是登录名，不是其他玩家看到的个人资料昵称。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "是你的登入名稱，而非其他玩家看到的個人檔案名稱。"}}}
    },
    "Password" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Senha"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "암호"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パスワード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "密码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "密碼"}}}
    },
    "Show password" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar senha"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "암호 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パスワードを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示密码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示密碼"}}}
    },
    "Hide password" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar senha"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "비밀번호 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パスワードを非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏密码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏密碼"}}}
    },
    "Keeps you signed in to Steam on this Mac so downloads don’t ask again. Your password is not saved." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mantém sua sessão da Steam iniciada neste Mac para que os downloads não peçam de novo. Sua senha não é salva."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서 Steam 로그인을 유지하여 다운로드할 때 다시 로그인하지 않아도 됩니다. 비밀번호는 저장되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでSteamにサインインしたままにして、ダウンロードのたびにサインインを求められないようにします。パスワードは保存されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在这台 Mac 上保持 Steam 登录，之后下载不用再登录。不会保存密码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在這台 Mac 上保持 Steam 登入狀態，之後下載時就不必再次登入。不會儲存你的密碼。"}}}
    },
    "Sign in" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入"}}}
    },
    "Install SteamCMD and sign in" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Instalar SteamCMD e iniciar sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 설치 후 로그인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDをインストールしてサインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装 SteamCMD 并登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝 SteamCMD 並登入"}}}
    },
    "Your password goes straight to Valve’s SteamCMD and is never stored by this app. Steam Guard requests appear here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sua senha vai direto para o SteamCMD da Valve e nunca é armazenada por este app. Pedidos do Steam Guard aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "암호는 Valve의 SteamCMD로 직접 전달되며 이 앱에 저장되지 않습니다. Steam Guard 요청은 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パスワードはValveのSteamCMDに直接渡され、このアプリに保存されることはありません。Steam Guardのリクエストはここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "密码直接交给 Valve 的 SteamCMD，应用不会保存。Steam 令牌验证会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你的密碼會直接傳送給 Valve 的 SteamCMD，此 App 絕不會儲存。Steam Guard 驗證要求會顯示在這裡。"}}}
    },
    "SteamCMD is Valve’s free download tool. It is installed into this app’s own folder the first time. Your password goes straight to it and is never stored by this app." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD é a ferramenta gratuita de download da Valve. Ele é instalado na própria pasta deste app na primeira vez. Sua senha vai direto para ele e nunca é armazenada por este app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD는 Valve의 무료 다운로드 도구입니다. 처음 사용할 때 이 앱 전용 폴더에 설치됩니다. 암호는 SteamCMD로 직접 전달되며 이 앱에 저장되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveの無料ダウンロードツールです。初回にこのアプリ専用のフォルダにインストールされます。パスワードはSteamCMDに直接渡され、このアプリに保存されることはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免费下载工具，首次使用时会安装到应用自己的文件夹。密码直接交给它，应用不会保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免費下載工具，首次使用時會安裝到此 App 自己的資料夾。你的密碼會直接傳送給它，此 App 絕不會儲存。"}}}
    },
    "Enter your Steam account name: the login name, not the profile name." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite o nome da sua conta Steam: o nome de usuário, não o nome de perfil."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 계정 이름을 입력하세요. 프로필 이름이 아닌 로그인 이름입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウント名を入力してください。プロフィール名ではなくログイン名です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 Steam 账户名：是登录名，不是个人资料昵称。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入你的 Steam 帳號名稱：是登入名稱，而非個人檔案名稱。"}}}
    },
    "Enter your Steam password." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite sua senha da Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 비밀번호를 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamパスワードを入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 Steam 密码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入你的 Steam 密碼。"}}}
    },
    "SteamCMD is Valve’s free download tool. It is being installed into this app’s own folder; the sign-in follows on its own." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD é a ferramenta gratuita de download da Valve. Ele está sendo instalado na própria pasta deste app; o início de sessão vem logo em seguida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD는 Valve의 무료 다운로드 도구입니다. 이 앱 전용 폴더에 설치하고 있습니다. 완료되면 자동으로 로그인이 진행됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveの無料ダウンロードツールです。このアプリ専用のフォルダにインストールしています。完了すると自動的にサインインに進みます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免费下载工具，正在安装到应用自己的文件夹，装好后会自动继续登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免費下載工具，正在安裝到此 App 自己的資料夾；安裝完成後會自動接著登入。"}}}
    },
    "macOS needs your approval before this downloaded copy of SteamCMD can run. Only this exact copy is allowed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS precisa da sua aprovação antes que esta cópia baixada do SteamCMD possa ser executada. Somente esta cópia exata é permitida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 이 SteamCMD 사본을 실행하려면 macOS에서 사용자의 승인이 필요합니다. 정확히 이 사본만 허용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたこのSteamCMDのコピーを実行するには、macOSでの承認が必要です。許可されるのはこのコピーのみです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这份下载的 SteamCMD 需要你批准才能运行，批准只对这一份有效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 需要你核准後，這份下載的 SteamCMD 副本才能執行。只有這一份副本會獲得允許。"}}}
    },
    "The sign-in starts as soon as the current download is done." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O início de sessão começa assim que o download atual terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 다운로드가 완료되는 즉시 로그인이 시작됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のダウンロードが完了するとすぐにサインインが始まります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前下载完成后就会开始登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前的下載完成後就會開始登入。"}}}
    },
    "Waiting" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대기 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "待機中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "等待中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "等待中"}}}
    },
    "Waiting for Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando a Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 대기 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待 Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待 Steam"}}}
    },
    "Steam asks for your password" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam está pedindo sua senha"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 암호를 요청합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがパスワードを求めています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求输入密码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求輸入密碼"}}}
    },
    "Enter it below. It goes straight to Steam and is never stored by this app." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite-a abaixo. Ela vai direto para a Steam e nunca é armazenada por este app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아래에 입력하세요. Steam으로 직접 전송되며 이 앱에는 절대 저장되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "下に入力してください。パスワードはSteamに直接渡され、このアプリに保存されることはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在下方输入。密码直接交给 Steam，应用不会保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請在下方輸入。密碼會直接傳送給 Steam，此 App 絕不會儲存。"}}}
    },
    "Contacting Steam…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Contatando a Steam…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에 연결 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamに接続中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在连接 Steam…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在連線至 Steam…"}}}
    },
    "Password and Steam Guard prompts appear here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pedidos de senha e do Steam Guard aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "암호 및 Steam Guard 입력 요청이 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パスワードとSteam Guardの入力要求はここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要输入密码或 Steam 令牌时会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要輸入密碼或 Steam Guard 驗證時會顯示在這裡。"}}}
    },
    "The sign-in was cancelled." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O início de sessão foi cancelado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인이 취소되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインはキャンセルされました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录已取消。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入已取消。"}}}
    },
    "Downloads will use this sign-in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os downloads usarão este início de sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드에 이 로그인을 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードにはこのサインインが使用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "之后的下载会使用这次登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "之後的下載會使用此登入。"}}}
    },
    "Use a different account" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar outra conta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 계정 사용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のアカウントを使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "换一个账户"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用其他帳號"}}}
    },
    "Choose how smoothly wallpapers run and how much energy they use. You can change this later in Settings › Performance." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha a fluidez dos papéis de parede e quanta energia eles consomem. Você pode alterar isso depois em Ajustes › Desempenho."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재생의 부드러움과 에너지 사용량을 선택하세요. 나중에 설정 › 성능에서 변경할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の動作の滑らかさとエネルギー使用量を選択します。この設定は後で「設定」›「パフォーマンス」で変更できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸运行的流畅度和耗电量。之后也可以在“设置 › 性能”中更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布執行的流暢度與能源用量。之後可以在「設定 › 效能」中更改。"}}}
    },
    "Up to 30 fps at half resolution. Uses the least energy." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Até 30 fps em metade da resolução. Consome menos energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "절반 해상도에서 최대 30 fps로 재생합니다. 에너지를 가장 적게 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最大30 fps、解像度は半分。エネルギー使用量が最も少なくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最高 30 fps，以一半分辨率渲染。最省电。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "最高 30 fps，以一半解析度渲染。最節省能源。"}}}
    },
    "Up to 60 fps at 75% resolution." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Até 60 fps em 75% da resolução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "75% 해상도에서 최대 60 fps로 재생합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最大60 fps、解像度は75%。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最高 60 fps，以 75% 分辨率渲染。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "最高 60 fps，以 75% 解析度渲染。"}}}
    },
    "No frame-rate limit, full resolution. The default." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sem limite de taxa de quadros, resolução total. O padrão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프레임률 제한 없이 전체 해상도를 사용합니다. 기본 설정입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームレートの制限なし、フル解像度。デフォルトの設定です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不限帧率，完整分辨率。默认选项。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不限制影格率，完整解析度。預設選項。"}}}
    },
    "Custom: the frame-rate limit and render scale match none of the presets." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Personalizado: o limite de taxa de quadros e a escala de renderização não correspondem a nenhuma predefinição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용자화: 프레임률 제한과 렌더링 배율이 어떤 프리셋과도 일치하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "カスタム：フレームレートの上限とレンダリングスケールがどのプリセットとも一致しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自定义：当前的帧率上限和渲染比例与任何预设都不相符。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自訂：目前的影格率上限與渲染比例不符合任何預設集。"}}}
    },
    "At the top of the slider there is no limit, and each display runs at up to 60 fps unless you choose more for it. A lower limit saves energy." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "No topo do controle deslizante não há limite, e cada monitor roda a até 60 fps, a menos que você escolha mais para ele. Um limite menor economiza energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "슬라이더를 최대로 올리면 제한이 없으며, 개별적으로 더 높은 값을 선택하지 않는 한 각 디스플레이는 최대 60 fps로 작동합니다. 상한을 낮추면 에너지를 절약할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スライダをいちばん上にすると制限なしになり、個別に高い値を選択しない限り、各ディスプレイは最大60 fpsで動作します。上限を低くするとエネルギーを節約できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "滑块最顶端表示不限制，每台显示器最高以 60 fps 运行，除非你为它选了更高的帧率。更低的上限更省电。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "滑桿拉到最頂端表示不限制，此時每台顯示器最高以 60 fps 執行，除非你為它選擇更高的值。較低的上限可節省能源。"}}}
    },
    "A few preferences" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Algumas preferências"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "몇 가지 설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "いくつかの環境設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "几项偏好设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "幾項偏好設定"}}}
    },
    "You can change these later in Settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você pode alterar isso depois nos Ajustes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "나중에 설정에서 변경할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "これらは後で「設定」で変更できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这些之后也可以在“设置”中更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "之後可以在「設定」中更改這些項目。"}}}
    },
    "Wallpapers come back on their own after a restart." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os papéis de parede voltam sozinhos após reiniciar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재시작 후 배경화면이 자동으로 복원됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再起動後、壁紙が自動的に元に戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重启 Mac 后壁纸会自动恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新開機後，桌布會自動恢復。"}}}
    },
    "The basics" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O básico"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기본 사용법"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "基本操作"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "基本用法"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "基本操作"}}}
    },
    "Browse wallpapers in Steam Workshop. No account needed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Explore papéis de parede no Workshop da Steam. Não é preciso ter conta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 창작마당에서 배경화면을 둘러보세요. 계정은 필요하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「Steamワークショップ」で壁紙をブラウズできます。アカウントは不要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“Steam 创意工坊”中浏览壁纸，无需登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「Steam 工作坊」中瀏覽桌布，不需要帳號。"}}}
    },
    "Download one, then double-click it to apply." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixe um e clique duas vezes nele para aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 다운로드한 다음 이중 클릭하여 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をダウンロードしたら、ダブルクリックして適用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载后双击即可应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載桌布後，按兩下即可套用。"}}}
    },
    "Each display plays its own wallpaper. Pick the display in the top bar." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cada monitor exibe seu próprio papel de parede. Escolha o monitor na barra superior."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "각 디스플레이에서 별도의 배경화면을 재생합니다. 상단 막대에서 디스플레이를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイごとに別々の壁紙を再生できます。上部のバーでディスプレイを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每个显示器可以播放不同的壁纸，在顶栏选择显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每台顯示器會播放各自的桌布。請在頂部列中選擇顯示器。"}}}
    },
    "Not every wallpaper works yet" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nem todo papel de parede funciona ainda"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 모든 배경화면이 작동하는 것은 아닙니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まだすべての壁紙が動作するわけではありません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "并非所有壁纸都能播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "並非所有桌布都能使用"}}}
    },
    "Videos usually play. Scenes are experimental, and Application wallpapers can’t run on macOS. If one doesn’t work, use “Report on GitHub” in its details. Pull requests are welcome too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vídeos geralmente funcionam. Cenas são experimentais, e papéis de parede do tipo Aplicativo não rodam no macOS. Se algum não funcionar, use “Relatar no GitHub” nos detalhes dele. Pull requests também são bem-vindos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상은 대부분 재생됩니다. 장면 지원은 실험적이며, 애플리케이션 배경화면은 macOS에서 실행할 수 없습니다. 작동하지 않는 경우 세부사항의 ‘GitHub에 보고’를 사용하세요. 풀 리퀘스트도 환영합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオはほとんどの場合再生できます。シーンは実験的なサポートで、アプリケーション壁紙はmacOSでは実行できません。動作しない壁紙があれば、その詳細にある「GitHubで報告」を使用してください。プルリクエストも歓迎します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频壁纸通常可以播放；场景壁纸为实验性支持；应用程序壁纸无法在 macOS 上运行。遇到无法正常使用的壁纸，可以在它的详情中点击“在 GitHub 上反馈”，也欢迎提交 Pull Request。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片桌布通常可以播放；場景桌布屬於實驗性支援；應用程式桌布無法在 macOS 上執行。若某張桌布無法運作，請在其詳細資訊中使用「在 GitHub 上回報」。也歡迎提交 Pull Request。"}}}
    },
    "Contribute on GitHub" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Contribuir no GitHub"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub에서 기여하기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GitHubで貢献"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 上参与贡献"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 上參與貢獻"}}}
    },
    "Report an issue" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Relatar um problema"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "문제 보고"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "問題を報告"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "反馈问题"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回報問題"}}}
    },
    "Setup complete" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Configuração concluída"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 완료"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップ完了"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置完成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定完成"}}}
    },
    "%lld change not saved" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld alteração não salva"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 사항 %lld개가 저장되지 않음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld件の変更が保存されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 项更改未保存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 項變更未儲存"}}}
    },
    "%lld changes not saved" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld alterações não salvas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 사항 %lld개가 저장되지 않음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld件の変更が保存されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 项更改未保存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 項變更未儲存"}}}
    },
    "Review" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Revisar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검토"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "查看"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "檢視"}}}
    },
    "Your Steam subscriptions could not be read, so the tiles do not mark them yet: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Steam subscriptions could not be read, so the tiles do not mark them yet: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steamのサブスクリプションを読み込めなかったため、タイルにはまだ印が付いていません: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 구독을 읽을 수 없어 타일에 아직 구독 표시가 없습니다: %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler suas inscrições na Steam, então os blocos ainda não as marcam: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取你在 Steam 上的订阅，卡片暂时不显示订阅标记：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取你在 Steam 上的訂閱，縮圖暫時不顯示訂閱標記：%@"
          }
        }
      }
    },
    "Your desktop won’t change until you apply a wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sua mesa não vai mudar até você aplicar um papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 적용하기 전까지 데스크탑은 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用するまで、デスクトップは変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸之前，桌面不会有任何变化。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在你套用桌布之前，桌面不會有任何變化。"}}}
    },
    "Not signed in. You’ll be asked at your first download." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão não iniciada. Isso será pedido no seu primeiro download."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인하지 않았습니다. 처음 다운로드할 때 로그인 안내가 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしていません。最初のダウンロード時に求められます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未登录，第一次下载时再登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未登入。第一次下載時會請你登入。"}}}
    },
    "Browse the Workshop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Explorar o Workshop"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창작마당 둘러보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップをブラウズ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "浏览创意工坊"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "瀏覽工作坊"}}}
    },
    "Find wallpapers from Steam in Browse → Steam Workshop." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Encontre papéis de parede da Steam em Explorar → Workshop da Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "둘러보기 → Steam 창작마당에서 Steam 배경화면을 찾아보세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ブラウズ」→「Steamワークショップ」でSteamの壁紙を探せます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“浏览 → Steam 创意工坊”中查找 Steam 上的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「瀏覽 → Steam 工作坊」中尋找 Steam 上的桌布。"}}}
    },
    "Bring in wallpaper folders or files you already have." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Traga pastas ou arquivos de papel de parede que você já tem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미 보유한 배경화면 폴더나 파일을 가져옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "手持ちの壁紙フォルダやファイルを読み込みます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入你已有的壁纸文件夹或文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯入你現有的桌布資料夾或檔案。"}}}
    },
