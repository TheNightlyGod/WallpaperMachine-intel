    },
    "External file references are not portable. Choose the files in the property editor and save a new preset." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "External file references are not portable. Choose the files in the property editor and save a new preset."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外部ファイル参照は移行できません。プロパティエディタでファイルを選択し、新しいプリセットを保存してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外部文件引用不可移植。请在属性编辑器中选择文件并保存新预设。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "外部檔案參照無法攜帶至其他電腦。請在屬性編輯器中選擇檔案並儲存新預設。"}}}
    },
    "Enter a property preset name of 1–120 characters." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter a property preset name of 1–120 characters."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1～120 文字のプロパティプリセット名を入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 1–120 个字符的属性预设名称。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入 1–120 個字元的屬性預設名稱。"}}}
    },
    "This property preset document is invalid or exceeds the supported limits." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset document is invalid or exceeds the supported limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセット文書は無効か、対応する上限を超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设文档无效或超过支持的限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設文件無效或超過支援的限制。"}}}
    },
    "Preset property %@ does not match the current authored values or limits." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ does not match the current authored values or limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は、現在の作者定義の値または制限に一致しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 不符合当前作者定义的值或限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 不符合目前作者定義的值或限制。"}}}
    },
    "Preset property %@ is currently disabled. No preset changes were applied." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ is currently disabled. No preset changes were applied."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は現在無効です。プリセットの変更は適用されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 当前已禁用。未应用任何预设更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 目前已停用。未套用任何預設變更。"}}}
    },
    "Preset property %@ references missing or unreadable assets. Choose the files again before applying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ references missing or unreadable assets. Choose the files again before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は、見つからないか読み取れないアセットを参照しています。適用前にファイルを再選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 引用了缺失或不可读的资源。应用前请重新选择文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 參照了遺失或無法讀取的資源。套用前請重新選擇檔案。"}}}
    },
    "Portable property presets support up to 32 MB of managed assets. External files are not bundled." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Portable property presets support up to 32 MB of managed assets. External files are not bundled."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移行可能なプロパティプリセットは、最大 32 MB の管理対象アセットに対応します。外部ファイルは同梱されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "便携属性预设支持最多 32 MB 的托管资源。外部文件不会打包。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可攜式屬性預設支援最多 32 MB 的受管理資源。外部檔案不會封裝。"}}}
    },
    "The backup contains an unsafe path, link or special file: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The backup contains an unsafe path, link or special file: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップに安全でないパス、リンク、または特殊ファイルが含まれています：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份包含不安全的路径、链接或特殊文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份包含不安全的路徑、連結或特殊檔案：%@"}}}
    },
    "This backup exceeds the supported file, size or manifest limits." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This backup exceeds the supported file, size or manifest limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバックアップは、対応するファイル数、サイズ、またはマニフェストの上限を超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此备份超过支持的文件、大小或清单限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此備份超過支援的檔案、大小或資訊清單限制。"}}}
    },
    "The backup changed after it was reviewed. Preview it again before restoring." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The backup changed after it was reviewed. Preview it again before restoring."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認後にバックアップが変更されました。復元前にもう一度プレビューしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份在检查后发生变化。恢复前请重新预览。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份在檢查後發生變更。還原前請重新預覽。"}}}
