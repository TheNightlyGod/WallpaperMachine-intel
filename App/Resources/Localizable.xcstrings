    "This web wallpaper’s entry page is missing. Import the complete project folder, including its HTML file, before applying it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A página de entrada deste papel de parede web está ausente. Importe a pasta completa do projeto, incluindo o arquivo HTML, antes de aplicá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 웹 배경화면의 진입 페이지가 없습니다. 적용하기 전에 HTML 파일을 포함한 전체 프로젝트 폴더를 가져오세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This web wallpaper’s entry page is missing. Import the complete project folder, including its HTML file, before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このWeb壁紙のエントリページが見つかりません。適用する前に、HTMLファイルを含むプロジェクトフォルダ全体を読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此网页壁纸缺少入口页面。请先导入包含 HTML 文件的完整项目文件夹，再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此網頁桌布缺少進入頁面。套用前，請先匯入包含 HTML 檔案的完整專案資料夾。"}}}
    },
    "Web wallpaper “%@” could not load: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível carregar o papel de parede web “%1$@”: %2$@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면 ‘%1$@’을(를) 불러올 수 없습니다: %2$@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Web wallpaper “%1$@” could not load: %2$@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙「%1$@」を読み込めませんでした：%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸“%1$@”无法加载：%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布「%1$@」無法載入：%2$@"}}}
    },
    "The web wallpaper stopped unexpectedly and could not be restarted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede web parou inesperadamente e não pôde ser reiniciado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면이 예기치 않게 정지되었으며 다시 시작할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper stopped unexpectedly and could not be restarted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙が予期せず停止し、再起動できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸意外停止且无法重新启动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布意外停止，且無法重新啟動。"}}}
