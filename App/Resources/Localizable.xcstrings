    },
    "This property preset no longer exists." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset no longer exists."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセットは存在しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设已不存在。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設已不存在。"}}}
    },
    "Apply or revert pending edits before saving or applying a property preset." : {
