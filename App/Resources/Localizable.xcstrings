    },
    "Sunset time" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Horário do pôr do sol"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일몰 시각"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Sunset time"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "日の入り時刻"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日落时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日落時間"}}}
    },
    "Open Location Settings" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir Ajustes de Localização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "위치 설정 열기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Open Location Settings"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "位置情報設定を開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开定位设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟定位設定"}}}
    },
    "Location Services is turned off on this Mac. Turn it on in System Settings → Privacy & Security → Location Services." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os Serviços de Localização estão desativados neste Mac. Ative-os em Ajustes do Sistema → Privacidade e Segurança → Serviços de Localização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서 위치 서비스가 꺼져 있습니다. 시스템 설정 → 개인정보 보호 및 보안 → 위치 서비스에서 켜세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Location Services is turned off on this Mac. Turn it on in System Settings → Privacy & Security → Location Services."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでは位置情報サービスがオフです。システム設定 → プライバシーとセキュリティ → 位置情報サービスでオンにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台 Mac 的定位服务已关闭。请在「系统设置 → 隐私与安全性 → 定位服务」中打开。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這台 Mac 的定位服務已關閉。請在「系統設定 → 隱私權與安全性 → 定位服務」中開啟。"}}}
    },
    "Allow location access to calculate sunrise and sunset for this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permita o acesso à localização para calcular o nascer e o pôr do sol para este Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac의 일출 및 일몰 시간을 계산하려면 위치 접근을 허용하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Allow location access to calculate sunrise and sunset for this Mac."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacの日の出と日の入りを計算するために、位置情報へのアクセスを許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请允许访问位置，以计算这台 Mac 所在地的日出和日落时间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請允許存取位置，以計算這台 Mac 所在地的日出和日落時間。"}}}
    },
    "Waiting for the current location…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando a localização atual…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 위치 대기 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the current location…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在地を取得しています…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在获取当前位置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在取得目前位置…"}}}
    },
    "NSLocationUsageDescription" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine usa a localização aproximada deste Mac para calcular o nascer e o pôr do sol para as trocas automáticas de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine은 배경화면을 자동으로 변경하기 위해 이 Mac의 대략적인 위치를 사용하여 일출 및 일몰 시각을 계산합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine uses this Mac’s approximate location to calculate sunrise and sunset for automatic wallpaper changes."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは、このMacのおおよその位置情報を使って日の出と日の入りを計算し、壁紙を自動的に切り替えます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 使用这台 Mac 的大致位置计算日出和日落时间，以自动切换壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 使用這台 Mac 的概略位置計算日出和日落時間，以自動切換桌布。"}}}
    },
    "NSAppleEventsUsageDescription" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine pergunta à Música e ao Spotify o que está tocando, somente enquanto a integração de mídia estiver ativada para um papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine은 배경화면의 미디어 연동을 켠 동안에만 Music과 Spotify에 재생 중인 곡 정보를 요청합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine asks Music and Spotify what is playing, only while you have turned media integration on for a wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは、壁紙のメディア連携をオンにしている間だけ、MusicとSpotifyで再生中の曲を確認します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仅在你为壁纸开启媒体集成时，向 Music 和 Spotify 查询正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 只會在你為桌布開啟媒體整合時，向 Music 和 Spotify 查詢正在播放的內容。"}}}
    },
    "NSAudioCaptureUsageDescription" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine captura o áudio do sistema somente quando você ativa papéis de parede que reagem ao áudio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine은 오디오 반응형 배경화면을 활성화할 때만 시스템 오디오를 캡처합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine captures system audio only when you enable audio-reactive wallpapers."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは、音声に反応する壁紙を有効にしたときだけシステムオーディオをキャプチャします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仅在你启用音频响应壁纸时捕获系统音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 只會在你啟用音訊反應桌布時擷取系統音訊。"}}}
    },
    "A new version of WallpaperMachine is available!" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma nova versão do WallpaperMachine está disponível!"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine의 새 버전을 사용할 수 있습니다!"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A new version of WallpaperMachine is available!"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine の新しいバージョンがあります！"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 有新版本可用！"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 有新版本可用！"}}}
    },
    "A new version of WallpaperMachine is ready to install!" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma nova versão do WallpaperMachine está pronta para instalar!"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine의 새 버전을 설치할 준비가 되었습니다!"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A new version of WallpaperMachine is ready to install!"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine の新しいバージョンをインストールできます！"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 新版本已可安装！"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 新版本已可安裝！"}}}
    },
    "WallpaperMachine %@ is now available—you have %@. Would you like to download it now?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine %@ já está disponível — você tem a %@. Deseja baixá-lo agora?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@을(를) 사용할 수 있습니다. 현재 버전은 %@입니다. 지금 다운로드하시겠습니까?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ is now available—you have %@. Would you like to download it now?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ が利用可能です（現在のバージョンは %@）。今すぐダウンロードしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 现已推出，你当前使用的是 %@。要立即下载吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 現已推出，你目前使用的是 %@。要立即下載嗎？"}}}
    },
    "WallpaperMachine %@ is now available—you have %@. Download it from GitHub Releases." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine %@ já está disponível — você tem a %@. Baixe-o no GitHub Releases."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@을(를) 사용할 수 있습니다. 현재 버전은 %@입니다. GitHub Releases에서 다운로드하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ is now available—you have %@. Download it from GitHub Releases."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ が利用可能です（現在のバージョンは %@）。GitHub Releases からダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 现已推出，你当前使用的是 %@。请从 GitHub Releases 下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 現已推出，你目前使用的是 %@。請從 GitHub Releases 下載。"}}}
    },
    "WallpaperMachine %@ has been downloaded—you have %@. WallpaperMachine quits and reopens to install it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine %@ foi baixado — você tem a %@. O WallpaperMachine será encerrado e reaberto para instalá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@을(를) 다운로드했습니다. 현재 버전은 %@입니다. 설치를 위해 WallpaperMachine이 종료된 후 다시 열립니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ has been downloaded—you have %@. WallpaperMachine quits and reopens to install it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ をダウンロードしました（現在のバージョンは %@）。インストールのため WallpaperMachine を終了して再度開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 已下载，你当前使用的是 %@。WallpaperMachine 将退出并重新打开以完成安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine %@ 已下載，你目前使用的是 %@。WallpaperMachine 將結束並重新開啟以完成安裝。"}}}
    },
    "Automatically download and install updates in the future" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar e instalar atualizações automaticamente no futuro"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앞으로 업데이트를 자동으로 다운로드하고 설치"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Automatically download and install updates in the future"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "今後はアップデートを自動的にダウンロードしてインストール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以后自动下载并安装更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以後自動下載並安裝更新"}}}
    },
