    },
    "View on Steam Workshop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ver no Workshop da Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 창작마당에서 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamワークショップで表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 创意工坊中查看"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 工作坊中檢視"}}}
    },
    "Not working? Report on GitHub" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não funciona? Relatar no GitHub"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "작동하지 않나요? GitHub에 문제 보고"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "正常に動作しない場合はGitHubで報告"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法正常使用？在 GitHub 上反馈"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法正常運作？在 GitHub 上回報"}}}
    },
    "Report this problem on GitHub" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Relatar este problema no GitHub"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub에 이 문제 보고"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この問題をGitHubで報告"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 上反馈此问题"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 上回報此問題"}}}
    },
    "Loading wallpaper options…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Carregando opções do papel de parede…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 옵션 불러오는 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のオプションを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在加载壁纸选项…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入桌布選項…"}}}
    },
    "Audio response" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Resposta ao áudio"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오디오 반응"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオ反応"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频响应"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊回應"}}}
    },
    "Audio and media status" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Status de áudio e mídia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오디오 및 미디어 상태"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオとメディアの状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频与媒体状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊與媒體狀態"}}}
    },
    "Reactive wallpapers use sound playing in other apps. macOS may request system audio recording permission." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede reativos usam o som tocado em outros apps. O macOS pode pedir permissão de gravação de áudio do sistema."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오디오 반응형 배경화면은 다른 앱에서 재생 중인 소리를 사용합니다. macOS가 시스템 오디오 녹음 권한을 요청할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオに反応する壁紙は、ほかのアプリで再生中のサウンドを使用します。macOSからシステムオーディオの録音の許可を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会跟随其他应用播放的声音变化。macOS 可能会请求录制系统音频的权限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隨聲音變化的桌布會使用其他 App 正在播放的聲音。macOS 可能會要求錄製系統音訊的權限。"}}}
    },
    "Off. No audio is captured." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desativado. Nenhum áudio é capturado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "꺼져 있습니다. 오디오를 캡처하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オフ。オーディオは取り込まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已关闭，不采集音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已關閉。不會擷取任何音訊。"}}}
    },
    "On. Parts of the wallpaper made to react to sound will respond." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. As partes do papel de parede feitas para reagir ao som vão responder."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 배경화면에서 소리에 반응하도록 만들어진 부분이 반응합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙のうちサウンドに反応するよう作られた部分が反応します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启。壁纸中会响应声音的部分将随音频变化。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布中設計為隨聲音變化的部分會產生回應。"}}}
    },
    "On. The wallpaper is receiving audio." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. O papel de parede está recebendo áudio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 배경화면이 오디오를 수신하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙はオーディオを受信しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，壁纸正在接收音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布正在接收音訊。"}}}
    },
    "On, but this wallpaper doesn’t use audio." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado, mas este papel de parede não usa áudio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있지만 이 배경화면은 오디오를 사용하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オンですが、この壁紙はオーディオを使用しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，但这张壁纸没有用到音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，但此桌布未使用音訊。"}}}
    },
    "On. Apply the wallpaper to see whether it uses audio." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. Aplique o papel de parede para ver se ele usa áudio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 오디오 사용 여부를 확인하려면 배경화면을 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。オーディオを使用するかどうかは、壁紙を適用すると確認できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启。应用壁纸后才能看到它是否用到音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。套用桌布後即可得知它是否使用音訊。"}}}
    },
    "Media integration" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Integração de mídia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미디어 연동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メディア連携"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "媒体集成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "媒體整合"}}}
    },
    "Share song titles, artists and artwork from system Now Playing. Supports Spotify, Apple Music and compatible browsers and local players." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Compartilha títulos de músicas, artistas e capas do Reproduzindo Agora do sistema. Compatível com Spotify, Apple Music e navegadores e reprodutores locais compatíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템의 ‘지금 재생 중’에서 곡 제목, 아티스트 및 앨범 표지를 공유합니다. Spotify, Apple Music 및 호환되는 브라우저와 로컬 플레이어를 지원합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの「再生中」の曲名、アーティスト、アートワークを壁紙と共有します。Spotify、Apple Music、および対応するブラウザやローカルプレーヤーに対応しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "把系统“正在播放”的歌名、歌手和封面提供给壁纸。支持 Spotify、Apple Music，以及兼容的浏览器和本地播放器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將系統「正在播放」中的歌名、演出者與專輯插圖提供給桌布。支援 Spotify、Apple Music，以及相容的瀏覽器和本機播放器。"}}}
    },
    "Off. The wallpaper gets no track information." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desativado. O papel de parede não recebe informações da faixa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "꺼져 있습니다. 배경화면에 곡 정보를 전달하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オフ。壁紙はトラック情報を受け取りません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已关闭，壁纸收不到曲目信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已關閉。桌布不會取得曲目資訊。"}}}
    },
    "On. The wallpaper gets the track details macOS reports." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. O papel de parede recebe os detalhes da faixa informados pelo macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. macOS가 제공하는 곡 정보를 배경화면에 전달합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙はmacOSが報告するトラック情報を受け取ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，壁纸会收到 macOS 提供的曲目信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布會取得 macOS 提供的曲目詳細資訊。"}}}
    },
    "On, but track information is unavailable: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado, mas as informações da faixa não estão disponíveis: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있지만 곡 정보를 사용할 수 없습니다: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オンですが、トラック情報を取得できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，但无法获取曲目信息：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，但無法取得曲目資訊：%@"}}}
    },
    "the system declined to report what is playing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "o sistema se recusou a informar o que está tocando."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템이 재생 중인 정보를 제공하지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムが再生中の内容を提供しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "系统没有提供正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "系統拒絕提供正在播放的內容。"}}}
    },
    "On. Apply the wallpaper to see whether track information is available." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativado. Aplique o papel de parede para ver se as informações da faixa estão disponíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜져 있습니다. 곡 정보 사용 가능 여부를 확인하려면 배경화면을 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。トラック情報を取得できるかどうかは、壁紙を適用すると確認できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启。应用壁纸后才能看到能否获取曲目信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。套用桌布後即可得知能否取得曲目資訊。"}}}
    },
    "This wallpaper cannot be rendered on this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede não pode ser renderizado neste Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서는 이 배경화면을 렌더링할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はこのMacではレンダリングできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸无法在这台 Mac 上渲染。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布無法在這部 Mac 上渲染。"}}}
    },
    "General configuration" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Configuração geral"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일반 설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一般設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "常规配置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一般設定"}}}
    },
    "Mute this wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar este papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 음소거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙を消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将此壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將此桌布靜音"}}}
    },
    "Mute All is on, so every wallpaper is silent." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar Tudo está ativado, então todos os papéis de parede estão sem som."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모두 음소거가 켜져 있어 모든 배경화면이 무음입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「すべて消音」がオンのため、すべての壁紙が消音されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“全部静音”已开启，所有壁纸均已静音。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「全部靜音」已開啟，所有桌布均已靜音。"}}}
    },
    "Changing wallpaper…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trocando o papel de parede…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 변경 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を切り替えています…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在更换壁纸…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在更換桌布…"}}}
    },
    "Choose a wallpaper below to show it here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um papel de parede abaixo para mostrá-lo aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아래에서 배경화면을 선택하면 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "下で壁紙を選ぶと、ここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在下方选择一张壁纸，它就会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在下方選擇一張桌布，它就會顯示在這裡。"}}}
    },
    "On battery. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na bateria. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리를 사용 중입니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中です。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用电池，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用電池，桌布已暫停。"}}}
    },
    "A playback rule is in effect. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma regra de reprodução está em vigor. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 규칙이 적용 중입니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生ルールが適用されています。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放规则正在生效，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放規則正在生效，桌布已暫停。"}}}
    },
    "The wallpaper library’s drive is disconnected. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O disco da biblioteca de papéis de parede está desconectado. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함이 있는 드라이브의 연결이 해제되었습니다. 배경화면이 정지되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper library’s drive is disconnected. Wallpapers are stopped."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリのドライブの接続が解除されています。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库所在的磁盘已断开连接，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫所在的磁碟已中斷連線，桌布已停止。"}}}
    },
    "A playback rule is in effect. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma regra de reprodução está em vigor. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 규칙이 적용 중입니다. 배경화면이 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生ルールが適用されています。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放规则正在生效，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放規則正在生效，桌布已停止。"}}}
    },
    "Show other wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar outros papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 배경화면 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかの壁紙を表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示其他壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示其他桌布"}}}
    },
