    },
    "Install and Relaunch" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Instalar e Reabrir"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치 후 다시 열기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Install and Relaunch"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールして再度開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装并重新打开"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝並重新開啟"}}}
    },
    "Software Update" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualização de Software"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "소프트웨어 업데이트"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Software Update"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ソフトウェア・アップデート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "软件更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "軟體更新"}}}
    },
    "Automatically download and install updates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar e instalar atualizações automaticamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 자동 다운로드 및 설치"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Automatically download and install updates"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートを自動的にダウンロードしてインストール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动下载并安装更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動下載並安裝更新"}}}
    },
    "Updates download in the background and install while the display sleeps or the Mac is locked; WallpaperMachine quits and reopens to finish." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As atualizações são baixadas em segundo plano e instaladas enquanto o monitor está em repouso ou o Mac está bloqueado; o WallpaperMachine é encerrado e reaberto para concluir."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트는 백그라운드에서 다운로드되고 디스플레이가 잠자기 상태이거나 Mac이 잠겨 있을 때 설치됩니다. 설치를 마치기 위해 WallpaperMachine이 종료된 후 다시 열립니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Updates download in the background and install while the display sleeps or the Mac is locked; WallpaperMachine quits and reopens to finish."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートはバックグラウンドでダウンロードされ、ディスプレイがスリープ中または Mac がロック中にインストールされます。完了するため WallpaperMachine は終了して再度開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新会在后台下载，并在显示器睡眠或 Mac 锁定时安装；WallpaperMachine 会退出并重新打开以完成安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新會在背景下載，並在顯示器睡眠或 Mac 鎖定時安裝；WallpaperMachine 會結束並重新開啟以完成安裝。"}}}
    },
