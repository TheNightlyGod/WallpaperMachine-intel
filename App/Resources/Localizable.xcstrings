    },
    "Accent color" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cor de destaque"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "강조 색상"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アクセントカラー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "强调色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "強調色"}}}
    },
    "Colors buttons, links and focus rings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Colore botões, links e anéis de foco."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "버튼, 링크 및 포커스 테두리의 색상을 지정합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ボタン、リンク、フォーカスリングの色になります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "用于按钮、链接和焦点环。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用於按鈕、連結與焦點環。"}}}
    },
    "Surface tone" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tom da superfície"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경 색조"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "背景の色調"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "表面色调"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "表面色調"}}}
    },
    "Neutral" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Neutro"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중립"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ニュートラル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "中性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "中性"}}}
    },
    "Warm" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "따뜻한 색조"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "暖色"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暖色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暖色"}}}
    },
    "Cool" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Frio"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "차가운 색조"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "寒色"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "冷色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "冷色"}}}
    },
    "App icon" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ícone do app"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 아이콘"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appアイコン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用图标"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 圖像"}}}
    },
    "Minimal" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Minimalista"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미니멀"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ミニマル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "简约"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "簡約"}}}
    },
    "Day" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "昼"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日間"}}}
    },
    "Night" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Noite"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "밤"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "夜"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "夜间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "夜間"}}}
    },
    "Changes the Dock icon while the app is running. Finder and the menu bar stay unchanged." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Muda o ícone do Dock enquanto o app está aberto. O Finder e a barra de menus não mudam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱이 실행 중일 때 Dock 아이콘을 변경합니다. Finder 및 메뉴 막대는 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "App実行中のDockアイコンを変更します。Finderとメニューバーのアイコンは変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用运行时更改程序坞图标。访达和菜单栏中的图标保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 執行時會更改 Dock 圖像。Finder 與選單列中的圖像保持不變。"}}}
    },
    "Theme defaults" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Padrões do tema"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "테마 기본값"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "テーマのデフォルト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "主题默认值"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "主題預設值"}}}
    },
    "Reset appearance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Redefinir aparência"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모양 재설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外観をリセット"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重置外观"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重設外觀"}}}
    },
    "Restores System, the default accent, Neutral tone, the Day icon and Halloween week." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaura Sistema, a cor de destaque padrão, o tom Neutro, o ícone Dia e a Semana do Halloween."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘시스템’, 기본 강조 색상, ‘중립’ 색조, ‘낮’ 아이콘 및 ‘핼러윈 주간’으로 복원합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「システム」、デフォルトのアクセントカラー、「ニュートラル」の色調、「昼」アイコン、「ハロウィン週間」に戻します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复为跟随系统、默认强调色、中性色调、日间图标和万圣节周。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "恢復為「系統」、預設強調色、「中性」色調、「日間」圖像與「萬聖節週」。"}}}
    },
    "Halloween look" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Visual de Halloween"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "핼러윈 테마"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ハロウィンの装い"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "万圣节装扮"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "萬聖節裝扮"}}}
    },
    "Halloween week" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Semana do Halloween"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "핼러윈 주간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ハロウィン週間"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "万圣节周"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "萬聖節週"}}}
    },
    "Always" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sempre"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "항상"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "常に"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "始终"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "始終"}}}
    },
    "Dresses the window, its accent and the Dock icon for Halloween. Halloween week runs from October 24 to November 1." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Veste a janela, a cor de destaque e o ícone do Dock para o Halloween. A Semana do Halloween vai de 24 de outubro a 1º de novembro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창, 강조 색상 및 Dock 아이콘을 핼러윈 분위기로 꾸밉니다. 핼러윈 주간은 10월 24일부터 11월 1일까지입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ウインドウ、アクセントカラー、Dockアイコンをハロウィン仕様にします。ハロウィン週間は10月24日から11月1日までです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "为窗口、强调色和程序坞图标换上万圣节装扮。万圣节周为 10 月 24 日至 11 月 1 日。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "為視窗、強調色與 Dock 圖像換上萬聖節裝扮。萬聖節週為 10 月 24 日至 11 月 1 日。"}}}
    },
    "On until November 1. Your own accent, tone and Dock icon come back after." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativo até 1º de novembro. Sua cor de destaque, tom e ícone do Dock voltam depois."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "11월 1일까지 적용됩니다. 이후 원래의 강조 색상, 색조 및 Dock 아이콘으로 돌아갑니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "11月1日まで適用されます。その後、元のアクセントカラー、色調、Dockアイコンに戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将持续到 11 月 1 日。之后会恢复你自己的强调色、色调和程序坞图标。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將持續到 11 月 1 日。之後會恢復你自己的強調色、色調與 Dock 圖像。"}}}
    },
    "On all year. Your own accent, tone and Dock icon come back when you choose Halloween week or Off." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativo o ano todo. Sua cor de destaque, tom e ícone do Dock voltam quando você escolher Semana do Halloween ou Desativado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연중 적용됩니다. ‘핼러윈 주간’ 또는 ‘끔’을 선택하면 원래의 강조 색상, 색조 및 Dock 아이콘으로 돌아갑니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一年中適用されます。「ハロウィン週間」または「オフ」を選ぶと、元のアクセントカラー、色調、Dockアイコンに戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "全年生效。选择“万圣节周”或“关闭”后，会恢复你自己的强调色、色调和程序坞图标。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "全年生效。選擇「萬聖節週」或「關閉」後，會恢復你自己的強調色、色調與 Dock 圖像。"}}}
    },
    "Appearance changes apply right away and only affect this app’s window, not your wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As alterações de aparência são aplicadas na hora e afetam apenas a janela deste app, não seus papéis de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 모드 변경은 즉시 적용되며 이 앱의 창에만 영향을 줍니다. 배경화면에는 영향을 주지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外観の変更はすぐに適用され、このAppのウインドウにのみ影響します。壁紙には影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外观设置会立即生效，只影响本应用的窗口，不影响壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "外觀變更會立即生效，且只影響此 App 的視窗，不會影響你的桌布。"}}}
    },
    "%@ for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%2$@의 %1$@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%2$@の%1$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%2$@ 的%1$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%2$@ 的%1$@"}}}
    },
