    "An active wallpaper display is no longer connected. Refresh displays before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um monitor com papel de parede ativo não está mais conectado. Atualize os monitores antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 표시 중이던 디스플레이의 연결이 해제되었습니다. 디스플레이를 새로 고친 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "An active wallpaper display is no longer connected. Refresh displays before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を表示中のディスプレイが接続されていません。ディスプレイを更新してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一台正在播放壁纸的显示器已断开连接。请先刷新显示器再重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一台正在顯示桌布的顯示器已中斷連接。請先重新整理顯示器再重試。"}}}
    },
    "This wallpaper type cannot be presented by the native wallpaper provider." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este tipo de papel de parede não pode ser exibido pelo provedor nativo de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 유형은 시스템 배경화면 제공자로 표시할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper type cannot be presented by the native wallpaper provider."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この種類の壁紙はシステム壁紙プロバイダで表示できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生墙纸提供程序无法显示此类型的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布提供者無法顯示此類型的桌布。"}}}
    },
    "The web wallpaper entry must be a readable file inside its project." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A entrada do papel de parede web precisa ser um arquivo legível dentro do projeto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면의 진입 파일은 프로젝트 내부에 있는 읽을 수 있는 파일이어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper entry must be a readable file inside its project."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のエントリは、プロジェクト内の読み取り可能なファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸的入口必须是项目内可读取的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布的進入點必須是專案內可讀取的檔案。"}}}
    },
    "The committed wallpaper does not declare a project type." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede confirmado não declara um tipo de projeto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용된 배경화면에 프로젝트 유형이 선언되어 있지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not declare a project type."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙にプロジェクトの種類が宣言されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有声明项目类型。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布未宣告專案類型。"}}}
    },
    "The committed wallpaper does not reference project.json." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede confirmado não faz referência ao project.json."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용된 배경화면이 project.json을 참조하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not reference project.json."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙がproject.jsonを参照していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有引用 project.json。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布未參照 project.json。"}}}
    },
    "The committed wallpaper contains a non-absolute source path." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede confirmado contém um caminho de origem não absoluto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용된 배경화면에 절대 경로가 아닌 소스 경로가 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper contains a non-absolute source path."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙に、絶対パスではないソースパスが含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸包含非绝对路径的来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布包含非絕對路徑的來源。"}}}
    },
    "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não carregou o renderizador da tela bloqueada. O papel de parede original foi restaurado. Verifique se há outro app de papel de parede ou uma seleção de papel de parede conflitante em todo o sistema."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 잠금 화면 렌더러를 불러오지 않았습니다. 원래 배경화면이 복원되었습니다. 다른 배경화면 앱이나 충돌하는 시스템 전체 배경화면 선택이 있는지 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがロック画面のレンダラを読み込みませんでした。元の壁紙が復元されました。ほかの壁紙Appや、競合するシステム全体の壁紙設定がないか確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 没有加载锁定屏幕渲染器，已恢复原来的墙纸。请检查是否有其他墙纸应用，或冲突的全局墙纸设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未載入鎖定畫面渲染器，已還原原本的桌布。請檢查是否有其他桌布 App，或有衝突的全系統桌布選擇。"}}}
    },
    "The lock-screen renderer stopped repeatedly. The original wallpaper has been restored." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador da tela bloqueada parou repetidamente. O papel de parede original foi restaurado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 렌더러가 반복해서 중지되었습니다. 원래 배경화면이 복원되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The lock-screen renderer stopped repeatedly. The original wallpaper has been restored."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面のレンダラが繰り返し停止しました。元の壁紙が復元されました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕渲染器反复停止，已恢复原来的墙纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面渲染器反覆停止，已還原原本的桌布。"}}}
    },
    "Wallpaper assets changed while preparing native playback. Retry after the download or edit finishes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os recursos do papel de parede mudaram durante a preparação da reprodução nativa. Tente novamente depois que o download ou a edição terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 재생을 준비하는 동안 배경화면 리소스가 변경되었습니다. 다운로드나 편집이 완료된 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper assets changed while preparing native playback. Retry after the download or edit finishes."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムによる再生の準備中に壁紙のアセットが変更されました。ダウンロードまたは編集が完了してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备原生播放时壁纸文件发生了变化。请等下载或编辑完成后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "準備原生播放時，桌布資源發生變更。請等下載或編輯完成後再重試。"}}}
    },
    "Cannot create native wallpaper asset: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível criar o recurso nativo de papel de parede: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 배경화면 에셋을 생성할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot create native wallpaper asset: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のアセットを作成できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建原生墙纸文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法建立原生桌布資源：%@"}}}
    },
    "Native wallpaper assets cannot contain symbolic links or special files: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os recursos nativos de papel de parede não podem conter links simbólicos ou arquivos especiais: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 배경화면 에셋에는 심볼릭 링크나 특수 파일을 포함할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Native wallpaper assets cannot contain symbolic links or special files: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のアセットにシンボリックリンクや特殊ファイルを含めることはできません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生墙纸文件不能包含符号链接或特殊文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布資源不能包含符號連結或特殊檔案：%@"}}}
    },
    "Cannot enumerate wallpaper assets: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível enumerar os recursos do papel de parede: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 에셋 목록을 가져올 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot enumerate wallpaper assets: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のアセットを列挙できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取壁纸文件列表：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法列舉桌布資源：%@"}}}
    },
    "The wallpaper asset source must be a real directory: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A origem dos recursos do papel de parede precisa ser um diretório real: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 리소스 소스는 실제 디렉토리여야 합니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper asset source must be a real directory: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のアセットのソースは実際のディレクトリである必要があります：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸文件来源必须是真实的文件夹：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布資源的來源必須是實際的資料夾：%@"}}}
    },
    "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um papel de parede válido do Workshop. Papéis de parede de aplicativo executam programas do Windows e não podem ser usados no macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "유효한 창작마당 배경화면을 선택하세요. 응용 프로그램 배경화면은 Windows 프로그램을 실행하므로 macOS에서 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "有効なワークショップの壁紙を選択してください。アプリケーション壁紙はWindowsプログラムを実行するため、macOSでは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择有效的创意工坊壁纸。应用程序类壁纸需要运行 Windows 程序，无法在 macOS 上使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇有效的工作坊桌布。應用程式桌布會執行 Windows 程式，無法在 macOS 上使用。"}}}
    },
    "Downloaded, but the library could not refresh: %@. Refresh the library before applying it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixado, mas não foi possível atualizar a biblioteca: %@. Atualize a biblioteca antes de aplicá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드했지만 보관함을 새로 고치지 못했습니다: %@. 적용하기 전에 보관함을 새로 고치세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but the library could not refresh: %@. Refresh the library before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、ライブラリを更新できませんでした：%@。適用する前にライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但壁纸库未能刷新：%@。请先刷新壁纸库再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但桌布庫無法重新整理：%@。請先重新整理桌布庫再套用。"}}}
    },
    "Downloaded, but not applied because you chose another wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixado, mas não aplicado porque você escolheu outro papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드했지만 다른 배경화면을 선택하여 적용하지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but not applied because you chose another wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、ほかの壁紙を選んだため適用しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但你选择了其他壁纸，因此没有应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但你選擇了其他桌布，因此沒有套用。"}}}
    },
    "Downloaded, but not applied because the download took more than an hour." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixado, mas não aplicado porque o download levou mais de uma hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드했지만 다운로드에 1시간이 넘게 걸려 적용하지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but not applied because the download took more than an hour."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、完了まで1時間以上かかったため適用しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但下载用时超过一小时，因此没有应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但下載耗時超過一小時，因此沒有套用。"}}}
    },
    "Downloaded, but it could not be applied: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixado, mas não foi possível aplicá-lo: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드했지만 적용하지 못했습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but it could not be applied: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、適用できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但无法应用：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但無法套用：%@"}}}
    },
    "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite o nome de login da sua conta Steam (não o seu nome de exibição). É necessária uma conta que possua o Wallpaper Engine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 계정의 로그인 이름을 입력하세요(표시 이름이 아닙니다). Wallpaper Engine을 소유한 계정이 필요합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウントのログイン名（表示名ではありません）を入力してください。Wallpaper Engineを所有するアカウントが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 Steam 账户的登录名（不是昵称）。需要拥有 Wallpaper Engine 的账户。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入你的 Steam 帳號登入名稱（不是顯示名稱）。需要使用擁有 Wallpaper Engine 的帳號。"}}}
    },
    "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD excedeu o tempo limite. Se o Steam Guard não foi concluído, tente iniciar a sessão novamente e aprove a nova solicitação ou digite um código novo. Caso contrário, verifique a sua conexão e o espaço disponível em disco."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 응답 시간이 초과되었습니다. Steam Guard 인증을 완료하지 않았다면 다시 로그인하여 새 요청을 승인하거나 새 코드를 입력하세요. 그렇지 않으면 연결과 사용 가능한 디스크 공간을 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがタイムアウトしました。Steam Guardが完了していない場合は、もう一度サインインして新しいリクエストを承認するか、新しいコードを入力してください。それ以外の場合は、ネットワーク接続とディスクの空き容量を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 超时。如果 Steam 令牌验证没有完成，请重新登录并批准新的请求或输入新的验证码；否则请检查网络连接和磁盘空间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 逾時。如果尚未完成 Steam Guard 驗證，請重新登入並核准新的請求，或輸入新的驗證碼；否則請檢查網路連線和可用磁碟空間。"}}}
    },
    "Steam closed the session without confirming the sign-in. Check the account name and password, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam encerrou a sessão sem confirmar o início de sessão. Verifique o nome da conta e a senha e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 로그인을 확인하지 않고 세션을 종료했습니다. 계정 이름과 암호를 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam closed the session without confirming the sign-in. Check the account name and password, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインを確認せずにセッションを閉じました。アカウント名とパスワードを確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未确认登录就关闭了会话。请检查账户名和密码后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未確認登入就關閉了工作階段。請檢查帳號名稱和密碼後重試。"}}}
    },
    "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam foi encerrada sem confirmar uma instalação completa do Wallpaper Engine. Tente instalar os recursos de cena novamente; os recursos existentes não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 Wallpaper Engine 설치 완료를 확인하지 않고 종료되었습니다. 장면 에셋 설치를 다시 시도하세요. 기존 에셋은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWallpaper Engineのインストール完了を確認せずに終了しました。共有シーンリソースのインストールを再試行してください。既存のリソースは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认 Wallpaper Engine 已完整安装。请重新安装场景资源，现有资源没有被改动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束時未確認 Wallpaper Engine 已完整安裝。請重新安裝場景資源；現有資源未被更動。"}}}
    },
    "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam foi encerrada sem confirmar um download completo do Workshop. Tente novamente; nenhum papel de parede parcial foi adicionado à sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 창작마당 다운로드 완료를 확인하지 않고 종료되었습니다. 다시 시도하세요. 불완전한 배경화면은 보관함에 추가되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamはワークショップのダウンロード完了を確認せずに終了しました。再試行してください。不完全な壁紙はライブラリに追加されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认创意工坊下载已完成。请重试，未完成的壁纸不会加入壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束時未確認工作坊下載已完成。請重試；沒有任何不完整的桌布加入你的桌布庫。"}}}
    },
    "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD foi encerrado antes de confirmar o início de sessão. Verifique o nome da conta e a senha, aprove o Steam Guard e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인을 확인하기 전에 SteamCMD가 종료되었습니다. 계정 이름과 암호를 확인하고 Steam Guard에서 승인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがサインインを確認する前に終了しました。アカウント名とパスワードを確認し、Steam Guardで承認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在确认登录前就退出了。请检查账户名和密码，批准 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在確認登入前就已結束。請檢查帳號名稱和密碼，核准 Steam Guard 後重試。"}}}
    },
    "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD foi encerrado antes de concluir o download. Confirme que esta conta possui o Wallpaper Engine, aprove o Steam Guard e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드를 완료하기 전에 SteamCMD가 종료되었습니다. 이 계정이 Wallpaper Engine을 소유하고 있는지 확인하고 Steam Guard에서 승인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがダウンロードを完了する前に終了しました。このアカウントがWallpaper Engineを所有していることを確認し、Steam Guardで承認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在下载完成前就退出了。请确认此账户拥有 Wallpaper Engine，批准 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在完成下載前就已結束。請確認此帳號擁有 Wallpaper Engine，核准 Steam Guard 後重試。"}}}
    },
    "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler o terminal privado do SteamCMD sem bloqueio. Reinicie o WallpaperMachine e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 전용 터미널을 논블로킹 방식으로 읽지 못했습니다. WallpaperMachine을 재시작한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの専用ターミナルを非ブロッキングで読み取れませんでした。WallpaperMachineを再起動してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取 SteamCMD 的终端输出。请重新打开 WallpaperMachine 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法在不阻斷的情況下讀取 SteamCMD 的私有終端機。請重新啟動 WallpaperMachine 後重試。"}}}
    },
    "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível criar um terminal privado para o SteamCMD. Reinicie o WallpaperMachine e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 전용 터미널을 생성하지 못했습니다. WallpaperMachine을 재시작한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD用の専用ターミナルを作成できませんでした。WallpaperMachineを再起動してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法为 SteamCMD 创建终端。请重新打开 WallpaperMachine 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法為 SteamCMD 建立私有終端機。請重新啟動 WallpaperMachine 後重試。"}}}
    },
    "Cannot launch SteamCMD: %@. Reinstall SteamCMD in Settings → Library & Steam to get Valve’s Apple silicon version." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível abrir o SteamCMD: %@. Reinstale o SteamCMD em Ajustes → Biblioteca e Steam para obter a versão da Valve para Apple silicon."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD를 실행할 수 없습니다: %@. 설정 → 보관함 및 Steam에서 SteamCMD를 다시 설치하여 Valve의 Apple silicon 버전을 받으세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot launch SteamCMD: %@. Reinstall SteamCMD in Settings → Library & Steam to get Valve’s Apple silicon version."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDを起動できません：%@。設定 → ライブラリとSteamでSteamCMDを再インストールし、ValveのAppleシリコン版を入手してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法启动 SteamCMD：%@。请在设置 → 壁纸库与 Steam 中重新安装 SteamCMD，以获取 Valve 的 Apple 芯片版本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法啟動 SteamCMD：%@。請在設定 → 桌布庫與 Steam 中重新安裝 SteamCMD，以取得 Valve 的 Apple 晶片版本。"}}}
    },
    "Lost the connection to SteamCMD’s login terminal. Retry signing in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A conexão com o terminal de login do SteamCMD foi perdida. Tente iniciar a sessão novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 로그인 터미널과의 연결이 끊어졌습니다. 다시 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Lost the connection to SteamCMD’s login terminal. Retry signing in."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのログインターミナルとの接続が切れました。もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "与 SteamCMD 登录终端的连接已断开。请重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "與 SteamCMD 登入終端機的連線已中斷。請重新登入。"}}}
    },
    "SteamCMD closed its login prompt. Retry signing in to start a new session." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD fechou o prompt de login. Tente iniciar a sessão novamente para começar uma nova sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 로그인 창을 닫았습니다. 새 세션을 시작하려면 다시 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD closed its login prompt. Retry signing in to start a new session."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがログインプロンプトを閉じました。新しいセッションを開始するには、もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 关闭了登录提示。请重新登录以开始新的会话。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已關閉登入提示。請重新登入以開始新的工作階段。"}}}
    },
    "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam encerrou esta sessão porque a conta iniciou sessão em outro lugar. Tente novamente quando o outro início de sessão terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 계정이 다른 곳에서 로그인하여 Steam이 이 세션을 종료했습니다. 다른 곳의 로그인이 끝나면 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアカウントがほかの場所でサインインしたため、Steamがこのセッションを終了しました。ほかの場所でのサインインが終わってから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在其他地方登录，Steam 结束了本次会话。等另一处登录结束后再重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "由於此帳號在其他地方登入，Steam 已結束此工作階段。請在另一處登入完成後再重試。"}}}
    },
    "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam negou este download. Inicie sessão com uma conta que possua o Wallpaper Engine e tenha acesso a este item do Workshop."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 이 다운로드를 거부했습니다. Wallpaper Engine을 소유하고 이 창작마당 항목에 접근할 수 있는 계정으로 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがこのダウンロードを拒否しました。Wallpaper Engineを所有し、このワークショップアイテムにアクセスできるアカウントでサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了此次下载。请使用拥有 Wallpaper Engine 且可以访问此创意工坊项目的账户登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒絕了此次下載。請使用擁有 Wallpaper Engine 且可存取此工作坊項目的帳號登入。"}}}
    },
    "Steam could not download this wallpaper. Downloads require a Steam account that has purchased Wallpaper Engine. Buy it on Steam or sign in with an account that already owns it, then retry. If this account already owns it, the wallpaper may be private or removed; check its Workshop page." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não conseguiu baixar este papel de parede. Os downloads exigem uma conta Steam que tenha comprado o Wallpaper Engine. Compre-o na Steam ou inicie sessão com uma conta que já o possua e tente novamente. Se esta conta já o possui, o papel de parede pode ser privado ou ter sido removido; verifique a página dele no Workshop."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이 배경화면을 다운로드하지 못했습니다. 다운로드하려면 Wallpaper Engine을 구매한 Steam 계정이 필요합니다. Steam에서 구매하거나 이미 소유한 계정으로 로그인한 후 다시 시도하세요. 이 계정이 이미 소유하고 있다면 배경화면이 비공개이거나 삭제되었을 수 있습니다. 해당 창작마당 페이지를 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not download this wallpaper. Downloads require a Steam account that has purchased Wallpaper Engine. Buy it on Steam or sign in with an account that already owns it, then retry. If this account already owns it, the wallpaper may be private or removed; check its Workshop page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamはこの壁紙をダウンロードできませんでした。ダウンロードには、Wallpaper Engineを購入済みのSteamアカウントが必要です。Steamで購入するか、すでに所有しているアカウントでサインインしてから再試行してください。このアカウントで購入済みの場合は、壁紙が非公開または削除済みの可能性があります。ワークショップのページを確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法下载这张壁纸。下载需要使用已购买 Wallpaper Engine 的 Steam 账户。请在 Steam 上购买，或使用已拥有它的账户登录后重试。如果此账户已经拥有它，壁纸可能已设为私密或已被删除；请查看它的创意工坊页面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法下載這張桌布。下載需要使用已購買 Wallpaper Engine 的 Steam 帳號。請在 Steam 上購買，或使用已擁有它的帳號登入後重試。如果此帳號已經擁有它，桌布可能已設為私人或已被移除；請查看其工作坊頁面。"}}}
    },
    "Not enough free disk space: this download needs about %@ and only %@ is available on the disk that holds your library. Free up space, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Espaço livre em disco insuficiente: este download precisa de cerca de %@ e só há %@ disponível no disco que contém a sua biblioteca. Libere espaço e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스크 여유 공간이 부족합니다. 이 다운로드에는 약 %@의 공간이 필요하지만, 보관함이 있는 디스크의 여유 공간은 %@뿐입니다. 공간을 확보한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Not enough free disk space: this download needs about %@ and only %@ is available on the disk that holds your library. Free up space, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスクの空き容量が足りません：このダウンロードには約%@必要ですが、ライブラリがあるディスクの空きは%@しかありません。空き容量を増やしてから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "磁盘可用空间不足：此下载大约需要 %@，而存放壁纸库的磁盘只剩 %@ 可用。请腾出空间后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "磁碟可用空間不足：此下載大約需要 %@，而存放桌布庫的磁碟只剩 %@ 可用。請釋出空間後再試一次。"}}}
    },
    "Connection lost; retrying (%lld of %lld)…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Conexão perdida; tentando novamente (%lld de %lld)…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연결이 끊어졌습니다. 다시 시도 중 (%lld/%lld)…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Connection lost; retrying (%lld of %lld)…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続が切れました。再試行しています（%lld/%lld）…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "连接已中断，正在重试（第 %lld 次，共 %lld 次）…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "連線已中斷，正在重試（第 %lld 次，共 %lld 次）…"}}}
    },
    "The connection to Steam dropped while downloading. Check your connection and try again; what was already downloaded is kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A conexão com a Steam caiu durante o download. Verifique a sua conexão e tente novamente; o que já foi baixado é mantido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 중 Steam 연결이 끊어졌습니다. 연결을 확인하고 다시 시도하세요. 이미 다운로드한 내용은 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The connection to Steam dropped while downloading. Check your connection and try again; what was already downloaded is kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード中にSteamとの接続が切れました。ネットワーク接続を確認してから、もう一度お試しください。ダウンロード済みの分は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载过程中与 Steam 的连接中断了。请检查网络连接后重试；已下载的内容会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載過程中與 Steam 的連線中斷了。請檢查網路連線後再試一次；已下載的內容會保留。"}}}
    },
    "The connection to Steam stopped responding after the Mac woke from sleep. Check your connection and try again; what was already downloaded is kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A conexão com a Steam parou de responder depois que o Mac saiu do repouso. Verifique a sua conexão e tente novamente; o que já foi baixado é mantido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 잠자기에서 깨어난 후 Steam 연결이 응답하지 않습니다. 연결을 확인하고 다시 시도하세요. 이미 다운로드한 내용은 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The connection to Steam stopped responding after the Mac woke from sleep. Check your connection and try again; what was already downloaded is kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macがスリープから復帰した後、Steamとの接続が応答しなくなりました。ネットワーク接続を確認してから、もう一度お試しください。ダウンロード済みの分は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 从睡眠中唤醒后，与 Steam 的连接不再响应。请检查网络连接后重试；已下载的内容会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 從睡眠中喚醒後，與 Steam 的連線不再回應。請檢查網路連線後再試一次；已下載的內容會保留。"}}}
    },
    "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não conseguiu instalar os recursos compartilhados do Wallpaper Engine. Confirme que você possui o app e verifique o espaço disponível em disco; depois, tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 Wallpaper Engine의 공유 에셋을 설치하지 못했습니다. 소유 여부와 사용 가능한 디스크 공간을 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWallpaper Engineの共有リソースをインストールできませんでした。Wallpaper Engineを所有していることとディスクの空き容量を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法安装 Wallpaper Engine 的共享资源。请确认账户拥有 Wallpaper Engine 并检查磁盘空间后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法安裝 Wallpaper Engine 的共用資源。請確認你擁有 Wallpaper Engine 並檢查可用磁碟空間後重試。"}}}
    },
    "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O seu início de sessão salvo da Steam expirou ou foi revogado. Tente novamente e inicie sessão na Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 Steam 로그인 정보가 만료되었거나 취소되었습니다. 다시 시도하여 Steam에 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みのSteamのサインイン情報が期限切れか、取り消されました。もう一度試して、Steamにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的 Steam 登录已过期或被撤销。请重试并重新登录 Steam。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的 Steam 登入資訊已過期或已被撤銷。請再試一次並登入 Steam。"}}}
    },
    "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Steam Guard foi rejeitado, cancelado ou expirou. Tente novamente, digite a sua senha e aprove a nova solicitação ou use um código novo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard 인증이 거부되었거나 취소되었거나 만료되었습니다. 다시 시도하여 암호를 입력한 후 새 요청을 승인하거나 새 코드를 사용하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guardが拒否されたか、キャンセルされたか、期限切れになりました。もう一度試してパスワードを入力し、新しいリクエストを承認するか新しいコードを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 令牌验证被拒绝、已取消或已过期。请重试，输入密码后批准新的请求或使用新的验证码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard 驗證遭拒、已取消或已過期。請再試一次，輸入密碼後核准新的請求，或使用新的驗證碼。"}}}
    },
    "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não conseguiu concluir a conexão ou o início de sessão a tempo. Verifique a sua conexão e qualquer aprovação do Steam Guard e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 제한 시간 내에 연결 또는 로그인을 완료하지 못했습니다. 연결 상태와 Steam Guard 승인 여부를 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamが時間内に接続またはサインインを完了できませんでした。ネットワーク接続とSteam Guardの承認を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没能及时完成连接或登录。请检查网络连接和 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法及時完成連線或登入。請檢查網路連線及 Steam Guard 核准狀態後重試。"}}}
    },
    "Steam has temporarily limited sign-in attempts. Wait before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam limitou temporariamente as tentativas de início de sessão. Aguarde antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 로그인 시도를 일시적으로 제한했습니다. 잠시 기다린 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam has temporarily limited sign-in attempts. Wait before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインの試行を一時的に制限しています。しばらく待ってから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 暂时限制了登录尝试，请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 暫時限制了登入嘗試次數。請稍候再重試。"}}}
    },
    "SteamCMD could not complete the request. Check your connection and try again. If it keeps failing, export a diagnostics report from Settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD não conseguiu concluir a solicitação. Verifique a sua conexão e tente novamente. Se continuar falhando, exporte um relatório de diagnóstico nos Ajustes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 요청을 완료하지 못했습니다. 연결을 확인하고 다시 시도하세요. 계속 실패하면 설정에서 진단 보고서를 내보내세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD could not complete the request. Check your connection and try again. If it keeps failing, export a diagnostics report from Settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがリクエストを完了できませんでした。ネットワーク接続を確認して再試行してください。失敗が続く場合は、設定から診断レポートを書き出してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 未能完成请求。请检查网络连接后重试。如果仍然失败，请从设置中导出诊断报告。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 未能完成請求。請檢查網路連線後重試。如果仍然失敗，請從設定中匯出診斷報告。"}}}
    },
    "Steam rejected the sign-in. Check your account login name and password, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam rejeitou o início de sessão. Verifique o nome de login da conta e a senha e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 로그인을 거부했습니다. 계정 로그인 이름과 암호를 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam rejected the sign-in. Check your account login name and password, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインを拒否しました。アカウントのログイン名とパスワードを確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了登录。请检查登录名和密码后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒絕了登入。請檢查帳號登入名稱和密碼後重試。"}}}
    },
    "Steam allows one session at a time for this account; waiting to retry" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam permite uma sessão por vez para esta conta; aguardando para tentar novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam은 이 계정에 한 번에 하나의 세션만 허용합니다. 재시도 대기 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam allows one session at a time for this account; waiting to retry"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアカウントでSteamが許可するセッションは一度に1つだけです。再試行を待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在 Steam 上同时只能有一个会话，正在等待重试"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 對此帳號一次只允許一個工作階段；正在等待重試"}}}
    },
    "Waiting for a free download slot" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando um espaço livre para download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 슬롯 대기 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for a free download slot"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの空きを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待空闲的下载名额"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待可用的下載名額"}}}
    },
    "Waiting for the current sign-in to finish" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando o início de sessão atual terminar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 로그인 완료 대기 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the current sign-in to finish"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のサインインが終わるのを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待当前登录完成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待目前的登入完成"}}}
    },
    "Waiting for the previous download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando o download anterior"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이전 다운로드 대기 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the previous download"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "前のダウンロードを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待上一项下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待上一個下載項目"}}}
    },
    "Wait for active and queued downloads to finish before changing saved sign-in settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguarde os downloads ativos e na fila terminarem antes de alterar os ajustes do início de sessão salvo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 로그인 설정을 변경하기 전에 진행 중이거나 대기 중인 다운로드가 완료될 때까지 기다리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for active and queued downloads to finish before changing saved sign-in settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みのサインイン設定を変更する前に、実行中およびキュー内のダウンロードが完了するまで待ってください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请等进行中和排队的下载完成后，再更改已保存的登录设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請等候進行中及佇列中的下載完成後，再更改已儲存的登入設定。"}}}
    },
    "No system media provider is configured." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum provedor de mídia do sistema está configurado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 미디어 제공자가 구성되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No system media provider is configured."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムのメディアプロバイダが設定されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有可用的系统媒体来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未設定系統媒體提供者。"}}}
    },
    "The folder name cannot be used as a library identifier." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O nome da pasta não pode ser usado como identificador da biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 폴더 이름을 보관함 식별자로 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The folder name cannot be used as a library identifier."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ名はライブラリの識別子として使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹名称无法用作壁纸库标识符。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾名稱無法用作桌布庫識別碼。"}}}
    },
    "Choose a source outside WallpaperMachine’s managed library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma origem fora da biblioteca gerenciada do WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 관리하는 보관함 외부의 원본을 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a source outside WallpaperMachine’s managed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineが管理するライブラリの外にあるソースを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 WallpaperMachine 壁纸库以外的来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 WallpaperMachine 所管理桌布庫以外的來源。"}}}
    },
    "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível publicar o item do Workshop %@: %@. A área de preparação de downloads e a biblioteca precisam estar no mesmo volume."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창작마당 항목 %@을(를) 보관함에 추가하지 못했습니다: %@. 다운로드 임시 저장 공간과 보관함은 같은 볼륨에 있어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップアイテム%1$@をライブラリに追加できませんでした：%2$@。ダウンロードの一時領域とライブラリは同じボリューム上にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法添加创意工坊项目 %1$@：%2$@。下载的临时目录和壁纸库必须在同一个磁盘卷上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法將工作坊項目 %1$@ 加入桌布庫：%2$@。下載暫存區和桌布庫必須位於同一個卷宗。"}}}
    },
    "Download staging must be outside the managed library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A área de preparação de downloads precisa estar fora da biblioteca gerenciada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 임시 저장 영역은 관리 대상 보관함 외부에 있어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Download staging must be outside the managed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの一時領域は、管理対象のライブラリの外にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的临时目录必须位于壁纸库之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載暫存區必須位於受管理的桌布庫之外。"}}}
    },
    "Choose a valid numeric Workshop item identifier." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um identificador numérico válido de item do Workshop."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "숫자로 된 유효한 창작마당 항목 ID를 지정하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid numeric Workshop item identifier."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "数字のみの有効なワークショップアイテムIDを指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请使用有效的数字创意工坊项目 ID。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請使用有效的工作坊項目數字 ID。"}}}
    },
    "Download directories must be real folders, not symbolic links or special files: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os diretórios de download precisam ser pastas reais, não links simbólicos ou arquivos especiais: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 디렉토리는 심볼릭 링크나 특수 파일이 아닌 실제 폴더여야 합니다: %@."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Download directories must be real folders, not symbolic links or special files: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード先のディレクトリは、シンボリックリンクや特殊ファイルではなく実際のフォルダである必要があります：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载目录必须是真实的文件夹，不能是符号链接或特殊文件：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載目錄必須是實際的資料夾，不能是符號連結或特殊檔案：%@。"}}}
    },
    "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os projetos baixados só podem conter arquivos e pastas comuns, não links simbólicos ou arquivos especiais: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 프로젝트에는 일반 파일과 폴더만 포함할 수 있으며, 심볼릭 링크나 특수 파일은 포함할 수 없습니다: %@."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたプロジェクトに含められるのは通常のファイルとフォルダのみで、シンボリックリンクや特殊ファイルは含められません：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的项目只能包含普通文件和文件夹，不能包含符号链接或特殊文件：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載的專案只能包含一般檔案和資料夾，不能包含符號連結或特殊檔案：%@。"}}}
    },
    "No project.json found. Choose a wallpaper project, a folder containing projects, a Steam library or a Wallpaper Engine folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum project.json encontrado. Escolha um projeto de papel de parede, uma pasta com projetos, uma biblioteca da Steam ou uma pasta do Wallpaper Engine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "project.json을 찾지 못했습니다. 배경화면 프로젝트, 프로젝트가 있는 폴더, Steam 보관함 또는 Wallpaper Engine 폴더를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No project.json found. Choose a wallpaper project, a folder containing projects, a Steam library or a Wallpaper Engine folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonが見つかりません。壁紙プロジェクト、プロジェクトを含むフォルダ、Steamライブラリ、またはWallpaper Engineのフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "找不到 project.json。请选择壁纸项目、包含项目的文件夹、Steam 库或 Wallpaper Engine 文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "找不到 project.json。請選擇桌布專案、包含專案的資料夾、Steam 收藏庫或 Wallpaper Engine 資料夾。"}}}
    },
    "Symbolic links are not imported. Choose the original folder or file instead." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Links simbólicos não são importados. Escolha a pasta ou o arquivo original."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "심볼릭 링크는 가져오지 않습니다. 대신 원본 폴더나 파일을 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported. Choose the original folder or file instead."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シンボリックリンクは読み込まれません。代わりに元のフォルダまたはファイルを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接。请选择原始文件夹或文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不會匯入符號連結。請改為選擇原始資料夾或檔案。"}}}
    },
    "The project’s file field must be a relative filename." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O campo file do projeto precisa ser um nome de arquivo relativo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트의 file 필드는 상대 파일 이름이어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must be a relative filename."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトのfileフィールドは相対ファイル名である必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须是相对文件名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案的 file 欄位必須是相對檔名。"}}}
    },
    "The preview path must remain inside the wallpaper folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O caminho da pré-visualização precisa permanecer dentro da pasta do papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 경로는 배경화면 폴더 내부에 있어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The preview path must remain inside the wallpaper folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビューのパスは壁紙フォルダ内にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图路径必须位于壁纸文件夹内。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽圖路徑必須位於桌布資料夾內。"}}}
    },
    "Project dependency paths may not escape their folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os caminhos de dependência do projeto não podem sair da pasta dele."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트 종속 항목의 경로는 해당 폴더 밖을 가리킬 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Project dependency paths may not escape their folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの依存関係のパスは、そのフォルダの外を指すことはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目依赖路径不能指向其文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案相依項目的路徑不能超出其資料夾。"}}}
    },
    "Missing project content: %@. Copy the complete wallpaper folder, not just project.json." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Conteúdo do projeto ausente: %@. Copie a pasta completa do papel de parede, não apenas o project.json."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트 콘텐츠가 없습니다: %@. project.json뿐 아니라 배경화면 폴더 전체를 복사하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Missing project content: %@. Copy the complete wallpaper folder, not just project.json."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの内容が見つかりません：%@。project.jsonだけでなく、壁紙フォルダ全体をコピーしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少项目内容：%@。请复制完整的壁纸文件夹，而不只是 project.json。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "缺少專案內容：%@。請拷貝完整的桌布資料夾，而不只是 project.json。"}}}
    },
    "The project’s file field must point inside its own folder (no absolute paths or parent traversal)." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O campo file do projeto precisa apontar para dentro da própria pasta (sem caminhos absolutos ou navegação para a pasta pai)."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트의 file 필드는 자체 폴더 내부를 가리켜야 합니다(절대 경로나 상위 폴더로의 이동은 허용되지 않습니다)."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must point inside its own folder (no absolute paths or parent traversal)."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトのfileフィールドは自身のフォルダ内を指す必要があります（絶対パスや親ディレクトリへの移動は使用できません）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须指向自身文件夹内的文件（不能用绝对路径或上级目录）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案的 file 欄位必須指向其資料夾內的檔案（不可使用絕對路徑或上層目錄）。"}}}
    },
    "This preset names itself as the wallpaper it is based on, so it cannot be used." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição indica a si mesma como o papel de parede em que se baseia, então não pode ser usada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋은 자신을 기반 배경화면으로 지정하고 있어 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This preset names itself as the wallpaper it is based on, so it cannot be used."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットは自分自身を元の壁紙として指定しているため、使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设将自身指定为所基于的壁纸，因此无法使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集將自身指定為所依據的桌布，因此無法使用。"}}}
    },
    "This preset is based on another preset (Workshop item %@). Presets of presets are not supported." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição se baseia em outra predefinição (item do Workshop %@). Predefinições de predefinições não são compatíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋은 다른 프리셋(창작마당 항목 %@)을 기반으로 합니다. 프리셋을 기반으로 한 프리셋은 지원되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This preset is based on another preset (Workshop item %@). Presets of presets are not supported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットは別のプリセット（ワークショップアイテム %@）を元にしています。プリセットを元にしたプリセットには対応していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设基于另一个预设（创意工坊项目 %@）。不支持基于预设的预设。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集依據另一個預設集（工作坊項目 %@）。不支援依據預設集的預設集。"}}}
    },
    "This preset is based on Workshop item %@, which is not in your library. Download or import that wallpaper first, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição se baseia no item do Workshop %@, que não está na sua biblioteca. Baixe ou importe esse papel de parede primeiro e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋의 기반인 창작마당 항목 %@이(가) 보관함에 없습니다. 먼저 해당 배경화면을 다운로드하거나 가져온 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This preset is based on Workshop item %@, which is not in your library. Download or import that wallpaper first, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットはワークショップアイテム %@ を元にしていますが、ライブラリにありません。先にその壁紙をダウンロードまたは読み込んでから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设基于创意工坊项目 %@，但它不在你的资源库中。请先下载或导入该壁纸，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集依據工作坊項目 %@，但它不在你的資料庫中。請先下載或匯入該桌布，然後再試一次。"}}}
    },
    "The preset downloaded, but the wallpaper it is based on (Workshop item %@) did not, so nothing was added to your library. %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A predefinição foi baixada, mas o papel de parede em que ela se baseia (item do Workshop %@) não foi, então nada foi adicionado à sua biblioteca. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋은 다운로드했지만 기반 배경화면(창작마당 항목 %@)을 다운로드하지 못해 보관함에 아무것도 추가되지 않았습니다. %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The preset downloaded, but the wallpaper it is based on (Workshop item %@) did not, so nothing was added to your library. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットはダウンロードできましたが、元になっている壁紙（ワークショップアイテム%1$@）がダウンロードできなかったため、ライブラリには何も追加されていません。%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设已下载，但它所基于的壁纸（创意工坊项目 %1$@）没有下载成功，因此没有向壁纸库添加任何内容。%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設集已下載，但它所依據的桌布（工作坊項目 %1$@）沒有下載成功，因此沒有任何內容加入你的桌布庫。%2$@"}}}
    },
    "Downloading the wallpaper this preset is based on…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixando o papel de parede em que esta predefinição se baseia…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋의 기반이 되는 배경화면 다운로드 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloading the wallpaper this preset is based on…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットの元になる壁紙をダウンロード中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载此预设所基于的壁纸…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載此預設集所依據的桌布…"}}}
    },
    "Downloading “%@” (%@), the wallpaper this preset is based on…" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋의 기반이 되는 배경화면 “%@”(%@) 다운로드 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloading “%@” (%@), the wallpaper this preset is based on…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットの元になる壁紙「%@」（%@）をダウンロード中…"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixando “%@” (%@), o papel de parede em que esta predefinição se baseia…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载此预设所基于的壁纸“%@”（%@）…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載此預設集所依據的桌布「%@」（%@）…"}}}
    },
    "Downloading “%@”, the wallpaper this preset is based on…" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋의 기반이 되는 배경화면 “%@” 다운로드 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloading “%@”, the wallpaper this preset is based on…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットの元になる壁紙「%@」をダウンロード中…"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixando “%@”, o papel de parede em que esta predefinição se baseia…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载此预设所基于的壁纸“%@”…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載此預設集所依據的桌布「%@」…"}}}
    },
