    },
    "%@: %lld wallpapers have updates. Update them from Installed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@: %lld papéis de parede têm atualizações. Atualize-os em Instalados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@: 배경화면 %lld개에 업데이트가 있습니다. ‘설치됨’에서 업데이트하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@：%2$lld個の壁紙にアップデートがあります。「インストール済み」からアップデートしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@：有 %2$lld 张壁纸可更新。可在“已安装”中更新。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@：有 %2$lld 張桌布可更新。請在「已安裝」中更新。"}}}
    },
    "Keyboard shortcuts" : {
