    },
    "Restore is ready for the next launch. Current wallpapers and settings have not changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Restore is ready for the next launch. Current wallpapers and settings have not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回起動時の復元の準備ができました。現在の壁紙と設定は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复已准备就绪，将在下次启动时生效。当前壁纸和设置未改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原已準備就緒，將在下次啟動時生效。目前桌布和設定未變更。"}}}
    },
    "Pending restore cancelled. Current wallpapers and settings have not changed." : {
