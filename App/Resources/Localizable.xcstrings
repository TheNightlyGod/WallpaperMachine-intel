    },
    "Audio response" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオ反応"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频响应"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊回應"}}}
    },
    "Audio and media status" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオとメディアの状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频与媒体状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊與媒體狀態"}}}
    },
    "Reactive wallpapers use sound playing in other apps. macOS may request system audio recording permission." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オーディオに反応する壁紙は、ほかのアプリで再生中のサウンドを使用します。macOSからシステムオーディオの録音の許可を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会跟随其他应用播放的声音变化。macOS 可能会请求录制系统音频的权限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隨聲音變化的桌布會使用其他 App 正在播放的聲音。macOS 可能會要求錄製系統音訊的權限。"}}}
    },
    "Off. No audio is captured." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オフ。オーディオは取り込まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已关闭，不采集音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已關閉。不會擷取任何音訊。"}}}
    },
    "On. Parts of the wallpaper made to react to sound will respond." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙のうちサウンドに反応するよう作られた部分が反応します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启。壁纸中会响应声音的部分将随音频变化。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布中設計為隨聲音變化的部分會產生回應。"}}}
    },
    "On. The wallpaper is receiving audio." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙はオーディオを受信しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，壁纸正在接收音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布正在接收音訊。"}}}
    },
    "On, but this wallpaper doesn’t use audio." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オンですが、この壁紙はオーディオを使用しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，但这张壁纸没有用到音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，但此桌布未使用音訊。"}}}
    },
    "On. Apply the wallpaper to see whether it uses audio." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。オーディオを使用するかどうかは、壁紙を適用すると確認できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启。应用壁纸后才能看到它是否用到音频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。套用桌布後即可得知它是否使用音訊。"}}}
    },
    "Media integration" : {
      "extractionState" : "manual",
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "メディア連携"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "媒体集成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "媒體整合"}}}
    },
    "Share song titles, artists and artwork from system Now Playing. Supports Spotify, Apple Music and compatible browsers and local players." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの「再生中」の曲名、アーティスト、アートワークを壁紙と共有します。Spotify、Apple Music、および対応するブラウザやローカルプレーヤーに対応しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "把系统“正在播放”的歌名、歌手和封面提供给壁纸。支持 Spotify、Apple Music，以及兼容的浏览器和本地播放器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將系統「正在播放」中的歌名、演出者與專輯插圖提供給桌布。支援 Spotify、Apple Music，以及相容的瀏覽器和本機播放器。"}}}
    },
    "Off. The wallpaper gets no track information." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オフ。壁紙はトラック情報を受け取りません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已关闭，壁纸收不到曲目信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已關閉。桌布不會取得曲目資訊。"}}}
    },
    "On. The wallpaper gets the track details macOS reports." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。壁紙はmacOSが報告するトラック情報を受け取ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，壁纸会收到 macOS 提供的曲目信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟。桌布會取得 macOS 提供的曲目詳細資訊。"}}}
    },
    "On, but track information is unavailable: %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オンですが、トラック情報を取得できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，但无法获取曲目信息：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，但無法取得曲目資訊：%@"}}}
    },
    "the system declined to report what is playing." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "システムが再生中の内容を提供しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "系统没有提供正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "系統拒絕提供正在播放的內容。"}}}
    },
    "On. Apply the wallpaper to see whether track information is available." : {
