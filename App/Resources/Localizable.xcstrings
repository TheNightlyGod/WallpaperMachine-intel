    },
    "Around %@, if wallpapers are playing then." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ごろ（その時点で壁紙が再生中の場合）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "约 %@（届时壁纸需在播放）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "約 %@（若屆時桌布正在播放）。"}}}
    },
    "Starts counting once wallpapers play." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生が始まるとカウントを開始します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸开始播放后开始计时。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布開始播放後才會開始計時。"}}}
    },
    "Changes when you unlock the Mac, while wallpapers are playing." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macのロックを解除したときに切り替わります（壁紙が再生中の場合）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "解锁 Mac 时更换（届时壁纸需在播放）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "解鎖 Mac 時更換（若屆時桌布正在播放）。"}}}
    },
    "Playlist paused" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリストを一時停止中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表已暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表已暫停"}}}
    },
    "Resume playlist" : {
