    },
    "Appearance changes apply right away and only affect this app’s window, not your wallpapers." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "外観の変更はすぐに適用され、このAppのウインドウにのみ影響します。壁紙には影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外观设置会立即生效，只影响本应用的窗口，不影响壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "外觀變更會立即生效，且只影響此 App 的視窗，不會影響你的桌布。"}}}
