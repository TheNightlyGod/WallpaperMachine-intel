{
  "sourceLanguage" : "en",
  "strings" : {
    "Plays on a Mac with WallpaperMachine: %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Plays on a Mac with WallpaperMachine: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "用 WallpaperMachine 在 Mac 上播放：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "用 WallpaperMachine 在 Mac 上播放：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "WallpaperMachineでMacで再生できます：%@"}}}},
    "Wallpaper Engine wallpapers, now on macOS." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine wallpapers, now on macOS."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine 壁纸，现已来到 macOS。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine 桌布，現已登上 macOS。"}}, "ja": {"stringUnit": {"state": "translated", "value": "Wallpaper Engineの壁紙が、macOSで使えます。"}}}},
    "The data to be sent could not be written: %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The data to be sent could not be written: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法写入待发送的数据：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法寫入待傳送的資料：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "送信予定のデータを書き出せませんでした：%@"}}}},
    "Quitting…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Quitting…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在退出…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在結束…"}}, "ja": {"stringUnit": {"state": "translated", "value": "終了しています…"}}}},
    "WallpaperMachine did not quit because restoring the desktop picture took too long. The app is still running; quit again to retry." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "WallpaperMachine did not quit because restoring the desktop picture took too long. The app is still running; quit again to retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复桌面壁纸用时过长，WallpaperMachine 未能退出。应用仍在运行；请再次尝试退出。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "還原桌面桌布耗時過久，WallpaperMachine 未能結束。App 仍在執行；請再次嘗試結束。"}}, "ja": {"stringUnit": {"state": "translated", "value": "デスクトップの壁紙の復元に時間がかかりすぎたため、WallpaperMachineを終了できませんでした。Appは引き続き実行中です。もう一度終了を試してください。"}}}},
    "“%@” was not restored: WallpaperMachine quit unexpectedly twice in a row while loading it. Nothing was deleted." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "“%@” was not restored: WallpaperMachine quit unexpectedly twice in a row while loading it. Nothing was deleted."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "“%@”未恢复：加载它时 WallpaperMachine 连续两次意外退出。没有删除任何内容。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "「%@」未還原：載入它時 WallpaperMachine 連續兩次意外結束。沒有刪除任何內容。"}}, "ja": {"stringUnit": {"state": "translated", "value": "「%@」は復元されませんでした：読み込み中に WallpaperMachine が2回続けて予期せず終了しました。何も削除されていません。"}}}},
    "A wallpaper was held back after a crash" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A wallpaper was held back after a crash"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "崩溃后有一张壁纸暂未恢复"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "當機後有一張桌布暫未還原"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラッシュ後に壁紙を1つ復元せず保留しました"}}}},
    "Turn off animated lock-screen wallpaper before using Space-based wallpaper choices." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Turn off animated lock-screen wallpaper before using Space-based wallpaper choices."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先关闭动态锁屏壁纸，再使用按桌面空间选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先關閉動態鎖定畫面桌布，再使用依桌面空間選擇桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "スペースごとの壁紙を使う前に、動くロック画面の壁紙をオフにしてください。"}}}},
    "Desktop Space information is unavailable. Refresh Spaces or choose another automatic mode." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Desktop Space information is unavailable. Refresh Spaces or choose another automatic mode."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂时无法读取桌面空间信息。请刷新空间列表，或选择其他自动切换模式。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫時無法讀取桌面空間資訊。請重新整理空間列表，或選擇其他自動切換模式。"}}, "ja": {"stringUnit": {"state": "translated", "value": "デスクトップスペースの情報を取得できません。スペースを更新するか、別の自動モードを選んでください。"}}}},
    "Choose another automatic wallpaper mode for your displays before enabling animated lock-screen wallpaper." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose another automatic wallpaper mode for your displays before enabling animated lock-screen wallpaper."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先为显示器选择其他自动壁纸模式，再开启动态锁屏壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先為顯示器選擇其他自動桌布模式，再開啟動態鎖定畫面桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "動くロック画面の壁紙を有効にする前に、各ディスプレイで別の自動壁紙モードを選んでください。"}}}},
    "Display layout" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Display layout"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "多屏壁纸方案"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "多螢幕桌布方案"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙セット"}}}},
    "Apply Display Layout" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Display Layout"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用多屏壁纸方案"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用多螢幕桌布方案"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙セットを適用"}}}},
    "Restores saved wallpaper choices across independent displays. All saved displays and wallpapers must be available." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restores saved wallpaper choices across independent displays. All saved displays and wallpapers must be available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复各独立显示器上保存的壁纸搭配。方案中的所有显示器和壁纸都必须可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "還原各獨立顯示器上儲存的桌布搭配。方案中的所有顯示器和桌布都必須可用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "独立したディスプレイに保存済みの壁紙セットを復元します。保存したすべてのディスプレイと壁紙が利用可能である必要があります。"}}}},
    "This display layout is invalid or exceeds the limit of 64 layouts and 64 displays per layout." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This display layout is invalid or exceeds the limit of 64 layouts and 64 displays per layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此多屏壁纸方案无效，或超出最多 64 套方案、每套 64 台显示器的限制。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此多螢幕桌布方案無效，或超出最多 64 套方案、每套 64 台顯示器的限制。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この壁紙セットは無効か、最大64セット・1セットあたり64台の制限を超えています。"}}}},
    "This display layout no longer exists. Choose another layout." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This display layout no longer exists. Choose another layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此多屏壁纸方案已不存在。请选择其他方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此多螢幕桌布方案已不存在。請選擇其他方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この壁紙セットは削除されています。別のセットを選んでください。"}}}},
    "Apply a wallpaper to an enabled independent display before saving or copying a layout." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply a wallpaper to an enabled independent display before saving or copying a layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先在已启用的独立显示器上应用壁纸，再保存或复制方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先在已啟用的獨立顯示器上套用桌布，再儲存或複製方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "セットの保存やコピーの前に、有効な独立ディスプレイに壁紙を適用してください。"}}}},
    "Choose two different independent displays." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose two different independent displays."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择两台不同的独立显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇兩台不同的獨立顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "異なる2台の独立ディスプレイを選んでください。"}}}},
    "The display assignments changed. Review the displays and try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The display assignments changed. Review the displays and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示器的壁纸分配已改变。请检查各屏幕后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "顯示器的桌布分配已變更。請檢查各螢幕後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙割り当てが変わりました。各画面を確認して再試行してください。"}}}},
    "Apply or revert wallpaper edits before changing a display layout." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply or revert wallpaper edits before changing a display layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先应用或还原壁纸编辑，再切换多屏壁纸方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先套用或還原桌布編輯，再切換多螢幕桌布方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙の編集を適用するか元に戻してから、壁紙セットを変更してください。"}}}},
    "Enable at least one independent display before applying a wallpaper to all displays." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enable at least one independent display before applying a wallpaper to all displays."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先启用至少一台独立显示器，再将壁纸应用到所有显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先啟用至少一台獨立顯示器，再將桌布套用到所有顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのディスプレイに壁紙を適用する前に、独立ディスプレイを1台以上有効にしてください。"}}}},
    "On all displays" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "On all displays"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "所有显示器"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "所有顯示器"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのディスプレイ"}}}},
    "The display “%@” is disconnected, disabled or mirrored. Connect and enable it as an independent display." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The display “%@” is disconnected, disabled or mirrored. Connect and enable it as an independent display."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示器“%@”已断开、被禁用或正在镜像。请连接并启用为独立显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "顯示器「%@」已中斷連線、被停用或正在鏡像。請連線並啟用為獨立顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイ「%@」は未接続、無効、またはミラーリング中です。接続して独立ディスプレイとして有効にしてください。"}}}},
    "The wallpaper “%@” is unavailable. Restore it to the library before applying this layout." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The wallpaper “%@” is unavailable. Restore it to the library before applying this layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸“%@”不可用。请先将其恢复到壁纸库，再应用此方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布「%@」無法使用。請先將其還原到桌布庫，再套用此方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙「%@」を利用できません。ライブラリに戻してから、このセットを適用してください。"}}}},
    "The layout could not be applied. Previous wallpapers were restored. %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The layout could not be applied. Previous wallpapers were restored. %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "方案应用失败，已恢复原来的壁纸。%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "方案套用失敗，已還原原來的桌布。%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "セットを適用できませんでした。元の壁紙に復元しました。%@"}}}},
    "The layout could not be completed or fully restored on: %@. Review these displays before retrying. %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The layout could not be completed or fully restored on: %@. Review these displays before retrying. %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "方案未能完成应用，且以下显示器未能完全恢复：%@。请检查这些屏幕后重试。%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "方案未能完成套用，且以下顯示器未能完全還原：%@。請檢查這些螢幕後重試。%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "次のディスプレイで適用または復元を完了できませんでした：%@。再試行する前に確認してください。%@"}}}},
    "Use wallpaper" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用指定壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用指定桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙を指定"}}}},
    "Use saved playlist" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use saved playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストを使用"}}}},
    "The automatic wallpaper target display is unavailable." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The automatic wallpaper target display is unavailable."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动切换的目标显示器不可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動切換的目標顯示器無法使用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動切り替え先のディスプレイを使用できません。"}}}},
    "The wallpaper chosen by this rule is no longer available." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The wallpaper chosen by this rule is no longer available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此规则选择的壁纸已不可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此規則選擇的桌布已無法使用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このルールで選んだ壁紙は使用できなくなりました。"}}}},
    "Apply Saved Playlist" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Saved Playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストを適用"}}}},
    "Apply Playlist" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレイリストを適用"}}}},
    "Apply Wallpaper Property Preset" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Wallpaper Property Preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用壁纸属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用桌布屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プロパティプリセットを適用"}}}},
    "Apply Property Preset" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Property Preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "プロパティプリセットを適用"}}}},
    "Copies a saved playlist to a display. Playback starts when that display can play." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Copies a saved playlist to a display. Playback starts when that display can play."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将已存播放列表复制到显示器，在该显示器能够播放时开始播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將已存播放列表複製到顯示器，在該顯示器能夠播放時開始播放。"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストをディスプレイにコピーします。そのディスプレイで再生可能になると再生が始まります。"}}}},
    "Applies saved properties to their wallpaper on every display using it. Unapplied edits must be applied or reverted first." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Applies saved properties to their wallpaper on every display using it. Unapplied edits must be applied or reverted first."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将已存属性应用到所有显示器上的对应壁纸。请先应用或还原尚未应用的编辑。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將已存屬性套用到所有顯示器上的對應桌布。請先套用或還原尚未套用的編輯。"}}, "ja": {"stringUnit": {"state": "translated", "value": "同じ壁紙を使うすべてのディスプレイに保存済みのプロパティを適用します。未適用の編集は先に適用するか、元に戻してください。"}}}},
    "Saved playlist" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリスト"}}}},
    "Property preset" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Property preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "プロパティプリセット"}}}},
    "Wallpaper property preset" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Wallpaper property preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プロパティプリセット"}}}},
    "Choose a saved playlist for this Focus filter." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a saved playlist for this Focus filter."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请为此专注模式过滤条件选择已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請為此專注模式過濾條件選擇已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モードフィルタで使う保存済みプレイリストを選んでください。"}}}},
    "Choose a wallpaper for this Focus filter." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a wallpaper for this Focus filter."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请为此专注模式过滤条件选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請為此專注模式過濾條件選擇桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モードフィルタで使う壁紙を選んでください。"}}}},
    "Pause, mute or stop wallpapers, or temporarily use a wallpaper or saved playlist while this Focus is on." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pause, mute or stop wallpapers, or temporarily use a wallpaper or saved playlist while this Focus is on."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在此专注模式开启时，暂停、静音或停止壁纸，或者临时使用指定壁纸或已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在此專注模式開啟時，暫停、靜音或停止桌布，或者暫時使用指定桌布或已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モード中に壁紙を一時停止・消音・停止するか、指定した壁紙や保存済みプレイリストを一時的に使用します。"}}}},
    "Choose a valid display, time, weekday and wallpaper or saved playlist." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a valid display, time, weekday and wallpaper or saved playlist."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择有效的显示器、时间、星期和壁纸或已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇有效的顯示器、時間、星期和桌布或已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "有効なディスプレイ、時刻、曜日、壁紙または保存済みプレイリストを選んでください。"}}}},
    "Some automatic wallpaper settings could not be read. Check your rules and Focus choices before using them." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Some automatic wallpaper settings could not be read. Check your rules and Focus choices before using them."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分自动切换设置无法读取。请先检查规则和专注模式的选择。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分自動切換設定無法讀取。請先檢查規則和專注模式的選擇。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動切り替え設定の一部を読み込めませんでした。使用前にルールと集中モードの選択内容を確認してください。"}}}},
    "This preset’s wallpaper is no longer installed." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This preset’s wallpaper is no longer installed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此预设对应的壁纸已不在库中。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此預設對應的桌布已不在庫中。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このプリセットの壁紙はインストールされていません。"}}}},
    "Unmute" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unmute"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消静音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消靜音"}},"ja":{"stringUnit":{"state":"translated","value":"消音を解除"}}}},
    "Preview loading was cancelled. Try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preview loading was cancelled. Try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览加载已取消。请重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽載入已取消。請重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの読み込みがキャンセルされました。再試行してください。"}}}},
    "The preview did not become ready within 30 seconds. Try another wallpaper or reload the preview." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The preview did not become ready within 30 seconds. Try another wallpaper or reload the preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览在 30 秒内未能准备好。请尝试其他壁纸，或重新载入预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽在 30 秒內未能準備好。請嘗試其他桌布，或重新載入預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "30秒以内にプレビューを準備できませんでした。別の壁紙を選ぶか、プレビューを再読み込みしてください。"}}}},
    "Metal rendering is unavailable for this preview." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Metal rendering is unavailable for this preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此预览无法使用 Metal 渲染。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此預覽無法使用 Metal 算繪。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このプレビューではMetalレンダリングを利用できません。"}}}},
    "The preview renderer could not start." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The preview renderer could not start."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览渲染器无法启动。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽算繪器無法啟動。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューレンダラを起動できませんでした。"}}}},
    "WebKit cannot provide muted playback for this preview." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "WebKit cannot provide muted playback for this preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "WebKit 无法为此预览提供静音播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "WebKit 無法為此預覽提供靜音播放。"}}, "ja": {"stringUnit": {"state": "translated", "value": "WebKitでこのプレビューを消音再生できません。"}}}},
    "This wallpaper type cannot be previewed." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This wallpaper type cannot be previewed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此类壁纸无法预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此類桌布無法預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この種類の壁紙はプレビューできません。"}}}},
    "The preview inputs are invalid. Refresh the library and try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The preview inputs are invalid. Refresh the library and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览数据无效。请刷新壁纸库后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽資料無效。請重新整理桌布庫後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューのデータが無効です。ライブラリを更新して再試行してください。"}}}},
    "The wallpaper files changed or are missing. Refresh the library before previewing." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The wallpaper files changed or are missing. Refresh the library before previewing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸文件已变化或缺失。请刷新壁纸库后再预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布檔案已變更或遺失。請重新整理桌布庫後再預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙ファイルが変更されたか見つかりません。ライブラリを更新してからプレビューしてください。"}}}},
    "The preview entry file is missing or outside this wallpaper folder." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The preview entry file is missing or outside this wallpaper folder."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览入口文件缺失，或位于此壁纸文件夹之外。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽入口檔案遺失，或位於此桌布資料夾之外。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの開始ファイルがないか、壁紙フォルダの外にあります。"}}}},
    "Install Wallpaper Engine’s shared scene resources before previewing a scene wallpaper." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Install Wallpaper Engine’s shared scene resources before previewing a scene wallpaper."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览场景壁纸前，请先安装 Wallpaper Engine 共享场景资源。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽場景桌布前，請先安裝 Wallpaper Engine 共用場景資源。"}}, "ja": {"stringUnit": {"state": "translated", "value": "シーン壁紙をプレビューする前にWallpaper Engineの共有シーンリソースをインストールしてください。"}}}},
    "Wallpaper Preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Wallpaper Preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プレビュー"}}}},
    "Reload preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reload preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新载入预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新載入預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再読み込み"}}}},
    "Reload with the current wallpaper options." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reload with the current wallpaper options."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用当前壁纸选项重新载入。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用目前桌布選項重新載入。"}}, "ja": {"stringUnit": {"state": "translated", "value": "現在の壁紙設定で再読み込みします。"}}}},
    "Reload preview to show the picture or files you chose." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reload preview to show the picture or files you chose."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新载入预览以显示所选图片或文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新載入預覽以顯示所選圖片或檔案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択した画像やファイルを表示するには、プレビューを再読み込みしてください。"}}}},
    "Preview does not change your desktop. Audio response and media information are unavailable here." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preview does not change your desktop. Audio response and media information are unavailable here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览不会更改桌面。此处不提供音频响应和媒体信息。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽不會變更桌面。此處不提供音訊回應和媒體資訊。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューはデスクトップを変更しません。音声連動とメディア情報は利用できません。"}}}},
    "Preview — %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preview — %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览 — %@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽 — %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビュー — %@"}}}},
    "Play preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Play preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "播放预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "播放預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再生"}}}},
    "Pause preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pause preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫停預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを一時停止"}}}},
    "Turn preview sound on" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Turn preview sound on"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "开启预览声音"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟預覽聲音"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの音声をオンにする"}}}},
    "Mute preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mute preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "静音预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將預覽靜音"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを消音"}}}},
    "Loading preview…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Loading preview…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在加载预览…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在載入預覽…"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを読み込み中…"}}}},
    "Playing preview" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Playing preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在播放预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在播放預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再生中"}}}},
    "Preview paused" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preview paused"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览已暂停"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽已暫停"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューは一時停止中"}}}},
    "Enter a valid scale before previewing." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter a valid scale before previewing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先输入有效的缩放比例，再预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先輸入有效的縮放比例，再預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "有効な拡大率を入力してからプレビューしてください。"}}}},
    "Some preview options are no longer available. Refresh the library and try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Some preview options are no longer available. Refresh the library and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分预览选项已不可用。请刷新壁纸库后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分預覽選項已無法使用。請重新整理桌布庫後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "一部のプレビュー設定を利用できなくなりました。ライブラリを更新して再試行してください。"}}}},
    "Previous wallpaper" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Previous wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "上一张壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上一張桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "前の壁紙"}}}},
    "Previous Wallpaper" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Previous Wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "上一张壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上一張桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "前の壁紙"}}}},
    "Recently used" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recently used"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "最近使用"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "最近使用"}}, "ja": {"stringUnit": {"state": "translated", "value": "最近使った壁紙"}}}},
    "Random Wallpaper" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Random Wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "随机壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨機桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "ランダムな壁紙"}}}},
    "Random wallpaper" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Random wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "随机壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨機桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "ランダムな壁紙"}}}},
    "Changes a chosen display to a random wallpaper other than the one it shows, or the target display when none is chosen." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changes a chosen display to a random wallpaper other than the one it shows, or the target display when none is chosen."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将所选显示器切换到一张与当前不同的随机壁纸；未选择时使用目标显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將所選顯示器切換到一張與目前不同的隨機桌布；未選擇時使用目標顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択したディスプレイを、表示中とは別のランダムな壁紙に切り替えます。未選択の場合は対象ディスプレイを使用します。"}}}},
    "Choose from" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose from"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选取范围"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取範圍"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択元"}}}},
    "All wallpapers" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "All wallpapers"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全部壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "所有桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべての壁紙"}}}},
    "Favorites" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Favorites"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "收藏"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "最愛"}}, "ja": {"stringUnit": {"state": "translated", "value": "お気に入り"}}}},
    "There is no other wallpaper to choose from." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "There is no other wallpaper to choose from."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有其他壁纸可供选择。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有其他桌布可供選擇。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選べる別の壁紙がありません。"}}}},
    "Remove from Display" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove from Display"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "从显示器移除"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "從顯示器移除"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイから取り除く"}}}},
    "Start Again" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Start Again"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新开始"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新開始"}}, "ja": {"stringUnit": {"state": "translated", "value": "もう一度始める"}}}},
    "Open in Control Panel" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open in Control Panel"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在控制面板中打开"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在控制面板中打開"}}, "ja": {"stringUnit": {"state": "translated", "value": "コントロールパネルで開く"}}}},
    "This display has no previous wallpaper still in your library." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This display has no previous wallpaper still in your library."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器没有仍在壁纸库中的上一张壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器沒有仍在桌布庫中的上一張桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイの以前の壁紙はライブラリにありません。"}}}},
    "No wallpaper is running on this display." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No wallpaper is running on this display."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器上没有正在运行的壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器上沒有正在執行的桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイで実行中の壁紙はありません。"}}}},
    "The playlist changed. Refresh it and try reordering again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The playlist changed. Refresh it and try reordering again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "播放列表已变化。请刷新后重新排序。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "播放清單已變更。請重新整理後再排序。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレイリストが変更されました。更新してから並べ替えてください。"}}}},
    "Returns a chosen display to its previous wallpaper, or the target display when none is chosen." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Returns a chosen display to its previous wallpaper, or the target display when none is chosen."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将指定显示器切换回上一张壁纸；未指定时使用目标显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將指定顯示器切換回上一張桌布；未指定時使用目標顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選んだディスプレイを前の壁紙に戻します。未選択の場合は対象ディスプレイを使用します。"}}}},
    "macOS is still loading the wallpaper renderer from another copy of WallpaperMachine. Close other running copies, then retry in this app." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS is still loading the wallpaper renderer from another copy of WallpaperMachine. Close other running copies, then retry in this app."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍在从另一个 WallpaperMachine 副本加载壁纸渲染器。请退出其他正在运行的副本，然后在此应用中重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍在從另一個 WallpaperMachine 副本載入桌布算繪器。請結束其他正在執行的副本，然後在此 App 中重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSは別のWallpaperMachineのコピーから壁紙レンダラを読み込み続けています。ほかの実行中のコピーを終了してから、このアプリで再試行してください。"}}}},
    "macOS could not register this app’s wallpaper renderer. Close other running copies of WallpaperMachine, then retry. If this persists, reinstall the app." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS could not register this app’s wallpaper renderer. Close other running copies of WallpaperMachine, then retry. If this persists, reinstall the app."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 无法注册此应用的壁纸渲染器。请退出其他正在运行的 WallpaperMachine 副本后重试。如果问题持续，请重新安装应用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 無法註冊此 App 的桌布算繪器。請結束其他正在執行的 WallpaperMachine 副本後重試。如果問題持續，請重新安裝 App。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがこのアプリの壁紙レンダラを登録できませんでした。ほかの実行中のWallpaperMachineのコピーを終了してから、再試行してください。解決しない場合はアプリを再インストールしてください。"}}}},
    "macOS has WallpaperMachine’s lock-screen renderer switched off. Retry turns it back on." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS has WallpaperMachine’s lock-screen renderer switched off. Retry turns it back on."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 已关闭 WallpaperMachine 的锁定屏幕渲染器。点按“重试”即可重新打开。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 已關閉 WallpaperMachine 的鎖定畫面算繪器。按一下「重試」即可重新開啟。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSでWallpaperMachineのロック画面レンダラがオフになっています。「再試行」を押すとオンに戻します。"}}}},
    "macOS kept WallpaperMachine’s lock-screen renderer switched off. Turn it on in System Settings, then retry." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS kept WallpaperMachine’s lock-screen renderer switched off. Turn it on in System Settings, then retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍将 WallpaperMachine 的锁定屏幕渲染器保持关闭。请在“系统设置”中将其打开，然后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍將 WallpaperMachine 的鎖定畫面算繪器保持關閉。請在「系統設定」中將其開啟，然後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがWallpaperMachineのロック画面レンダラをオフのままにしました。「システム設定」でオンにしてから、再試行してください。"}}}},
    "Checking the system wallpaper renderer…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Checking the system wallpaper renderer…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在检查系统壁纸渲染器…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在檢查系統桌布算繪器…"}}, "ja": {"stringUnit": {"state": "translated", "value": "システムの壁紙レンダラを確認中…"}}}},
    "This display’s playlist has no other wallpaper to change to." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This display’s playlist has no other wallpaper to change to."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器的播放列表里没有可以换上的其他壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器的播放列表裡沒有可以換上的其他桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイのプレイリストには、切り替えられる別の壁紙がありません。"}}}},
    "SteamCMD stopped receiving the download. Check your connection and available disk space, then try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "SteamCMD stopped receiving the download. Check your connection and available disk space, then try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "SteamCMD 已停止接收下载内容。请检查网络连接和磁盘空间后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "SteamCMD 已停止接收下載內容。請檢查網路連線和可用磁碟空間後再試一次。"}}, "ja": {"stringUnit": {"state": "translated", "value": "SteamCMDがダウンロードの受信を停止しました。ネットワーク接続とディスクの空き容量を確認してから、もう一度お試しください。"}}}},
    "Preparing update…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preparing update…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在准备更新…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在準備更新…"}}, "ja": {"stringUnit": {"state": "translated", "value": "アップデートを準備中…"}}}},
    "Another update installation is still running." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Another update installation is still running."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "另一个更新安装仍在进行。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "另一個更新安裝仍在進行。"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のアップデートのインストールがまだ実行中です。"}}}},
    "Download paused" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Download paused"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "下载已暂停"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "下載已暫停"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを一時停止中"}}}},
    "Pause download" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pause download"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停下载"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫停下載"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを一時停止"}}}},
    "Resume download" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Resume download"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "继续下载"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "繼續下載"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを再開"}}}},
    "Pausing…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pausing…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在暂停…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在暫停…"}}, "ja": {"stringUnit": {"state": "translated", "value": "一時停止しています…"}}}},
    "Could not save the download queue: %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not save the download queue: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存下载队列：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存下載佇列：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードキューを保存できませんでした：%@"}}}},
    "Could not save partial download data: %@" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not save partial download data: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存已下载的数据：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存已下載的資料：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロード済みのデータを保存できませんでした：%@"}}}},
    "The wallpaper entry file is outside its project folder." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The wallpaper entry file is outside its project folder."}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙のエントリファイルがプロジェクトフォルダの外にあります。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸入口文件位于项目文件夹之外。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布進入點檔案位於專案資料夾之外。"}}}},
    "The saved wallpaper file list could not be read. Your files have been kept." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The saved wallpaper file list could not be read. Your files have been kept."}}, "ja": {"stringUnit": {"state": "translated", "value": "保存された壁紙ファイルの一覧を読み込めませんでした。ファイルは保持されています。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取已保存的壁纸文件清单。你的文件已保留。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取已儲存的桌布檔案清單。你的檔案已保留。"}}}},
    "Signed in; checking Wallpaper Engine ownership…" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Signed in; checking Wallpaper Engine ownership…"}}, "ja": {"stringUnit": {"state": "translated", "value": "サインイン済み。Wallpaper Engineの所有を確認中…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已登录；正在检查是否拥有 Wallpaper Engine…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已登入；正在檢查是否擁有 Wallpaper Engine…"}}}},
    "macOS is still restoring the desktop wallpaper. Please try quitting again." : {
      "localizations" : {"en": {"stringUnit": {"state": "translated", "value": "macOS is still restoring the desktop wallpaper. Please try quitting again."}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがデスクトップの壁紙を復元しています。もう一度終了を試してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍在恢复桌面壁纸。请再次尝试退出。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍在還原桌面桌布。請再次嘗試結束 App。"}}}
    },
    "The app and the lock-screen renderer use incompatible configuration versions. Quit other copies of WallpaperMachine and reopen the intended app, then retry." : {
      "localizations" : {"en":{"stringUnit":{"state":"translated","value":"The app and the lock-screen renderer use incompatible configuration versions. Quit other copies of WallpaperMachine and reopen the intended app, then retry."}},"ja":{"stringUnit":{"state":"translated","value":"アプリとロック画面レンダラの構成バージョンに互換性がありません。ほかのWallpaperMachineのコピーを終了し、使用するアプリを開き直してから、再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用与锁定屏幕渲染器使用的配置版本不兼容。请退出其他 WallpaperMachine 副本，重新打开要使用的应用，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 與鎖定畫面算繪器使用的設定版本不相容。請結束其他 WallpaperMachine 副本，重新開啟要使用的 App，然後重試。"}}}
    },
    "The lock-screen renderer could not load its configuration: %@" : {
      "localizations" : {"en":{"stringUnit":{"state":"translated","value":"The lock-screen renderer could not load its configuration: %@"}},"ja":{"stringUnit":{"state":"translated","value":"ロック画面レンダラが構成を読み込めませんでした：%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定屏幕渲染器无法加载其配置：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"鎖定畫面算繪器無法載入設定：%@"}}}
    },
    "The import file picker could not open." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The import file picker could not open."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込み用のファイル選択ウインドウを開けませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法打开导入文件选择窗口。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法開啟匯入檔案選擇視窗。"}}}
    },
    "This display uses a linked or unsupported native wallpaper configuration. Choose separate desktop and screen saver wallpapers in System Settings before enabling native wallpaper animation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This display uses a linked or unsupported native wallpaper configuration. Choose separate desktop and screen saver wallpapers in System Settings before enabling native wallpaper animation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイは、リンクされた、または対応していないシステム壁紙の構成を使用しています。システム壁紙のアニメーションをオンにする前に、「システム設定」でデスクトップとスクリーンセーバの壁紙を別々に選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器使用了关联或不受支持的原生墙纸配置。请先在“系统设置”中为桌面和屏幕保护程序分别选择墙纸，再启用原生墙纸动画。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器使用連動或不受支援的原生桌布設定。請先在「系統設定」中為桌面和螢幕保護程式分別選擇桌布，再啟用原生桌布動畫。"}}}
    },
    "The web wallpaper entry or asset is outside its published folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper entry or asset is outside its published folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のエントリまたはアセットが公開済みフォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸的入口或资源位于已发布的文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布的進入點或資源位於已發佈的資料夾之外。"}}}
    },
    "The published web wallpaper properties are invalid." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The published web wallpaper properties are invalid."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "公開済みWeb壁紙のプロパティが無効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已发布的网页壁纸属性无效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已發佈的網頁桌布屬性無效。"}}}
    },
    "This macOS version cannot host a live web screen saver." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS version cannot host a live web screen saver."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのmacOSではライブWebスクリーンセーバを実行できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 版本无法运行实时网页屏幕保护程序。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 版本無法執行即時網頁螢幕保護程式。"}}}
    },
    "The web screen saver did not produce a frame in time." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web screen saver did not produce a frame in time."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Webスクリーンセーバが時間内にフレームを生成しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页屏幕保护程序未能及时输出画面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁螢幕保護程式未能及時產生影格。"}}}
    },
    "The web screen saver frame is unavailable." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web screen saver frame is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Webスクリーンセーバのフレームを利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页屏幕保护程序的画面不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁螢幕保護程式的影格無法使用。"}}}
    },
    "The web screen saver stopped unexpectedly." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web screen saver stopped unexpectedly."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Webスクリーンセーバが予期せず停止しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页屏幕保护程序意外停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁螢幕保護程式意外停止。"}}}
    },
    "The web screen saver could not suspend or resume playback." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web screen saver could not suspend or resume playback."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Webスクリーンセーバの再生を一時停止または再開できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法暂停或恢复网页屏幕保护程序的播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法暫停或恢復網頁螢幕保護程式的播放。"}}}
    },
    "Restore recovery found old files without its journal. Keep this support folder intact; the old files have not been deleted." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Restore recovery found old files without its journal. Keep this support folder intact; the old files have not been deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元のリカバリーで、ジャーナルのない旧ファイルが見つかりました。このサポートフォルダを変更しないでください。旧ファイルは削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复修复发现旧文件但没有日志。请保持此支持文件夹完整；旧文件尚未删除。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原復原發現舊檔案但沒有日誌。請保持此支援資料夾完整；舊檔案尚未刪除。"}}}
    },
    "A previous restore failed. Preview and confirm the backup again to retry, or cancel the pending restore." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A previous restore failed. Preview and confirm the backup again to retry, or cancel the pending restore."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "以前の復元が失敗しました。バックアップを再度プレビューして確定し、再試行するか、保留中の復元を取り消してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "之前的恢复失败。请重新预览并确认备份以重试，或取消待执行恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "先前的還原失敗。請重新預覽並確認備份以重試，或取消待執行還原。"}}}
    },
    "Display" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器"}}}
    },
    "Changes a chosen display to its next wallpaper, or the target display when none is chosen." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Changes a chosen display to its next wallpaper, or the target display when none is chosen."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したディスプレイを次の壁紙に切り替えます。未選択の場合は対象ディスプレイを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将所选显示器切换到下一张壁纸；未选择时使用目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將所選顯示器切換到下一張桌布；未選擇時使用目標顯示器。"}}}
    },
    "Applies an installed wallpaper to a chosen display, to every display, or to the target display when none is chosen." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Applies an installed wallpaper to a chosen display, to every display, or to the target display when none is chosen."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの壁紙を、選択したディスプレイ、すべてのディスプレイ、または未選択の場合は対象ディスプレイに適用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将已安装的壁纸应用到所选显示器、所有显示器；未选择时使用目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將已安裝的桌布套用到所選顯示器、所有顯示器；未選擇時使用目標顯示器。"}}}
    },
    "Target display" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Target display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対象ディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "目标显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目標顯示器"}}}
    },
    "Checking this display at %u FPS, including its mirror group and global frame-rate cap." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Checking this display at %u FPS, including its mirror group and global frame-rate cap."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ミラーグループと全体のフレームレート上限を含め、このディスプレイを %u FPS で確認します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以 %u FPS 检查此显示器，包括镜像组和全局帧率上限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以 %u FPS 檢查此顯示器，包括鏡像群組和全域影格率上限。"}}}
    },
    "Choose a connected, enabled independent display. A mirror follows its source wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a connected, enabled independent display. A mirror follows its source wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続され、有効な独立ディスプレイを選択してください。ミラーは元の壁紙に従います。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择已连接并启用的独立显示器。镜像显示器跟随来源壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇已連接並啟用的獨立顯示器。鏡像顯示器跟隨來源桌布。"}}}
    },
    "Lock screen" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lock screen"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面"}}}
    },
    "Web wallpapers are not supported on the lock screen." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Web wallpapers are not supported on the lock screen."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面では Web 壁紙は使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕不支持网页壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面不支援網頁桌布。"}}}
    },
    "This wallpaper type has no supported lock-screen route." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper type has no supported lock-screen route."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙の種類には、対応するロック画面での表示方法がありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸类型没有受支持的锁定屏幕方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布類型沒有支援的鎖定畫面方式。"}}}
    },
    "Video and scene wallpapers have a lock-screen route. Publishing, resource access and extension playback still require runtime verification; scenes use Compatibility there." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Video and scene wallpapers have a lock-screen route. Publishing, resource access and extension playback still require runtime verification; scenes use Compatibility there."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "動画とシーン壁紙にはロック画面への表示経路があります。公開、リソースへのアクセス、拡張機能での再生は実行時の検証が必要です。シーンは互換モードを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频和场景壁纸支持锁定屏幕方式。发布、资源访问和扩展播放仍需运行时验证；场景在此使用兼容模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片和場景桌布支援鎖定畫面方式。發佈、資源存取和延伸功能播放仍需執行時驗證；場景在此使用相容模式。"}}}
    },
    "Installed project" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Installed project"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みプロジェクト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装项目"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝專案"}}}
    },
    "The installed wallpaper identifier is not a safe library path." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The installed wallpaper identifier is not a safe library path."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済み壁紙の識別子は安全なライブラリパスではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装壁纸的标识符不是安全的库路径。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝桌布的識別碼不是安全的資料庫路徑。"}}}
    },
    "The project resolves outside the installed library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The project resolves outside the installed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの参照先がインストール済みライブラリの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目解析到已安装库之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案解析到已安裝資料庫之外。"}}}
    },
    "The installed wallpaper folder is missing or unreadable. Refresh or reinstall this wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The installed wallpaper folder is missing or unreadable. Refresh or reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済み壁紙のフォルダが見つからないか、読み取れません。更新するか、この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装壁纸文件夹缺失或不可读。请刷新或重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝桌布資料夾遺失或無法讀取。請重新整理或重新安裝此桌布。"}}}
    },
    "project.json is missing, unreadable, too large or has no valid entry file. Reinstall this wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json is missing, unreadable, too large or has no valid entry file. Reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.json が見つからない、読み取れない、大きすぎる、または有効なエントリファイルがありません。この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 缺失、不可读、过大或没有有效入口文件。请重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 遺失、無法讀取、過大或沒有有效入口檔案。請重新安裝此桌布。"}}}
    },
    "The manifest type no longer matches the library entry. Refresh your library before checking again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The manifest type no longer matches the library entry. Refresh your library before checking again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "マニフェストの種類がライブラリ項目と一致しなくなりました。ライブラリを更新してから再確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清单类型与库条目不再匹配。请刷新壁纸库后重新检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "資訊清單類型與資料庫項目不再相符。請重新整理桌布庫後重新檢查。"}}}
    },
    "Entry resources" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Entry resources"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エントリリソース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "入口资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "入口資源"}}}
    },
    "The declared entry resolves outside this wallpaper folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry resolves outside this wallpaper folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリの参照先がこの壁紙フォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口解析到此壁纸文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口解析到此桌布資料夾之外。"}}}
    },
    "The installed manifest has a declared entry file." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The installed manifest has a declared entry file."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みマニフェストにエントリファイルが宣言されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装清单声明了入口文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝資訊清單宣告了入口檔案。"}}}
    },
    "The library reports this project type as unsupported." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The library reports this project type as unsupported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリによると、このプロジェクトの種類は未対応です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库报告此项目类型不受支持。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫回報此專案類型不受支援。"}}}
    },
    "The declared entry file is installed and readable. This does not verify every authored dependency." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry file is installed and readable. This does not verify every authored dependency."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリファイルはインストール済みで読み取れます。すべての作者定義の依存リソースが検証されたわけではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口文件已安装且可读。这不代表所有作者依赖均已验证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口檔案已安裝且可讀取。這不代表所有作者相依資源均已驗證。"}}}
    },
    "A scene package is installed. Its internal entry and dependencies need the renderer's package parser; preflight cannot certify them." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A scene package is installed. Its internal entry and dependencies need the renderer's package parser; preflight cannot certify them."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンパッケージはインストール済みです。内部エントリと依存リソースにはレンダラーのパッケージ解析が必要で、事前確認では保証できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景包已安装。其内部入口和依赖需要渲染器的包解析器；预检无法认证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景套件已安裝。其內部入口和相依資源需要算繪器的套件解析器；預先檢查無法認證。"}}}
    },
    "The declared entry file is missing or unreadable. Reinstall this wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry file is missing or unreadable. Reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリファイルが見つからないか、読み取れません。この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口文件缺失或不可读。请重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口檔案遺失或無法讀取。請重新安裝此桌布。"}}}
    },
    "Native video admission" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Native video admission"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブ動画の適合確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生视频准入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生影片准入"}}}
    },
    "AVFoundation metadata meets this target frame-rate constraint. Actual player preparation and on-screen presentation are not verified by this check." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation metadata meets this target frame-rate constraint. Actual player preparation and on-screen presentation are not verified by this check."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation のメタデータは対象のフレームレート制約を満たしています。実際のプレイヤーの準備や画面表示は、この確認では検証しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation 元数据符合目标帧率约束。此检查不验证实际播放器准备和屏幕显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation 中繼資料符合目標影格率限制。此檢查不驗證實際播放器準備和螢幕顯示。"}}}
    },
    "AVFoundation metadata meets this target frame-rate constraint. Compatibility remains selected; this check does not change your backend." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation metadata meets this target frame-rate constraint. Compatibility remains selected; this check does not change your backend."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation のメタデータは対象のフレームレート制約を満たしています。互換モードの選択は維持され、この確認でバックエンドは変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation 元数据符合目标帧率约束。仍选择兼容模式；此检查不会更改后端。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "AVFoundation 中繼資料符合目標影格率限制。仍選擇相容模式；此檢查不會變更後端。"}}}
    },
    "Native admission needs a supported installed video, a readable entry and a valid target display." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Native admission needs a supported installed video, a readable entry and a valid target display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブ適合確認には、対応するインストール済み動画、読み取れるエントリ、有効な対象ディスプレイが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生准入需要受支持的已安装视频、可读入口和有效目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生准入需要支援的已安裝影片、可讀取入口和有效目標顯示器。"}}}
    },
    "Shared scene resources" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene resources"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享场景资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用場景資源"}}}
    },
    "The required baseline shared shaders and material are installed. Authored resources are not fully validated." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The required baseline shared shaders and material are installed. Authored resources are not fully validated."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "必要な基本共有シェーダーとマテリアルはインストール済みです。作者定義のリソースは完全には検証されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所需的基础共享着色器和材质已安装。作者资源尚未全面验证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所需的基礎共用著色器和材質已安裝。作者資源尚未全面驗證。"}}}
    },
    "Baseline Wallpaper Engine shaders or materials are missing. Install or locate the complete scene assets folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Baseline Wallpaper Engine shaders or materials are missing. Install or locate the complete scene assets folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "基本の Wallpaper Engine シェーダーまたはマテリアルがありません。完全なシーンアセットフォルダをインストールするか、指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少基础 Wallpaper Engine 着色器或材质。请安装或定位完整的场景资源文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "缺少基礎 Wallpaper Engine 著色器或材質。請安裝或定位完整的場景資源資料夾。"}}}
    },
    "Scene shader and graph support" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Scene shader and graph support"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンのシェーダーとグラフの対応"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景着色器和图支持"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景著色器和圖支援"}}}
    },
    "Preflight has no parsed render-graph capability result. Shader, puppet, particle and effect support need runtime evaluation; the live backend and fallback reason are shown separately." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Preflight has no parsed render-graph capability result. Shader, puppet, particle and effect support need runtime evaluation; the live backend and fallback reason are shown separately."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "事前確認には解析済みレンダーグラフの対応結果がありません。シェーダー、パペット、パーティクル、エフェクトは実行時の評価が必要です。実際のバックエンドとフォールバック理由は別途表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预检没有已解析的渲染图能力结果。着色器、骨骼模型、粒子和特效支持需运行时评估；实际后端和回退原因另行显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預先檢查沒有已解析的算繪圖能力結果。著色器、骨骼模型、粒子和特效支援需執行時評估；實際後端和備援原因另行顯示。"}}}
    },
    "Web runtime" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Web runtime"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web 実行環境"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页运行时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁執行環境"}}}
    },
    "The entry file check does not execute scripts or verify media, local dependencies or WebGL. These need runtime evaluation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The entry file check does not execute scripts or verify media, local dependencies or WebGL. These need runtime evaluation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エントリファイルの確認では、スクリプトの実行やメディア、ローカル依存リソース、WebGL の検証は行いません。これらは実行時の評価が必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "入口文件检查不会执行脚本或验证媒体、本地依赖或 WebGL。这些需要运行时评估。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "入口檔案檢查不會執行指令碼或驗證媒體、本機相依資源或 WebGL。這些需要執行時評估。"}}}
    },
    "Wallpaper capability" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper capability"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の対応機能"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸能力"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布能力"}}}
    },
    "No supported renderer is declared for this wallpaper type." : {
