      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 구독함"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Subscribed on Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでサブスクライブ中"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inscrito na Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已在 Steam 订阅"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已在 Steam 訂閱"}}}
    },
