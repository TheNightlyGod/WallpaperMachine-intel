      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This web wallpaper’s entry page is missing. Import the complete project folder, including its HTML file, before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このWeb壁紙のエントリページが見つかりません。適用する前に、HTMLファイルを含むプロジェクトフォルダ全体を読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此网页壁纸缺少入口页面。请先导入包含 HTML 文件的完整项目文件夹，再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此網頁桌布缺少進入頁面。套用前，請先匯入包含 HTML 檔案的完整專案資料夾。"}}}
