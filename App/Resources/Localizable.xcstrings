    },
    "Your filters hide the only work on this page." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seus filtros ocultam a única obra desta página."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "필터가 이 페이지의 유일한 작품을 가리고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このページにある唯一の作品がフィルタで非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "筛选条件隐藏了本页唯一的作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "篩選條件隱藏了此頁唯一的作品。"}}}
    },
