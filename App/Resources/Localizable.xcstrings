    },
    "Not checked yet." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "まだ確認していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未檢查。"}}}
    },
    "%@: everything is up to date." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@：すべて最新です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@：全部是最新版本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@：全部都是最新版本。"}}}
    },
