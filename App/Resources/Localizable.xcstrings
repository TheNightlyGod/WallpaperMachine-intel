    },
    "Workshop creator" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Workshop creator"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップの作成者"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创意工坊作者"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "工作坊作者"}}}
    },
    "Steam could not load the Workshop. Check your connection or open Steam in your browser, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not load the Workshop. Check your connection or open Steam in your browser, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamワークショップを読み込めませんでした。ネットワーク接続を確認するか、ブラウザでSteamを開いてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法加载创意工坊。请检查网络连接，或在浏览器中打开 Steam 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法載入工作坊。請檢查網路連線，或在瀏覽器中打開 Steam，然後重試。"}}}
    },
    "Steam returned an unreadable Workshop page. Try again or browse on Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam returned an unreadable Workshop page. Try again or browse on Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから読み取れないワークショップページが返されました。もう一度試すか、Steamで閲覧してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回了无法读取的创意工坊页面。请重试或前往 Steam 浏览。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 傳回了無法讀取的工作坊頁面。請再試一次，或前往 Steam 瀏覽。"}}}
    },
    "Steam changed its public page or requires a browser sign-in. Open Workshop on Steam, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam changed its public page or requires a browser sign-in. Open Workshop on Steam, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamの公開ページが変更されたか、ブラウザでのサインインが必要です。Steamでワークショップを開いてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 的公开页面已更改，或需要在浏览器中登录。请在 Steam 上打开创意工坊后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已變更其公開頁面，或需要在瀏覽器中登入。請在 Steam 上打開工作坊，然後重試。"}}}
    },
    "This wallpaper is no longer in your library. Refresh Library and choose another wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is no longer in your library. Refresh Library and choose another wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はもうライブラリにありません。ライブラリを更新して、別の壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸已不在壁纸库中。请刷新壁纸库并选择其他壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已不在你的桌布庫中。請重新整理桌布庫並選擇其他桌布。"}}}
    },
    "This control sent an invalid value. Refresh the interface and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This control sent an invalid value. Refresh the interface and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコントロールから無効な値が送信されました。インターフェイスを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此控件发送了无效的值。请刷新界面后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此控制項傳送了無效的值。請重新整理介面後重試。"}}}
    },
    "Lock Screen integration is unavailable." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lock Screen integration is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面との連携は利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕集成不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用鎖定畫面整合。"}}}
    },
    "Turn off Animate lock screen before changing this: it sets the desktop picture itself." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Turn off Animate lock screen before changing this: it sets the desktop picture itself."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この設定を変更する前に、「ロック画面をアニメーション表示」をオフにしてください。デスクトップピクチャはその機能が自身で設定します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先关闭“锁定屏幕动态壁纸”再更改此项：桌面图片由它自行设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請先關閉「鎖定畫面動態桌布」再變更此項目：桌面圖片由它自行設定。"}}}
    },
    "Screen saver integration is unavailable." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Screen saver integration is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバとの連携は利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序集成不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用螢幕保護程式整合。"}}}
    },
    "Selected for %lld display(s) — starts when macOS is idle" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Selected for %lld display(s) — starts when macOS is idle"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld台のディスプレイで選択済み — macOSがアイドル状態になると開始"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已为 %lld 台显示器选择，macOS 闲置时开始"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已為 %lld 台顯示器選取，macOS 閒置時開始"}}}
    },
    "Waiting for an applied wallpaper on a connected display" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for an applied wallpaper on a connected display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続されたディスプレイに壁紙が適用されるのを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待已连接的显示器应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待已連接的顯示器套用桌布"}}}
    },
    "Choose a wallpaper for this display first." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a wallpaper for this display first."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まず、このディスプレイの壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先为此显示器选择壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請先為此顯示器選擇桌布。"}}}
    },
    "An import is already running." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "An import is already running."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みはすでに実行中です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已有导入正在进行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已有匯入作業正在進行。"}}}
    },
    "Wallpaper settings are unavailable. Refresh Library and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper settings are unavailable. Refresh Library and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の設定を利用できません。ライブラリを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸设置不可用。请刷新壁纸库后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用桌布設定。請重新整理桌布庫後重試。"}}}
    },
    "No configuration is available for this display. Refresh Displays and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No configuration is available for this display. Refresh Displays and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイで利用できる構成がありません。ディスプレイを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器没有可用配置。请刷新显示器后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器沒有可用的設定。請重新整理顯示器後重試。"}}}
    },
    "The display did not report this wallpaper as active. Refresh Displays and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The display did not report this wallpaper as active. Refresh Displays and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイからこの壁紙がアクティブであるという報告がありませんでした。ディスプレイを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器未报告此壁纸正在播放。请刷新显示器后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器未回報此桌布正在使用中。請重新整理顯示器後重試。"}}}
    },
    "Could not confirm the display state after applying: %@. Refresh failed: %@. Refresh all wallpaper state before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not confirm the display state after applying: %@. Refresh failed: %@. Refresh all wallpaper state before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用後にディスプレイの状態を確認できませんでした：%@。更新に失敗しました：%@。再試行する前に、すべての壁紙の状態を更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用后无法确认显示器状态：%@。刷新失败：%@。重试前，请刷新所有壁纸状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用後無法確認顯示器狀態：%@。重新整理失敗：%@。重試前，請重新整理所有桌布狀態。"}}}
    },
    "The display assignment changed, but the operation could not be fully saved: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The display assignment changed, but the operation could not be fully saved: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの割り当ては変更されましたが、操作を完全には保存できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器的壁纸分配已更改，但操作未能完整保存：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器的桌布指派已變更，但無法完整儲存此操作：%@"}}}
    },
    "Could not apply the wallpaper: %@. Could not restore the display draft: %@. Refresh all wallpaper state before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not apply the wallpaper: %@. Could not restore the display draft: %@. Refresh all wallpaper state before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用できませんでした：%@。ディスプレイの下書きを復元できませんでした：%@。再試行する前に、すべての壁紙の状態を更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法应用壁纸：%@。无法恢复显示器草稿：%@。重试前，请刷新所有壁纸状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法套用桌布：%@。無法還原顯示器的草稿：%@。重試前，請重新整理所有桌布狀態。"}}}
    },
    "The selected display is unavailable, disabled, or mirroring another display. Choose an enabled independent display in Settings." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The selected display is unavailable, disabled, or mirroring another display. Choose an enabled independent display in Settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したディスプレイは利用できないか、無効になっているか、別のディスプレイをミラーリングしています。「設定」で有効な独立したディスプレイを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所选显示器不可用、已停用或正在镜像其他显示器。请在设置中选择已启用的独立显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所選的顯示器無法使用、已停用，或正在鏡像輸出另一部顯示器。請在「設定」中選擇已啟用的獨立顯示器。"}}}
    },
    "Wait for the pending setting to finish before applying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for the pending setting to finish before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用する前に、保留中の設定が完了するまでお待ちください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用前，请等待当前设置操作完成。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用前，請等候進行中的設定操作完成。"}}}
    },
    "A pending display setting is no longer available. Revert it before applying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A pending display setting is no longer available. Revert it before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保留中のディスプレイ設定が利用できなくなりました。適用する前に元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一项待提交的显示器设置已不可用。应用前，请撤销该设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一項待套用的顯示器設定已無法使用。套用前，請先還原該設定。"}}}
    },
    "A pending property is no longer editable. Revert it before applying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A pending property is no longer editable. Revert it before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保留中のプロパティが編集できなくなりました。適用する前に元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一项待提交的属性已无法编辑。应用前，请撤销该属性。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一項待套用的屬性已無法編輯。套用前，請先還原該屬性。"}}}
    },
    "This video cannot be decoded. Import a complete, playable video file before applying it." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This video cannot be decoded. Import a complete, playable video file before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオはデコードできません。適用する前に、再生可能な完全なビデオファイルを読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法解码此视频。请先导入完整且可播放的视频文件，再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法解碼此影片。套用前，請先匯入完整且可播放的影片檔案。"}}}
    },
    "Applying was interrupted by another playback or display change. Your pending edits have been kept. Refresh and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Applying was interrupted by another playback or display change. Your pending edits have been kept. Refresh and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別の再生またはディスプレイの変更により適用が中断されました。保留中の編集内容は保持されています。更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用操作被其他播放或显示器更改中断。待提交的修改已保留。请刷新后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用作業被其他播放或顯示器變更中斷。你尚未套用的編輯已保留。請重新整理後重試。"}}}
    },
    "Choose a local macOS SteamCMD installation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a local macOS SteamCMD installation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacにあるmacOS版SteamCMDを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择本地的 macOS SteamCMD 安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇本機的 macOS SteamCMD 安裝。"}}}
    },
    "SteamCMD was not found at %@. Locate an existing installation or install SteamCMD." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD was not found at %@. Locate an existing installation or install SteamCMD."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にSteamCMDが見つかりませんでした。既存のインストール先を指定するか、SteamCMDをインストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 未找到 SteamCMD。请选择已有安装或安装 SteamCMD。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 找不到 SteamCMD。請指定現有的安裝位置，或安裝 SteamCMD。"}}}
    },
    "Choose steamcmd, steamcmd.sh, or its flat/MacOS installation folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose steamcmd, steamcmd.sh, or its flat/MacOS installation folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "steamcmd、steamcmd.sh、またはそれらを含むインストールフォルダ（フラット構成またはMacOSフォルダ）を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 steamcmd、steamcmd.sh，或直接包含它们的安装目录（平铺目录或 MacOS 文件夹）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 steamcmd、steamcmd.sh，或直接包含它們的安裝資料夾（扁平結構或 MacOS 資料夾）。"}}}
    },
    "The private SteamCMD staging path is not safe: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The private SteamCMD staging path is not safe: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "専用のSteamCMDステージングパスが安全ではありません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 私有暂存路径不安全：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 的私人暫存路徑不安全：%@"}}}
    },
    "The Homebrew SteamCMD wrapper has an unrecognized format. Locate the complete MacOS runtime directly." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The Homebrew SteamCMD wrapper has an unrecognized format. Locate the complete MacOS runtime directly."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "HomebrewのSteamCMDラッパーの形式を認識できません。完全なMacOSランタイムの場所を直接指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法识别 Homebrew SteamCMD 包装脚本的格式。请直接选择完整的 MacOS 运行时。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法辨識 Homebrew SteamCMD 包裝程式的格式。請直接指定完整的 MacOS 執行環境。"}}}
    },
    "SteamCMD runtime directories cannot be symbolic links: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD runtime directories cannot be symbolic links: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのランタイムディレクトリにシンボリックリンクは使用できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 运行时目录不能是符号链接：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 執行環境目錄不能是符號連結：%@"}}}
    },
    "Unexpected SteamCMD runtime layout." : {
