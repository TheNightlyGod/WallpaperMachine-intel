    },
    "Signed in as %@ · log out once downloads finish" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada como %@ · saia quando os downloads terminarem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 계정으로 로그인됨 · 다운로드 완료 후 로그아웃 가능"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@としてサインイン中 · ダウンロードの完了後にログアウトできます"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已以 %@ 登录 · 下载完成后即可退出登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已使用 %@ 登入 · 下載完成後即可登出"}}}
    },
    "Clear unused caches" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar caches não usados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용하지 않는 캐시 지우기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "未使用のキャッシュを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除未使用的缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除未使用的快取"}}}
    },
    "%lld update" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld atualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld件のアップデート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個更新"}}}
    },
    "%lld updates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld atualizações"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld件のアップデート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個更新"}}}
    },
    "You can open this guide again from Settings → General." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você pode abrir este guia novamente em Ajustes → Geral."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 → 일반에서 이 가이드를 다시 열 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このガイドは「設定」→「一般」からもう一度開くことができます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "之后可以在“设置 → 通用”中再次打开本指南。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你可以從「設定 → 一般」再次開啟本指南。"}}}
    },
    "%lld imported · %lld skipped · Cancelled" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld importados · %lld ignorados · Cancelado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld개 가져옴 · %lld개 건너뜀 · 취소됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld件読み込み済み · %2$lld件スキップ · キャンセル済み"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已导入 %1$lld 项 · 已跳过 %2$lld 项 · 已取消"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已匯入 %1$lld 項 · 已略過 %2$lld 項 · 已取消"}}}
    },
    "converted once per frame, direct sampling still being prepared" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "convertido uma vez por quadro, amostragem direta ainda em preparação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프레임당 한 번 변환됨, 직접 샘플링은 준비 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームごとに1回変換、直接サンプリングは準備中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每帧转换一次，直接采样仍在准备中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個影格轉換一次，直接取樣仍在準備中"}}}
    },
    "10-bit, converted once per frame (HDR tone mapped to SDR)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "10 bits, convertido uma vez por quadro (HDR mapeado em tons para SDR)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "10비트, 프레임당 한 번 변환(HDR은 SDR로 톤 매핑)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "10ビット、フレームごとに1回変換（HDRはSDRにトーンマッピング）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "10 位，每帧转换一次（HDR 色调映射为 SDR）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "10 位元，每個影格轉換一次（HDR 色調映射為 SDR）"}}}
    },
    "%@ (from configuration)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ (da configuração)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ (구성 파일 값)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@（設定ファイルの値）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@（来自配置）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@（來自設定檔）"}}}
    },
    "All types" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os tipos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 유형"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての種類"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有类型"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有類型"}}}
    },
    "Ascending" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Crescente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "오름차순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "昇順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "升序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遞增"}}}
    },
    "Descending" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Decrescente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "내림차순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "降順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遞減"}}}
    },
    "Sign-in window" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Janela de início de sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 창"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインウインドウ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录窗口"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入視窗"}}}
    },
    "Enter a number greater than 0." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite um número maior que 0."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "0보다 큰 숫자를 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "0より大きい数値を入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入大于 0 的数字。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入大於 0 的數字。"}}}
    },
    "Enter a whole number from 1 to %lld." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Digite um número inteiro de 1 a %lld."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "1~%lld 사이의 정수를 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1〜%lldの整数を入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 1 到 %lld 之间的整数。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入 1 到 %lld 之間的整數。"}}}
    },
    "SteamCMD is Valve’s free download tool. Install it into this app’s own folder or locate a copy you already have; the sign-in follows on its own." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD é a ferramenta de download gratuita da Valve. Instale-o na pasta própria deste app ou localize uma cópia que você já tenha; o início de sessão vem em seguida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD는 Valve의 무료 다운로드 도구입니다. 이 앱 전용 폴더에 설치하거나 이미 설치된 위치를 지정하세요. 완료되면 자동으로 로그인이 진행됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveの無料ダウンロードツールです。このアプリ専用のフォルダにインストールするか、既存のコピーを指定してください。完了すると自動的にサインインに進みます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免费下载工具。可以安装到应用自己的文件夹，也可以选择已有副本，完成后会自动继续登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的免費下載工具。你可以安裝到此 App 自己的資料夾，或指定現有副本；完成後會自動接著登入。"}}}
    },
    "A quality preset sets the frame-rate limit and render scale together. The frame-rate limit caps scenes and web wallpapers on every display without rewriting the frame rate saved for each wallpaper; a video plays at its own frame rate. Internal render scale sets how many pixels are rendered before the image is scaled to fit." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma predefinição de qualidade define o limite da taxa de quadros e a escala de renderização juntos. O limite da taxa de quadros restringe cenas e papéis de parede web em todos os monitores sem reescrever a taxa de quadros salva para cada papel de parede; um vídeo é reproduzido na própria taxa de quadros. A escala de renderização interna define quantos pixels são renderizados antes de a imagem ser redimensionada para caber."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질 프리셋은 프레임률 제한과 렌더링 배율을 함께 설정합니다. 프레임률 제한은 배경화면별로 저장된 프레임률을 변경하지 않고 모든 디스플레이의 장면과 웹 배경화면에 상한을 적용하며, 동영상은 자체 프레임률로 재생됩니다. 내부 렌더링 배율은 이미지를 화면 크기에 맞게 조정하기 전에 렌더링할 픽셀 수를 정합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質プリセットは、フレームレートの上限とレンダリングスケールをまとめて設定します。フレームレートの上限はすべてのディスプレイのシーンとWeb壁紙に適用され、壁紙ごとに保存されたフレームレートは書き換えられません。ビデオは動画自体のフレームレートで再生されます。内部レンダリングスケールは、画像を画面に合わせて拡大縮小する前に描画するピクセル数を設定します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质预设会同时设置帧率上限和渲染比例。帧率上限限制每台显示器上的场景和网页壁纸，但不会改写各壁纸已保存的帧率；视频按自身帧率播放。内部渲染比例决定放大到屏幕之前要渲染多少像素。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質預設集會同時設定影格率上限與渲染比例。影格率上限會限制每台顯示器上的場景與網頁桌布，但不會改寫各桌布已儲存的影格率；影片會以自身的影格率播放。內部渲染比例決定影像縮放至適當大小前要渲染多少像素。"}}}
    },
    "At the top of the slider there is no limit, and each display runs at its own frame rate: up to 60 fps unless you chose more for it. A lower value caps scenes and web wallpapers on every display, while a video plays at its own frame rate; saved per-display frame rates are not rewritten." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "No topo do controle deslizante não há limite, e cada monitor roda na própria taxa de quadros: até 60 fps, a menos que você tenha escolhido mais para ele. Um valor menor restringe cenas e papéis de parede web em todos os monitores, enquanto um vídeo é reproduzido na própria taxa de quadros; as taxas de quadros salvas por monitor não são reescritas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "슬라이더 맨 위에서는 제한이 없으며, 각 디스플레이가 자체 프레임률로 동작합니다. 해당 디스플레이에 더 높은 값을 선택하지 않은 경우 최대 60fps입니다. 값을 낮추면 모든 디스플레이의 장면과 웹 배경화면에 상한이 적용되며, 동영상은 자체 프레임률로 재생됩니다. 디스플레이별로 저장된 프레임률은 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スライダの一番上では制限がなく、各ディスプレイがそれぞれのフレームレートで動作します（個別により高い値を選択していない限り最大60 fps）。低い値にすると、すべてのディスプレイのシーンとWeb壁紙に上限が適用されます。ビデオは動画自体のフレームレートで再生されます。ディスプレイごとに保存されたフレームレートは書き換えられません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "滑块最顶端表示不限制，每台显示器按各自的帧率运行：除非你为它选了更高的帧率，否则最高 60 fps。更低的值会限制每台显示器上的场景和网页壁纸，而视频按自身帧率播放；不会改写各显示器已保存的帧率。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "滑桿拉到最頂端時沒有限制，每台顯示器會以各自的影格率執行：除非你為它選擇了更高的值，否則最高為 60 fps。較低的值會限制每台顯示器上的場景與網頁桌布，而影片會以自身的影格率播放；不會改寫各顯示器已儲存的影格率。"}}}
    },
    "AV1 video needs hardware decoding, which this Mac doesn’t have. Convert it to MP4 or MOV with H.264 or HEVC, then import it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vídeo AV1 precisa de decodificação por hardware, que este Mac não tem. Converta-o para MP4 ou MOV com H.264 ou HEVC e importe-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "AV1 동영상에는 하드웨어 디코딩이 필요하지만 이 Mac에는 없습니다. H.264 또는 HEVC를 사용하는 MP4 또는 MOV로 변환한 후 다시 가져오세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AV1ビデオにはハードウェアデコードが必要ですが、このMacには搭載されていません。H.264またはHEVCのMP4またはMOVに変換してから、もう一度読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "AV1 视频需要硬件解码，而这台 Mac 不支持。请先将其转换为 H.264 或 HEVC 编码的 MP4 或 MOV，再重新导入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "AV1 影片需要硬體解碼，但這台 Mac 不支援。請先轉換為 H.264 或 HEVC 編碼的 MP4 或 MOV，再重新匯入。"}}}
    },
    "This HEVC video is tagged hev1, which macOS plays only from a corrected copy. The copy is being made, and the video plays when it’s ready." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo HEVC está marcado como hev1, que o macOS só reproduz a partir de uma cópia corrigida. A cópia está sendo criada, e o vídeo será reproduzido quando ela estiver pronta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 HEVC 동영상은 hev1로 태그되어 있어 macOS에서는 수정된 사본으로만 재생할 수 있습니다. 사본을 만드는 중이며, 준비되면 동영상이 재생됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このHEVCビデオはhev1としてタグ付けされており、macOSでは修正したコピーからしか再生できません。コピーを作成中です。準備ができるとビデオが再生されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 视频标记为 hev1，macOS 只能通过修正后的副本播放。正在创建副本，完成后即会播放该视频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 影片標記為 hev1，macOS 只能透過修正後的副本播放。正在建立副本，完成後即會播放此影片。"}}}
    },
    "This HEVC video is tagged hev1, which macOS plays only from a corrected copy. The video isn’t on this Mac’s startup disk, so the copy has to be a full one, and there isn’t room for it now: other videos’ copies are in use, or the startup disk is nearly full. Move the library to this Mac, or convert the video to H.264 or to HEVC tagged hvc1 and import it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo HEVC está marcado como hev1, que o macOS só reproduz a partir de uma cópia corrigida. O vídeo não está no disco de inicialização deste Mac, então a cópia precisa ser completa, e não há espaço para ela agora: as cópias de outros vídeos estão em uso ou o disco de inicialização está quase cheio. Mova a biblioteca para este Mac ou converta o vídeo para H.264 ou para HEVC marcado como hvc1 e importe-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 HEVC 동영상은 hev1로 태그되어 있어 macOS에서는 수정된 사본으로만 재생할 수 있습니다. 이 동영상은 이 Mac의 시동 디스크에 있지 않아 전체 사본을 만들어야 하지만, 지금은 공간이 없습니다. 다른 동영상의 사본이 사용 중이거나 시동 디스크가 거의 가득 찼습니다. 보관함을 이 Mac으로 옮기거나, 동영상을 H.264 또는 hvc1로 태그된 HEVC로 변환한 후 다시 가져오세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このHEVCビデオはhev1としてタグ付けされており、macOSでは修正したコピーからしか再生できません。このビデオはこのMacの起動ディスク上にないため、コピーは完全なものにする必要がありますが、現在はその空き容量がありません。ほかのビデオのコピーが使用中か、起動ディスクの空き容量が残りわずかです。ライブラリをこのMacに移動するか、ビデオをH.264またはhvc1タグ付きのHEVCに変換してから、もう一度読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 视频标记为 hev1，macOS 只能通过修正后的副本播放。该视频不在这台 Mac 的启动磁盘上，因此副本必须是完整副本，而现在没有足够的空间：其他视频的副本正在使用中，或启动磁盘快满了。请将壁纸库移到这台 Mac 上，或将视频转换为 H.264 或标记为 hvc1 的 HEVC，再重新导入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 影片標記為 hev1，macOS 只能透過修正後的副本播放。此影片不在這台 Mac 的啟動磁碟上，因此副本必須是完整副本，而現在沒有足夠的空間：其他影片的副本正在使用中，或啟動磁碟快滿了。請將桌布庫移到這台 Mac 上，或將影片轉換為 H.264 或標記為 hvc1 的 HEVC，再重新匯入。"}}}
    },
    "This HEVC video is tagged hev1, which macOS plays only from a corrected copy. The video isn’t on this Mac’s startup disk, so the copy would have to be a full one, and the video is too large for that. Move the library to this Mac, or convert the video to H.264 or to HEVC tagged hvc1 and import it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo HEVC está marcado como hev1, que o macOS só reproduz a partir de uma cópia corrigida. O vídeo não está no disco de inicialização deste Mac, então a cópia teria de ser completa, e o vídeo é grande demais para isso. Mova a biblioteca para este Mac ou converta o vídeo para H.264 ou para HEVC marcado como hvc1 e importe-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 HEVC 동영상은 hev1로 태그되어 있어 macOS에서는 수정된 사본으로만 재생할 수 있습니다. 이 동영상은 이 Mac의 시동 디스크에 있지 않아 전체 사본을 만들어야 하지만, 동영상이 너무 커서 복사할 수 없습니다. 보관함을 이 Mac으로 옮기거나, 동영상을 H.264 또는 hvc1로 태그된 HEVC로 변환한 후 다시 가져오세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このHEVCビデオはhev1としてタグ付けされており、macOSでは修正したコピーからしか再生できません。このビデオはこのMacの起動ディスク上にないため、コピーは完全なものにする必要がありますが、ビデオが大きすぎてコピーできません。ライブラリをこのMacに移動するか、ビデオをH.264またはhvc1タグ付きのHEVCに変換してから、もう一度読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 视频标记为 hev1，macOS 只能通过修正后的副本播放。该视频不在这台 Mac 的启动磁盘上，因此副本必须是完整副本，而该视频太大，无法完整复制。请将壁纸库移到这台 Mac 上，或将视频转换为 H.264 或标记为 hvc1 的 HEVC，再重新导入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 HEVC 影片標記為 hev1，macOS 只能透過修正後的副本播放。此影片不在這台 Mac 的啟動磁碟上，因此副本必須是完整副本，而此影片太大，無法完整複製。請將桌布庫移到這台 Mac 上，或將影片轉換為 H.264 或標記為 hvc1 的 HEVC，再重新匯入。"}}}
    },
    "This video’s format isn’t supported (%@), or the file is damaged. Convert it to MP4 or MOV with H.264 or HEVC, or import a complete copy, then apply it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O formato deste vídeo não é compatível (%@) ou o arquivo está danificado. Converta-o para MP4 ou MOV com H.264 ou HEVC, ou importe uma cópia completa, e aplique-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 동영상의 형식(%@)이 지원되지 않거나 파일이 손상되었습니다. H.264 또는 HEVC를 사용하는 MP4 또는 MOV로 변환하거나 완전한 사본을 가져온 후 다시 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオの形式（%@）には対応していないか、ファイルが破損しています。H.264またはHEVCのMP4またはMOVに変換するか、完全なコピーを読み込んでから、もう一度適用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持此视频的格式（%@），或文件已损坏。请将其转换为 H.264 或 HEVC 编码的 MP4 或 MOV，或导入完整的副本，然后重新应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援此影片的格式（%@），或檔案已損毀。請轉換為 H.264 或 HEVC 編碼的 MP4 或 MOV，或匯入完整的副本，然後重新套用。"}}}
    },
    "Diagnostics & experimental options" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Diagnóstico e opções experimentais"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진단 및 실험적 옵션"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "診断と実験的な設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "诊断与实验性选项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "診斷與實驗性選項"}}}
    },
    "A scene it can't draw is not drawn at all: it keeps its last picture, or its preview when it has drawn nothing yet, and the reason appears under “Drawn by”." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma cena que ele não consegue desenhar não é desenhada: ela mantém a última imagem, ou a pré-visualização quando ainda não desenhou nada, e o motivo aparece em “Desenhado por”."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "그릴 수 없는 장면은 전혀 그려지지 않습니다. 마지막 화면(아직 아무것도 그리지 않았다면 미리보기)이 유지되며, 그 이유는 ‘렌더링 방식’ 아래에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalで描画できないシーンはまったく描画されません。最後の画像（まだ何も描画していない場合はプレビュー）が保持され、理由は「描画バックエンド」の下に表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 无法绘制的场景完全不会绘制：它会保留最后的画面（尚未绘制任何内容时则显示预览），原因会显示在“绘制方”下方。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 無法繪製的場景完全不會繪製：它會保留最後的畫面（尚未繪製任何內容時則顯示預覽），原因會顯示在「繪製者」下方。"}}}
    },
    "Native Metal is the only scene renderer. It draws a scene only if it supports everything in it: image layers, sprite-sheet animation, 2D puppets with their own skinning shader, 2D sprite, sprite-trail, rope and rope-trail particles, 3D models, perspective cameras, scene lights, standard effect chains and post-processing, effects that read the previous frame, layer links, and BGRA, 8-bit NV12 or 10-bit video textures (HDR video is tone mapped to SDR). This applies to the lock screen and screen saver too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Metal nativo é o único renderizador de cenas. Ele só desenha uma cena se for compatível com tudo nela: camadas de imagem, animação de sprite sheet, marionetes 2D com shader de skinning próprio, partículas 2D de sprite, rastro de sprite, corda e rastro de corda, modelos 3D, câmeras em perspectiva, luzes de cena, cadeias de efeitos padrão e pós-processamento, efeitos que leem o quadro anterior, vínculos de camadas e texturas de vídeo BGRA, NV12 de 8 bits ou de 10 bits (vídeo HDR é mapeado em tons para SDR). Isso também vale para a tela bloqueada e o protetor de tela."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal은 유일한 장면 렌더러입니다. 장면에 포함된 모든 요소를 지원하는 경우에만 해당 장면을 그립니다. 지원 요소: 이미지 레이어, 스프라이트 시트 애니메이션, 자체 스키닝 셰이더를 사용하는 2D 퍼펫, 2D 스프라이트·스프라이트 트레일·로프·로프 트레일 파티클, 3D 모델, 원근 카메라, 장면 조명, 표준 효과 체인 및 후처리, 이전 프레임을 읽는 효과, 레이어 링크, BGRA·8비트 NV12·10비트 동영상 텍스처(HDR 동영상은 SDR로 톤 매핑됩니다). 이는 잠금 화면과 화면 보호기에도 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンのレンダラはネイティブMetalのみです。ネイティブMetalは、シーン内のすべての要素に対応している場合にのみそのシーンを描画します。対応している要素：画像レイヤー、スプライトシートアニメーション、独自のスキニングシェーダを持つ2Dパペット、2Dのスプライト／スプライトトレイル／ロープ／ロープトレイルパーティクル、3Dモデル、透視投影カメラ、シーンのライト、標準的なエフェクトチェーンとポストプロセス、前のフレームを読み取るエフェクト、レイヤーリンク、BGRA、8ビットNV12、または10ビットのビデオテクスチャ（HDRビデオはSDRにトーンマッピングされます）。これはロック画面とスクリーンセーバーにも適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 是唯一的场景渲染器。只有场景里的内容全部受支持时，它才会绘制该场景。支持的内容包括：图像图层、精灵表动画、使用自身蒙皮着色器的二维木偶、二维的精灵、精灵拖尾、绳索和绳索拖尾粒子、3D 模型、透视摄像机、场景光源、常规效果链和后期处理、读取上一帧的效果、图层链接，以及 BGRA、8 位 NV12 或 10 位视频纹理（HDR 视频会被色调映射为 SDR）。此设置同样适用于锁定屏幕和屏幕保护程序。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 是唯一的場景算繪器。只有在它支援場景中的所有內容時，才會繪製該場景。支援的內容包括：影像圖層、精靈圖集動畫、使用自身蒙皮著色器的 2D 人偶、2D 精靈圖、精靈圖拖尾、繩索與繩索拖尾粒子、3D 模型、透視攝影機、場景光源、標準效果鏈與後製處理、讀取上一影格的效果、圖層連結，以及 BGRA、8 位元 NV12 或 10 位元影片紋理（HDR 影片會被色調映射為 SDR）。此設定同樣適用於鎖定畫面和螢幕保護程式。"}}}
    },
    "Skips rendering work that wouldn’t change the picture, such as parts of a scene that stay the same. Resolution, frame rate and animation speed are unaffected. Turn it off to compare." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ignora trabalho de renderização que não mudaria a imagem, como partes de uma cena que permanecem iguais. Resolução, taxa de quadros e velocidade de animação não são afetadas. Desative para comparar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면에서 변하지 않는 부분처럼 화면을 바꾸지 않는 렌더링 작업을 생략합니다. 해상도, 프레임률, 애니메이션 속도에는 영향이 없습니다. 비교하려면 끄세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン内の変化しない部分など、画像に影響しないレンダリング処理を省略します。解像度、フレームレート、アニメーションの速度は変わりません。オフにすると比較できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过不影响画面的渲染工作，比如场景中没有变化的部分。分辨率、帧率和动画速度都不受影响。可以关掉对比效果。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過不會改變畫面的渲染工作，例如場景中保持不變的部分。解析度、影格率與動畫速度皆不受影響。可關閉此功能來比較差異。"}}}
    },
    "Video, scene and web wallpapers have a lock-screen route. Publishing, resource access and extension playback still require runtime verification." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede de vídeo, de cena e web têm um caminho para a tela bloqueada. Publicação, acesso a recursos e reprodução na extensão ainda exigem verificação em tempo de execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상, 장면 및 웹 배경화면에는 잠금 화면 경로가 있습니다. 게시, 리소스 접근, 확장 프로그램 재생은 아직 실행 시 검증이 필요합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "動画、シーン、Web壁紙にはロック画面への表示経路があります。公開、リソースへのアクセス、拡張機能での再生は実行時の検証が必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频、场景和网页壁纸支持锁定屏幕方式。发布、资源访问和扩展播放仍需运行时验证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片、場景和網頁桌布支援鎖定畫面方式。發佈、資源存取和延伸功能播放仍需執行時驗證。"}}}
    },
    "Preflight has no parsed render-graph capability result. Shader, puppet, particle and effect support need runtime evaluation; the live backend, and the reason a scene it cannot draw is held, are shown separately." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pré-verificação não tem resultado de capacidade do grafo de renderização analisado. O suporte a shaders, marionetes, partículas e efeitos requer avaliação em tempo de execução; o back-end ativo e o motivo pelo qual uma cena que ele não consegue desenhar fica retida são mostrados separadamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사전 점검에는 분석된 렌더 그래프 지원 결과가 없습니다. 셰이더, 퍼펫, 파티클, 효과 지원 여부는 실행 시 평가가 필요하며, 실제 백엔드와 그릴 수 없는 장면이 유지되는 이유는 따로 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "事前確認には解析済みレンダーグラフの対応結果がありません。シェーダー、パペット、パーティクル、エフェクトは実行時の評価が必要です。実際のバックエンドと、描画できないシーンが保持されている理由は別途表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预检没有已解析的渲染图能力结果。着色器、骨骼模型、粒子和特效支持需运行时评估；实际后端，以及无法绘制的场景被保留的原因，会另行显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預先檢查沒有已解析的算繪圖能力結果。著色器、骨骼模型、粒子和特效支援需執行時評估；實際後端，以及無法繪製的場景被保留的原因，會另行顯示。"}}}
    },
    "Coordinates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Coordenadas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "좌표"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Coordinates"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "座標"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "经纬度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "經緯度"}}}
    },
    "Fixed times" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Horários fixos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지정 시각"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Fixed times"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "固定時刻"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "固定时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "固定時間"}}}
    },
    "Automatic" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Automático"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자동"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Automatic"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动定位"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動定位"}}}
    },
    "Use current location" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar localização atual"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 위치 사용"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Use current location"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在地を使う"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用当前位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用目前位置"}}}
    },
    "Location access has not been granted yet. Allow it in System Settings → Privacy & Security → Location Services." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O acesso à localização ainda não foi concedido. Permita-o em Ajustes do Sistema → Privacidade e Segurança → Serviços de Localização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 위치 접근이 허용되지 않았습니다. 시스템 설정 → 개인정보 보호 및 보안 → 위치 서비스에서 허용하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Location access has not been granted yet. Allow it in System Settings → Privacy & Security → Location Services."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "位置情報へのアクセスがまだ許可されていません。システム設定 → プライバシーとセキュリティ → 位置情報サービスで許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未获得定位权限。请在「系统设置 → 隐私与安全性 → 定位服务」中允许。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未取得定位權限。請在「系統設定 → 隱私權與安全性 → 定位服務」中允許。"}}}
    },
    "Using the current location: %.4f, %.4f" : {
