    },
    "suspended by the app" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Appによって中断中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已由应用挂起"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已由 App 暫停執行"}}}
    },
    "stopped after a rendering failure" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダリングの失敗により停止中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染失败后已停止"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "渲染失敗後已停止"}}}
    },
    "not applicable to this wallpaper" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙には適用されません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不适用于此壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不適用於此桌布"}}}
    },
    "running — state could not be read" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中 — 状態を読み取れません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "运行中 — 无法读取状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "執行中 — 無法讀取狀態"}}}
    },
    "Scene renderer" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダラ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染器"}}}
    },
    "Native Metal draws a scene only if it supports everything in it: image layers, sprite-sheet animation, 2D puppets with their own skinning shader, 2D sprite, sprite-trail, rope and rope-trail particles, 3D models, perspective cameras, scene lights, standard effect chains and post-processing, effects that read the previous frame, layer links, and BGRA or 8-bit NV12 video textures. Scenes with anything else, such as lit particles or HDR video, use Compatibility. This applies to desktop wallpapers only; the lock screen always uses Compatibility." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalは、シーン内のすべての要素に対応している場合にのみそのシーンを描画します。対応している要素：画像レイヤー、スプライトシートアニメーション、独自のスキニングシェーダを持つ2Dパペット、2Dのスプライト／スプライトトレイル／ロープ／ロープトレイルパーティクル、3Dモデル、透視投影カメラ、シーンのライト、標準的なエフェクトチェーンとポストプロセス、前のフレームを読み取るエフェクト、レイヤーリンク、BGRAまたは8ビットNV12のビデオテクスチャ。ライティングされたパーティクルやHDRビデオなど、それ以外の要素を含むシーンには互換モードが使用されます。これはデスクトップ壁紙にのみ適用されます。ロック画面では常に互換モードが使用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只有场景里的内容全部受支持时，原生 Metal 才会绘制它。支持的内容包括：图像图层、精灵表动画、使用自身蒙皮着色器的二维木偶、二维的精灵、精灵拖尾、绳索和绳索拖尾粒子、3D 模型、透视摄像机、场景光源、常规效果链和后期处理、读取上一帧的效果、图层链接，以及 BGRA 或 8 位 NV12 视频纹理。含有其他内容（如受光照的粒子、HDR 视频）的场景会使用兼容模式。此设置只影响桌面壁纸，锁定屏幕始终使用兼容模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只有在原生 Metal 支援場景中的所有內容時，才會由它繪製該場景。支援的內容包括：影像圖層、精靈圖集動畫、使用自身蒙皮著色器的 2D 人偶、2D 精靈圖、精靈圖拖尾、繩索與繩索拖尾粒子、3D 模型、透視攝影機、場景光源、標準效果鏈與後製處理、讀取上一影格的效果、圖層連結，以及 BGRA 或 8 位元 NV12 影片紋理。含有其他內容（例如受光照的粒子或 HDR 影片）的場景會使用相容模式。此設定只適用於桌面桌布；鎖定畫面一律使用相容模式。"}}}
    },
    "Drawn by" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "描画バックエンド"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "绘制方"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繪製者"}}}
    },
    "preparing — no backend chosen yet" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "準備中 — バックエンドはまだ選択されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备中 — 尚未选择后端"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "準備中 — 尚未選擇後端"}}}
    },
    "(fell back: %@)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "（フォールバック済み：%@）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "（已回退：%@）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "（已改用備援：%@）"}}}
    },
    "— video: %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "— ビデオ：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "— 视频：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "— 影片：%@"}}}
    },
    "sampled directly, no conversion" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "直接サンプリング、変換なし"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接采样，无需转换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接取樣，無需轉換"}}}
    },
    "planes sampled directly, no conversion" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "プレーンを直接サンプリング、変換なし"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接采样平面，无需转换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接取樣平面，無需轉換"}}}
    },
    "converted once per frame" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームごとに1回変換"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每帧转换一次"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個影格轉換一次"}}}
    },
    "planes sampled directly, plus one shared conversion" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "プレーンを直接サンプリング、加えて共有変換を1回"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接采样平面，另有一次共享转换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接取樣平面，另加一次共用轉換"}}}
    },
    "Advanced" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "詳細"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "高级"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "進階"}}}
    },
    "Renderers & experimental options" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラーと実験的な設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染器与实验性选项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繪製器與實驗性選項"}}}
    },
    "Live diagnostics" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の動作状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实时诊断"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "即時診斷"}}}
    },
    "Content pacing" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "コンテンツペーシング"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "内容节拍"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "內容步調"}}}
    },
    "Experimental. Presents frames at the content’s own frame rate instead of the display’s refresh rate." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的機能です。ディスプレイのリフレッシュレートではなく、コンテンツ自体のフレームレートでフレームを表示します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性功能。按内容自身的帧率呈现画面，而不是跟随显示器刷新率。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性功能。以內容本身的影格率呈現畫面，而非顯示器的更新頻率。"}}}
    },
    "Shared video decode" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオデコードの共有"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享视频解码"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用影片解碼"}}}
    },
    "Experimental. Screens showing the same video share one decoder." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的機能です。同じビデオを表示している画面で1つのデコーダを共有します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性功能。显示同一视频的多个画面共用一个解码器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性功能。顯示相同影片的螢幕會共用一個解碼器。"}}}
    },
    "Direct video plane sampling" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオプレーンの直接サンプリング"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "直接采样视频平面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "直接取樣影片平面"}}}
    },
    "Experimental. In scenes drawn by Native Metal, lets a layer’s shader read video frames directly instead of converting them to a color image every frame. Only works with 8-bit NV12 video and shaders that support it; everything else converts as before. Live diagnostics under Scene wallpapers shows which path each scene uses." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的機能です。ネイティブMetalで描画されるシーンで、フレームごとにカラー画像へ変換する代わりに、レイヤーのシェーダがビデオフレームを直接読み取れるようにします。8ビットNV12ビデオと、これに対応したシェーダでのみ機能します。それ以外は従来どおり変換されます。「シーン壁紙」の「現在の動作状況」に、各シーンで使用されている方式が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性功能。在由原生 Metal 绘制的场景中，让图层着色器直接读取视频帧，省去每帧一次的颜色转换。仅适用于 8 位 NV12 视频和支持的着色器，其他情况照常转换。“场景壁纸”下的“实时诊断”会显示每个场景实际采用的方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性功能。在由原生 Metal 繪製的場景中，讓圖層的著色器直接讀取影片影格，而不必每個影格都轉換成彩色影像。僅適用於 8 位元 NV12 影片及支援此功能的著色器；其他情況照舊轉換。「場景桌布」下的「即時診斷」會顯示每個場景使用的方式。"}}}
    },
    "Shared decode in use" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "デコード共有の使用状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享解码使用情况"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用解碼使用情況"}}}
    },
    "%@ serving %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@で%2$@に供給中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，供 %2$@使用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，供 %2$@使用"}}}
    },
    "%lld session" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個のセッション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个会话"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個工作階段"}}}
    },
    "%lld sessions" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個のセッション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个会话"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個工作階段"}}}
    },
    "%lld surface" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個のサーフェス"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个表面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個表面"}}}
    },
    "%lld surfaces" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個のサーフェス"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个表面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個表面"}}}
    },
    "What these settings change" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "これらの設定で変わること"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这些设置会改变什么"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這些設定會改變什麼"}}}
    },
    "Content pacing, shared video decode and direct video plane sampling are experimental. Shared decode merges only the decoding; each screen still draws its own frames. Direct plane sampling skips a color conversion when a layer’s shader can handle it; otherwise the picture is produced as before." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "コンテンツペーシング、ビデオデコードの共有、ビデオプレーンの直接サンプリングは実験的機能です。デコードの共有で統合されるのはデコード処理のみで、各画面はそれぞれ独自にフレームを描画します。プレーンの直接サンプリングでは、レイヤーのシェーダが対応している場合にカラー変換を省略します。それ以外の場合は、従来どおりに画像が生成されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "内容节拍、共享视频解码和直接采样视频平面都是实验性功能。共享解码只合并解码，每个画面仍各自绘制。直接采样在图层着色器能处理时省去一次颜色转换，否则画面与之前完全一样。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "內容步調、共用影片解碼與直接取樣影片平面都是實驗性功能。共用解碼只會合併解碼工作，每個螢幕仍會各自繪製影格。當圖層的著色器能夠處理時，直接取樣平面會省略一次色彩轉換；否則畫面會照舊產生。"}}}
    },
    "System (Auto)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "システム（自動）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跟随系统（自动）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "系統（自動）"}}}
    },
