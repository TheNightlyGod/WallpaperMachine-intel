    },
    "Friday" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "金曜日"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "星期五"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "星期五"}}}
    },
    "Saturday" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "土曜日"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "星期六"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "星期六"}}}
    },
    "Choose a wallpaper or saved playlist" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙または保存済みプレイリストを選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸或已存播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布或已存播放列表"}}}
    },
    "%lld min before" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分前"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "提前 %lld 分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "提前 %lld 分鐘"}}}
    },
    "%lld min after" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分後"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "延后 %lld 分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "延後 %lld 分鐘"}}}
    },
    "Time" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "時間"}}}
    },
    "Offset in minutes" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "前後の時間（分）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "偏移分钟数"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "偏移分鐘數"}}}
    },
    "When" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "切り替えるタイミング"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "触发时机"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "觸發時機"}}}
    },
    "Repeat on" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "繰り返す曜日"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重复日期"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重複日期"}}}
    },
    "Weekdays" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "平日"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "工作日"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "平日"}}}
    },
    "Weekends" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "週末"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "周末"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "週末"}}}
    },
    "Switch to" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "切り替え先"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "切换为"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "切換為"}}}
    },
    "Negative offsets run before the sun event; positive offsets run after it. Set your location below." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "負の値は日の出・日の入りの前、正の値は後を指定します。下で位置を設定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "负数表示提前，正数表示延后。请在下方设置位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "負數表示提前，正數表示延後。請在下方設定位置。"}}}
    },
    "Save rule" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ルールを保存"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存規則"}}}
    },
    "Automatic changes" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動切換"}}}
    },
    "Automatic changes for %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的自動切換"}}}
    },
    "Manual choices stay until the next rule changes them." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "手動で選んだ内容は、次のルールが実行されるまで維持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "手动选择会保留到下一条规则触发。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "手動選擇會保留到下一條規則觸發。"}}}
    },
    "In light appearance" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ライトモード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "浅色外观时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "淺色外觀時"}}}
    },
    "In dark appearance" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダークモード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "深色外观时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "深色外觀時"}}}
    },
    "No time rules yet. Add one to choose when this display changes." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻のルールはまだありません。追加して、このディスプレイを切り替える時刻を設定できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有时间规则。添加规则，设置此显示器的切换时间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還沒有時間規則。新增規則，設定此顯示器的切換時間。"}}}
    },
    "Add time rule" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻ルールを追加"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "添加时间规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "新增時間規則"}}}
    },
    "If times coincide, the later rule in this list wins. Missed changes wait until this display can play." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻が重なる場合は、リストの後のルールが優先されます。実行できなかった切り替えは、このディスプレイが再生可能になるまで待機します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "时间相同时，列表中靠后的规则优先。错过的切换会等到此显示器恢复播放时执行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "時間相同時，列表中較後的規則優先。錯過的切換會等到此顯示器恢復播放時執行。"}}}
    },
    "Next: %@ at %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "次回：%2$@に%1$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下次：%2$@ 切换为 %1$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下次：%2$@ 切換為 %1$@"}}}
    },
    "A Focus filter is active for this display. Manual choices remain available." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイでは集中モードフィルタが有効です。手動での選択も可能です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器正在使用专注模式过滤条件。你仍可手动选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器正在使用專注模式過濾條件。你仍可手動選擇。"}}}
    },
    "Retry automatic change" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替えを再試行"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重试自动切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重試自動切換"}}}
    },
    "Automatic wallpaper selection" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の自動選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动选择壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動選擇桌布"}}}
    },
    "Choosing a wallpaper stops this display’s playlist. Choosing a saved playlist starts that plan. Focus choices temporarily override these rules." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を選ぶと、このディスプレイのプレイリストが停止します。保存済みプレイリストを選ぶと、その設定が有効になります。集中モードの選択は一時的にこれらのルールより優先されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸会停止此显示器的播放列表；选择已存播放列表会启用该方案。专注模式的选择会暂时优先于这些规则。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布會停止此顯示器的播放列表；選擇已存播放列表會啟用該方案。專注模式的選擇會暫時優先於這些規則。"}}}
    },
    "Sunrise and sunset" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "日の出と日の入り"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日出与日落"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日出與日落"}}}
    },
    "Enter your coordinates. North and east are positive; south and west are negative. Times use your Mac’s time zone and are calculated locally." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "緯度と経度を入力してください。北緯と東経は正、南緯と西経は負の値です。Macの時間帯を使ってローカルで計算します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入经纬度。北纬和东经为正数，南纬和西经为负数。时间按 Mac 的时区在本机计算。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入經緯度。北緯和東經為正數，南緯和西經為負數。時間依 Mac 的時區在本機計算。"}}}
    },
    "Latitude" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "緯度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "纬度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "緯度"}}}
    },
    "Longitude" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "経度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "经度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "經度"}}}
    },
    "Save location" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "位置を保存"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存位置"}}}
    },
    "Clear location" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "位置を消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除位置"}}}
    },
    "Solar times are approximate. Near the poles, a day may have no sunrise or sunset." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "日の出・日の入りの時刻は概算です。極地付近では、日の出や日の入りがない日もあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日出日落时间为估算值。极地附近可能出现全天无日出或日落的情况。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日出日落時間為估算值。極地附近可能出現全天無日出或日落的情況。"}}}
    },
    "Choose at least one weekday." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "曜日を少なくとも1つ選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请至少选择一周中的一天。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請至少選擇一週中的一天。"}}}
    },
    "The Shortcuts app can control playback, mute or unmute wallpapers, go to the previous or next wallpaper, apply a wallpaper, saved playlist or property preset, and open this window. Siri and Spotlight can run these actions too." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ショートカットで再生の操作、壁紙の消音と消音解除、前後の壁紙への切り替え、壁紙・保存済みプレイリスト・プロパティプリセットの適用、このウインドウの表示ができます。SiriとSpotlightからも実行できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“快捷指令”可以控制播放、让壁纸静音或取消静音、切换上一张或下一张壁纸、应用壁纸、已存播放列表或属性预设，以及打开此窗口。Siri 和聚焦也能运行这些操作。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「捷徑」可以控制播放、讓桌布靜音或取消靜音、切換上一張或下一張桌布、套用桌布、已存播放列表或屬性預設，以及開啟此視窗。Siri 和 Spotlight 也能執行這些操作。"}}}
    },
    "Links can run the same actions. Wallpaper and playlist actions accept display= for a specific screen; otherwise they use the target display. An apply link also accepts display=all, and Apply Wallpaper has an On all displays option, to use every display at once. Property presets affect their wallpaper on every display. Choose saved items by name in Shortcuts." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "リンクからも同じ操作を実行できます。壁紙とプレイリストはdisplay=で画面を指定でき、省略すると対象ディスプレイを使います。適用リンクはdisplay=allにも対応し、「壁紙を適用」には「すべてのディスプレイ」オプションがあり、どちらもすべてのディスプレイをまとめて使います。プロパティプリセットは、同じ壁紙を使うすべてのディスプレイに適用されます。保存した項目はショートカットで名前から選べます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "链接可执行相同操作。壁纸和播放列表操作可用 display= 指定屏幕，省略时使用目标显示器。应用链接还支持 display=all，“应用壁纸”也有“所有显示器”选项，二者都会一次性使用所有显示器。属性预设会影响所有显示器上的对应壁纸。在“快捷指令”中可按名称选择已存项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "連結可執行相同操作。桌布和播放列表操作可用 display= 指定螢幕，省略時使用目標顯示器。套用連結還支援 display=all，「套用桌布」也有「所有顯示器」選項，兩者都會一次使用所有顯示器。屬性預設會影響所有顯示器上的對應桌布。在「捷徑」中可依名稱選擇已存項目。"}}}
    },
    "In System Settings → Focus, add the WallpaperMachine filter to pause, mute, stop or temporarily switch wallpapers. No Focus filter is in effect now." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "システム設定 → 集中モードでWallpaperMachineフィルタを追加すると、一時停止・消音・停止・壁紙の一時切り替えができます。現在有効なフィルタはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“系统设置 → 专注模式”中添加 WallpaperMachine 过滤条件，即可暂停、静音、停止或临时切换壁纸。目前没有生效的专注模式过滤条件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「系統設定 → 專注模式」中新增 WallpaperMachine 過濾條件，即可暫停、靜音、停止或暫時切換桌布。目前沒有生效的專注模式過濾條件。"}}}
    },
    "%@ moved to position %lld of %lld." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@を%3$lld件中%2$lld番目に移動しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已将 %1$@ 移至第 %2$lld 项，共 %3$lld 项。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已將 %1$@ 移至第 %2$lld 項，共 %3$lld 項。"}}}
    },
    "The age rating filters hide every collection found for this page." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "年齢区分のフィルタによって、このページで見つかったコレクションがすべて非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "年龄分级筛选隐藏了为本页找到的所有合集。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "年齡分級篩選隱藏了為本頁找到的所有合集。"}}}
    },
    "Open on Steam" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamで開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上打开"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上開啟"}}}
    },
    "The age rating and type filters hide every wallpaper on this page." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "年齢区分と種類のフィルタによって、このページの壁紙がすべて非表示になっています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "年龄分级和类型筛选隐藏了本页的所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "年齡分級和類型篩選隱藏了本頁的所有桌布。"}}}
    },
    "pixiv downloads run two at a time; paused downloads stay in the queue." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロードは同時に2件まで実行され、一時停止した項目はキューに残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 下载每次同时运行两个；已暂停的下载会保留在队列中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 下載每次同時執行兩個；已暫停的下載會保留在佇列中。"}}}
    },
    "On. Waiting for an audio frame." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。音声フレームを待っています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，正在等待音频数据。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，正在等待音訊資料。"}}}
    },
    "On. Connecting to audio…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "オン。音声に接続中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已开启，正在连接音频…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已開啟，正在連接音訊…"}}}
    },
    "Audio could not be connected. Turn Audio response off and on to retry." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "音声に接続できませんでした。「音声に反応」をオフにしてからオンにすると再試行できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音频连接失败。关闭再开启“音频响应”以重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音訊連接失敗。關閉再開啟「音訊回應」以重試。"}}}
    },
    "Wallpaper could not load" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を読み込めませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸无法加载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布無法載入"}}}
    },
    "Wallpaper content is ready" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のコンテンツが準備できました"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸内容已就绪"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布內容已就緒"}}}
    },
    "Loading wallpaper content…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のコンテンツを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在加载壁纸内容…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入桌布內容…"}}}
    },
    "Retry wallpaper" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再試行"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重试壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重試桌布"}}}
    },
    "Wallpaper Engine ownership confirmed. You can download its Workshop wallpapers." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認しました。Workshopの壁紙をダウンロードできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已确认拥有 Wallpaper Engine。你可以下载其创意工坊壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已確認擁有 Wallpaper Engine。你可以下載其工作坊桌布。"}}}
    },
    "This Steam account does not own Wallpaper Engine. Please purchase it on Steam to download Wallpaper Engine wallpapers. You can still download from Pixiv, browse the Workshop, and view Wallpaper Engine wallpapers you already have." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamアカウントはWallpaper Engineを所有していません。Wallpaper Engineの壁紙をダウンロードするには、Steamで購入してください。Pixivからのダウンロード、Workshopの閲覧、お持ちのWallpaper Engineの壁紙の表示は引き続き利用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 账户未拥有 Wallpaper Engine。请在 Steam 上购买后再下载 Wallpaper Engine 壁纸。你仍可从 Pixiv 下载、浏览创意工坊，以及查看已有的 Wallpaper Engine 壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 帳號未擁有 Wallpaper Engine。請在 Steam 上購買後再下載 Wallpaper Engine 桌布。你仍可從 Pixiv 下載、瀏覽工作坊，以及檢視已有的 Wallpaper Engine 桌布。"}}}
    },
    "Wallpaper Engine ownership has not been confirmed. Check again to verify this account can download its Workshop wallpapers. You can still download from Pixiv, browse the Workshop, and view wallpapers you already have." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認できていません。再確認して、このアカウントでWorkshopの壁紙をダウンロードできるか確認してください。Pixivからのダウンロード、Workshopの閲覧、お持ちの壁紙の表示は引き続き利用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未确认是否拥有 Wallpaper Engine。请重新检查此账户能否下载其创意工坊壁纸。你仍可从 Pixiv 下载、浏览创意工坊，以及查看已有的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未確認是否擁有 Wallpaper Engine。請重新檢查此帳號能否下載其工作坊桌布。你仍可從 Pixiv 下載、瀏覽工作坊，以及檢視已有的桌布。"}}}
    },
    "Check ownership again" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "所有状況を再確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新检查拥有状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新檢查擁有狀態"}}}
    },
    "Checking Wallpaper Engine ownership…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engineの所有を確認中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在检查是否拥有 Wallpaper Engine…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在檢查是否擁有 Wallpaper Engine…"}}}
    },
    "You can browse without an account. Steam Workshop downloads require an account that owns Wallpaper Engine. Sign in now, or skip and sign in at your first download." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "アカウントなしでも閲覧できます。Steam Workshopからのダウンロードには、Wallpaper Engineを所有するアカウントが必要です。今サインインするか、スキップして初回ダウンロード時にサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无需账户即可浏览。从 Steam 创意工坊下载需要拥有 Wallpaper Engine 的账户。现在登录，或跳过并在首次下载时登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無需帳號即可瀏覽。從 Steam 工作坊下載需要擁有 Wallpaper Engine 的帳號。現在登入，或略過並在首次下載時登入。"}}}
    },
