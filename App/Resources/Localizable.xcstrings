      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset belongs to a different wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセットは別の壁紙用です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设属于其他壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設屬於其他桌布。"}}}
    },
