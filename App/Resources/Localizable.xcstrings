      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ゴミ箱に入れる壁紙を選択します。タイルを押したまま他のタイルの上をドラッグしても選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择要移到废纸篓的壁纸。按住一张卡片并拖过其他卡片，也能一次选中多张。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選取要丟到垃圾桶的桌布。按住一張縮圖並拖過其他縮圖，也能一併選取。"}}}
