    "Drawn now by %@ (fallback: %@)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desenhado agora por %@ (alternativa: %@)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 %@ 방식으로 렌더링 중 (대체 방식: %@)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在%1$@で描画中（フォールバック：%2$@）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前由 %1$@ 绘制（回退：%2$@）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前由 %1$@ 繪製（回退：%2$@）"}}}
