    },
    "%@ · needed for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ · necessário para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ · %@에 필요"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ · %2$@に必要"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ · %2$@ 需要"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ · %2$@ 所需"}}}
    },
    "Close without removing this download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Fechar sem remover este download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 다운로드를 제거하지 않고 닫기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このダウンロードを削除せずに閉じる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭但保留此下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉但保留此下載"}}}
    },
    "This downloaded copy needs your approval before it can run:" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta cópia baixada precisa da sua aprovação antes de poder ser executada:"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 이 사본을 실행하려면 승인이 필요합니다:"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたこのコピーは、実行する前に承認が必要です："}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这份已下载的副本需要你批准后才能运行："}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這份下載的副本需要你核准後才能執行："}}}
    },
    "A downloaded copy is retained but not usable yet:" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma cópia baixada foi mantida, mas ainda não pode ser usada:"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 사본은 보관되어 있지만 아직 사용할 수 없습니다:"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたコピーは保持されていますが、まだ使用できません："}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保留一份下载的副本，但尚不可用："}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已保留一份下載的副本，但目前尚無法使用："}}}
    },
    "SteamCMD is Valve’s download tool. Install it here, or point to a copy you already have. Installing it does not sign you in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD é a ferramenta de download da Valve. Instale-o aqui ou indique uma cópia que você já tenha. Instalá-lo não inicia sua sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD는 Valve의 다운로드 도구입니다. 여기에서 설치하거나 이미 설치된 위치를 지정하세요. 설치만으로 로그인되지는 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveのダウンロードツールです。ここでインストールするか、手持ちのコピーの場所を指定してください。インストールしてもサインインはされません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下载工具。可以在这里安装，也可以指定你已有的副本。安装时不需要登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下載工具。你可以在這裡安裝，或指定你已有的副本。安裝時不會登入你的帳號。"}}}
    },
    "SteamCMD is ready." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD está pronto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 준비되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの準備ができました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已就绪。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已準備就緒。"}}}
    },
    "SteamCMD is not installed yet." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD ainda não está instalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 아직 설치되지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはまだインストールされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未安装 SteamCMD。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未安裝 SteamCMD。"}}}
    },
