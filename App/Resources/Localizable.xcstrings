    },
    "SteamCMD at %@ needs to finish installation: steamconsole.dylib is missing, empty, or unreadable." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD at %@ needs to finish installation: steamconsole.dylib is missing, empty, or unreadable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にあるSteamCMDのインストールを完了する必要があります：steamconsole.dylibが見つからないか、空か、読み取れません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 中的 SteamCMD 需要完成安装：steamconsole.dylib 缺失、为空或无法读取。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "位於 %@ 的 SteamCMD 需要完成安裝：steamconsole.dylib 遺失、為空或無法讀取。"}}}
    },
    "SteamCMD is missing its Breakpad.framework directory." : {
