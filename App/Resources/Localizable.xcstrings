    },
    "This display’s wallpaper was removed, so its playlist waits until you choose a wallpaper or resume it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede deste monitor foi removido, então a playlist dele aguarda até você escolher um papel de parede ou retomá-la."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이의 배경화면이 제거되어 배경화면을 선택하거나 재생목록을 재개할 때까지 기다립니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイの壁紙が削除されたため、壁紙を選択するかプレイリストを再開するまで、プレイリストは待機します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器的壁纸已被移除，因此其播放列表会等待，直到你选择一张壁纸或继续播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器的桌布已被移除，因此其播放列表會等待，直到你選擇一張桌布或繼續播放列表。"}}}
    },
