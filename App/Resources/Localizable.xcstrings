    },
    "App" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "App"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "App"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "應用程式"}}}
    },
    "Remove" : {
