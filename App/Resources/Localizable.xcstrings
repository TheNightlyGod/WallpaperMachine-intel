    },
    "Move %@ to Trash?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Move %@ to Trash?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」をゴミ箱に入れますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要将“%@”移到废纸篓吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要將「%@」丟到垃圾桶嗎？"}}}
    },
    "It is removed from your library and stops playing. The original files you imported are not affected." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "It is removed from your library and stops playing. The original files you imported are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリから削除され、再生が停止します。読み込んだ元のファイルには影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它会从壁纸库中移除并停止播放，导入时的原始文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它會從桌布庫中移除並停止播放。你匯入的原始檔案不受影響。"}}}
    },
    "Move %lld wallpapers to Trash?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Move %lld wallpapers to Trash?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld枚の壁紙をゴミ箱に入れますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要将 %lld 张壁纸移到废纸篓吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要將 %lld 張桌布丟到垃圾桶嗎？"}}}
    },
    "They are removed from your library and stop playing. The original files you imported are not affected." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "They are removed from your library and stop playing. The original files you imported are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリから削除され、再生が停止します。読み込んだ元のファイルには影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它们会从壁纸库中移除并停止播放，导入时的原始文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它們會從桌布庫中移除並停止播放。你匯入的原始檔案不受影響。"}}}
    },
    "Moved %lld of %lld wallpapers to Trash. Couldn’t move %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Moved %lld of %lld wallpapers to Trash. Couldn’t move %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%2$lld枚中%1$lld枚の壁紙をゴミ箱に入れました。移動できなかった壁紙：%3$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已将 %2$lld 张壁纸中的 %1$lld 张移到废纸篓。以下壁纸未能移动：%3$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已將 %2$lld 張桌布中的 %1$lld 張丟到垃圾桶。無法移動：%3$@"}}}
    },
    "Locate Scene Assets" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Locate Scene Assets"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソースの場所を指定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择场景资源位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指定場景資源位置"}}}
    },
    "Clear shader cache?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear shader cache?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダキャッシュを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除着色器缓存吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除著色器快取嗎？"}}}
    },
    "Shaders are rebuilt the next time wallpapers need them." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Shaders are rebuilt the next time wallpapers need them."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダは、次に壁紙で必要になったときに再構築されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸下次需要时会重新生成着色器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "著色器會在桌布下次需要時重新建立。"}}}
    },
    "Clear Cache" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Cache"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャッシュを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除快取"}}}
    },
    "Clear logs?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear logs?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除日志吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除記錄嗎？"}}}
    },
    "Only diagnostic logs are removed. Wallpapers and settings are not affected." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Only diagnostic logs are removed. Wallpapers and settings are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのは診断ログのみです。壁紙と設定には影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除诊断日志，不影响壁纸和设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除診斷記錄，桌布和設定不受影響。"}}}
    },
    "Clear Logs" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Logs"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除記錄"}}}
    },
    "Export Diagnostics" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Export Diagnostics"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "診断情報を書き出す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导出诊断报告"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯出診斷資料"}}}
    },
    "Attach this file to your bug report." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Attach this file to your bug report."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このファイルをバグレポートに添付してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请将此文件附在问题报告中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請將此檔案附加到你的錯誤回報中。"}}}
    },
    "Clear unused caches?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear unused caches?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "未使用のキャッシュを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除未使用的缓存吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除未使用的快取嗎？"}}}
    },
    "Only caches that can be rebuilt are removed. Files you chose in wallpaper settings are kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Only caches that can be rebuilt are removed. Files you chose in wallpaper settings are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのは再構築できるキャッシュのみです。壁紙の設定で選択したファイルは保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除可以重新生成的缓存，你在壁纸设置中选择的文件会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除可重新建立的快取，你在桌布設定中選擇的檔案會保留。"}}}
    },
    "Clear Caches" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Caches"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャッシュを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除快取"}}}
    },
    "The new copy replaces the current one only after it passes validation. Wallpapers and your saved sign-in are kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The new copy replaces the current one only after it passes validation. Wallpapers and your saved sign-in are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "新しいコピーは、検証に合格した後にのみ現在のものと置き換えられます。壁紙と保存済みのサインイン情報は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "新副本通过验证后才会替换当前的 SteamCMD，壁纸和已保存的登录都会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "新的副本通過驗證後才會取代目前的副本。桌布和已儲存的登入資訊都會保留。"}}}
    },
    "Reinstall" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Reinstall"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再インストール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新安装"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新安裝"}}}
    },
    "Reinstall this wallpaper?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Reinstall this wallpaper?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙を再インストールしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要重新安装此壁纸吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要重新安裝此桌布嗎？"}}}
    },
    "WallpaperMachine downloads it again from the Steam Workshop and swaps it in when the download is complete. Your settings for it are kept, and if the download fails the installed copy stays." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine downloads it again from the Steam Workshop and swaps it in when the download is complete. Your settings for it are kept, and if the download fails the installed copy stays."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineがSteamワークショップからもう一度ダウンロードし、ダウンロードが完了したら置き換えます。この壁紙の設定は引き継がれ、ダウンロードに失敗した場合はインストール済みのコピーがそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 会从 Steam 创意工坊重新下载此壁纸，并在下载完成后替换现有副本。它的设置会保留；如果下载失败，已安装的副本不会改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 會從 Steam 工作坊重新下載此桌布，並在下載完成後取代現有副本。它的設定會保留；如果下載失敗，已安裝的副本不會改變。"}}}
    },
    "Steam no longer serves this wallpaper, so it can’t be reinstalled." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this wallpaper, so it can’t be reinstalled."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがこの壁紙を提供しなくなったため、再インストールできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此壁纸，因此无法重新安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此桌布，因此無法重新安裝。"}}}
    },
    "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはこのソフトウェアを承認していないため、実行するとデータが危険にさらされる可能性があります。このフィンガープリントに一致するファイルのみが許可され、検疫フラグはこのコピーからのみ削除されます。そのほかのすべてについては、Gatekeeperと署名の確認は有効のままです。\n\nパス：%1$@\nSHA-256：%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准此软件，运行它可能危及你的数据。只允许与此指纹一致的文件，并且只移除这份副本的隔离标记。Gatekeeper 和签名检查对其他软件照常生效。\n\n路径：%1$@\nSHA-256：%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未核准此軟體，執行它可能會危及你的資料。只會允許符合此指紋的檔案，且只會移除這份副本的隔離標記。其他所有項目仍會進行 Gatekeeper 和簽署檢查。\n\n路徑：%1$@\nSHA-256：%2$@"}}}
    },
    "Discard downloaded SteamCMD?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Discard downloaded SteamCMD?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたSteamCMDを破棄しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要丢弃下载的 SteamCMD 吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要丟棄已下載的 SteamCMD 嗎？"}}}
    },
    "Only this downloaded copy is removed. The installed SteamCMD and your saved sign-in are kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Only this downloaded copy is removed. The installed SteamCMD and your saved sign-in are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのはダウンロードしたこのコピーのみです。インストール済みのSteamCMDと保存済みのサインイン情報は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除这份下载的副本，已安装的 SteamCMD 和已保存的登录都会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除這份下載的副本，已安裝的 SteamCMD 和已儲存的登入資訊都會保留。"}}}
    },
    "This wallpaper is no longer installed. Refresh your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is no longer installed. Refresh your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はもうインストールされていません。ライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸已不在壁纸库中，请刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已不在桌布庫中。請重新整理桌布庫。"}}}
    },
    "Some selected wallpapers are no longer installed. Refresh your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Some selected wallpapers are no longer installed. Refresh your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した壁紙の一部はもうインストールされていません。ライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "部分所选壁纸已不在壁纸库中，请刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "部分所選桌布已不在桌布庫中。請重新整理桌布庫。"}}}
