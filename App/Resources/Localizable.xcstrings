    "Steam could not load the Workshop. Check your connection or open Steam in your browser, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não conseguiu carregar o Workshop. Verifique sua conexão ou abra a Steam no navegador e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 창작마당을 불러오지 못했습니다. 연결 상태를 확인하거나 브라우저에서 Steam을 연 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not load the Workshop. Check your connection or open Steam in your browser, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamワークショップを読み込めませんでした。ネットワーク接続を確認するか、ブラウザでSteamを開いてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法加载创意工坊。请检查网络连接，或在浏览器中打开 Steam 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法載入工作坊。請檢查網路連線，或在瀏覽器中打開 Steam，然後重試。"}}}
    },
    "Steam returned an unreadable Workshop page. Try again or browse on Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam retornou uma página do Workshop ilegível. Tente novamente ou navegue na Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 읽을 수 없는 창작마당 페이지를 반환했습니다. 다시 시도하거나 Steam에서 둘러보세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam returned an unreadable Workshop page. Try again or browse on Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから読み取れないワークショップページが返されました。もう一度試すか、Steamで閲覧してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回了无法读取的创意工坊页面。请重试或前往 Steam 浏览。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 傳回了無法讀取的工作坊頁面。請再試一次，或前往 Steam 瀏覽。"}}}
    },
    "Steam changed its public page or requires a browser sign-in. Open Workshop on Steam, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam alterou sua página pública ou exige um início de sessão no navegador. Abra o Workshop na Steam e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam의 공개 페이지가 변경되었거나 브라우저 로그인이 필요합니다. Steam에서 창작마당을 연 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam changed its public page or requires a browser sign-in. Open Workshop on Steam, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamの公開ページが変更されたか、ブラウザでのサインインが必要です。Steamでワークショップを開いてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 的公开页面已更改，或需要在浏览器中登录。请在 Steam 上打开创意工坊后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已變更其公開頁面，或需要在瀏覽器中登入。請在 Steam 上打開工作坊，然後重試。"}}}
    },
    "Steam’s Workshop is busy. Try again in a moment." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Workshop da Steam está ocupado. Tente novamente em instantes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 창작마당이 혼잡합니다. 잠시 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam’s Workshop is busy. Try again in a moment."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのワークショップが混み合っています。しばらくしてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 创意工坊繁忙，请稍后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 工作坊忙碌中，請稍後再試。"}}}
    },
    "This wallpaper is no longer in your library. Refresh Library and choose another wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede não está mais na sua biblioteca. Atualize a Biblioteca e escolha outro papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면이 보관함에 더 이상 없습니다. 보관함을 새로 고침하고 다른 배경화면을 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is no longer in your library. Refresh Library and choose another wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はもうライブラリにありません。ライブラリを更新して、別の壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸已不在壁纸库中。请刷新壁纸库并选择其他壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已不在你的桌布庫中。請重新整理桌布庫並選擇其他桌布。"}}}
    },
    "This control sent an invalid value. Refresh the interface and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este controle enviou um valor inválido. Atualize a interface e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 컨트롤이 유효하지 않은 값을 전송했습니다. 인터페이스를 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This control sent an invalid value. Refresh the interface and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコントロールから無効な値が送信されました。インターフェイスを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此控件发送了无效的值。请刷新界面后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此控制項傳送了無效的值。請重新整理介面後重試。"}}}
    },
    "Lock Screen integration is unavailable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A integração com a Tela Bloqueada não está disponível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 연동을 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Lock Screen integration is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面との連携は利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕集成不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用鎖定畫面整合。"}}}
    },
    "Turn off Animate lock screen before changing this: it sets the desktop picture itself." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desative Animar tela bloqueada antes de alterar isto: essa opção define a própria imagem da mesa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경하기 전에 ‘잠금 화면 애니메이션’을 끄세요. 이 기능이 데스크탑 이미지를 직접 설정합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Turn off Animate lock screen before changing this: it sets the desktop picture itself."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この設定を変更する前に、「ロック画面をアニメーション表示」をオフにしてください。デスクトップピクチャはその機能が自身で設定します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先关闭“锁定屏幕动态壁纸”再更改此项：桌面图片由它自行设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請先關閉「鎖定畫面動態桌布」再變更此項目：桌面圖片由它自行設定。"}}}
    },
    "Screen saver integration is unavailable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A integração com o protetor de tela não está disponível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 보호기 연동을 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Screen saver integration is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバとの連携は利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序集成不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用螢幕保護程式整合。"}}}
    },
    "Selected for %lld display(s) — starts when macOS is idle" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Selecionado para %lld monitor(es) — inicia quando o macOS fica inativo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 %lld대에 선택됨 — macOS가 유휴 상태가 되면 시작"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Selected for %lld display(s) — starts when macOS is idle"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld台のディスプレイで選択済み — macOSがアイドル状態になると開始"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已为 %lld 台显示器选择，macOS 闲置时开始"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已為 %lld 台顯示器選取，macOS 閒置時開始"}}}
    },
    "Waiting for an applied wallpaper on a connected display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardando um papel de parede aplicado em um monitor conectado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연결된 디스플레이에 배경화면이 적용되기를 기다리는 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for an applied wallpaper on a connected display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続されたディスプレイに壁紙が適用されるのを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待已连接的显示器应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待已連接的顯示器套用桌布"}}}
    },
    "Choose a wallpaper for this display first." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha primeiro um papel de parede para este monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "먼저 이 디스플레이의 배경화면을 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a wallpaper for this display first."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まず、このディスプレイの壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先为此显示器选择壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請先為此顯示器選擇桌布。"}}}
    },
    "An import is already running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Já há uma importação em andamento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미 가져오는 중입니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "An import is already running."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みはすでに実行中です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已有导入正在进行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已有匯入作業正在進行。"}}}
    },
    "Wallpaper settings are unavailable. Refresh Library and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os ajustes do papel de parede não estão disponíveis. Atualize a Biblioteca e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 설정을 사용할 수 없습니다. 보관함을 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper settings are unavailable. Refresh Library and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の設定を利用できません。ライブラリを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸设置不可用。请刷新壁纸库后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用桌布設定。請重新整理桌布庫後重試。"}}}
    },
    "No configuration is available for this display. Refresh Displays and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não há configuração disponível para este monitor. Atualize os Monitores e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에 사용할 수 있는 구성이 없습니다. ‘디스플레이 새로 고침’을 실행한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No configuration is available for this display. Refresh Displays and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイで利用できる構成がありません。ディスプレイを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器没有可用配置。请刷新显示器后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器沒有可用的設定。請重新整理顯示器後重試。"}}}
    },
    "The display did not report this wallpaper as active. Refresh Displays and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O monitor não informou este papel de parede como ativo. Atualize os Monitores e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이에서 이 배경화면이 활성 상태임을 확인하지 못했습니다. 디스플레이를 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The display did not report this wallpaper as active. Refresh Displays and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイからこの壁紙がアクティブであるという報告がありませんでした。ディスプレイを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器未报告此壁纸正在播放。请刷新显示器后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器未回報此桌布正在使用中。請重新整理顯示器後重試。"}}}
    },
    "Could not confirm the display state after applying: %@. Refresh failed: %@. Refresh all wallpaper state before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível confirmar o estado do monitor após aplicar: %@. A atualização falhou: %@. Atualize todo o estado dos papéis de parede antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용 후 디스플레이 상태를 확인하지 못했습니다: %@. 새로 고침 실패: %@. 모든 배경화면 상태를 새로 고친 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not confirm the display state after applying: %@. Refresh failed: %@. Refresh all wallpaper state before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用後にディスプレイの状態を確認できませんでした：%@。更新に失敗しました：%@。再試行する前に、すべての壁紙の状態を更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用后无法确认显示器状态：%@。刷新失败：%@。重试前，请刷新所有壁纸状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用後無法確認顯示器狀態：%@。重新整理失敗：%@。重試前，請重新整理所有桌布狀態。"}}}
    },
    "The display assignment changed, but the operation could not be fully saved: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A atribuição do monitor foi alterada, mas a operação não pôde ser totalmente salva: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 할당은 변경되었지만 작업을 완전히 저장할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The display assignment changed, but the operation could not be fully saved: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの割り当ては変更されましたが、操作を完全には保存できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器的壁纸分配已更改，但操作未能完整保存：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器的桌布指派已變更，但無法完整儲存此操作：%@"}}}
    },
    "Could not apply the wallpaper: %@. Could not restore the display draft: %@. Refresh all wallpaper state before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível aplicar o papel de parede: %@. Não foi possível restaurar o rascunho do monitor: %@. Atualize todo o estado dos papéis de parede antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 적용하지 못했습니다: %@. 디스플레이의 편집 중 설정을 복원하지 못했습니다: %@. 모든 배경화면 상태를 새로 고친 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not apply the wallpaper: %@. Could not restore the display draft: %@. Refresh all wallpaper state before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用できませんでした：%@。ディスプレイの下書きを復元できませんでした：%@。再試行する前に、すべての壁紙の状態を更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法应用壁纸：%@。无法恢复显示器草稿：%@。重试前，请刷新所有壁纸状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法套用桌布：%@。無法還原顯示器的草稿：%@。重試前，請重新整理所有桌布狀態。"}}}
    },
    "The selected display is unavailable, disabled, or mirroring another display. Choose an enabled independent display in Settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O monitor selecionado não está disponível, está desativado ou espelhando outro monitor. Escolha um monitor independente ativado em Ajustes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 디스플레이를 사용할 수 없거나 비활성화되었거나 다른 디스플레이를 미러링하고 있습니다. 설정에서 활성화된 독립 디스플레이를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The selected display is unavailable, disabled, or mirroring another display. Choose an enabled independent display in Settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したディスプレイは利用できないか、無効になっているか、別のディスプレイをミラーリングしています。「設定」で有効な独立したディスプレイを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所选显示器不可用、已停用或正在镜像其他显示器。请在设置中选择已启用的独立显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所選的顯示器無法使用、已停用，或正在鏡像輸出另一部顯示器。請在「設定」中選擇已啟用的獨立顯示器。"}}}
    },
    "Wait for the pending setting to finish before applying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguarde o ajuste pendente terminar antes de aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용하기 전에 보류 중인 설정이 완료될 때까지 기다리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for the pending setting to finish before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用する前に、保留中の設定が完了するまでお待ちください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用前，请等待当前设置操作完成。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用前，請等候進行中的設定操作完成。"}}}
    },
    "A pending display setting is no longer available. Revert it before applying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um ajuste de monitor pendente não está mais disponível. Reverta-o antes de aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대기 중인 디스플레이 설정을 더 이상 사용할 수 없습니다. 적용하기 전에 해당 변경을 되돌리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A pending display setting is no longer available. Revert it before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保留中のディスプレイ設定が利用できなくなりました。適用する前に元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一项待提交的显示器设置已不可用。应用前，请撤销该设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一項待套用的顯示器設定已無法使用。套用前，請先還原該設定。"}}}
    },
    "A pending property is no longer editable. Revert it before applying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma propriedade pendente não é mais editável. Reverta-a antes de aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대기 중인 속성을 더 이상 편집할 수 없습니다. 적용하기 전에 해당 변경을 되돌리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A pending property is no longer editable. Revert it before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保留中のプロパティが編集できなくなりました。適用する前に元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一项待提交的属性已无法编辑。应用前，请撤销该属性。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一項待套用的屬性已無法編輯。套用前，請先還原該屬性。"}}}
    },
    "This video cannot be decoded. Import a complete, playable video file before applying it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo não pode ser decodificado. Importe um arquivo de vídeo completo e reproduzível antes de aplicá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 동영상을 디코딩할 수 없습니다. 적용하기 전에 재생 가능한 완전한 동영상 파일을 가져오세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This video cannot be decoded. Import a complete, playable video file before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオはデコードできません。適用する前に、再生可能な完全なビデオファイルを読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法解码此视频。请先导入完整且可播放的视频文件，再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法解碼此影片。套用前，請先匯入完整且可播放的影片檔案。"}}}
    },
    "Applying was interrupted by another playback or display change. Your pending edits have been kept. Refresh and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A aplicação foi interrompida por outra alteração de reprodução ou de monitor. Suas edições pendentes foram mantidas. Atualize e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 재생 또는 디스플레이 변경으로 적용이 중단되었습니다. 대기 중인 편집 내용은 유지되었습니다. 새로 고친 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Applying was interrupted by another playback or display change. Your pending edits have been kept. Refresh and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別の再生またはディスプレイの変更により適用が中断されました。保留中の編集内容は保持されています。更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用操作被其他播放或显示器更改中断。待提交的修改已保留。请刷新后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用作業被其他播放或顯示器變更中斷。你尚未套用的編輯已保留。請重新整理後重試。"}}}
    },
    "Choose a local macOS SteamCMD installation." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma instalação local do SteamCMD para macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에 설치된 macOS용 SteamCMD를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a local macOS SteamCMD installation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacにあるmacOS版SteamCMDを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择本地的 macOS SteamCMD 安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇本機的 macOS SteamCMD 安裝。"}}}
    },
    "SteamCMD was not found at %@. Locate an existing installation or install SteamCMD." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD não foi encontrado em %@. Localize uma instalação existente ou instale o SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에서 SteamCMD를 찾을 수 없습니다. 기존 설치 위치를 지정하거나 SteamCMD를 설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD was not found at %@. Locate an existing installation or install SteamCMD."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にSteamCMDが見つかりませんでした。既存のインストール先を指定するか、SteamCMDをインストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 未找到 SteamCMD。请选择已有安装或安装 SteamCMD。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 找不到 SteamCMD。請指定現有的安裝位置，或安裝 SteamCMD。"}}}
    },
    "Choose steamcmd, steamcmd.sh, or its flat/MacOS installation folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha steamcmd, steamcmd.sh ou a pasta de instalação flat/MacOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "steamcmd, steamcmd.sh 또는 해당 설치 폴더(단일 계층 구조 또는 MacOS 폴더)를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose steamcmd, steamcmd.sh, or its flat/MacOS installation folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "steamcmd、steamcmd.sh、またはそれらを含むインストールフォルダ（フラット構成またはMacOSフォルダ）を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 steamcmd、steamcmd.sh，或直接包含它们的安装目录（平铺目录或 MacOS 文件夹）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 steamcmd、steamcmd.sh，或直接包含它們的安裝資料夾（扁平結構或 MacOS 資料夾）。"}}}
    },
    "The private SteamCMD staging path is not safe: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O caminho de preparação privado do SteamCMD não é seguro: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전용 SteamCMD 준비 경로가 안전하지 않습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The private SteamCMD staging path is not safe: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "専用のSteamCMDステージングパスが安全ではありません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 私有暂存路径不安全：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 的私人暫存路徑不安全：%@"}}}
    },
    "The Homebrew SteamCMD wrapper has an unrecognized format. Locate the complete MacOS runtime directly." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O wrapper do SteamCMD do Homebrew tem um formato não reconhecido. Localize diretamente o ambiente MacOS completo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Homebrew SteamCMD 래퍼의 형식을 인식할 수 없습니다. 완전한 MacOS 런타임 위치를 직접 지정하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The Homebrew SteamCMD wrapper has an unrecognized format. Locate the complete MacOS runtime directly."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "HomebrewのSteamCMDラッパーの形式を認識できません。完全なMacOSランタイムの場所を直接指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法识别 Homebrew SteamCMD 包装脚本的格式。请直接选择完整的 MacOS 运行时。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法辨識 Homebrew SteamCMD 包裝程式的格式。請直接指定完整的 MacOS 執行環境。"}}}
    },
    "SteamCMD runtime directories cannot be symbolic links: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os diretórios do ambiente do SteamCMD não podem ser links simbólicos: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 런타임 디렉토리는 심볼릭 링크일 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD runtime directories cannot be symbolic links: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのランタイムディレクトリにシンボリックリンクは使用できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 运行时目录不能是符号链接：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 執行環境目錄不能是符號連結：%@"}}}
    },
    "Unexpected SteamCMD runtime layout." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Estrutura inesperada do ambiente do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "예상치 못한 SteamCMD 런타임 구성입니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unexpected SteamCMD runtime layout."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのランタイムの構成が想定外です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 运行时目录结构不符合预期。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 執行環境的目錄結構不符預期。"}}}
    },
    "SteamCMD at %@ needs to finish installation: steamconsole.dylib is missing, empty, or unreadable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD em %@ precisa concluir a instalação: steamconsole.dylib está ausente, vazio ou ilegível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 있는 SteamCMD의 설치를 완료해야 합니다. steamconsole.dylib가 없거나 비어 있거나 읽을 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD at %@ needs to finish installation: steamconsole.dylib is missing, empty, or unreadable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@にあるSteamCMDのインストールを完了する必要があります：steamconsole.dylibが見つからないか、空か、読み取れません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 中的 SteamCMD 需要完成安装：steamconsole.dylib 缺失、为空或无法读取。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "位於 %@ 的 SteamCMD 需要完成安裝：steamconsole.dylib 遺失、為空或無法讀取。"}}}
    },
    "SteamCMD is missing its Breakpad.framework directory." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Está faltando o diretório Breakpad.framework do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD에 Breakpad.framework 디렉토리가 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD is missing its Breakpad.framework directory."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDにBreakpad.frameworkディレクトリがありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 缺少 Breakpad.framework 目录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 缺少 Breakpad.framework 目錄。"}}}
    },
    "Cannot inspect %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível inspecionar %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@을(를) 검사할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot inspect %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を検査できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法检查 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法檢查 %@。"}}}
    },
    "Breakpad.framework has no valid Mach-O binary." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.framework não tem um binário Mach-O válido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.framework에 유효한 Mach-O 바이너리가 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.framework has no valid Mach-O binary."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.frameworkに有効なMach-Oバイナリがありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.framework 不包含有效的 Mach-O 二进制文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Breakpad.framework 沒有有效的 Mach-O 二進位檔。"}}}
    },
    "SteamCMD signature validation failed for %@. Select a valid installation or reinstall; no signatures were changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A validação da assinatura do SteamCMD falhou para %@. Selecione uma instalação válida ou reinstale; nenhuma assinatura foi alterada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 SteamCMD 서명 검증에 실패했습니다. 유효한 설치를 선택하거나 재설치하세요. 서명은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD signature validation failed for %@. Select a valid installation or reinstall; no signatures were changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@のSteamCMD署名の検証に失敗しました。有効なインストールを選択するか、再インストールしてください。署名は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的 SteamCMD 签名验证失败。请选择有效安装或重新安装；未修改任何签名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的 SteamCMD 簽署驗證失敗。請選擇有效的安裝或重新安裝；未更改任何簽署。"}}}
    },
    "This SteamCMD copy is built for Intel Macs only (%@). Reinstall SteamCMD to get Valve’s Apple silicon version." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta cópia do SteamCMD foi criada apenas para Macs Intel (%@). Reinstale o SteamCMD para obter a versão da Valve para Apple silicon."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 SteamCMD 사본은 Intel Mac 전용입니다(%@). Valve의 Apple silicon 버전을 받으려면 SteamCMD를 재설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This SteamCMD copy is built for Intel Macs only (%@). Reinstall SteamCMD to get Valve’s Apple silicon version."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamCMDはIntel Mac専用です（%@）。ValveのAppleシリコン版を入手するには、SteamCMDを再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 SteamCMD 仅适用于 Intel Mac（%@）。请重新安装 SteamCMD 以获取 Valve 的 Apple 芯片版本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這份 SteamCMD 僅適用於 Intel Mac（%@）。請重新安裝 SteamCMD 以取得 Valve 的 Apple 晶片版本。"}}}
    },
    "Missing architecture-compatible runtime image: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Imagem de ambiente compatível com a arquitetura ausente: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아키텍처와 호환되는 런타임 이미지가 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Missing architecture-compatible runtime image: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アーキテクチャ互換のランタイムイメージがありません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少架构兼容的运行时二进制文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "缺少與架構相容的執行環境映像檔：%@"}}}
    },
    "Unsupported SteamCMD runtime architecture in %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquitetura do ambiente do SteamCMD sem suporte em %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 SteamCMD 런타임 아키텍처는 지원되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unsupported SteamCMD runtime architecture in %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@のSteamCMDランタイムのアーキテクチャには対応していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 中的 SteamCMD 运行时架构不受支持。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 中的 SteamCMD 執行環境架構不受支援。"}}}
    },
    "SteamCMD system validation timed out while running %@. Retry after checking system security prompts." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A validação do sistema do SteamCMD expirou ao executar %@. Tente novamente após verificar os avisos de segurança do sistema."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 실행 중 SteamCMD 시스템 검증 시간이 초과되었습니다. 시스템 보안 알림을 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD system validation timed out while running %@. Retry after checking system security prompts."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の実行中にSteamCMDのシステム検証がタイムアウトしました。システムのセキュリティに関するダイアログを確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 系统验证在运行 %@ 时超时。请检查系统安全提示后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "執行 %@ 時，SteamCMD 系統驗證逾時。請檢查系統安全性提示後重試。"}}}
    },
    "Unreadable or unsafe runtime entry: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Item do ambiente ilegível ou inseguro: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "읽을 수 없거나 안전하지 않은 런타임 항목: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unreadable or unsafe runtime entry: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み取れないか安全ではないランタイム項目：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "运行时条目无法读取或不安全：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取或不安全的執行環境項目：%@"}}}
    },
    "Unreadable or hard-linked runtime file: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivo do ambiente ilegível ou com link físico: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "읽을 수 없거나 하드 링크된 런타임 파일: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unreadable or hard-linked runtime file: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み取れないかハードリンクされたランタイムファイル：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "运行时文件无法读取或为硬链接：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取或為硬連結的執行環境檔案：%@"}}}
    },
    "Only contained framework symbolic links are accepted: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Somente links simbólicos de framework contidos são aceitos: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프레임워크 내부를 가리키는 심볼릭 링크만 허용됩니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Only contained framework symbolic links are accepted: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームワーク内を指すシンボリックリンクのみ使用できます：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅接受目标位于框架内部的符号链接：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只接受指向框架內部的符號連結：%@"}}}
    },
    "Broken, cyclic, or escaping framework symbolic link: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Link simbólico de framework quebrado, cíclico ou que aponta para fora: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프레임워크 심볼릭 링크가 손상되었거나 순환 참조하거나 프레임워크 외부를 가리킵니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Broken, cyclic, or escaping framework symbolic link: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壊れているか、循環しているか、フレームワーク外を指すシンボリックリンク：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "框架符号链接已失效、形成循环或指向框架之外：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "框架符號連結已損壞、形成循環或指向框架之外：%@"}}}
    },
    "Special files are not accepted in SteamCMD: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivos especiais não são aceitos no SteamCMD: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD에서는 특수 파일을 허용하지 않습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Special files are not accepted in SteamCMD: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDでは特殊ファイルは使用できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 不接受特殊文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 不接受特殊檔案：%@"}}}
    },
    "Missing, empty, unreadable, or unsafe SteamCMD file: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivo do SteamCMD ausente, vazio, ilegível ou inseguro: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "없거나, 비어 있거나, 읽을 수 없거나, 안전하지 않은 SteamCMD 파일: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Missing, empty, unreadable, or unsafe SteamCMD file: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "見つからない、空、読み取れない、または安全ではないSteamCMDファイル：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 文件缺失、为空、无法读取或不安全：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 檔案遺失、為空、無法讀取或不安全：%@"}}}
    },
    "Unresolved SteamCMD dynamic loader path: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Caminho do carregador dinâmico do SteamCMD não resolvido: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "해석할 수 없는 SteamCMD 동적 로더 경로: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unresolved SteamCMD dynamic loader path: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "解決できないSteamCMDの動的ローダパス：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法解析 SteamCMD 动态加载器路径：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法解析的 SteamCMD 動態載入器路徑：%@"}}}
    },
    "SteamCMD dynamic loader path escapes its runtime: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O caminho do carregador dinâmico do SteamCMD sai do seu ambiente: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 동적 로더 경로가 런타임 외부를 가리킵니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD dynamic loader path escapes its runtime: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの動的ローダパスがランタイム外を指しています：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 动态加载器路径指向运行时目录之外：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 動態載入器路徑指向執行環境之外：%@"}}}
    },
    "Malformed Mach-O runtime file: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivo de ambiente Mach-O malformado: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "형식이 잘못된 Mach-O 런타임 파일: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Malformed Mach-O runtime file: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "形式が正しくないMach-Oランタイムファイル：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mach-O 运行时文件格式错误：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "格式錯誤的 Mach-O 執行環境檔案：%@"}}}
    },
    "Create process output pipe" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Criar pipe de saída do processo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로세스 출력 파이프 생성"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Create process output pipe"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロセス出力パイプの作成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创建进程输出管道"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "建立程序輸出管線"}}}
    },
    "Initialize process actions" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inicializar ações do processo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로세스 동작 초기화"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Initialize process actions"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロセスアクションの初期化"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "初始化进程操作"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "初始化程序動作"}}}
    },
    "Initialize process attributes" : {
