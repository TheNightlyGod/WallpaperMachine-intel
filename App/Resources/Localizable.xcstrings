    },
    "This display’s wallpaper was removed, so its playlist waits until you choose a wallpaper or resume it." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイの壁紙が削除されたため、壁紙を選択するかプレイリストを再開するまで、プレイリストは待機します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器的壁纸已被移除，因此其播放列表会等待，直到你选择一张壁纸或继续播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器的桌布已被移除，因此其播放列表會等待，直到你選擇一張桌布或繼續播放列表。"}}}
    },
    "Day wallpaper" : {
