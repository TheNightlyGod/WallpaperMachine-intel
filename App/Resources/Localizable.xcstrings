    },
    "Its preview, pages and download appear here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pré-visualização, as páginas e o download dela aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기, 페이지 및 다운로드가 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "イラストのプレビュー、ページ、ダウンロードがここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "插画的预览、分页和下载会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "插畫的預覽、頁面和下載選項會顯示在這裡。"}}}
    },
    "Download page %lld" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar página %lld"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld페이지 다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lldページ目をダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载第 %lld 页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載第 %lld 頁"}}}
    },
    "View on pixiv" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ver no pixiv"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivで表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 pixiv 上查看"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 pixiv 上檢視"}}}
    },
    "A still illustration saved from pixiv. Choose how it fits the screen under Image fit." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma ilustração estática salva do pixiv. Escolha como ela se ajusta à tela em Ajuste da imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 저장한 정지 일러스트입니다. ‘이미지 맞춤’에서 화면에 맞추는 방식을 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから保存した静止画のイラストです。画面への収め方は「画像の表示方法」で選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从 pixiv 保存的静态插画。可在“图片适配”中选择它在屏幕上的显示方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從 pixiv 儲存的靜態插畫。可在「圖片顯示方式」中選擇它在螢幕上的呈現方式。"}}}
    },
    "A still image imported from your Mac. Choose how it fits the screen under Image fit." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma imagem estática importada do seu Mac. Escolha como ela se ajusta à tela em Ajuste da imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac에서 가져온 정지 이미지입니다. ‘이미지 맞춤’에서 화면에 맞추는 방식을 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacから読み込んだ静止画です。画面への収め方は「画像の表示方法」で選択できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从这台 Mac 导入的静态图片。可在“图片适配”中选择它在屏幕上的显示方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從你的 Mac 匯入的靜態圖片。可在「圖片顯示方式」中選擇它在螢幕上的呈現方式。"}}}
    },
    "Pages of this work" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Páginas desta obra"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 작품의 페이지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この作品のページ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此作品的分页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此作品的頁面"}}}
    },
    "Page %lld of %lld" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Página %lld de %lld"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld / %lld페이지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%2$lldページ中%1$lldページ目"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "第 %1$lld 页，共 %2$lld 页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "第 %1$lld 頁，共 %2$lld 頁"}}}
    },
    "Loading pages…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Carregando páginas…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "페이지 불러오는 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ページを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在加载分页…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入頁面…"}}}
    },
    "pixiv: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "pixiv: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロード：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv：%@"}}}
    },
    "%lld pixiv downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld downloads do pixiv"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 다운로드 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのダウンロード%lld件"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个 pixiv 下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個 pixiv 下載項目"}}}
    },
    "Saved to your library as a still wallpaper that applies like any other. The artwork belongs to its artist." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva na sua biblioteca como papel de parede estático, aplicado como qualquer outro. A obra pertence ao seu artista."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 배경화면처럼 적용할 수 있는 정지 이미지 배경화면으로 보관함에 저장했습니다. 작품의 권리는 작가에게 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "静止画の壁紙としてライブラリに保存され、ほかの壁紙と同じように適用できます。作品の著作権は作者に帰属します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以静态壁纸保存到壁纸库，可像其他壁纸一样应用。作品版权归原作者所有。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已作為靜態桌布儲存到桌布庫，可像其他桌布一樣套用。作品版權歸原作者所有。"}}}
    },
    "Image fit" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ajuste da imagem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 맞춤"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の表示方法"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片适配"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片顯示方式"}}}
    },
    "Background color" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cor de fundo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경 색상"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "背景色"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "背景颜色"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "背景顏色"}}}
    },
    "Fill, keep the top" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preencher, manter o topo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "채우기, 상단 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面全体に表示（上部を維持）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "填充（保留顶部）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "填滿（保留頂部）"}}}
    },
    "Fit with blurred backdrop" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ajustar com fundo desfocado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "맞춤, 흐린 배경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面に合わせる（背景をぼかす）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "适应（模糊背景）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "符合大小（模糊背景）"}}}
    },
    "When the battery is low" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando a bateria estiver fraca"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 잔량이 부족할 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時"}}}
    },
    "Low battery level" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nível de bateria fraca"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 부족 기준"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量の基準"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量阈值"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低電量門檻"}}}
    },
    "Applies only while the Mac runs on battery. It ends 5 points above the level you choose, or when you plug in. The battery is at %lld%% now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vale apenas enquanto o Mac está na bateria. Termina 5 pontos acima do nível escolhido ou quando você conecta o carregador. A bateria está em %lld%% agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 배터리로 작동하는 동안에만 적용됩니다. 선택한 잔량보다 5퍼센트포인트 높아지거나 전원에 연결하면 종료됩니다. 현재 배터리 잔량은 %lld%%입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macがバッテリー駆動の間だけ有効です。選んだ残量より5ポイント上がるか、電源に接続すると終了します。現在のバッテリー残量は%lld%%です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在 Mac 使用电池供电时生效。电量回升到所选阈值再高 5 个百分点，或接上电源后结束。目前电量为 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在 Mac 使用電池供電時生效。電量回升到所選門檻再高 5 個百分點，或接上電源後結束。目前電量為 %lld%%。"}}}
    },
    "When the battery is low, wallpapers pause or stop once the charge falls to the level you chose, and resume when you plug in or the charge recovers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando a bateria está fraca, os papéis de parede pausam ou param assim que a carga cai até o nível escolhido, e retomam quando você conecta o carregador ou a carga se recupera."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 잔량이 선택한 수준까지 낮아지면 배경화면이 일시 정지되거나 정지됩니다. 전원을 연결하거나 잔량이 회복되면 재개됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないときは、残量が選んだレベルまで下がると壁紙が一時停止または停止し、電源に接続するか残量が回復すると再開します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时，壁纸会在电量降到你所选的阈值后暂停或停止，并在你接上电源或电量回升后恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時，桌布會在電量降到你所選的門檻後暫停或停止，並在你接上電源或電量回升後恢復。"}}}
    },
    "Mute all wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar todos os papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 배경화면 음소거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての壁紙を消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有桌布靜音"}}}
    },
    "Silences every wallpaper without changing their saved sound or volume. It works together with the rules below." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silencia todos os papéis de parede sem alterar o som ou o volume salvos de cada um. Funciona em conjunto com as regras abaixo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 사운드나 음량 설정을 변경하지 않고 모든 배경화면의 소리를 끕니다. 아래 규칙과 함께 작동합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているサウンドや音量の設定は変えずに、すべての壁紙を消音します。下のルールとあわせて機能します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音，不更改它们已保存的声音或音量。它与下方的规则共同生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音，不更改它們已儲存的聲音或音量。它會與下方的規則一併生效。"}}}
    },
    "Only play on the display I’m using" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir só no monitor que estou usando"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용 중인 디스플레이에서만 재생"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "使用中のディスプレイでのみ再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在我正在使用的显示器上播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在我正在使用的顯示器上播放"}}}
    },
    "The display your pointer is on keeps playing. The others pause a few seconds after you leave them and resume the moment you return. Your own Play and Pause are not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O monitor em que está o ponteiro continua reproduzindo. Os outros pausam alguns segundos depois que você sai deles e retomam assim que você volta. Seus próprios comandos de Reproduzir e Pausar não são alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "포인터가 있는 디스플레이는 계속 재생합니다. 다른 디스플레이는 포인터가 떠난 몇 초 후 일시 정지되고 돌아오는 즉시 재개됩니다. 직접 설정한 재생 및 일시 정지 상태는 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ポインタがあるディスプレイは再生を続けます。ほかのディスプレイは、ポインタが離れて数秒後に一時停止し、戻るとすぐに再開します。手動での再生と一時停止は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "鼠标指针所在的显示器会继续播放。其他显示器会在指针离开几秒后暂停，指针回来后立即恢复。不会改动你自己的播放和暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "游標所在的顯示器會繼續播放。其他顯示器會在游標離開幾秒後暫停，游標回來時立即恢復。不會變更你自己的播放與暫停操作。"}}}
    },
    "With two or more displays, Only play on the display I’m using pauses the others a few seconds after your pointer leaves them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Com dois ou mais monitores, Reproduzir só no monitor que estou usando pausa os outros alguns segundos depois que o ponteiro sai deles."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이가 두 대 이상일 때 ‘사용 중인 디스플레이에서만 재생’을 켜면 포인터가 떠난 몇 초 후 다른 디스플레이가 일시 정지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイが2台以上あるとき、「使用中のディスプレイでのみ再生」をオンにすると、ポインタが離れてから数秒後にほかのディスプレイが一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "有两台或更多显示器时，“仅在我正在使用的显示器上播放”会在指针离开几秒后暂停其他显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "有兩台或更多顯示器時，「僅在我正在使用的顯示器上播放」會在游標離開幾秒後暫停其他顯示器。"}}}
    },
    "In Low Power Mode" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "No Modo de Pouca Energia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드일 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード時"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式時"}}}
    },
    "Low Power Mode is on now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia está ativado agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 저전력 모드가 켜져 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードは現在オンです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式现已开启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式目前已開啟。"}}}
    },
    "Low Power Mode is off now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia está desativado agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 저전력 모드가 꺼져 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードは現在オフです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式现已关闭。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式目前已關閉。"}}}
    },
    "When the Mac is hot" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando o Mac estiver quente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨거울 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温のとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱時"}}}
    },
    "Applies while macOS reports the Mac as hot or very hot, which is when it starts slowing itself down. Right now it is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vale enquanto o macOS informa que o Mac está quente ou muito quente, que é quando ele começa a reduzir o próprio desempenho. Agora ele está %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS가 Mac의 온도를 높음 또는 매우 높음으로 보고할 때 적용됩니다. 이 상태에서는 Mac이 스스로 성능을 낮추기 시작합니다. 현재 상태는 %@입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがMacを高温または非常に高温と報告している間に適用されます。これはMacが自ら動作を抑え始める状態です。現在は%@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 macOS 报告 Mac 发热或严重发热时生效，这也是它开始自行降速的时候。目前状态为%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "會在 macOS 回報 Mac 過熱或嚴重過熱時生效，此時 Mac 會開始自行降速。目前為%@狀態。"}}}
    },
    "Reduced quality applies while the Mac is hot, and wallpapers pause if it becomes very hot. Right now it is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A qualidade reduzida vale enquanto o Mac está quente, e os papéis de parede pausam se ele ficar muito quente. Agora ele está %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨거워지면 화질을 낮추고, 매우 뜨거워지면 배경화면을 일시 정지합니다. 현재 상태: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「画質を下げる」はMacが高温の間に適用されます。非常に高温になった場合、壁紙は一時停止します。現在は%@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“降低画质”在 Mac 发热期间生效；如果 Mac 变得严重发热，壁纸会暂停。目前状态为%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「降低畫質」會在 Mac 過熱期間生效；如果 Mac 變得嚴重過熱，桌布會暫停。目前為%@狀態。"}}}
    },
    "normal" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "normal"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "정상"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正常"}}}
    },
    "warm" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "morno"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다소 따뜻함"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "やや高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "偏热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "偏熱"}}}
    },
    "hot" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "quente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "고온"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "发热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "過熱"}}}
    },
    "very hot" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "muito quente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "매우 뜨거움"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "非常に高温"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "严重发热"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "嚴重過熱"}}}
    },
    "Focus" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Foco"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "집중 모드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "集中モード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "专注模式"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專注模式"}}}
    },
    "Open Focus Settings…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir Ajustes de Foco…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "집중 모드 설정 열기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "集中モード設定を開く…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开专注模式设置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開專注模式設定…"}}}
    },
    "A Focus filter is in effect now: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um filtro de Foco está ativo agora: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 집중 모드 필터가 적용되어 있습니다: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、集中モードフィルタが有効です：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "专注模式过滤器正在生效：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專注模式過濾條件目前生效中：%@。"}}}
    },
    "Low Power Mode, a hot Mac and a Focus filter work the same way: while they hold, wallpapers pause, mute or stop as you chose, and resume when they end. Stop frees renderer memory and reloads wallpapers afterwards." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia, um Mac quente e um filtro de Foco funcionam da mesma forma: enquanto durarem, os papéis de parede pausam, silenciam ou param conforme você escolheu, e retomam quando terminarem. Parar libera a memória do renderizador e recarrega os papéis de parede depois."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드, Mac의 고온 상태 및 집중 모드 필터는 같은 방식으로 작동합니다. 조건이 유지되는 동안 선택한 설정에 따라 배경화면을 일시 정지, 음소거 또는 정지하고, 조건이 해제되면 재개합니다. ‘정지’는 렌더러 메모리를 해제하며, 이후 배경화면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード、Macの高温、集中モードフィルタはどれも同じように働きます。条件が続いている間は壁紙が選択どおりに一時停止、消音、または停止し、条件が終わると再開します。「停止」はレンダラのメモリを解放し、その後で壁紙を再読み込みします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式、Mac 过热和专注模式过滤器的作用方式相同：条件成立期间，壁纸按你的选择暂停、静音或停止，条件结束后恢复。“停止”会释放渲染器内存，之后重新加载壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式、Mac 過熱和專注模式過濾條件的運作方式相同：在條件持續期間，桌布會依你的選擇暫停、靜音或停止，條件結束後再恢復。「停止」會釋放渲染器記憶體，並在之後重新載入桌布。"}}}
    },
    "In Low Power Mode, when the Mac is hot or when the battery is low, Reduced quality keeps wallpapers running at the lower render scale and frame rate instead of pausing them, and never goes above your own quality settings. If the Mac gets very hot, wallpapers pause instead. It promises no measured power saving." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "No Modo de Pouca Energia, quando o Mac está quente ou quando a bateria está fraca, a qualidade reduzida mantém os papéis de parede em execução com escala de renderização e taxa de quadros menores em vez de pausá-los, e nunca ultrapassa seus próprios ajustes de qualidade. Se o Mac ficar muito quente, os papéis de parede pausam. Não há promessa de economia de energia medida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드이거나 Mac이 뜨겁거나 배터리가 부족할 때 ‘화질 낮추기’를 사용하면 배경화면을 일시 정지하지 않고 더 낮은 렌더링 배율과 프레임률로 계속 실행합니다. 사용자가 설정한 화질보다 높아지지는 않습니다. Mac이 매우 뜨거워지면 대신 배경화면을 일시 정지합니다. 실측에 따른 절전 효과를 보장하지는 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード中、Macが高温のとき、またはバッテリー残量が少ないときに「画質を下げる」を選ぶと、壁紙を一時停止せず、より低いレンダリングスケールとフレームレートで実行を続けます。ご自身の画質設定を超えることはありません。Macが非常に高温になった場合は、壁紙が一時停止します。実測に基づく省電力効果を保証するものではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在低电量模式下、Mac 过热时或电量低时，“降低画质”会让壁纸以较低的渲染比例和帧率继续运行，而不是暂停，并且不会超过你自己的画质设置。如果 Mac 严重发热，壁纸会暂停。这并不承诺经过测量的省电效果。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在低耗電模式下、Mac 過熱時或電量低時，「降低畫質」會讓桌布以較低的渲染比例與影格率繼續執行，而不是暫停，且不會超過你自己的畫質設定。如果 Mac 嚴重過熱，桌布會暫停。這並不保證經過測量的省電效果。"}}}
    },
    "Playlist" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlist"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリスト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表"}}}
    },
    "Playlist: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlist: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリスト：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表：%@"}}}
    },
    "Changes on its own" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Troca automática"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자동 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "自動切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自动更换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自動更換"}}}
    },
    "Rotate wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alternar papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 순환"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をローテーション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "轮换壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "輪播桌布"}}}
    },
    "Day and night" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dia e noite"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮과 밤"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "昼と夜"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日夜切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日夜切換"}}}
    },
    "Only while wallpapers play. A change that falls due while they are paused, the screen is locked or the displays sleep happens once they play again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Só enquanto os papéis de parede estão em reprodução. Uma troca prevista para quando estiverem pausados, a tela estiver bloqueada ou os monitores estiverem em repouso acontece assim que voltarem a reproduzir."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 재생 중일 때만 변경됩니다. 일시 정지 중이거나 화면이 잠겨 있거나 디스플레이가 잠자기 상태일 때 예정된 변경은 다시 재생될 때 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生中にのみ切り替わります。一時停止中、画面のロック中、またはディスプレイのスリープ中に予定時刻になった切り替えは、再生が再開したときに一度だけ行われます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在壁纸播放时进行。在暂停、锁屏或显示器睡眠期间到期的更换，会在壁纸恢复播放后执行一次。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在桌布播放時進行。若更換時間落在桌布暫停、螢幕鎖定或顯示器睡眠期間，會在桌布恢復播放後執行一次。"}}}
    },
    "This display’s list (%lld)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Lista deste monitor (%lld)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이의 목록(%lld개)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイのリスト（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器的列表（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器的列表（%lld）"}}}
    },
    "Order" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ordem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "순서"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "順序"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "顺序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "順序"}}}
    },
    "In order" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em ordem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "순서대로"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "順番どおり"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "按顺序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "依序"}}}
    },
    "Shuffle" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ordem aleatória"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "임의 재생"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シャッフル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "随机"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隨機"}}}
    },
    "How often" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Frequência"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 주기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "切り替え間隔"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更换频率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更換頻率"}}}
    },
    "Every %lld minutes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A cada %lld minutos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld분마다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分ごと"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 分鐘"}}}
    },
    "Every hour" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A cada hora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "매시간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間ごと"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每小时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每小時"}}}
    },
    "Every %lld hours" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A cada %lld horas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld시간마다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld時間ごと"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 小时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 小時"}}}
    },
    "Every day" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todo dia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "매일"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "毎日"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每天"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每天"}}}
    },
    "Every minute" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A cada minuto"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "매분"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1分ごと"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每分鐘"}}}
    },
    "Every %lld days" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A cada %lld dias"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld일마다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld日ごと"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 天"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每 %lld 天"}}}
    },
    "Each time the Mac is unlocked" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sempre que o Mac for desbloqueado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac의 잠금을 해제할 때마다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macのロックを解除するたび"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每次解锁 Mac 时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每次解鎖 Mac 時"}}}
    },
    "Minutes between changes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Minutos entre trocas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 간격(분)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "切り替え間隔（分）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更换间隔（分钟）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更換間隔（分鐘）"}}}
    },
    "min" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "min"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "분"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "分"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "分鐘"}}}
    },
    "Any whole number of minutes, up to %lld." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qualquer número inteiro de minutos, até %lld."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld분 이하의 정수로 입력하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分までの範囲で、分単位の整数を入力できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可输入任意整数分钟，最多 %lld 分钟。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可輸入任意整數分鐘，最多 %lld 分鐘。"}}}
    },
    "Wait for the video to finish" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esperar o vídeo terminar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상이 끝날 때까지 기다리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "動画の終わりまで待つ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "等待视频播完"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "等待影片播完"}}}
    },
    "A change that falls due while a video wallpaper plays waits until the video reaches its end, for up to an hour. Other wallpapers change on time." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma troca prevista para quando um papel de parede de vídeo estiver em reprodução espera o vídeo chegar ao fim, por até uma hora. Os outros papéis de parede trocam na hora prevista."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상 배경화면이 재생 중일 때 예정된 변경은 동영상이 끝날 때까지 최대 1시간 기다립니다. 다른 배경화면은 예정된 시간에 변경됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "動画壁紙の再生中に予定時刻になった切り替えは、動画が最後まで再生されるまで最長1時間待ちます。ほかの壁紙は予定どおりに切り替わります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频壁纸播放时到期的更换，会等到视频播到结尾再进行，最多等待一小时。其他壁纸按时更换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片桌布播放時到期的更換，會等到影片播到結尾再進行，最多等待一小時。其他桌布按時更換。"}}}
    },
    "The list is empty. In Installed, select wallpapers and choose Add to playlist, or use the list button in a wallpaper’s details." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A lista está vazia. Em Instalados, selecione papéis de parede e escolha Adicionar à playlist, ou use o botão de lista nos detalhes de um papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "목록이 비어 있습니다. ‘설치됨’에서 배경화면을 선택하고 ‘재생목록에 추가’를 선택하거나 배경화면 세부사항의 목록 버튼을 사용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リストは空です。「インストール済み」で壁紙を選択して「プレイリストに追加」を選ぶか、壁紙の詳細にあるリストボタンを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "列表为空。在“已安装”中选择壁纸后点按“加入播放列表”，或使用壁纸详情中的列表按钮。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "列表是空的。請在「已安裝」中選取桌布並選擇「加入播放列表」，或使用桌布詳細資訊中的列表按鈕。"}}}
    },
    "Next change" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Próxima troca"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回の切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下次更换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下次更換"}}}
    },
    "Change now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trocar agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "今すぐ切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "立即更换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "立即更換"}}}
    },
    "Around %@, if wallpapers are playing then." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Por volta de %@, se os papéis de parede estiverem em reprodução nesse momento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "해당 시점에 배경화면이 재생 중이면 %@쯤에 변경됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ごろ（その時点で壁紙が再生中の場合）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "约 %@（届时壁纸需在播放）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "約 %@（若屆時桌布正在播放）。"}}}
    },
    "When the video finishes, by %@ at the latest." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando o vídeo terminar, até %@ no máximo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상이 끝나면 변경되며, 늦어도 %@에는 변경됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "動画が終わったとき（遅くとも%@）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频播完时，最迟 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片播完時，最遲 %@。"}}}
    },
    "Starts counting once wallpapers play." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A contagem começa quando os papéis de parede forem reproduzidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재생이 시작되면 시간을 세기 시작합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生が始まるとカウントを開始します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸开始播放后开始计时。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布開始播放後才會開始計時。"}}}
    },
    "Changes when you unlock the Mac, while wallpapers are playing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Troca quando você desbloqueia o Mac, enquanto os papéis de parede estão em reprodução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 재생 중일 때 Mac의 잠금을 해제하면 변경됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macのロックを解除したときに切り替わります（壁紙が再生中の場合）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "解锁 Mac 时更换（届时壁纸需在播放）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "解鎖 Mac 時更換（若屆時桌布正在播放）。"}}}
    },
    "None of these wallpapers can play on this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum destes papéis de parede pode ser reproduzido neste Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면은 모두 이 Mac에서 재생할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "これらの壁紙はどれもこの Mac では再生できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这些壁纸都无法在这台 Mac 上播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這些桌布都無法在這台 Mac 上播放。"}}}
    },
    "Plays these wallpapers in order on this display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduz estes papéis de parede em ordem neste monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 이 배경화면들을 순서대로 재생합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイでこれらの壁紙を順番どおりに再生します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此显示器上按顺序播放这些壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此顯示器上依序播放這些桌布"}}}
    },
    "Plays these wallpapers in a random order on this display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduz estes papéis de parede em ordem aleatória neste monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 이 배경화면들을 임의 순서로 재생합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイでこれらの壁紙をランダムな順番で再生します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此显示器上随机播放这些壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此顯示器上隨機播放這些桌布"}}}
    },
    "The wallpaper on screen stays until you change it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede na tela fica até você trocá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면의 배경화면은 직접 바꿀 때까지 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "表示中の壁紙は、変更するまでそのままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前壁纸会一直保留，直到你更换它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前的桌布會一直保留，直到你更換它。"}}}
    },
    "Changes between the day and night wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alterna entre os papéis de parede de dia e de noite."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮 배경화면과 밤 배경화면 사이를 전환합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "昼と夜の壁紙を切り替えます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在白天和夜晚的壁纸之间切换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在白天和夜晚的桌布之間切換。"}}}
    },
    "To rotate wallpapers, press Play above All wallpapers, Favorites or a collection in Installed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Para alternar papéis de parede, abra Todos os papéis de parede, Favoritos ou uma coleção em Instalados e pressione Reproduzir acima."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 순환하려면 ‘설치됨’에서 모든 배경화면, 즐겨찾기 또는 컬렉션을 연 다음 위쪽의 재생을 누르세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をローテーションするには、「インストール済み」で「すべての壁紙」「お気に入り」またはコレクションを開き、上の「再生」を押します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要轮换壁纸，请在“已安装”中打开全部壁纸、收藏或某个合集，然后点按上方的“播放”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "若要輪播桌布，請在「已安裝」中開啟所有桌布、最愛或某個收藏集，然後按一下上方的「播放」。"}}}
    },
    "Playlist paused" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlist pausada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록 일시 정지됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリストを一時停止中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表已暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表已暫停"}}}
    },
