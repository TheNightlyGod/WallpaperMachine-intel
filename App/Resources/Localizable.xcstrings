    },
    "Reflections on" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reflexos ativados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "반사 켬"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "反射オン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "反射开启"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "反射開啟"}}}
    },
    "Reflections off" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reflexos desativados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "반사 끔"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "反射オフ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "反射关闭"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "反射關閉"}}}
    },
    "Post-processing: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pós-processamento: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "후처리: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ポストプロセス：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "后期处理：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "後期處理：%@"}}}
    },
    "Smooths the edges of 3D models; scenes without one are not affected. Changing it loads running scenes again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Suaviza as bordas dos modelos 3D; cenas sem modelos não são afetadas. Alterar isso recarrega as cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "3D 모델의 가장자리를 매끄럽게 합니다. 모델이 없는 장면에는 영향이 없습니다. 변경하면 실행 중인 장면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "3D モデルの輪郭を滑らかにします。モデルのないシーンには影響しません。変更すると実行中のシーンが再読み込みされます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "平滑 3D 模型的边缘；没有模型的场景不受影响。更改后，正在运行的场景会重新载入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "平滑 3D 模型的邊緣；沒有模型的場景不受影響。變更後，正在執行的場景會重新載入。"}}}
    },
    "Detail of the shadows lit 3D scenes cast. Changing it loads running scenes again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Detalhe das sombras projetadas pelas cenas 3D iluminadas. Alterar isso recarrega as cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "조명이 있는 3D 장면이 드리우는 그림자의 세밀함입니다. 변경하면 실행 중인 장면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライティングされた 3D シーンが落とす影の精細さです。変更すると実行中のシーンが再読み込みされます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "光照 3D 场景投射阴影的精细程度。更改后，正在运行的场景会重新载入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "光照 3D 場景投射陰影的精細程度。變更後，正在執行的場景會重新載入。"}}}
    },
    "Light shafts and fog volumes in 3D scenes. Changing it loads running scenes again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Feixes de luz e volumes de neblina em cenas 3D. Alterar isso recarrega as cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "3D 장면의 빛줄기와 안개 볼륨입니다. 변경하면 실행 중인 장면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "3D シーンの光の筋とフォグボリュームです。変更すると実行中のシーンが再読み込みされます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "3D 场景中的光束和雾体积。更改后，正在运行的场景会重新载入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "3D 場景中的光束與霧體積。變更後，正在執行的場景會重新載入。"}}}
    },
    "Lets reflective materials show the scene around them. Changing it loads running scenes again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permite que materiais reflexivos mostrem a cena ao redor deles. Alterar isso recarrega as cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "반사 재질에 주변 장면이 비치게 합니다. 변경하면 실행 중인 장면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "反射する素材に周囲のシーンを映します。変更すると実行中のシーンが再読み込みされます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让反射材质显示周围的场景。更改后，正在运行的场景会重新载入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓反射材質顯示周圍的場景。變更後，正在執行的場景會重新載入。"}}}
    },
    "How much of a scene’s bloom and HDR is drawn; HDR needs Ultra or Display HDR. Changing it loads running scenes again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quanto do bloom e do HDR de uma cena é desenhado; o HDR requer Máxima ou HDR da tela. Alterar isso recarrega as cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면의 블룸과 HDR을 얼마나 그릴지 정합니다. HDR에는 '최고' 또는 '디스플레이 HDR'이 필요합니다. 변경하면 실행 중인 장면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンのブルームと HDR をどこまで描くかです。HDR には「最高」または「ディスプレイ HDR」が必要です。変更すると実行中のシーンが再読み込みされます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景的泛光和 HDR 绘制多少；HDR 需要“极高”或“显示器 HDR”。更改后，正在运行的场景会重新载入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景的泛光與 HDR 繪製多少；HDR 需要「極高」或「顯示器 HDR」。變更後，正在執行的場景會重新載入。"}}}
    },
    "Native Metal can’t draw this scene" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Native Metal não consegue desenhar esta cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal이 이 장면을 그릴 수 없습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalではこのシーンを描画できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 无法绘制此场景"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 無法繪製此場景"}}}
    },
    "It was refused when it last ran or was checked with this version of the app: %@. Applied, it shows its preview picture instead of moving." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ela foi recusada na última vez em que foi executada ou verificada com esta versão do app: %@. Se aplicada, mostra a imagem de prévia em vez de se mover."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 버전의 앱에서 마지막으로 실행하거나 검사했을 때 거부되었습니다: %@. 적용하면 움직이는 대신 미리보기 이미지가 표시됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "It was refused when it last ran or was checked with this version of the app: %@. Applied, it shows its preview picture instead of moving."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのアプリで最後に実行または確認したときに拒否されました：%@。適用すると、動く代わりにプレビュー画像が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上次在此版本的应用中运行或检查时被拒绝：%@。应用后会显示其预览图，而不是动态壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上次在此版本的 App 中執行或檢查時被拒絕：%@。套用後會顯示其預覽圖，而不是動態桌布。"}}}
    },
    "Apply Anyway" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar mesmo assim"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "그래도 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このまま適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仍然应用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "仍然套用"}}}
    },
    "Files the scene names" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivos usados pela cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면이 사용하는 파일"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンが使うファイル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景用到的文件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景用到的檔案"}}}
    },
    "The renderer could not check this scene: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador não conseguiu verificar esta cena: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "렌더러가 이 장면을 검사할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The renderer could not check this scene: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラーはこのシーンを確認できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染器无法检查此场景：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "算繪器無法檢查此場景：%@"}}}
    },
    "The renderer could not read this scene: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador não conseguiu ler esta cena: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "렌더러가 이 장면을 읽을 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The renderer could not read this scene: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラーはこのシーンを読み込めませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染器无法读取此场景：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "算繪器無法讀取此場景：%@"}}}
    },
    "Every file the scene names is installed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os arquivos usados pela cena estão instalados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면이 사용하는 파일이 모두 설치되어 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンが使うファイルはすべてインストールされています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景用到的文件都已安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景用到的檔案都已安裝。"}}}
    },
    "Layer “%@”: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Camada “%1$@”: %2$@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이어 “%1$@”: %2$@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Layer “%@”: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "レイヤー「%1$@」：%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图层“%1$@”：%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖層「%1$@」：%2$@"}}}
    },
    "and %lld more" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "e mais %lld"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "외 %lld개"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "and %lld more"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほか %lld 件"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "另有 %lld 个"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另有 %lld 個"}}}
    },
    "Some files the scene names are not installed. A layer that needs one is drawn without it, or not at all." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alguns arquivos usados pela cena não estão instalados. Uma camada que precisa de um deles é desenhada sem ele, ou não é desenhada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면이 사용하는 파일 중 일부가 설치되어 있지 않습니다. 이 파일이 필요한 레이어는 파일 없이 그려지거나 그려지지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンが使うファイルの一部がインストールされていません。そのファイルが必要なレイヤーは、ファイルなしで描画されるか、描画されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景用到的部分文件未安装。需要这些文件的图层会在缺少它们的情况下绘制，或完全不绘制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景用到的部分檔案未安裝。需要這些檔案的圖層會在缺少它們的情況下繪製，或完全不繪製。"}}}
    },
    "Native Metal has drawn this scene with this version of the app. Options that turn other layers or effects on are not covered." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Native Metal já desenhou esta cena com esta versão do app. Opções que ativam outras camadas ou efeitos não estão incluídas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 버전의 앱에서 네이티브 Metal이 이 장면을 그린 적이 있습니다. 다른 레이어나 효과를 켜는 옵션은 포함되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのアプリで、ネイティブMetalはこのシーンを描画したことがあります。ほかのレイヤーやエフェクトをオンにするオプションは対象外です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此版本的应用中，原生 Metal 已绘制过此场景。打开其他图层或特效的选项不在此列。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此版本的 App 中，原生 Metal 已繪製過此場景。開啟其他圖層或特效的選項不在此列。"}}}
    },
    "The renderer read the whole scene and found nothing Native Metal cannot draw. Its shaders are compiled, and its render graph built, only when it is drawn." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador leu a cena inteira e não encontrou nada que o Native Metal não consiga desenhar. Os shaders só são compilados, e o grafo de renderização só é montado, quando ela é desenhada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "렌더러가 장면 전체를 읽었으며 네이티브 Metal이 그릴 수 없는 요소를 찾지 못했습니다. 셰이더 컴파일과 렌더 그래프 구성은 실제로 그릴 때에만 이루어집니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラーがシーン全体を読み込み、ネイティブMetalで描画できないものは見つかりませんでした。シェーダーのコンパイルとレンダーグラフの構築は、実際に描画するときにだけ行われます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染器已读取整个场景，未发现原生 Metal 无法绘制的内容。着色器编译和渲染图构建只在实际绘制时进行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "算繪器已讀取整個場景，未發現原生 Metal 無法繪製的內容。著色器編譯和算繪圖建構只在實際繪製時進行。"}}}
    },
    "no reason was given" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "nenhum motivo foi informado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이유가 제공되지 않았습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "理由は示されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未提供原因"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未提供原因"}}}
    },
    "Native Metal cannot draw this scene with this version of the app: %@. Applying it shows its preview picture instead." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Native Metal não consegue desenhar esta cena com esta versão do app: %@. Ao aplicá-la, a imagem de prévia é mostrada no lugar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 버전의 앱에서는 네이티브 Metal이 이 장면을 그릴 수 없습니다: %@. 적용하면 대신 미리보기 이미지가 표시됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Native Metal cannot draw this scene with this version of the app: %@. Applying it shows its preview picture instead."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのアプリでは、ネイティブMetalはこのシーンを描画できません：%@。適用すると、代わりにプレビュー画像が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此版本的应用中，原生 Metal 无法绘制此场景：%@。应用后会改为显示其预览图。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此版本的 App 中，原生 Metal 無法繪製此場景：%@。套用後會改為顯示其預覽圖。"}}}
    },
    "About WallpaperMachine" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sobre o WallpaperMachine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine에 관하여"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "About WallpaperMachine"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineについて"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关于 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關於 WallpaperMachine"}}}
    },
    "Services" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Serviços"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "서비스"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Services"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サービス"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "服务"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "服務"}}}
    },
    "Hide WallpaperMachine" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar WallpaperMachine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 가리기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Hide WallpaperMachine"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏 WallpaperMachine"}}}
    },
    "Hide Others" : {
      "extractionState" : "manual",
