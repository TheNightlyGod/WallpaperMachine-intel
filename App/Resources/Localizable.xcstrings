    },
    "Download the new versions the Workshop has of your wallpapers" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップにある壁紙の新しいバージョンをダウンロードします"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载创意工坊中这些壁纸的新版本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從工作坊下載這些桌布的新版本"}}}
    },
    "Downloading the update…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートをダウンロード中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载更新…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載更新…"}}}
    },
    "Downloading the update… %lld%%" : {
