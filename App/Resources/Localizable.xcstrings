    },
    "A SteamCMD download is larger than Valve’s package manifest allows." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A SteamCMD download is larger than Valve’s package manifest allows."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのダウンロードサイズがValveのパッケージマニフェストで許可されたサイズを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下载大小超过 Valve 安装包清单允许的大小。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下載大小超過 Valve 套件清單允許的大小。"}}}
    },
    "A SteamCMD download is empty or truncated." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A SteamCMD download is empty or truncated."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのダウンロードが空か、途中で切れています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下载为空或不完整。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下載為空或不完整。"}}}
    },
    "%@ is not a macOS Mach-O SteamCMD executable." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ is not a macOS Mach-O SteamCMD executable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@はmacOS用のMach-O形式のSteamCMD実行ファイルではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是 macOS Mach-O 格式的 SteamCMD 可执行文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是 macOS Mach-O 格式的 SteamCMD 可執行檔。"}}}
    },
    "%@ is not a valid Mach-O runtime component." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ is not a valid Mach-O runtime component."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@は有効なMach-Oランタイムコンポーネントではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是有效的 Mach-O 运行时组件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是有效的 Mach-O 執行環境元件。"}}}
    },
    "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に必要なランタイム依存関係%@が見つからないか、ランタイム外にあります。公式のSteamCMDのインストールを完了してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的运行时依赖 %@ 缺失或位于运行时目录之外。请完成官方 SteamCMD 安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的執行環境相依項目 %@ 遺失或位於外部。請完成官方的 SteamCMD 安裝。"}}}
    },
    "%@: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}}
    },
    "Could not log out of Steam: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not log out of Steam: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトできませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法退出 Steam 登录：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法登出 Steam：%@"}}}
    },
    "Wait for active and queued downloads to finish before logging out of Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for active and queued downloads to finish before logging out of Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトする前に、実行中およびキュー内のダウンロードが完了するまでお待ちください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请等待进行中和排队的下载完成后再退出 Steam 登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請等待進行中和佇列中的下載完成後，再登出 Steam。"}}}
    },
    "Log out of Steam?" : {
      "extractionState" : "manual",
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Log out of Steam?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要退出 Steam 登录吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要登出 Steam 嗎？"}}}
    },
    "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again." : {
      "extractionState" : "manual",
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されている%@のサインイン情報がこのMacから削除されます。ほかのSteamデバイスはサインインしたままで、次回のダウンロード時に再度サインインを求められます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将从这台 Mac 移除 %@ 的已保存登录。其他 Steam 设备保持登录，下次下载时需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將從這部 Mac 移除 %@ 已儲存的登入資訊。其他 Steam 裝置會維持登入狀態，下次下載時會要求你重新登入。"}}}
    },
    "Log Out" : {
      "extractionState" : "manual",
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Log Out"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログアウト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "退出登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登出"}}}
    },
    "Could not update the saved Steam sign-in: %@. You may need to sign in again next time." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているSteamのサインイン情報を更新できませんでした：%@。次回、再度サインインが必要になる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法更新已保存的 Steam 登录：%@。下次可能需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法更新已儲存的 Steam 登入資訊：%@。下次可能需要重新登入。"}}}
    },
    "Steam did not provide reusable sign-in files. You may need to sign in again next time." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから再利用可能なサインインファイルが提供されませんでした。次回、再度サインインが必要になる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未提供可复用的登录文件，下次可能需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未提供可重複使用的登入檔案。下次可能需要重新登入。"}}}
    },
    "Saved Steam sign-in expired; waiting for fresh authentication…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているSteamのサインイン情報の有効期限が切れました。新たな認証を待機中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的 Steam 登录已失效，等待重新验证…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的 Steam 登入資訊已過期；正在等待重新驗證…"}}}
    },
    "Using your saved Steam sign-in…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているSteamのサインイン情報を使用中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用已保存的 Steam 登录…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用你已儲存的 Steam 登入資訊…"}}}
    },
    "Steam sign-in storage must be a private directory, not a symbolic link." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインイン情報の保存先は、シンボリックリンクではなく非公開のディレクトリである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登录保存位置必须是私有目录，不能是符号链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登入資訊的儲存位置必須是私人目錄，不能是符號連結。"}}}
    },
    "Steam sign-in files cannot be read through symbolic links." : {
