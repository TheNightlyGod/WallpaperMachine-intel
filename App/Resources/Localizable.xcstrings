    },
    "Your first downloaded wallpaper is up and running. Enjoying WallpaperMachine? You can help it grow." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seu primeiro papel de parede baixado já está funcionando. Gostando do WallpaperMachine? Você pode ajudá-lo a crescer."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "처음 다운로드한 배경화면이 실행 중입니다. WallpaperMachine이 마음에 드시나요? 더 발전할 수 있도록 도와주세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "初めてダウンロードした壁紙が動き始めました。WallpaperMachineを気に入ったら、応援していただけるとうれしいです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你下载的第一张壁纸已经用上了。喜欢 WallpaperMachine？欢迎支持它继续成长。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你下載的第一張桌布已經用上了。喜歡 WallpaperMachine？歡迎支持它繼續成長。"}}}
    },
    "Star on GitHub" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dar uma estrela no GitHub"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub에서 별표 표시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GitHubでStarを付ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "去 GitHub 点个 Star"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "到 GitHub 點個 Star"}}}
    },
    "Help others discover WallpaperMachine." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ajude outras pessoas a descobrir o WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "더 많은 사람이 WallpaperMachine을 알 수 있도록 도와주세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineをもっと多くの人に届けましょう。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让更多人发现 WallpaperMachine。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓更多人發現 WallpaperMachine。"}}}
    },
    "Become a Supporter" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Torne-se um Apoiador"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "후원하기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サポーターになる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "成为支持者"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "成為支持者"}}}
    },
    "Support development with a one-time contribution." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apoie o desenvolvimento com uma contribuição única."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일회성 후원으로 개발을 지원하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一度限りの寄付で開発を応援する。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "通过一次性赞助，支持后续开发。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "透過一次性贊助，支持後續開發。"}}}
    },
