    "Library & Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Biblioteca e Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함 및 Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリとSteam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库与 Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫與 Steam"}}}
    },
    "Storage" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Armazenamento"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장 공간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ストレージ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "存储"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存空間"}}}
    },
    "About" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sobre"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "정보"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "情報"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关于"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關於"}}}
    },
    "Settings categories" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Categorias dos ajustes"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 카테고리"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定のカテゴリ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置分类"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定類別"}}}
    },
    "Settings are unavailable. Try refreshing the library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os ajustes não estão disponíveis. Tente atualizar a biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정을 사용할 수 없습니다. 보관함을 새로고침해 보세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定を利用できません。ライブラリを更新してみてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置不可用。请尝试刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用設定。請嘗試重新整理桌布庫。"}}}
    },
    "Refresh" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "새로고침"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刷新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新整理"}}}
    },
    "Language" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Idioma"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "언어"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "言語"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "语言"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "語言"}}}
    },
    "The interface and import picker switch at once. Quit and reopen the app to switch menus and other dialogs." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A interface e o seletor de importação mudam na hora. Encerre e reabra o app para mudar os menus e outras caixas de diálogo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "인터페이스와 가져오기 선택 창은 즉시 전환됩니다. 메뉴와 다른 대화상자를 전환하려면 앱을 종료한 후 다시 여세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面と読み込み用のファイル選択ウインドウはすぐに切り替わります。メニューとその他のダイアログを切り替えるには、Appを終了して開き直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "界面和导入文件选择窗口会立即切换。菜单和其他对话框需要退出并重新打开应用后切换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "介面與匯入檔案選擇視窗會立即切換。選單和其他對話框需要結束並重新開啟 App 後切換。"}}}
    },
    "Launch at login" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir ao iniciar sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 시 실행"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン時に起動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录时启动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入時啟動"}}}
    },
    "Move the app to Applications to enable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mova o app para Aplicativos para ativar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "활성화하려면 앱을 응용 프로그램 폴더로 이동하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "有効にするには、Appを「アプリケーション」フォルダに移動してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将应用移到“应用程序”文件夹后即可启用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將 App 移到「應用程式」資料夾後即可啟用。"}}}
    },
    "Allow WallpaperMachine in System Settings → General → Login Items to launch it at login." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permita o WallpaperMachine em Ajustes do Sistema → Geral → Itens de Início para abri-lo ao iniciar sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인할 때 실행하려면 시스템 설정 → 일반 → 로그인 항목에서 WallpaperMachine을 허용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン時に起動するには、「システム設定」→「一般」→「ログイン項目」でWallpaperMachineを許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要在登录时启动，请在“系统设置 → 通用 → 登录项”中允许 WallpaperMachine。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "若要在登入時啟動，請在「系統設定」→「一般」→「登入項目」中允許 WallpaperMachine。"}}}
    },
    "Open Login Items…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir Itens de Início…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 항목 열기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン項目を開く…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开登录项…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開登入項目…"}}}
    },
    "Keep windows in place when clicking the wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Manter as janelas no lugar ao clicar no papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 클릭해도 윈도우 위치 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をクリックしたときにウインドウを移動しない"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点击壁纸时保持窗口不动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下桌布時讓視窗保持原位"}}}
    },
    "Play Library previews only on hover" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir as pré-visualizações da Biblioteca só ao passar o ponteiro"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "포인터를 올렸을 때만 보관함 미리보기 재생"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ポインタを重ねたときだけライブラリのプレビューを再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在指针悬停时播放壁纸库预览"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在游標停留時播放桌布庫預覽"}}}
    },
    "Clicking the menu bar icon" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ao clicar no ícone da barra de menus"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "메뉴 막대 아이콘을 클릭하면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューバーのアイコンをクリックしたとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点按菜单栏图标时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下選單列圖像時"}}}
    },
    "The panel shows what is playing on each display, its controls and a quick switcher. Right-click or Control-click the icon for the menu either way." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O painel mostra o que está sendo reproduzido em cada monitor, os controles e uma troca rápida. Em qualquer caso, clique no ícone com o botão direito ou com a tecla Control pressionada para abrir o menu."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "패널에는 각 디스플레이에서 재생 중인 항목과 재생 제어기, 빠른 전환 목록이 표시됩니다. 어느 쪽을 선택하든 아이콘을 오른쪽 클릭하거나 Control-클릭하면 메뉴가 열립니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パネルには、各ディスプレイで再生中の壁紙とその操作ボタン、クイック切り替えが表示されます。どちらを選んでも、アイコンを右クリックするかControlキーを押しながらクリックするとメニューが開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "面板显示每台显示器正在播放的内容、播放控制和快速切换栏。无论选择哪一项，右键点按或按住 Control 键点按图标都会打开菜单。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "面板會顯示每部顯示器正在播放的內容、播放控制項目和快速切換列。無論選擇哪一項，按一下右鍵或按住 Control 鍵並按一下圖像，都會打開選單。"}}}
    },
    "Shows the panel" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostra o painel"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "패널 표시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パネルを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示面板"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示面板"}}}
    },
    "Shows the menu" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostra o menu"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "메뉴 표시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示菜单"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示選單"}}}
    },
    "When this is off, every Library tile on screen plays its animated preview, as in the Steam Workshop. When it is on, a tile plays only while the pointer rests on it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando desativado, cada item da Biblioteca na tela reproduz sua pré-visualização animada, como no Workshop da Steam. Quando ativado, um item só a reproduz enquanto o ponteiro estiver sobre ele."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "끄면 화면에 보이는 모든 보관함 타일이 Steam 창작마당처럼 움직이는 미리보기를 재생합니다. 켜면 포인터를 올려 둔 타일만 재생합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オフのときは、Steamワークショップと同じように、画面に表示されているライブラリのすべてのタイルがアニメーションプレビューを再生します。オンのときは、ポインタを重ねている間だけタイルが再生されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭时，壁纸库中屏幕上的每个图块都会播放动态预览，就像 Steam 创意工坊一样。打开后，只有指针停留在图块上时才会播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉時，桌布庫中畫面上的每個方塊都會播放動態預覽，就像 Steam 工作坊一樣。開啟後，只有游標停留在方塊上時才會播放。"}}}
    },
    "Hide window after applying a wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar a janela após aplicar um papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 적용 후 윈도우 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用したあとにウインドウを隠す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸后隐藏窗口"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用桌布後隱藏視窗"}}}
    },
    "Show property edits on the desktop as I make them" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar na mesa as edições de propriedades enquanto as faço"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성을 편집하는 즉시 데스크탑에 표시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のプロパティの編集をデスクトップに即時表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在桌面上实时显示我所做的属性修改"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在桌面上即時顯示我所做的屬性變更"}}}
    },
    "While you edit a wallpaper’s properties, your displays follow each change before you press Apply changes, and Revert puts the saved look back. Pictures and options that switch an effect on or off still wait for Apply changes. The lock screen and the Mission Control picture keep the saved look until you apply." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Enquanto você edita as propriedades de um papel de parede, seus monitores acompanham cada alteração antes de você clicar em Aplicar alterações, e Reverter restaura a aparência salva. Imagens e opções que ativam ou desativam um efeito ainda aguardam Aplicar alterações. A tela bloqueada e a imagem do Mission Control mantêm a aparência salva até você aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 속성을 편집하는 동안 ‘변경 사항 적용’을 누르기 전에도 각 변경이 디스플레이에 반영되며, ‘되돌리기’를 누르면 저장된 모습으로 돌아갑니다. 이미지와 효과를 켜거나 끄는 옵션은 ‘변경 사항 적용’을 눌러야 반영됩니다. 잠금 화면과 Mission Control 이미지는 적용할 때까지 저장된 모습을 유지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のプロパティを編集している間、「変更を適用」を押す前でも、ディスプレイが変更に追従します。「元に戻す」を押すと保存済みの見た目に戻ります。画像や、エフェクトのオン・オフを切り替えるオプションは、「変更を適用」を押すまで反映されません。ロック画面とMission Controlの画像は、適用するまで保存済みの見た目のままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "编辑壁纸的属性时，显示器会在你按下“应用修改”之前跟随每一项更改，“还原”会恢复已保存的外观。图片，以及用来开关某个效果的选项，仍要等到“应用修改”才会生效。锁定屏幕和调度中心的画面在你应用之前保持已保存的外观。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "編輯桌布的屬性時，顯示器會在你按下「套用變更」之前跟隨每一項變更，「還原」會恢復已儲存的外觀。圖片，以及用來開關某個效果的選項，仍要等到「套用變更」才會生效。鎖定畫面和指揮中心的畫面在你套用之前會維持已儲存的外觀。"}}}
    },
    "Turns off macOS’s “Click wallpaper to reveal desktop” so clicks reach interactive wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desativa a opção “Clicar no papel de parede para mostrar a mesa” do macOS para que os cliques cheguem aos papéis de parede interativos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "클릭이 상호작용형 배경화면에 전달되도록 macOS의 ‘배경화면을 클릭하여 데스크탑 표시’를 끕니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSの「壁紙をクリックしてデスクトップを表示」をオフにして、クリックがインタラクティブな壁紙に届くようにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭 macOS 的“点按墙纸以显示桌面”，让点击可以传到可交互的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉 macOS 的「按一下背景圖片來顯示桌面」，讓可互動的桌布能接收到滑鼠點按。"}}}
    },
    "Hide desktop icons" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar os ícones da mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 아이콘 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップのアイコンを隠す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏桌面图标"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏桌面圖像"}}}
    },
    "Finder stops showing files, folders and disks on the desktop, so they no longer cover the wallpaper. They stay in your Desktop folder. Finder restarts to apply the change." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Finder deixa de mostrar arquivos, pastas e discos na mesa, então eles não cobrem mais o papel de parede. Eles continuam na sua pasta Mesa. O Finder reinicia para aplicar a mudança."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Finder가 데스크탑에 파일, 폴더, 디스크를 더 이상 표시하지 않으므로 배경화면을 가리지 않습니다. 항목은 데스크탑 폴더에 그대로 남아 있습니다. 변경 사항을 적용하기 위해 Finder가 재시작됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Finderがデスクトップにファイル、フォルダ、ディスクを表示しなくなるため、壁紙が隠れなくなります。項目は「デスクトップ」フォルダに残ります。変更を適用するためにFinderが再起動します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "访达不再在桌面上显示文件、文件夹和磁盘，它们就不会再遮住壁纸。这些项目仍保留在你的“桌面”文件夹中。访达会重新启动以应用此更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Finder 不再於桌面上顯示檔案、檔案夾和磁碟，它們就不會再遮住桌布。這些項目仍保留在你的「桌面」檔案夾中。Finder 會重新啟動以套用此變更。"}}}
    },
    "Restart Finder" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reiniciar o Finder"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Finder 재시작"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Finderを再起動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新启动访达"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新啟動 Finder"}}}
    },
    "Hide the notch" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar o notch"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "노치 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ノッチを隠す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏刘海"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏瀏海"}}}
    },
    "On displays with a camera notch, the menu bar turns black so the notch disappears into it. The rest of the screen still shows the wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em monitores com notch da câmera, a barra de menus fica preta para que o notch desapareça nela. O resto da tela continua mostrando o papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "카메라 노치가 있는 디스플레이에서는 메뉴 막대가 검은색으로 바뀌어 노치가 눈에 띄지 않습니다. 화면의 나머지 부분에는 계속 배경화면이 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "カメラのノッチがあるディスプレイでは、メニューバーが黒くなり、ノッチが目立たなくなります。画面のほかの部分には引き続き壁紙が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在带有摄像头刘海的显示器上，菜单栏会变成黑色，让刘海融入其中。屏幕的其余部分仍显示壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在有相機瀏海的顯示器上，選單列會變成黑色，讓瀏海融入其中。螢幕的其餘部分仍顯示桌布。"}}}
    },
    "Menu bar" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Barra de menus"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "메뉴 막대"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューバー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "菜单栏"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選單列"}}}
    },
    "Hide desktop icons?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar os ícones da mesa?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 아이콘을 가리시겠습니까?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップのアイコンを隠しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要隐藏桌面图标吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要隱藏桌面圖像嗎？"}}}
    },
    "Show desktop icons?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar os ícones da mesa?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 아이콘을 표시하시겠습니까?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップのアイコンを表示しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要显示桌面图标吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要顯示桌面圖像嗎？"}}}
    },
    "Finder restarts to apply this. Let any copy or move in Finder finish first." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Finder reinicia para aplicar isso. Espere terminar qualquer cópia ou movimentação no Finder antes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 변경 사항을 적용하기 위해 Finder가 재시작됩니다. Finder에서 진행 중인 복사나 이동이 있으면 먼저 끝날 때까지 기다리세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この変更を適用するためにFinderが再起動します。Finderでコピーや移動を行っている場合は、先に完了させてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "访达会重新启动以应用此更改。请先等访达中正在进行的拷贝或移动完成。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Finder 會重新啟動以套用此變更。請先等 Finder 中正在進行的拷貝或搬移完成。"}}}
    },
    "Hide Desktop Icons" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar Ícones da Mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 아이콘 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップのアイコンを隠す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏桌面图标"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏桌面圖像"}}}
    },
    "macOS did not accept the change to Finder’s desktop icons." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não aceitou a mudança nos ícones da mesa do Finder."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS가 Finder의 데스크탑 아이콘 변경을 받아들이지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがFinderのデスクトップアイコンの変更を受け付けませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受对访达桌面图标的更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受對 Finder 桌面圖像的變更。"}}}
    },
    "Finder could not be restarted, so the desktop icons change the next time Finder starts." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível reiniciar o Finder, então os ícones da mesa mudam na próxima vez que o Finder for iniciado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Finder를 재시작할 수 없어 데스크탑 아이콘은 다음에 Finder가 시작될 때 바뀝니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Finderを再起動できなかったため、デスクトップアイコンは次にFinderが起動したときに変わります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法重新启动访达，桌面图标将在访达下次启动时更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法重新啟動 Finder，桌面圖像會在 Finder 下次啟動時變更。"}}}
    },
    "Use the wallpaper as the macOS desktop picture" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar o papel de parede como imagem da mesa do macOS"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 macOS 데스크탑 이미지로 사용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をmacOSのデスクトップピクチャとして使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸用作 macOS 桌面图片"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布用作 macOS 桌面圖片"}}}
    },
    "Mission Control and the moment before a wallpaper loads show a still frame of the wallpaper. Turn this off to leave macOS’s own wallpaper settings alone; your own picture comes back at once." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mission Control e o momento antes de um papel de parede carregar mostram um quadro estático do papel de parede. Desative para não mexer nos ajustes de papel de parede do próprio macOS; sua imagem volta na hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mission Control과 배경화면이 로드되기 직전에는 배경화면의 정지 이미지가 표시됩니다. 이 기능을 끄면 macOS 자체의 배경화면 설정을 변경하지 않으며, 원래 사용하던 이미지가 즉시 복원됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlと壁紙の読み込み前の一瞬には、壁紙の静止画が表示されます。オフにすると、WallpaperMachineはmacOS自体の壁紙設定を変更せず、元のデスクトップピクチャがすぐに戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "调度中心以及壁纸加载前的片刻会显示壁纸的静态画面。关闭后，WallpaperMachine 不再改动 macOS 自己的壁纸设置，你自己的桌面图片会立即恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指揮中心以及桌布載入前的片刻會顯示桌布的靜態畫面。關閉後，WallpaperMachine 不再更動 macOS 自己的桌布設定，你自己的桌面圖片會立即恢復。"}}}
    },
    "Animate lock screen sets the desktop picture itself, so this cannot be changed while it is on." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Animar tela bloqueada define a própria imagem da mesa, então isso não pode ser alterado enquanto estiver ativado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘잠금 화면 애니메이션’은 데스크탑 사진을 직접 설정하므로 이 기능이 켜져 있는 동안에는 변경할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ロック画面をアニメーション表示」がオンの間は、デスクトップピクチャがその機能によって設定されるため、この設定は変更できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“锁定屏幕动态壁纸”会自行设置桌面图片，因此它开启期间无法更改此项。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「鎖定畫面動態桌布」會自行設定桌面圖片，因此它開啟期間無法變更此項目。"}}}
    },
    "Update the Mission Control picture every 5 minutes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizar a imagem do Mission Control a cada 5 minutos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "5분마다 Mission Control 이미지 갱신"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlの画像を5分ごとに更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每 5 分钟更新调度中心中的画面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每 5 分鐘更新指揮中心中的畫面"}}}
    },
    "Mission Control shows a still picture of the wallpaper, retaken when it starts, changes or resumes. This also retakes it while it plays. Not used while the lock screen is animated." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mission Control mostra uma imagem estática do papel de parede, recapturada quando ele inicia, muda ou é retomado. Esta opção também a recaptura enquanto ele é reproduzido. Não é usada enquanto a tela bloqueada estiver animada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mission Control에는 배경화면의 정지 이미지가 표시되며, 배경화면이 시작, 변경 또는 재개될 때 다시 캡처합니다. 이 기능을 켜면 재생 중에도 다시 캡처합니다. 잠금 화면 애니메이션이 작동하는 동안에는 사용하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlには壁紙の静止画が表示され、壁紙の開始時、変更時、再開時に撮り直されます。オンにすると再生中にも撮り直します。ロック画面のアニメーション表示中は使われません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "调度中心显示的是壁纸的静态画面，会在壁纸开始、更改或恢复播放时重新截取。打开后，播放期间也会重新截取。锁定屏幕动态壁纸开启时不使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指揮中心顯示的是桌布的靜態畫面，會在桌布開始、變更或恢復播放時重新擷取。開啟後，播放期間也會重新擷取。鎖定畫面動態桌布開啟時不使用。"}}}
    },
    "Animate lock screen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Animar tela bloqueada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 애니메이션"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面をアニメーション表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕动态壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面動態桌布"}}}
    },
    "Experimental" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Experimental"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실험적 기능"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性"}}}
    },
    "Lock screen status" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Status da tela bloqueada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 상태"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面の状態"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面狀態"}}}
    },
    "Updating" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizando"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "更新中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在更新"}}}
    },
    "Experimental. Applies right away." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Experimental. Aplica-se na hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실험적 기능입니다. 즉시 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的機能です。すぐに適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性功能，立即生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性功能，會立即生效。"}}}
    },
    "Compatibility & permissions" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Compatibilidade e permissões"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "호환성 및 권한"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "互換性とアクセス権"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "兼容性与权限"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "相容性與權限"}}}
    },
    "Lock screen animation uses private macOS APIs and may stop working after a macOS update. While it is on, the app takes over only the Desktop wallpaper selection on displays with an applied wallpaper, and reloads the macOS wallpaper service. The screen saver is a separate choice below. Turning this off restores the Desktop choices; quitting restores all choices the app changed and keeps other wallpaper changes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A animação da tela bloqueada usa APIs privadas do macOS e pode parar de funcionar após uma atualização do macOS. Enquanto estiver ativada, o app assume apenas a seleção de papel de parede da Mesa nos monitores com um papel de parede aplicado e recarrega o serviço de papel de parede do macOS. O protetor de tela é uma opção separada abaixo. Desativá-la restaura as opções da Mesa; encerrar o app restaura todas as opções que ele alterou e mantém as outras alterações de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 애니메이션은 macOS 비공개 API를 사용하므로 macOS 업데이트 후 작동하지 않을 수 있습니다. 켜져 있는 동안에는 배경화면이 적용된 디스플레이의 데스크탑 배경화면 선택만 이 앱에서 관리하며, macOS 배경화면 서비스를 다시 불러옵니다. 화면 보호기는 아래에서 별도로 선택합니다. 이 기능을 끄면 데스크탑 선택이 복원됩니다. 앱을 종료하면 이 앱이 변경한 모든 선택이 복원되고, 그 외의 배경화면 변경 사항은 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面のアニメーションはmacOSの非公開APIを使用しているため、macOSのアップデート後に動作しなくなる可能性があります。オンの間は、壁紙を適用しているディスプレイのDesktop（デスクトップ）の壁紙選択だけをこのAppが管理し、macOSの壁紙サービスを再読み込みします。スクリーンセーバは下の設定で個別に選択できます。この機能をオフにするとDesktopの選択が元に戻ります。Appを終了すると、このAppが変更したすべての選択が元に戻り、それ以外の壁紙の変更は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕动画使用 macOS 私有接口，系统更新后可能失效。开启后，本应用只接管已应用壁纸的显示器的 Desktop（桌面）墙纸选项，并重新加载 macOS 墙纸服务。屏幕保护程序可在下方独立设置。关闭此功能会还原桌面选项；退出应用会还原本应用改动的所有选项，并保留其他墙纸更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面動畫使用 macOS 私有 API，macOS 更新後可能會失效。開啟時，本 App 只接管已套用桌布之顯示器的 Desktop（桌面）桌布選項，並重新載入 macOS 桌布服務。螢幕保護程式可在下方獨立設定。關閉此功能會還原桌面選項；結束 App 會還原本 App 變更的所有選項，並保留其他桌布變更。"}}}
    },
    "It keeps separate copies of wallpaper files, which uses extra disk space, and may not render on every macOS version. Pause and battery settings still apply." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ela mantém cópias separadas dos arquivos de papel de parede, o que usa espaço extra em disco, e pode não renderizar em todas as versões do macOS. Os ajustes de pausa e de bateria continuam valendo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 파일의 별도 사본을 보관하므로 추가 디스크 공간을 사용하며, 일부 macOS 버전에서는 표시되지 않을 수 있습니다. 일시 정지 및 배터리 설정은 계속 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ファイルのコピーを別に保持するため、追加のディスク容量を使用します。また、すべてのmacOSバージョンで表示されるとは限りません。一時停止とバッテリーの設定は引き続き適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它会另存一份壁纸文件，需要额外磁盘空间，且不保证在每个 macOS 版本上都能显示。暂停和电池设置同样适用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此功能會另存一份桌布檔案，因此會佔用額外的磁碟空間，且不一定能在每個 macOS 版本上顯示。暫停與電池設定仍然適用。"}}}
    },
    "Screen saver" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Protetor de tela"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 보호기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式"}}}
    },
    "Use wallpaper as screen saver" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar papel de parede como protetor de tela"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 화면 보호기로 사용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をスクリーンセーバに使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸用作屏幕保护程序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布用作螢幕保護程式"}}}
    },
    "Screen saver status" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Status do protetor de tela"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 보호기 상태"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバの状態"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式狀態"}}}
    },
    "Requires macOS 26 or later. Uses each display’s applied wallpaper as its screen saver, including scenes, videos, web wallpapers and still images. This experimental feature uses private macOS APIs and may stop working after an update." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Requer macOS 26 ou posterior. Usa o papel de parede aplicado de cada monitor como protetor de tela, incluindo cenas, vídeos, papéis de parede web e imagens estáticas. Este recurso experimental usa APIs privadas do macOS e pode parar de funcionar após uma atualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26 이상이 필요합니다. 장면, 비디오, 웹 배경화면, 스틸 이미지를 포함하여 각 디스플레이에 적용된 배경화면을 화면 보호기로 사용합니다. 이 실험적 기능은 macOS의 비공개 API를 사용하므로 업데이트 후 작동하지 않을 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26以降が必要です。各ディスプレイに適用中のシーン、ビデオ、Web壁紙、静止画像をスクリーンセーバに使用します。この実験的機能はmacOSの非公開APIを使用しているため、アップデート後に動作しなくなる可能性があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或更高版本。将各显示器当前应用的壁纸用作屏幕保护程序，支持场景、视频、网页壁纸和静态图片。此实验性功能使用 macOS 私有接口，系统更新后可能失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或以上版本。將各顯示器目前套用的桌布用作螢幕保護程式，包含場景、影片、網頁桌布及靜態圖片。此實驗性功能使用 macOS 私有 API，系統更新後可能會失效。"}}}
    },
    "The screen saver choice is independent of lock screen animation. It changes only the Idle wallpaper selection and reloads the macOS wallpaper service. Turning it off restores the previous screen saver without changing the Desktop selection, and keeps screen saver changes made elsewhere. Pause and battery settings still apply." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A opção do protetor de tela é independente da animação da tela bloqueada. Ela altera apenas a seleção de papel de parede em repouso e recarrega o serviço de papel de parede do macOS. Desativá-la restaura o protetor de tela anterior sem alterar a seleção da Mesa e mantém as alterações no protetor de tela feitas em outros lugares. Os ajustes de pausa e de bateria continuam valendo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 보호기 선택은 잠금 화면 애니메이션과 별개입니다. Idle(유휴 상태) 배경화면 선택만 변경하고 macOS 배경화면 서비스를 다시 불러옵니다. 끄면 Desktop(데스크탑) 선택을 변경하지 않고 이전 화면 보호기를 복원하며, 다른 곳에서 변경한 화면 보호기 설정은 유지합니다. 일시 정지 및 배터리 설정은 계속 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバの選択はロック画面のアニメーションとは独立しています。Idle（アイドル時）の壁紙選択だけを変更し、macOSの壁紙サービスを再読み込みします。オフにすると、Desktop（デスクトップ）の選択を変更せずに、以前のスクリーンセーバが復元されます。ほかで行ったスクリーンセーバの変更は保持されます。一時停止とバッテリーの設定は引き続き適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序与锁定屏幕动画可独立选择。此功能只更改 Idle（闲置）墙纸选项，并重新加载 macOS 墙纸服务。关闭后会还原原来的屏幕保护程序，不会更改 Desktop（桌面）选项，并保留你在别处更改的屏幕保护程序设置。暂停和电池设置同样适用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式與鎖定畫面動畫可獨立選擇。此功能只變更 Idle（閒置）桌布選項，並重新載入 macOS 桌布服務。關閉後會還原原本的螢幕保護程式，不會變更 Desktop（桌面）選項，並保留你在其他地方變更的螢幕保護程式設定。暫停與電池設定仍然適用。"}}}
    },
    "Playback" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reprodução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放"}}}
    },
    "When windows cover the desktop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando janelas cobrem a mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "윈도우가 데스크탑을 가릴 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ウインドウがデスクトップを覆っているとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "桌面被窗口盖住时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "視窗遮住桌面時"}}}
    },
    "Covered means windows hide everything but the menu bar and the screen edges. Pause keeps the last frame there. Wallpapers you can’t see at all always pause." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Coberta significa que as janelas escondem tudo, exceto a barra de menus e as bordas da tela. Pausar mantém o último quadro ali. Papéis de parede que você não consegue ver de forma alguma sempre pausam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘가려짐’은 창이 메뉴 막대와 화면 가장자리를 제외한 모든 부분을 가린 상태입니다. 일시 정지하면 마지막 프레임이 그대로 유지됩니다. 전혀 보이지 않는 배경화면은 항상 일시 정지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「覆っている」とは、メニューバーと画面の端以外をウインドウがすべて隠している状態です。「一時停止」では、見えている部分が最後のフレームのまま止まります。まったく見えない壁紙は常に一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "窗口挡住除菜单栏和屏幕边缘以外的全部桌面，就算盖住。选“暂停”时，露出的地方停在最后一帧。完全看不见的壁纸总是会暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "當視窗擋住選單列與螢幕邊緣以外的所有區域，就視為「遮住」。「暫停」會讓露出的部分停在最後一個影格。完全看不到的桌布一律會暫停。"}}}
    },
    "When another app plays sound" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando outro app reproduz som"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱이 소리를 재생할 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppがサウンドを再生しているとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用播放声音时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 播放聲音時"}}}
    },
    "When another app is in front" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando outro app está em primeiro plano"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱이 맨 앞에 있을 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppが最前面にあるとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用位于前台时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 位於前景時"}}}
    },
    "Clicking the desktop brings Finder to the front, so Finder and this app count as the desktop. Mute and Pause work as they do when another app plays sound. Pause on battery applies only on battery: the wallpaper holds its last frame and plays again when you click the desktop or plug in your Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Clicar na mesa traz o Finder para o primeiro plano, por isso o Finder e este app contam como a mesa. Silenciar e Pausar funcionam como quando outro app reproduz som. Pausar na bateria só vale na bateria: o papel de parede mantém o último quadro e volta a rodar quando você clica na mesa ou conecta o Mac à energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑을 클릭하면 Finder가 맨 앞으로 오므로 Finder와 이 앱은 데스크탑으로 간주됩니다. 음소거와 일시 정지는 다른 앱이 소리를 재생할 때와 같이 작동합니다. ‘배터리 사용 시 일시 정지’는 배터리 사용 중에만 적용되며, 배경화면은 마지막 프레임을 유지하다가 데스크탑을 클릭하거나 Mac에 전원을 연결하면 다시 재생됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップをクリックするとFinderが最前面になるため、FinderとこのAppはデスクトップとして扱われます。消音と一時停止は、ほかのAppがサウンドを再生しているときと同じように働きます。「バッテリー駆動中は一時停止」はバッテリー駆動中にだけ働き、壁紙は最後のフレームのまま止まって、デスクトップをクリックするかMacを電源に接続すると再び再生されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点击桌面会让访达来到前台，因此访达和本应用都算作桌面。静音和暂停的效果与其他应用播放声音时相同。“使用电池时暂停”仅在使用电池时生效：壁纸停在最后一帧，点击桌面或为 Mac 接上电源后会继续播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下桌面會讓 Finder 來到前景，因此 Finder 和本 App 都算作桌面。靜音和暫停的效果與其他 App 播放聲音時相同。「使用電池時暫停」僅在使用電池時生效：桌布會停在最後一個影格，按一下桌面或為 Mac 接上電源後會繼續播放。"}}}
    },
    "Pause on battery applies only on battery: the wallpaper holds its last frame and plays again when you click the desktop or plug in your Mac. Clicking the desktop brings Finder to the front, so Finder and this app count as the desktop. Mute and Pause work as they do when another app plays sound." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar na bateria só vale na bateria: o papel de parede mantém o último quadro e volta a rodar quando você clica na mesa ou conecta o Mac à energia. Clicar na mesa traz o Finder para o primeiro plano, por isso o Finder e este app contam como a mesa. Silenciar e Pausar funcionam como quando outro app reproduz som."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘배터리 사용 시 일시 정지’는 배터리 사용 중에만 적용되며, 배경화면은 마지막 프레임을 유지하다가 데스크탑을 클릭하거나 Mac에 전원을 연결하면 다시 재생됩니다. 데스크탑을 클릭하면 Finder가 맨 앞으로 오므로 Finder와 이 앱은 데스크탑으로 간주됩니다. 음소거와 일시 정지는 다른 앱이 소리를 재생할 때와 같이 작동합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「バッテリー駆動中は一時停止」はバッテリー駆動中にだけ働き、壁紙は最後のフレームのまま止まって、デスクトップをクリックするかMacを電源に接続すると再び再生されます。デスクトップをクリックするとFinderが最前面になるため、FinderとこのAppはデスクトップとして扱われます。消音と一時停止は、ほかのAppがサウンドを再生しているときと同じように働きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“使用电池时暂停”仅在使用电池时生效：壁纸停在最后一帧，点击桌面或为 Mac 接上电源后会继续播放。点击桌面会让访达来到前台，因此访达和本应用都算作桌面。静音和暂停的效果与其他应用播放声音时相同。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「使用電池時暫停」僅在使用電池時生效：桌布會停在最後一個影格，按一下桌面或為 Mac 接上電源後會繼續播放。按一下桌面會讓 Finder 來到前景，因此 Finder 和本 App 都算作桌面。靜音和暫停的效果與其他 App 播放聲音時相同。"}}}
    },
    "Reduced quality" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qualidade reduzida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질 낮추기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質"}}}
    },
    "Stop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Parar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "정지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}}
    },
    "Mute silences scene and video wallpapers, and Web wallpapers when page-output mute is available. Pause applies to every wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar emudece papéis de parede de cena e de vídeo, e papéis de parede web quando o silenciamento da saída da página está disponível. Pausar se aplica a todos os papéis de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음소거는 장면 및 동영상 배경화면의 소리를 끄며, 페이지 출력 음소거를 지원하는 웹 배경화면에도 적용됩니다. 일시 정지는 모든 배경화면에 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ミュートはシーンと動画の音を消し、ページ全体のミュートに対応したWeb壁紙にも適用されます。一時停止はすべての壁紙に適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音会关闭场景和视频壁纸的声音；网页壁纸在支持整页静音时也适用。暂停适用于所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音會關閉場景和影片桌布的聲音；網頁桌布在支援整頁靜音時也適用。暫停適用於所有桌布。"}}}
    },
    "Reduce volume" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reduzir volume"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음량 줄이기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "音量を下げる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低音量"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低音量"}}}
    },
    "Reduce volume to" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reduzir o volume para"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "줄일 때의 음량"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "下げたときの音量"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低后的音量"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低後的音量"}}}
    },
    "Each wallpaper plays at this share of its own volume while the other sound lasts; its saved volume is not changed. In Web wallpapers it reaches only the audio and video played through media elements." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cada papel de parede toca nessa proporção do próprio volume enquanto o outro som durar; o volume salvo não é alterado. Em papéis de parede web, vale apenas para o áudio e o vídeo reproduzidos por elementos de mídia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 소리가 재생되는 동안 각 배경화면은 자체 음량의 이 비율로 재생되며, 저장된 음량은 바뀌지 않습니다. 웹 배경화면에서는 미디어 요소로 재생하는 오디오와 동영상에만 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかの音が鳴っている間、各壁紙はそれぞれの音量に対するこの割合で再生されます。保存された音量は変わりません。Web壁紙では、メディア要素で再生されるオーディオとビデオにだけ効きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他声音播放期间，各壁纸按自身音量的这一比例播放，已保存的音量不会改变。对网页壁纸，仅作用于通过媒体元素播放的音频和视频。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他聲音播放期間，各桌布按自身音量的這個比例播放，已儲存的音量不會改變。對網頁桌布，僅作用於透過媒體元素播放的音訊和視訊。"}}}
    },
    "When displays sleep" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando os monitores entram em repouso"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이가 잠자기 상태일 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイがスリープしたとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器休眠时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器進入睡眠時"}}}
    },
    "Stop frees renderer memory and reloads the wallpaper when the display wakes. Pause keeps it loaded." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Parar libera a memória do renderizador e recarrega o papel de parede quando o monitor desperta. Pausar o mantém carregado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘정지’는 렌더러 메모리를 확보하고 디스플레이가 깨어나면 배경화면을 다시 불러옵니다. ‘일시 정지’는 불러온 상태를 유지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「停止」ではレンダラのメモリを解放し、ディスプレイのスリープ解除時に壁紙を再読み込みします。「一時停止」では読み込んだままにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止会释放渲染器占用的内存，显示器唤醒后再重新加载壁纸。暂停则保持已加载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「停止」會釋放渲染器的記憶體，並在顯示器喚醒時重新載入桌布。「暫停」則會讓桌布保持載入。"}}}
    },
    "When the Mac is inactive" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando o Mac estiver inativo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 비활성 상태일 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macを操作していないとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 闲置时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 閒置時"}}}
    },
    "Inactive means no keyboard, mouse or trackpad input for the time you choose. Wallpapers resume at your next input." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inativo significa nenhuma entrada de teclado, mouse ou trackpad pelo tempo que você escolher. Os papéis de parede retomam na sua próxima entrada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "비활성 상태란 선택한 시간 동안 키보드, 마우스 또는 트랙패드 입력이 없는 상태입니다. 다음에 입력하면 배경화면이 재개됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "操作していないとは、選んだ時間のあいだキーボード、マウス、トラックパッドの入力がないことです。次に入力すると壁紙が再開します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "闲置指在你所选的时间内没有键盘、鼠标或触控板输入。你再次输入时，壁纸会恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "閒置是指在你所選的時間內沒有鍵盤、滑鼠或觸控式軌跡板輸入。你再次輸入時，桌布會恢復。"}}}
    },
    "Inactive after" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inativo após"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "비활성 기준 시간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "操作がない時間"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "闲置时长"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "閒置時間"}}}
    },
    "%lld minutes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld minutos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld분"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 分钟"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 分鐘"}}}
    },
    "1 hour" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "1 hora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "1시간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "1 小时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "1 小時"}}}
    },
    "Reduced quality uses the scale and frame rate below instead of your usual quality settings. Pause stops wallpapers until you plug in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qualidade reduzida usa a escala e a taxa de quadros abaixo em vez dos seus ajustes de qualidade habituais. Pausar interrompe os papéis de parede até você conectar o Mac à energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘화질 낮추기’는 평소 화질 설정 대신 아래의 배율과 프레임률을 사용합니다. ‘일시 정지’는 전원을 연결할 때까지 배경화면을 멈춥니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「画質を下げる」では、通常の画質設定の代わりに下のスケールとフレームレートを使用します。「一時停止」では、電源に接続するまで壁紙を停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质会用下方的渲染比例和帧率代替平时的画质设置。暂停会在接上电源前停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「降低畫質」會使用下方的渲染比例與影格率，取代平時的畫質設定。「暫停」會停止桌布，直到接上電源為止。"}}}
    },
    "On battery. Reduced quality is in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na bateria. Qualidade reduzida em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리를 사용 중입니다. 낮은 화질로 실행하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用电池，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用電池，已啟用「降低畫質」。"}}}
    },
    "Low Power Mode is on. Reduced quality is in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia está ativado. Qualidade reduzida em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드가 켜져 있습니다. 화질을 낮춰 실행하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，已啟用「降低畫質」。"}}}
    },
    "The Mac is hot. Reduced quality is in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mac está quente. Qualidade reduzida em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨겁습니다. 낮은 화질을 사용하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，已啟用「降低畫質」。"}}}
    },
    "The battery is low. Reduced quality is in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A bateria está fraca. Qualidade reduzida em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 잔량이 부족합니다. 낮은 화질을 사용하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少なくなっています。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，已啟用「降低畫質」。"}}}
    },
    "The Mac is hot. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mac está quente. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨겁습니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，桌布已暫停。"}}}
    },
    "The Mac is hot. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Mac está quente. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨겁습니다. 배경화면이 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，桌布已停止。"}}}
    },
    "Low Power Mode is on. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia está ativado. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드가 켜져 있습니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，桌布已暫停。"}}}
    },
    "Low Power Mode is on. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O Modo de Pouca Energia está ativado. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드가 켜져 있습니다. 배경화면이 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，桌布已停止。"}}}
    },
    "The battery is low. Wallpapers are paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A bateria está fraca. Os papéis de parede estão pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 잔량이 부족합니다. 배경화면이 일시 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少なくなっています。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，桌布已暫停。"}}}
