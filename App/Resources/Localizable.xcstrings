    },
    "Apply or revert pending edits before saving or applying a property preset." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Apply or revert pending edits before saving or applying a property preset."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを保存または適用する前に、保留中の編集を適用するか、元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存或应用属性预设前，请应用或撤销待处理的编辑。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存或套用屬性預設前，請套用或還原待處理的編輯。"}}}
