    },
    "Bring All to Front" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trazer Todas para a Frente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모두 앞으로 가져오기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Bring All to Front"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてを手前に移動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "前置全部窗口"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將此程式所有視窗移至最前"}}}
    },
    "WallpaperMachine on GitHub" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine no GitHub"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub의 WallpaperMachine"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine on GitHub"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GitHubのWallpaperMachine"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "GitHub 上的 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "GitHub 上的 WallpaperMachine"}}}
    },
    "Release Notes" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Notas da Versão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "릴리스 노트"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Release Notes"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リリースノート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "版本说明"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "版本說明"}}}
    },
    "Report an Issue…" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Relatar um Problema…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "문제 보고…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Report an Issue…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "問題を報告…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "报告问题…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回報問題…"}}}
    },
    "Join Discord" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Entrar no Discord"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Discord 참여하기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Join Discord"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Discordに参加"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "加入 Discord"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加入 Discord"}}}
    },
    "No wallpaper is playing" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede em reprodução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 중인 배경화면 없음"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No wallpaper is playing"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生中の壁紙はありません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在播放的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有正在播放的桌布"}}}
    },
    "Restore recovery could not find the copies it set aside. The restore folder has been kept and nothing has been deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A recuperação da restauração não encontrou as cópias que havia separado. A pasta de restauração foi mantida e nada foi apagado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원을 바로잡는 중에 따로 보관해 둔 사본을 찾을 수 없습니다. 복원 폴더는 그대로 유지되었으며 아무것도 삭제되지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元の修復で、取り置いたコピーが見つかりませんでした。復元用フォルダは保持されており、何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修复恢复时找不到预先留存的副本。恢复文件夹已保留，没有任何内容被删除。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "修復回復時找不到預先留存的副本。回復檔案夾已保留，沒有任何內容被刪除。"}}}
    },
    "A backup restore that did not finish is put right the next time you open WallpaperMachine. Move the library after that." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma restauração de backup que não terminou é corrigida na próxima vez que você abrir o WallpaperMachine. Mova a biblioteca depois disso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완료되지 않은 백업 복원은 다음에 WallpaperMachine을 열 때 바로잡힙니다. 그 후에 보관함을 이동하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "完了しなかったバックアップの復元は、次回WallpaperMachineを開いたときに修復されます。ライブラリの移動はその後に行ってください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未完成的备份恢复会在下次打开 WallpaperMachine 时修复。请在那之后再移动壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未完成的備份回復會在下次開啟 WallpaperMachine 時修復。請在那之後再搬移桌布庫。"}}}
    },
    "Restore recovery needs the drive that holds the wallpaper library. Connect it and open WallpaperMachine again; nothing has been deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A recuperação da restauração precisa do disco que contém a biblioteca de papéis de parede. Conecte-o e abra o WallpaperMachine novamente; nada foi apagado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원을 바로잡으려면 배경화면 보관함이 있는 드라이브가 필요합니다. 드라이브를 연결하고 WallpaperMachine을 다시 여세요. 아무것도 삭제되지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元の修復には壁紙ライブラリがあるドライブが必要です。ドライブを接続して、もう一度WallpaperMachineを開いてください。何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修复恢复需要存放壁纸库的磁盘。请连接它，然后重新打开 WallpaperMachine；没有任何内容被删除。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "修復回復需要存放桌布庫的磁碟。請連接它，然後重新開啟 WallpaperMachine；沒有任何內容被刪除。"}}}
    },
    "WallpaperMachine could not read where your wallpaper library is kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine não conseguiu ler onde sua biblioteca de papéis de parede está guardada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 배경화면 보관함이 저장된 위치를 읽지 못했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは壁紙ライブラリの保存場所を読み取れませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 无法读取壁纸库的存放位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 無法讀取桌布庫的存放位置。"}}}
    },
    "Your wallpaper library is in “%@”, which is not available. Connect the drive that holds it: WallpaperMachine opens the library once it is connected. If it does not, quit and reopen WallpaperMachine. If the drive is connected, allow WallpaperMachine to use removable volumes in System Settings › Privacy & Security › Files and Folders." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sua biblioteca de papéis de parede está em “%@”, que não está disponível. Conecte o disco que a contém: o WallpaperMachine abre a biblioteca assim que ele for conectado. Se ela não abrir, encerre e reabra o WallpaperMachine. Se o disco estiver conectado, permita que o WallpaperMachine use volumes removíveis em Ajustes do Sistema › Privacidade e Segurança › Arquivos e Pastas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함이 “%@”에 있지만 지금 사용할 수 없습니다. 보관함이 있는 드라이브를 연결하세요. 연결되면 WallpaperMachine이 보관함을 엽니다. 열리지 않으면 WallpaperMachine을 종료하고 다시 여세요. 드라이브가 연결되어 있다면 시스템 설정 › 개인정보 보호 및 보안 › 파일 및 폴더에서 WallpaperMachine이 이동식 볼륨을 사용할 수 있도록 허용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリは「%@」にありますが、現在利用できません。ライブラリがあるドライブを接続してください。接続されるとWallpaperMachineがライブラリを開きます。開かない場合は、WallpaperMachineを終了して開き直してください。ドライブが接続されている場合は、システム設定の「プライバシーとセキュリティ」›「ファイルとフォルダ」で、WallpaperMachineにリムーバブルボリュームの使用を許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你的壁纸库位于“%@”，但它现在不可用。请连接存放壁纸库的磁盘：连接后，WallpaperMachine 会打开壁纸库。如果没有打开，请退出并重新打开 WallpaperMachine。如果磁盘已经连接，请在“系统设置”›“隐私与安全性”›“文件与文件夹”中允许 WallpaperMachine 使用可移除的宗卷。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你的桌布庫位於「%@」，但它目前無法使用。請連接存放桌布庫的磁碟：連接後，WallpaperMachine 會開啟桌布庫。如果沒有開啟，請結束並重新開啟 WallpaperMachine。如果磁碟已經連接，請在「系統設定」›「隱私權與安全性」›「檔案與檔案夾」中允許 WallpaperMachine 使用可移除的卷宗。"}}}
    },
    "The current wallpaper library is not available, so it cannot be moved." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca de papéis de parede atual não está disponível, então não pode ser movida."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 배경화면 보관함을 사용할 수 없어 이동할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の壁紙ライブラリが利用できないため、移動できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前的壁纸库不可用，因此无法移动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前的桌布庫無法使用，因此無法搬移。"}}}
    },
    "A move is already waiting for the next launch. Cancel it before choosing another folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Já há uma mudança aguardando a próxima abertura. Cancele-a antes de escolher outra pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 실행 때 진행될 이동이 이미 대기 중입니다. 다른 폴더를 선택하기 전에 취소하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回の起動時に実行される移動がすでにあります。別のフォルダを選ぶ前にキャンセルしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已有一次移动在等待下次启动时完成。请先取消它，再选择其他文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已有一次搬移在等待下次啟動時完成。請先取消它，再選擇其他檔案夾。"}}}
    },
    "Choose a folder that exists." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma pasta que exista."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "존재하는 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "存在するフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择一个存在的文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇一個存在的檔案夾。"}}}
    },
    "Choose a folder outside WallpaperMachine’s own folders." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma pasta fora das pastas do próprio WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 자체 폴더 밖에 있는 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine自身のフォルダの外にあるフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 WallpaperMachine 自身文件夹以外的文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 WallpaperMachine 自身檔案夾以外的檔案夾。"}}}
    },
    "“%@” already has a folder named WallpaperMachine. Choose another folder, or move that one away first." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "“%@” já tem uma pasta chamada WallpaperMachine. Escolha outra pasta ou mova essa pasta para outro lugar primeiro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "“%@”에 이미 WallpaperMachine이라는 폴더가 있습니다. 다른 폴더를 선택하거나 먼저 그 폴더를 다른 곳으로 옮기세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」にはすでにWallpaperMachineという名前のフォルダがあります。別のフォルダを選ぶか、先にそのフォルダを移動してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“%@”中已有名为 WallpaperMachine 的文件夹。请选择其他文件夹，或先把那个文件夹移走。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「%@」中已有名為 WallpaperMachine 的檔案夾。請選擇其他檔案夾，或先把那個檔案夾移走。"}}}
    },
    "The wallpaper library is already on this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca de papéis de parede já está neste Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함이 이미 이 Mac에 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリはすでにこのMacにあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库已经在这台 Mac 上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫已經在這台 Mac 上。"}}}
    },
    "WallpaperMachine’s folder on this Mac already holds “%@”. Move it away, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta do WallpaperMachine neste Mac já contém “%@”. Mova-o para outro lugar e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac의 WallpaperMachine 폴더에 이미 “%@” 항목이 있습니다. 다른 곳으로 옮긴 후 다시 시도하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMac上のWallpaperMachineのフォルダにはすでに「%@」があります。それを移動してから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台 Mac 上的 WallpaperMachine 文件夹中已有“%@”。请把它移走后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這台 Mac 上的 WallpaperMachine 檔案夾中已有「%@」。請把它移走後再試一次。"}}}
    },
    "Not enough free space: the library and downloads need about %@ and only %@ is available there." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Espaço livre insuficiente: a biblioteca e os downloads precisam de cerca de %@ e só há %@ disponível lá."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "여유 공간이 부족합니다. 보관함과 다운로드에는 약 %@이(가) 필요하지만 그곳의 여유 공간은 %@뿐입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "空き容量が足りません：ライブラリとダウンロードには約%@必要ですが、そこには%@しか空きがありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可用空间不足：壁纸库和下载大约需要 %@，而那里只剩 %@ 可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可用空間不足：桌布庫和下載項目大約需要 %@，而那裡只剩 %@ 可用。"}}}
    },
    "Choose a folder on a disk connected to this Mac, not a network share." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma pasta em um disco conectado a este Mac, não um compartilhamento de rede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네트워크 공유가 아닌, 이 Mac에 연결된 디스크의 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネットワーク共有ではなく、このMacに接続されたディスク上のフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择连接到这台 Mac 的磁盘上的文件夹，而不是网络共享。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇連接到這台 Mac 的磁碟上的檔案夾，而不是網路共享。"}}}
    },
    "WallpaperMachine cannot write to this folder. Choose another one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine não pode gravar nesta pasta. Escolha outra."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 이 폴더에 쓸 수 없습니다. 다른 폴더를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineはこのフォルダに書き込めません。別のフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 无法写入这个文件夹。请选择其他文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 無法寫入這個檔案夾。請選擇其他檔案夾。"}}}
    },
    "This disk’s format cannot hold the wallpaper library. Use a disk formatted as APFS or Mac OS Extended." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O formato deste disco não comporta a biblioteca de papéis de parede. Use um disco formatado como APFS ou Mac OS Expandido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스크의 포맷으로는 배경화면 보관함을 저장할 수 없습니다. APFS 또는 Mac OS 확장으로 포맷된 디스크를 사용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスクのフォーマットでは壁紙ライブラリを保存できません。APFSまたはMac OS拡張でフォーマットされたディスクを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个磁盘的格式无法存放壁纸库。请使用格式为 APFS 或 Mac OS 扩展的磁盘。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這個磁碟的格式無法存放桌布庫。請使用格式為 APFS 或 Mac OS 擴充格式的磁碟。"}}}
    },
    "The wallpaper library was not moved: it is no longer where the move started from." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca de papéis de parede não foi movida: ela não está mais onde a mudança começou."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함이 이동되지 않았습니다. 이동을 시작한 위치에 더 이상 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリは移動されませんでした：移動を始めたときの場所にもうありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库未被移动：它已不在开始移动时的位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫未被搬移：它已不在開始搬移時的位置。"}}}
    },
    "The wallpaper library was not moved: “%@” was not available. Connect the drive and choose the folder again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca de papéis de parede não foi movida: “%@” não estava disponível. Conecte o disco e escolha a pasta novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함이 이동되지 않았습니다. “%@”을(를) 사용할 수 없었습니다. 드라이브를 연결하고 폴더를 다시 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリは移動されませんでした：「%@」を利用できませんでした。ドライブを接続して、もう一度フォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库未被移动：“%@”不可用。请连接磁盘，然后重新选择文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫未被搬移：「%@」無法使用。請連接磁碟，然後重新選擇檔案夾。"}}}
    },
    "Could not move “%@” into place: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível mover “%@” para o lugar: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "“%@”을(를) 제자리로 옮길 수 없습니다: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を所定の場所に移動できませんでした：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法将“%@”移动到位：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法將「%@」搬移到位：%@。"}}}
    },
    "Could not read the disk that holds “%@”." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler o disco que contém “%@”."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "“%@”이(가) 있는 디스크를 읽을 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」があるディスクを読み取れませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取存放“%@”的磁盘。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取存放「%@」的磁碟。"}}}
    },
    "Could not copy “%@”: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível copiar “%@”: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "“%@”을(를) 복사할 수 없습니다: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」をコピーできませんでした：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法拷贝“%@”：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法拷貝「%@」：%@。"}}}
    },
    "The wallpaper library is already being copied." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca de papéis de parede já está sendo copiada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 이미 복사하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリはすでにコピー中です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库已在拷贝中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫已在拷貝中。"}}}
    },
    "Wallpaper Library Unavailable" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Biblioteca de Papéis de Parede Indisponível"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 사용할 수 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを利用できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库不可用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫無法使用"}}}
    },
    "Wallpaper library unavailable: the drive that holds “%@” was disconnected, so its wallpapers stopped. They come back when you connect it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Biblioteca de papéis de parede indisponível: o disco que contém “%@” foi desconectado, então os papéis de parede dele pararam. Eles voltam quando você o conectar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 사용할 수 없음: “%@”이(가) 있는 드라이브의 연결이 해제되어 해당 배경화면이 멈췄습니다. 드라이브를 다시 연결하면 배경화면이 돌아옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを利用できません：「%@」があるドライブの接続が解除されたため、その壁紙は停止しました。ドライブをもう一度接続すると元に戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库不可用：存放“%@”的磁盘已断开连接，因此其中的壁纸已停止。重新连接该磁盘后，壁纸会恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫無法使用：存放「%@」的磁碟已中斷連線，因此其中的桌布已停止。重新連接該磁碟後，桌布會恢復。"}}}
    },
    "Use This Mac Instead…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar Este Mac…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대신 이 Mac 사용…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "代わりにこのMacを使用…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "改用这台 Mac…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "改用這台 Mac…"}}}
    },
    "Keep the wallpaper library on this Mac?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Manter a biblioteca de papéis de parede neste Mac?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 이 Mac에 두시겠습니까?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリをこのMacに置きますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要把壁纸库放在这台 Mac 上吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要把桌布庫放在這台 Mac 上嗎？"}}}
    },
    "From the next launch WallpaperMachine keeps its library in its own folder on this Mac, so the wallpapers on the drive are not shown. Nothing on the drive is deleted. WallpaperMachine quits now; open it again afterwards." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A partir da próxima abertura, o WallpaperMachine mantém a biblioteca na própria pasta neste Mac, então os papéis de parede do disco não são mostrados. Nada no disco é apagado. O WallpaperMachine será encerrado agora; abra-o novamente depois."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 실행부터 WallpaperMachine은 이 Mac에 있는 자체 폴더에 보관함을 두므로 드라이브의 배경화면은 표시되지 않습니다. 드라이브에서는 아무것도 삭제되지 않습니다. WallpaperMachine이 지금 종료되며, 그 후 다시 여세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回の起動から、WallpaperMachineはライブラリをこのMac上の自身のフォルダに保存するため、ドライブ上の壁紙は表示されません。ドライブ上のものは何も削除されません。WallpaperMachineは今すぐ終了します。その後、もう一度開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从下次启动起，WallpaperMachine 会把壁纸库放在这台 Mac 上它自己的文件夹中，因此不会显示磁盘上的壁纸。磁盘上的任何内容都不会被删除。WallpaperMachine 现在会退出，之后请重新打开它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從下次啟動起，WallpaperMachine 會把桌布庫放在這台 Mac 上它自己的檔案夾中，因此不會顯示磁碟上的桌布。磁碟上的任何內容都不會被刪除。WallpaperMachine 現在會結束，之後請重新開啟它。"}}}
    },
    "Use This Mac and Quit" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar Este Mac e Encerrar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac 사용 후 종료"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacを使用して終了"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用这台 Mac 并退出"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用這台 Mac 並結束"}}}
    },
    "Move Wallpaper Library" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover Biblioteca de Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを移動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移动壁纸库"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "搬移桌布庫"}}}
    },
    "Choose where to keep the wallpaper library and downloads, such as an external drive. WallpaperMachine creates a folder named WallpaperMachine there." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha onde manter a biblioteca de papéis de parede e os downloads, como um disco externo. O WallpaperMachine cria lá uma pasta chamada WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함과 다운로드를 저장할 위치(예: 외장 드라이브)를 선택하세요. WallpaperMachine이 그곳에 WallpaperMachine이라는 폴더를 만듭니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリとダウンロードの保存先（外部ドライブなど）を選択してください。WallpaperMachineはそこにWallpaperMachineという名前のフォルダを作成します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择存放壁纸库和下载的位置，例如外置硬盘。WallpaperMachine 会在那里创建名为 WallpaperMachine 的文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇存放桌布庫和下載項目的位置，例如外接硬碟。WallpaperMachine 會在那裡建立名為 WallpaperMachine 的檔案夾。"}}}
    },
    "Choose" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选取"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇"}}}
    },
    "WallpaperMachine copies %@ to “%@” now, and you can keep using it meanwhile. The move finishes the next time you open WallpaperMachine, which then deletes the old copy." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine copia %@ para “%@” agora, e você pode continuar usando o app enquanto isso. A mudança termina na próxima vez que você abrir o WallpaperMachine, que então apaga a cópia antiga."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 지금 %@을(를) “%@”(으)로 복사하며, 그동안에도 계속 사용할 수 있습니다. 이동은 다음에 WallpaperMachine을 열 때 완료되고, 그때 이전 사본이 삭제됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは今から%@を「%@」にコピーします。その間も引き続き使用できます。移動は次回WallpaperMachineを開いたときに完了し、その後、古いコピーが削除されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 现在会把 %@ 拷贝到“%@”，在此期间你可以继续使用。移动会在下次打开 WallpaperMachine 时完成，随后删除旧的副本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 現在會把 %@ 拷貝到「%@」，在此期間你可以繼續使用。搬移會在下次開啟 WallpaperMachine 時完成，隨後刪除舊的副本。"}}}
    },
    "The library and downloads move to “%@” the next time you open WallpaperMachine." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca e os downloads vão para “%@” na próxima vez que você abrir o WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함과 다운로드는 다음에 WallpaperMachine을 열 때 “%@”(으)로 이동합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリとダウンロードは、次回WallpaperMachineを開いたときに「%@」に移動します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库和下载会在下次打开 WallpaperMachine 时移动到“%@”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫和下載項目會在下次開啟 WallpaperMachine 時搬移到「%@」。"}}}
    },
    "Move the wallpaper library back to this Mac?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover a biblioteca de papéis de parede de volta para este Mac?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 이 Mac으로 다시 옮기시겠습니까?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリをこのMacに戻しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要把壁纸库移回这台 Mac 吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要把桌布庫搬回這台 Mac 嗎？"}}}
    },
    "Move the wallpaper library?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover a biblioteca de papéis de parede?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함을 이동하시겠습니까?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを移動しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要移动壁纸库吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要搬移桌布庫嗎？"}}}
    },
    "Move" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "搬移"}}}
    },
    "Wallpaper library location" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Local da biblioteca de papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 위치"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリの場所"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫位置"}}}
    },
    "Wallpaper library and downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Biblioteca de papéis de parede e downloads"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 및 다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリとダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库和下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫和下載項目"}}}
    },
    "Installed wallpapers and downloads are kept in this folder, which can be on an external drive. Settings, Steam sign-ins, caches and the files you chose for wallpapers stay on this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os papéis de parede instalados e os downloads ficam nesta pasta, que pode estar em um disco externo. Ajustes, sessões da Steam, caches e os arquivos que você escolheu para papéis de parede ficam neste Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치한 배경화면과 다운로드는 이 폴더에 보관되며, 외장 드라이브에 둘 수도 있습니다. 설정, Steam 로그인, 캐시, 배경화면용으로 선택한 파일은 이 Mac에 남습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールした壁紙とダウンロードはこのフォルダに保存されます。外部ドライブ上のフォルダにもできます。設定、Steamのサインイン、キャッシュ、壁紙用に選択したファイルはこのMacに残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装的壁纸和下载存放在这个文件夹中，它可以位于外置硬盘上。设置、Steam 登录、缓存和你为壁纸选择的文件仍保留在这台 Mac 上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝的桌布和下載項目存放在這個檔案夾中，它可以位於外接硬碟上。設定、Steam 登入、快取和你為桌布選擇的檔案仍保留在這台 Mac 上。"}}}
    },
    "Move…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이동…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移動…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移动…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "搬移…"}}}
    },
    "Move to This Mac…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover para Este Mac…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac으로 이동…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacに移動…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移到这台 Mac…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "搬到這台 Mac…"}}}
    },
    "External drive" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Disco externo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "외장 드라이브"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外部ドライブ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外置硬盘"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "外接硬碟"}}}
    },
    "Cancel move" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar mudança"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이동 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移動をキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消移动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消搬移"}}}
    },
    "Copying the wallpaper library…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiando a biblioteca de papéis de parede…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 복사 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリをコピー中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在拷贝壁纸库…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在拷貝桌布庫…"}}}
    },
    "Ready to move" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pronto para mover"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이동 준비 완료"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移動の準備完了"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已准备好移动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已準備好搬移"}}}
    },
    "Copy progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso da cópia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복사 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コピーの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "拷贝进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "拷貝進度"}}}
    },
    "The library moves to “%@” the next time you open WallpaperMachine. Quit and reopen the app when you are ready; it does not restart on its own." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca vai para “%@” na próxima vez que você abrir o WallpaperMachine. Encerre e reabra o app quando estiver pronto; ele não reinicia sozinho."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함은 다음에 WallpaperMachine을 열 때 “%@”(으)로 이동합니다. 준비가 되면 앱을 종료한 후 다시 여세요. 앱이 자동으로 재시작되지는 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリは次回WallpaperMachineを開いたときに「%@」に移動します。準備ができたらAppを終了して開き直してください。Appが自動で再起動することはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库会在下次打开 WallpaperMachine 时移动到“%@”。准备好后请退出并重新打开应用；应用不会自行重启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫會在下次開啟 WallpaperMachine 時搬移到「%@」。準備好後請結束並重新開啟 App；App 不會自行重新啟動。"}}}
    },
    "The library moves back to this Mac the next time you open WallpaperMachine. Quit and reopen the app when you are ready; it does not restart on its own." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca volta para este Mac na próxima vez que você abrir o WallpaperMachine. Encerre e reabra o app quando estiver pronto; ele não reinicia sozinho."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함은 다음에 WallpaperMachine을 열 때 이 Mac으로 다시 이동합니다. 준비가 되면 앱을 종료한 후 다시 여세요. 앱이 자동으로 재시작되지는 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリは次回WallpaperMachineを開いたときにこのMacに戻ります。準備ができたらAppを終了して開き直してください。Appが自動で再起動することはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库会在下次打开 WallpaperMachine 时移回这台 Mac。准备好后请退出并重新打开应用；应用不会自行重启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫會在下次開啟 WallpaperMachine 時搬回這台 Mac。準備好後請結束並重新開啟 App；App 不會自行重新啟動。"}}}
    },
    "Every setting returns to its default, including appearance, language, shortcuts, playback, performance and app rules. Your library, playlists, collections, displays and sign-ins are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os ajustes voltam ao padrão, incluindo aparência, idioma, atalhos, reprodução, desempenho e regras de apps. Sua biblioteca, playlists, coleções, monitores e sessões iniciadas são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모양, 언어, 단축키, 재생, 성능 및 앱 규칙을 포함한 모든 설정이 기본값으로 돌아갑니다. 보관함, 재생목록, 컬렉션, 디스플레이 및 로그인은 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外観、言語、ショートカット、再生、パフォーマンス、アプリルールを含むすべての設定がデフォルトに戻ります。ライブラリ、プレイリスト、コレクション、ディスプレイ、サインインはそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有设置都会恢复为默认值，包括外观、语言、快捷键、播放、性能和应用规则。资源库、播放列表、收藏夹、显示器和登录状态会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有設定都會恢復為預設值，包括外觀、語言、快速鍵、播放、效能和 App 規則。資料庫、播放列表、收藏集、顯示器和登入狀態會保留。"}}}
    },
    "Reset all settings" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Redefinir todos os ajustes"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 설정 재설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての設定をリセット"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重置所有设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重設所有設定"}}}
    },
    "Reset all settings?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Redefinir todos os ajustes?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 설정을 재설정할까요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての設定をリセットしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要重置所有设置吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要重設所有設定嗎？"}}}
    },
    "Reset…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Redefinir…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재설정…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リセット…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重設…"}}}
    },
    "Restore defaults" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaurar padrões"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기본값 복원"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デフォルトに戻す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复默认设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "恢復預設設定"}}}
    },
    "Returns every setting to its default. Your library, playlists, collections, displays and sign-ins are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Retorna todos os ajustes ao padrão. Sua biblioteca, playlists, coleções, monitores e sessões iniciadas são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 설정을 기본값으로 되돌립니다. 보관함, 재생목록, 컬렉션, 디스플레이 및 로그인 정보는 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての設定をデフォルトに戻します。ライブラリ、プレイリスト、コレクション、ディスプレイ、サインインはそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将所有设置恢复为默认值。资源库、播放列表、收藏夹、显示器和登录状态会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將所有設定恢復為預設值。資料庫、播放列表、收藏集、顯示器和登入狀態會保留。"}}}
    },
    "Show only this tag" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar só esta etiqueta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 태그만 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このタグのみ表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅显示此标签"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅顯示此標籤"}}}
    },
    "Hide this tag" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar esta etiqueta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 태그 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このタグを非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏此标签"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏此標籤"}}}
    },
    "Don't filter by this tag" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não filtrar por esta etiqueta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 태그로 필터링하지 않기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このタグで絞り込まない"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不按此标签筛选"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不依此標籤篩選"}}}
    },
    "Hidden" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Oculta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가려짐"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已隐藏"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已隱藏"}}}
    },
    "Click to show only wallpapers with this tag. Option-click to hide them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Clique para mostrar só papéis de parede com esta etiqueta. Clique com Option para ocultá-los."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "클릭하면 이 태그가 있는 배경화면만 표시합니다. Option 키를 누른 채 클릭하면 숨깁니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "クリックでこのタグの壁紙のみ表示。Option キーを押しながらクリックで非表示。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点按以仅显示带此标签的壁纸。按住 Option 键点按以隐藏它们。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下以僅顯示帶有此標籤的桌布。按住 Option 鍵按一下以隱藏它們。"}}}
    },
    "Details" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Detalhes"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "세부사항"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "詳細"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "详细信息"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "詳細資訊"}}}
    },
    "Like WallpaperMachine?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Gostou do WallpaperMachine?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 마음에 드시나요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを気に入りましたか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "喜欢 WallpaperMachine 吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "喜歡 WallpaperMachine 嗎？"}}}
    },
    "A star on GitHub helps other Mac users find it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma estrela no GitHub ajuda outros usuários de Mac a encontrá-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub에서 별을 누르면 다른 Mac 사용자가 앱을 찾는 데 도움이 됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GitHubでStarを付けると、ほかのMacユーザーが見つけやすくなります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 点个 Star，能让更多 Mac 用户找到它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 GitHub 點個 Star，能讓更多 Mac 使用者找到它。"}}}
    },
    "Opens the project on GitHub." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abre o projeto no GitHub."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GitHub에서 프로젝트를 엽니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GitHubのプロジェクトページを開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 GitHub 上的项目页面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟 GitHub 上的專案頁面。"}}}
    },
    "Join us on Discord?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vamos conversar no Discord?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Discord에서 함께하실래요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Discordに参加しませんか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "来 Discord 和我们聊聊？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "來 Discord 和我們聊聊？"}}}
    },
    "MMFoundation, which makes WallpaperMachine, has a Discord server. Talk with the people who build it and with other users, ask questions and share ideas." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A MMFoundation, que faz o WallpaperMachine, tem um servidor no Discord. Converse com quem o desenvolve e com outros usuários, tire dúvidas e compartilhe ideias."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine을 만드는 MMFoundation에는 Discord 서버가 있습니다. 개발자 및 다른 사용자와 이야기하고, 질문하고, 아이디어를 나눠 보세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを開発しているMMFoundationには、Discordサーバーがあります。開発者やほかのユーザーと話したり、質問したり、アイデアを共有したりできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 的开发组织 MMFoundation 有一个 Discord 服务器。来这里和开发者及其他用户聊天、提问、分享想法。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 的開發組織 MMFoundation 有一個 Discord 伺服器。來這裡和開發者及其他使用者聊天、提問、分享想法。"}}}
    },
    "Opens the invite to MMFoundation’s server." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abre o convite para o servidor da MMFoundation."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "MMFoundation 서버 초대 링크를 엽니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "MMFoundationのサーバーへの招待ページを開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 MMFoundation 服务器的邀请链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟 MMFoundation 伺服器的邀請連結。"}}}
    },
    "Send performance data?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Enviar dados de desempenho?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "성능 데이터를 전송할까요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンスデータを送信しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "发送性能数据？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "傳送效能資料？"}}}
    },
    "It helps find what makes wallpapers slow: how long they take to apply, their frame rate and energy use, and your Mac’s model, sent once a day. No names, files or account details." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Isso ajuda a descobrir o que deixa os papéis de parede lentos: quanto tempo levam para ser aplicados, a taxa de quadros e o consumo de energia deles e o modelo do seu Mac, enviados uma vez por dia. Nenhum nome, arquivo ou dado de conta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 느려지는 원인을 찾는 데 도움이 됩니다. 적용에 걸리는 시간, 프레임률, 에너지 사용량 및 Mac 모델을 하루에 한 번 전송합니다. 이름, 파일 또는 계정 정보는 포함하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙が重くなる原因を探すために使います。壁紙の適用にかかる時間、フレームレート、エネルギー使用量、Macのモデルを1日1回送信します。名前、ファイル、アカウント情報は含みません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "用于找出壁纸变慢的原因：每天发送一次壁纸的应用耗时、帧率和能耗，以及你的 Mac 型号。不包含名称、文件或账户信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "用來找出桌布變慢的原因：每天傳送一次桌布的套用耗時、影格率和能源用量，以及你的 Mac 機型。不包含名稱、檔案或帳號資訊。"}}}
    },
    "Send performance data" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Enviar dados de desempenho"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "성능 데이터 전송"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンスデータを送信"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "发送性能数据"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "傳送效能資料"}}}
    },
    "You can turn it off in Settings › Storage." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Você pode desativar isso em Ajustes › Armazenamento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 › 저장 공간에서 끌 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「設定」›「ストレージ」でオフにできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可以在“设置 › 存储”中关闭。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可以在「設定 › 儲存空間」中關閉。"}}}
    },
    "What is sent" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O que é enviado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전송되는 항목"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "送信される内容"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "会发送哪些数据"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "會傳送哪些資料"}}}
    },
    "Share…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Compartilhar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "分享…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "分享…"}}}
    },
    "Sends once a day: how long wallpapers take to apply, their frame rate and energy use, how the app quit, your Mac’s model, and the Workshop ids of the wallpapers measured. No names, files or account details. Turning it off asks for the sent data to be deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Envia uma vez por dia: quanto tempo os papéis de parede levam para ser aplicados, a taxa de quadros e o consumo de energia deles, como o app foi encerrado, o modelo do seu Mac e os IDs do Workshop dos papéis de parede medidos. Nenhum nome, arquivo ou dado de conta. Desativar isso solicita a exclusão dos dados enviados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "하루에 한 번 배경화면 적용 시간, 프레임률과 에너지 사용량, 앱의 종료 방식, Mac 모델 및 측정한 배경화면의 창작마당 ID를 전송합니다. 이름, 파일 및 계정 정보는 포함되지 않습니다. 이 기능을 끄면 전송된 데이터의 삭제를 요청합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1日1回、壁紙の適用にかかる時間、フレームレート、エネルギー使用量、アプリの終了のしかた、Macのモデル、計測した壁紙のワークショップIDを送信します。名前、ファイル、アカウント情報は含みません。オフにすると、送信済みのデータの削除を依頼します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每天发送一次：壁纸的应用耗时、帧率和能耗，应用的退出方式，你的 Mac 型号，以及被测壁纸的创意工坊 ID。不包含名称、文件或账户信息。关闭后会请求删除已发送的数据。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每天傳送一次：桌布的套用耗時、影格率和能源用量，App 的結束方式，你的 Mac 機型，以及受測桌布的工作坊 ID。不包含名稱、檔案或帳號資訊。關閉後會要求刪除已傳送的資料。"}}}
    },
    "Data to be sent" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dados a enviar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전송할 데이터"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "送信予定のデータ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "待发送的数据"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "待傳送的資料"}}}
    },
    "Last sent on %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Último envio em %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "마지막 전송: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最終送信日：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上次发送于 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上次傳送於 %@。"}}}
    },
    "Nothing sent yet." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nada enviado ainda."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 전송한 내용이 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まだ送信していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未发送。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未傳送。"}}}
    },
    "Spread the word" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Divulgue"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "널리 알리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "紹介する"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "推荐给朋友"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "推薦給朋友"}}}
    },
    "Share WallpaperMachine…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Compartilhar WallpaperMachine…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 공유…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを共有…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "分享 WallpaperMachine…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "分享 WallpaperMachine…"}}}
    },
    "Sends load times, frame rate, energy use and your Mac’s model once a day, to find what makes wallpapers slow. No names, files or account details." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Envia tempos de carregamento, taxa de quadros, consumo de energia e o modelo do seu Mac uma vez por dia, para descobrir o que deixa os papéis de parede lentos. Nenhum nome, arquivo ou dado de conta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 느려지는 원인을 찾기 위해 하루에 한 번 불러오기 시간, 프레임률, 에너지 사용량 및 Mac 모델을 전송합니다. 이름, 파일 및 계정 정보는 포함되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込み時間、フレームレート、エネルギー使用量、Macのモデルを1日1回送信し、壁紙が重くなる原因を探します。名前、ファイル、アカウント情報は含みません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每天发送一次加载耗时、帧率、能耗和你的 Mac 型号，用于找出壁纸变慢的原因。不包含名称、文件或账户信息。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每天傳送一次載入耗時、影格率、能源用量和你的 Mac 機型，用來找出桌布變慢的原因。不包含名稱、檔案或帳號資訊。"}}}
    },
    "Plays on a Mac with WallpaperMachine: %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Roda em um Mac com o WallpaperMachine: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac에서 WallpaperMachine으로 재생 가능: %@"}}, "en": {"stringUnit": {"state": "translated", "value": "Plays on a Mac with WallpaperMachine: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "用 WallpaperMachine 在 Mac 上播放：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "用 WallpaperMachine 在 Mac 上播放：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "WallpaperMachineでMacで再生できます：%@"}}}},
    "Wallpaper Engine wallpapers, now on macOS." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede do Wallpaper Engine, agora no macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이제 macOS에서도 Wallpaper Engine 배경화면을 사용하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine wallpapers, now on macOS."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine 壁纸，现已来到 macOS。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "Wallpaper Engine 桌布，現已登上 macOS。"}}, "ja": {"stringUnit": {"state": "translated", "value": "Wallpaper Engineの壁紙が、macOSで使えます。"}}}},
    "The data to be sent could not be written: %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível gravar os dados a enviar: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전송할 데이터를 기록할 수 없습니다: %@"}}, "en": {"stringUnit": {"state": "translated", "value": "The data to be sent could not be written: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法写入待发送的数据：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法寫入待傳送的資料：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "送信予定のデータを書き出せませんでした：%@"}}}},
    "Quitting…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Encerrando…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "종료 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Quitting…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在退出…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在結束…"}}, "ja": {"stringUnit": {"state": "translated", "value": "終了しています…"}}}},
    "WallpaperMachine did not quit because restoring the desktop picture took too long. The app is still running; quit again to retry." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine não foi encerrado porque restaurar a imagem da mesa demorou demais. O app continua aberto; encerre novamente para tentar de novo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 이미지 복원에 너무 오래 걸려 WallpaperMachine을 종료하지 못했습니다. 앱은 계속 실행 중입니다. 다시 종료하여 재시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "WallpaperMachine did not quit because restoring the desktop picture took too long. The app is still running; quit again to retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复桌面壁纸用时过长，WallpaperMachine 未能退出。应用仍在运行；请再次尝试退出。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "還原桌面桌布耗時過久，WallpaperMachine 未能結束。App 仍在執行；請再次嘗試結束。"}}, "ja": {"stringUnit": {"state": "translated", "value": "デスクトップの壁紙の復元に時間がかかりすぎたため、WallpaperMachineを終了できませんでした。Appは引き続き実行中です。もう一度終了を試してください。"}}}},
    "“%@” was not restored: WallpaperMachine quit unexpectedly twice in a row while loading it. Nothing was deleted." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "“%@” não foi restaurado: o WallpaperMachine fechou inesperadamente duas vezes seguidas ao carregá-lo. Nada foi apagado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’을(를) 복원하지 않았습니다. 불러오는 동안 WallpaperMachine이 두 번 연속 예기치 않게 종료되었습니다. 아무것도 삭제되지 않았습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "“%@” was not restored: WallpaperMachine quit unexpectedly twice in a row while loading it. Nothing was deleted."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "“%@”未恢复：加载它时 WallpaperMachine 连续两次意外退出。没有删除任何内容。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "「%@」未還原：載入它時 WallpaperMachine 連續兩次意外結束。沒有刪除任何內容。"}}, "ja": {"stringUnit": {"state": "translated", "value": "「%@」は復元されませんでした：読み込み中に WallpaperMachine が2回続けて予期せず終了しました。何も削除されていません。"}}}},
    "A wallpaper was held back after a crash" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um papel de parede foi retido após uma falha"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "충돌 후 배경화면 복원이 보류되었습니다"}}, "en": {"stringUnit": {"state": "translated", "value": "A wallpaper was held back after a crash"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "崩溃后有一张壁纸暂未恢复"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "當機後有一張桌布暫未還原"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラッシュ後に壁紙を1つ復元せず保留しました"}}}},
    "Turn off animated lock-screen wallpaper before using Space-based wallpaper choices." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desative o papel de parede animado na tela bloqueada antes de usar escolhas de papel de parede por Space."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 공간별 배경화면을 사용하기 전에 움직이는 잠금 화면 배경화면을 끄세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Turn off animated lock-screen wallpaper before using Space-based wallpaper choices."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先关闭动态锁屏壁纸，再使用按桌面空间选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先關閉動態鎖定畫面桌布，再使用依桌面空間選擇桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "スペースごとの壁紙を使う前に、動くロック画面の壁紙をオフにしてください。"}}}},
    "Desktop Space information is unavailable. Refresh Spaces or choose another automatic mode." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As informações dos Spaces da mesa não estão disponíveis. Atualize os Spaces ou escolha outro modo automático."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 공간 정보를 사용할 수 없습니다. Spaces를 새로 고치거나 다른 자동 모드를 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Desktop Space information is unavailable. Refresh Spaces or choose another automatic mode."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂时无法读取桌面空间信息。请刷新空间列表，或选择其他自动切换模式。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫時無法讀取桌面空間資訊。請重新整理空間列表，或選擇其他自動切換模式。"}}, "ja": {"stringUnit": {"state": "translated", "value": "デスクトップスペースの情報を取得できません。スペースを更新するか、別の自動モードを選んでください。"}}}},
    "Choose another automatic wallpaper mode for your displays before enabling animated lock-screen wallpaper." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha outro modo automático de papel de parede para seus monitores antes de ativar o papel de parede animado na tela bloqueada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 배경화면 애니메이션을 켜기 전에 디스플레이에 다른 자동 배경화면 모드를 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Choose another automatic wallpaper mode for your displays before enabling animated lock-screen wallpaper."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先为显示器选择其他自动壁纸模式，再开启动态锁屏壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先為顯示器選擇其他自動桌布模式，再開啟動態鎖定畫面桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "動くロック画面の壁紙を有効にする前に、各ディスプレイで別の自動壁紙モードを選んでください。"}}}},
    "Display layout" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Disposição dos monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 레이아웃"}}, "en": {"stringUnit": {"state": "translated", "value": "Display layout"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "多屏壁纸方案"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "多螢幕桌布方案"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙セット"}}}},
    "Apply Display Layout" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Disposição dos Monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 레이아웃 적용"}}, "en": {"stringUnit": {"state": "translated", "value": "Apply Display Layout"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用多屏壁纸方案"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用多螢幕桌布方案"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙セットを適用"}}}},
    "Restores saved wallpaper choices across independent displays. All saved displays and wallpapers must be available." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaura as escolhas de papel de parede salvas nos monitores independentes. Todos os monitores e papéis de parede salvos precisam estar disponíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "독립 디스플레이에 저장된 배경화면 선택 내용을 복원합니다. 저장된 모든 디스플레이와 배경화면을 사용할 수 있어야 합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Restores saved wallpaper choices across independent displays. All saved displays and wallpapers must be available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复各独立显示器上保存的壁纸搭配。方案中的所有显示器和壁纸都必须可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "還原各獨立顯示器上儲存的桌布搭配。方案中的所有顯示器和桌布都必須可用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "独立したディスプレイに保存済みの壁紙セットを復元します。保存したすべてのディスプレイと壁紙が利用可能である必要があります。"}}}},
    "This display layout is invalid or exceeds the limit of 64 layouts and 64 displays per layout." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta disposição dos monitores é inválida ou excede o limite de 64 disposições e 64 monitores por disposição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이 레이아웃이 유효하지 않거나, 레이아웃 64개 및 레이아웃당 디스플레이 64대 한도를 초과합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This display layout is invalid or exceeds the limit of 64 layouts and 64 displays per layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此多屏壁纸方案无效，或超出最多 64 套方案、每套 64 台显示器的限制。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此多螢幕桌布方案無效，或超出最多 64 套方案、每套 64 台顯示器的限制。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この壁紙セットは無効か、最大64セット・1セットあたり64台の制限を超えています。"}}}},
    "This display layout no longer exists. Choose another layout." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta disposição dos monitores não existe mais. Escolha outra disposição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이 레이아웃이 더 이상 존재하지 않습니다. 다른 레이아웃을 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "This display layout no longer exists. Choose another layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此多屏壁纸方案已不存在。请选择其他方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此多螢幕桌布方案已不存在。請選擇其他方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この壁紙セットは削除されています。別のセットを選んでください。"}}}},
    "Apply a wallpaper to an enabled independent display before saving or copying a layout." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplique um papel de parede a um monitor independente ativado antes de salvar ou copiar uma disposição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃을 저장하거나 복사하기 전에 활성화된 독립 디스플레이에 배경화면을 적용하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Apply a wallpaper to an enabled independent display before saving or copying a layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先在已启用的独立显示器上应用壁纸，再保存或复制方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先在已啟用的獨立顯示器上套用桌布，再儲存或複製方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "セットの保存やコピーの前に、有効な独立ディスプレイに壁紙を適用してください。"}}}},
    "Choose two different independent displays." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha dois monitores independentes diferentes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "서로 다른 독립 디스플레이 두 대를 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Choose two different independent displays."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择两台不同的独立显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇兩台不同的獨立顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "異なる2台の独立ディスプレイを選んでください。"}}}},
    "The display assignments changed. Review the displays and try again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As atribuições dos monitores mudaram. Revise os monitores e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 할당이 변경되었습니다. 디스플레이를 확인하고 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The display assignments changed. Review the displays and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示器的壁纸分配已改变。请检查各屏幕后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "顯示器的桌布分配已變更。請檢查各螢幕後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイの壁紙割り当てが変わりました。各画面を確認して再試行してください。"}}}},
    "Apply or revert wallpaper edits before changing a display layout." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplique ou reverta as edições do papel de parede antes de alterar uma disposição dos monitores."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 레이아웃을 변경하기 전에 배경화면 편집 내용을 적용하거나 되돌리세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Apply or revert wallpaper edits before changing a display layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先应用或还原壁纸编辑，再切换多屏壁纸方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先套用或還原桌布編輯，再切換多螢幕桌布方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙の編集を適用するか元に戻してから、壁紙セットを変更してください。"}}}},
    "Enable at least one independent display before applying a wallpaper to all displays." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ative pelo menos um monitor independente antes de aplicar um papel de parede a todos os monitores."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 디스플레이에 배경화면을 적용하기 전에 독립 디스플레이를 하나 이상 활성화하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Enable at least one independent display before applying a wallpaper to all displays."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先启用至少一台独立显示器，再将壁纸应用到所有显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先啟用至少一台獨立顯示器，再將桌布套用到所有顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのディスプレイに壁紙を適用する前に、独立ディスプレイを1台以上有効にしてください。"}}}},
    "On all displays" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em todos os monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 디스플레이에서 사용 중"}}, "en": {"stringUnit": {"state": "translated", "value": "On all displays"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "所有显示器"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "所有顯示器"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのディスプレイ"}}}},
    "The display “%@” is disconnected, disabled or mirrored. Connect and enable it as an independent display." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O monitor “%@” está desconectado, desativado ou espelhado. Conecte-o e ative-o como monitor independente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 ‘%@’의 연결이 끊겼거나 비활성화되었거나 미러링 중입니다. 연결한 후 독립 디스플레이로 활성화하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The display “%@” is disconnected, disabled or mirrored. Connect and enable it as an independent display."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示器“%@”已断开、被禁用或正在镜像。请连接并启用为独立显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "顯示器「%@」已中斷連線、被停用或正在鏡像。請連線並啟用為獨立顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイ「%@」は未接続、無効、またはミラーリング中です。接続して独立ディスプレイとして有効にしてください。"}}}},
    "The wallpaper “%@” is unavailable. Restore it to the library before applying this layout." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede “%@” não está disponível. Restaure-o na biblioteca antes de aplicar esta disposição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 ‘%@’을(를) 사용할 수 없습니다. 이 레이아웃을 적용하기 전에 보관함에 복원하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The wallpaper “%@” is unavailable. Restore it to the library before applying this layout."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸“%@”不可用。请先将其恢复到壁纸库，再应用此方案。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布「%@」無法使用。請先將其還原到桌布庫，再套用此方案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙「%@」を利用できません。ライブラリに戻してから、このセットを適用してください。"}}}},
    "The layout could not be applied. Previous wallpapers were restored. %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível aplicar a disposição. Os papéis de parede anteriores foram restaurados. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃을 적용할 수 없습니다. 이전 배경화면을 복원했습니다. %@"}}, "en": {"stringUnit": {"state": "translated", "value": "The layout could not be applied. Previous wallpapers were restored. %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "方案应用失败，已恢复原来的壁纸。%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "方案套用失敗，已還原原來的桌布。%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "セットを適用できませんでした。元の壁紙に復元しました。%@"}}}},
    "The layout could not be completed or fully restored on: %@. Review these displays before retrying. %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível concluir nem restaurar totalmente a disposição em: %@. Revise esses monitores antes de tentar novamente. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 디스플레이에서 레이아웃 적용이나 전체 복원을 완료할 수 없습니다: %@. 다시 시도하기 전에 해당 디스플레이를 확인하세요. %@"}}, "en": {"stringUnit": {"state": "translated", "value": "The layout could not be completed or fully restored on: %@. Review these displays before retrying. %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "方案未能完成应用，且以下显示器未能完全恢复：%@。请检查这些屏幕后重试。%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "方案未能完成套用，且以下顯示器未能完全還原：%@。請檢查這些螢幕後重試。%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "次のディスプレイで適用または復元を完了できませんでした：%@。再試行する前に確認してください。%@"}}}},
    "Use wallpaper" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 사용"}}, "en": {"stringUnit": {"state": "translated", "value": "Use wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用指定壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用指定桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙を指定"}}}},
    "Use saved playlist" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usar playlist salva"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록 사용"}}, "en": {"stringUnit": {"state": "translated", "value": "Use saved playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストを使用"}}}},
    "The automatic wallpaper target display is unavailable." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O monitor de destino do papel de parede automático não está disponível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자동 배경화면의 대상 디스플레이를 사용할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The automatic wallpaper target display is unavailable."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动切换的目标显示器不可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動切換的目標顯示器無法使用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動切り替え先のディスプレイを使用できません。"}}}},
    "The wallpaper chosen by this rule is no longer available." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede escolhido por esta regra não está mais disponível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 규칙에서 선택한 배경화면을 더 이상 사용할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The wallpaper chosen by this rule is no longer available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此规则选择的壁纸已不可用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此規則選擇的桌布已無法使用。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このルールで選んだ壁紙は使用できなくなりました。"}}}},
    "Apply Saved Playlist" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Playlist Salva"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록 적용"}}, "en": {"stringUnit": {"state": "translated", "value": "Apply Saved Playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストを適用"}}}},
    "Apply Playlist" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Playlist"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록 적용"}}, "en": {"stringUnit": {"state": "translated", "value": "Apply Playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレイリストを適用"}}}},
    "Apply Wallpaper Property Preset" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Predefinição de Propriedades do Papel de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 속성 프리셋 적용"}}, "en": {"stringUnit": {"state": "translated", "value": "Apply Wallpaper Property Preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用壁纸属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用桌布屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プロパティプリセットを適用"}}}},
    "Apply Property Preset" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Predefinição de Propriedades"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋 적용"}}, "en": {"stringUnit": {"state": "translated", "value": "Apply Property Preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "套用屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "プロパティプリセットを適用"}}}},
    "Copies a saved playlist to a display. Playback starts when that display can play." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copia uma playlist salva para um monitor. A reprodução começa quando esse monitor puder reproduzir."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록을 디스플레이에 복사합니다. 해당 디스플레이에서 재생할 수 있게 되면 재생이 시작됩니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Copies a saved playlist to a display. Playback starts when that display can play."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将已存播放列表复制到显示器，在该显示器能够播放时开始播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將已存播放列表複製到顯示器，在該顯示器能夠播放時開始播放。"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリストをディスプレイにコピーします。そのディスプレイで再生可能になると再生が始まります。"}}}},
    "Applies saved properties to their wallpaper on every display using it. Unapplied edits must be applied or reverted first." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplica as propriedades salvas ao papel de parede correspondente em todos os monitores que o usam. Edições não aplicadas precisam ser aplicadas ou revertidas antes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "해당 배경화면을 사용하는 모든 디스플레이에 저장된 속성을 적용합니다. 아직 적용하지 않은 편집 내용은 먼저 적용하거나 되돌려야 합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Applies saved properties to their wallpaper on every display using it. Unapplied edits must be applied or reverted first."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将已存属性应用到所有显示器上的对应壁纸。请先应用或还原尚未应用的编辑。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將已存屬性套用到所有顯示器上的對應桌布。請先套用或還原尚未套用的編輯。"}}, "ja": {"stringUnit": {"state": "translated", "value": "同じ壁紙を使うすべてのディスプレイに保存済みのプロパティを適用します。未適用の編集は先に適用するか、元に戻してください。"}}}},
    "Saved playlist" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlist salva"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록"}}, "en": {"stringUnit": {"state": "translated", "value": "Saved playlist"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存播放列表"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已存播放列表"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みプレイリスト"}}}},
    "Property preset" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋"}}, "en": {"stringUnit": {"state": "translated", "value": "Property preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "プロパティプリセット"}}}},
    "Wallpaper property preset" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades do papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 속성 프리셋"}}, "en": {"stringUnit": {"state": "translated", "value": "Wallpaper property preset"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸属性预设"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布屬性預設"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プロパティプリセット"}}}},
    "Choose a saved playlist for this Focus filter." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha uma playlist salva para este filtro de Foco."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 집중 모드 필터에 사용할 저장된 재생목록을 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Choose a saved playlist for this Focus filter."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请为此专注模式过滤条件选择已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請為此專注模式過濾條件選擇已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モードフィルタで使う保存済みプレイリストを選んでください。"}}}},
    "Choose a wallpaper for this Focus filter." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um papel de parede para este filtro de Foco."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 집중 모드 필터에 사용할 배경화면을 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Choose a wallpaper for this Focus filter."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请为此专注模式过滤条件选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請為此專注模式過濾條件選擇桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モードフィルタで使う壁紙を選んでください。"}}}},
    "Pause, mute or stop wallpapers, or temporarily use a wallpaper or saved playlist while this Focus is on." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pause, silencie ou pare os papéis de parede, ou use temporariamente um papel de parede ou uma playlist salva enquanto este Foco estiver ativado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 집중 모드가 켜져 있는 동안 배경화면을 일시 정지하거나 소리를 끄거나 중지하거나, 배경화면 또는 저장된 재생목록을 임시로 사용합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Pause, mute or stop wallpapers, or temporarily use a wallpaper or saved playlist while this Focus is on."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在此专注模式开启时，暂停、静音或停止壁纸，或者临时使用指定壁纸或已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在此專注模式開啟時，暫停、靜音或停止桌布，或者暫時使用指定桌布或已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この集中モード中に壁紙を一時停止・消音・停止するか、指定した壁紙や保存済みプレイリストを一時的に使用します。"}}}},
    "Choose a valid display, time, weekday and wallpaper or saved playlist." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um monitor, horário, dia da semana e papel de parede ou playlist salva válidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "유효한 디스플레이, 시각, 요일과 배경화면 또는 저장된 재생목록을 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Choose a valid display, time, weekday and wallpaper or saved playlist."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择有效的显示器、时间、星期和壁纸或已存播放列表。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇有效的顯示器、時間、星期和桌布或已存播放列表。"}}, "ja": {"stringUnit": {"state": "translated", "value": "有効なディスプレイ、時刻、曜日、壁紙または保存済みプレイリストを選んでください。"}}}},
    "Some automatic wallpaper settings could not be read. Check your rules and Focus choices before using them." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler alguns ajustes de papel de parede automático. Verifique suas regras e escolhas de Foco antes de usá-los."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일부 자동 배경화면 설정을 읽지 못했습니다. 사용하기 전에 규칙과 집중 모드 선택 내용을 확인하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Some automatic wallpaper settings could not be read. Check your rules and Focus choices before using them."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分自动切换设置无法读取。请先检查规则和专注模式的选择。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分自動切換設定無法讀取。請先檢查規則和專注模式的選擇。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動切り替え設定の一部を読み込めませんでした。使用前にルールと集中モードの選択内容を確認してください。"}}}},
    "This preset’s wallpaper is no longer installed." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede desta predefinição não está mais instalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋의 배경화면이 더 이상 설치되어 있지 않습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This preset’s wallpaper is no longer installed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此预设对应的壁纸已不在库中。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此預設對應的桌布已不在庫中。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このプリセットの壁紙はインストールされていません。"}}}},
    "Unmute" : {"localizations":{"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativar som"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "소리 켜기"}}, "en":{"stringUnit":{"state":"translated","value":"Unmute"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消静音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消靜音"}},"ja":{"stringUnit":{"state":"translated","value":"消音を解除"}}}},
    "Preview loading was cancelled. Try again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O carregamento da pré-visualização foi cancelado. Tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 불러오기가 취소되었습니다. 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Preview loading was cancelled. Try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览加载已取消。请重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽載入已取消。請重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの読み込みがキャンセルされました。再試行してください。"}}}},
    "The preview did not become ready within 30 seconds. Try another wallpaper or reload the preview." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pré-visualização não ficou pronta em 30 segundos. Tente outro papel de parede ou recarregue a pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "30초 이내에 미리보기가 준비되지 않았습니다. 다른 배경화면을 선택하거나 미리보기를 다시 불러오세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The preview did not become ready within 30 seconds. Try another wallpaper or reload the preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览在 30 秒内未能准备好。请尝试其他壁纸，或重新载入预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽在 30 秒內未能準備好。請嘗試其他桌布，或重新載入預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "30秒以内にプレビューを準備できませんでした。別の壁紙を選ぶか、プレビューを再読み込みしてください。"}}}},
    "Metal rendering is unavailable for this preview." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A renderização Metal não está disponível para esta pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 미리보기에서는 Metal 렌더링을 사용할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Metal rendering is unavailable for this preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此预览无法使用 Metal 渲染。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此預覽無法使用 Metal 算繪。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このプレビューではMetalレンダリングを利用できません。"}}}},
    "The preview renderer could not start." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível iniciar o renderizador da pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 렌더러를 시작할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The preview renderer could not start."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览渲染器无法启动。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽算繪器無法啟動。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューレンダラを起動できませんでした。"}}}},
    "WebKit cannot provide muted playback for this preview." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WebKit não consegue oferecer reprodução sem som para esta pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WebKit에서 이 미리보기를 소리 없이 재생할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "WebKit cannot provide muted playback for this preview."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "WebKit 无法为此预览提供静音播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "WebKit 無法為此預覽提供靜音播放。"}}, "ja": {"stringUnit": {"state": "translated", "value": "WebKitでこのプレビューを消音再生できません。"}}}},
    "This wallpaper type cannot be previewed." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este tipo de papel de parede não pode ser pré-visualizado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 유형은 미리보기를 제공할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This wallpaper type cannot be previewed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此类壁纸无法预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此類桌布無法預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "この種類の壁紙はプレビューできません。"}}}},
    "The preview inputs are invalid. Refresh the library and try again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os dados da pré-visualização são inválidos. Atualize a biblioteca e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 입력이 유효하지 않습니다. 보관함을 새로 고침하고 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The preview inputs are invalid. Refresh the library and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览数据无效。请刷新壁纸库后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽資料無效。請重新整理桌布庫後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューのデータが無効です。ライブラリを更新して再試行してください。"}}}},
    "The wallpaper files changed or are missing. Refresh the library before previewing." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os arquivos do papel de parede mudaram ou estão ausentes. Atualize a biblioteca antes de pré-visualizar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 파일이 변경되었거나 없습니다. 미리보기를 보기 전에 보관함을 새로 고침하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The wallpaper files changed or are missing. Refresh the library before previewing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸文件已变化或缺失。请刷新壁纸库后再预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布檔案已變更或遺失。請重新整理桌布庫後再預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙ファイルが変更されたか見つかりません。ライブラリを更新してからプレビューしてください。"}}}},
    "The preview entry file is missing or outside this wallpaper folder." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo de entrada da pré-visualização está ausente ou fora da pasta deste papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 진입 파일이 없거나 이 배경화면 폴더 외부에 있습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The preview entry file is missing or outside this wallpaper folder."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览入口文件缺失，或位于此壁纸文件夹之外。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽入口檔案遺失，或位於此桌布資料夾之外。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの開始ファイルがないか、壁紙フォルダの外にあります。"}}}},
    "Install Wallpaper Engine’s shared scene resources before previewing a scene wallpaper." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Instale os recursos de cena compartilhados do Wallpaper Engine antes de pré-visualizar um papel de parede de cena."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 배경화면을 미리보기 전에 Wallpaper Engine의 공유 장면 리소스를 설치하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Install Wallpaper Engine’s shared scene resources before previewing a scene wallpaper."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览场景壁纸前，请先安装 Wallpaper Engine 共享场景资源。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽場景桌布前，請先安裝 Wallpaper Engine 共用場景資源。"}}, "ja": {"stringUnit": {"state": "translated", "value": "シーン壁紙をプレビューする前にWallpaper Engineの共有シーンリソースをインストールしてください。"}}}},
    "Wallpaper Preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualização do Papel de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 미리보기"}}, "en": {"stringUnit": {"state": "translated", "value": "Wallpaper Preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙プレビュー"}}}},
    "Reload preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recarregar pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 다시 불러오기"}}, "en": {"stringUnit": {"state": "translated", "value": "Reload preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新载入预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新載入預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再読み込み"}}}},
    "Reload with the current wallpaper options." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recarregar com as opções atuais do papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 배경화면 옵션으로 다시 불러옵니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Reload with the current wallpaper options."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用当前壁纸选项重新载入。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用目前桌布選項重新載入。"}}, "ja": {"stringUnit": {"state": "translated", "value": "現在の壁紙設定で再読み込みします。"}}}},
    "Reload preview to show the picture or files you chose." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recarregue a pré-visualização para mostrar a imagem ou os arquivos que você escolheu."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 이미지나 파일을 표시하려면 미리보기를 다시 불러오세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Reload preview to show the picture or files you chose."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新载入预览以显示所选图片或文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新載入預覽以顯示所選圖片或檔案。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択した画像やファイルを表示するには、プレビューを再読み込みしてください。"}}}},
    "Preview does not change your desktop. Audio response and media information are unavailable here." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pré-visualização não altera sua mesa. A resposta ao áudio e as informações de mídia não estão disponíveis aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기는 데스크탑을 변경하지 않습니다. 여기에서는 오디오 반응과 미디어 정보를 사용할 수 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Preview does not change your desktop. Audio response and media information are unavailable here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览不会更改桌面。此处不提供音频响应和媒体信息。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽不會變更桌面。此處不提供音訊回應和媒體資訊。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューはデスクトップを変更しません。音声連動とメディア情報は利用できません。"}}}},
    "Preview — %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualização — %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 — %@"}}, "en": {"stringUnit": {"state": "translated", "value": "Preview — %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览 — %@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽 — %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビュー — %@"}}}},
    "Play preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 재생"}}, "en": {"stringUnit": {"state": "translated", "value": "Play preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "播放预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "播放預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再生"}}}},
    "Pause preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 일시 정지"}}, "en": {"stringUnit": {"state": "translated", "value": "Pause preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫停預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを一時停止"}}}},
    "Turn preview sound on" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativar som da pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 소리 켜기"}}, "en": {"stringUnit": {"state": "translated", "value": "Turn preview sound on"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "开启预览声音"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟預覽聲音"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューの音声をオンにする"}}}},
    "Mute preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 음소거"}}, "en": {"stringUnit": {"state": "translated", "value": "Mute preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "静音预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將預覽靜音"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを消音"}}}},
    "Loading preview…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Carregando pré-visualização…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 불러오는 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Loading preview…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在加载预览…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在載入預覽…"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを読み込み中…"}}}},
    "Playing preview" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzindo pré-visualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 재생 중"}}, "en": {"stringUnit": {"state": "translated", "value": "Playing preview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在播放预览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在播放預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューを再生中"}}}},
    "Preview paused" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualização pausada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 일시 정지됨"}}, "en": {"stringUnit": {"state": "translated", "value": "Preview paused"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览已暂停"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽已暫停"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレビューは一時停止中"}}}},
    "Enter a valid scale before previewing." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Insira uma escala válida antes de pré-visualizar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 전에 유효한 배율을 입력하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Enter a valid scale before previewing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先输入有效的缩放比例，再预览。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先輸入有效的縮放比例，再預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "有効な拡大率を入力してからプレビューしてください。"}}}},
    "Some preview options are no longer available. Refresh the library and try again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Algumas opções de pré-visualização não estão mais disponíveis. Atualize a biblioteca e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일부 미리보기 옵션을 더 이상 사용할 수 없습니다. 보관함을 새로고침한 후 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "Some preview options are no longer available. Refresh the library and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分预览选项已不可用。请刷新壁纸库后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分預覽選項已無法使用。請重新整理桌布庫後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "一部のプレビュー設定を利用できなくなりました。ライブラリを更新して再試行してください。"}}}},
    "Previous wallpaper" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de parede anterior"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이전 배경화면"}}, "en": {"stringUnit": {"state": "translated", "value": "Previous wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "上一张壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上一張桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "前の壁紙"}}}},
    "Previous Wallpaper" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de Parede Anterior"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이전 배경화면"}}, "en": {"stringUnit": {"state": "translated", "value": "Previous Wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "上一张壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上一張桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "前の壁紙"}}}},
    "Recently used" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usados recentemente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "최근 사용 항목"}}, "en": {"stringUnit": {"state": "translated", "value": "Recently used"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "最近使用"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "最近使用"}}, "ja": {"stringUnit": {"state": "translated", "value": "最近使った壁紙"}}}},
    "Random Wallpaper" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de Parede Aleatório"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "무작위 배경화면"}}, "en": {"stringUnit": {"state": "translated", "value": "Random Wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "随机壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨機桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "ランダムな壁紙"}}}},
    "Random wallpaper" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de parede aleatório"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "무작위 배경화면"}}, "en": {"stringUnit": {"state": "translated", "value": "Random wallpaper"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "随机壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨機桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "ランダムな壁紙"}}}},
    "Changes a chosen display to a random wallpaper other than the one it shows, or the target display when none is chosen." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Troca um monitor escolhido para um papel de parede aleatório diferente do que ele mostra, ou o monitor de destino quando nenhum for escolhido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 디스플레이의 배경화면을 현재 표시 중인 것과 다른 임의의 배경화면으로 변경합니다. 디스플레이를 선택하지 않으면 대상 디스플레이를 변경합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Changes a chosen display to a random wallpaper other than the one it shows, or the target display when none is chosen."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将所选显示器切换到一张与当前不同的随机壁纸；未选择时使用目标显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將所選顯示器切換到一張與目前不同的隨機桌布；未選擇時使用目標顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択したディスプレイを、表示中とは別のランダムな壁紙に切り替えます。未選択の場合は対象ディスプレイを使用します。"}}}},
    "Choose from" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher entre"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택 대상"}}, "en": {"stringUnit": {"state": "translated", "value": "Choose from"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选取范围"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取範圍"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択元"}}}},
    "All wallpapers" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 배경화면"}}, "en": {"stringUnit": {"state": "translated", "value": "All wallpapers"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全部壁纸"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "所有桌布"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべての壁紙"}}}},
    "Favorites" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Favoritos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기"}}, "en": {"stringUnit": {"state": "translated", "value": "Favorites"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "收藏"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "最愛"}}, "ja": {"stringUnit": {"state": "translated", "value": "お気に入り"}}}},
    "There is no other wallpaper to choose from." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não há outro papel de parede para escolher."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택할 다른 배경화면이 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "There is no other wallpaper to choose from."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有其他壁纸可供选择。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有其他桌布可供選擇。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選べる別の壁紙がありません。"}}}},
    "Remove from Display" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover do Monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이에서 제거"}}, "en": {"stringUnit": {"state": "translated", "value": "Remove from Display"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "从显示器移除"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "從顯示器移除"}}, "ja": {"stringUnit": {"state": "translated", "value": "ディスプレイから取り除く"}}}},
    "Start Again" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recomeçar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 시작"}}, "en": {"stringUnit": {"state": "translated", "value": "Start Again"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新开始"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新開始"}}, "ja": {"stringUnit": {"state": "translated", "value": "もう一度始める"}}}},
    "Open in Control Panel" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir no Painel de Controle"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제어 패널에서 열기"}}, "en": {"stringUnit": {"state": "translated", "value": "Open in Control Panel"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在控制面板中打开"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在控制面板中打開"}}, "ja": {"stringUnit": {"state": "translated", "value": "コントロールパネルで開く"}}}},
    "This display has no previous wallpaper still in your library." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este monitor não tem nenhum papel de parede anterior que ainda esteja na sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이의 이전 배경화면이 보관함에 남아 있지 않습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This display has no previous wallpaper still in your library."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器没有仍在壁纸库中的上一张壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器沒有仍在桌布庫中的上一張桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイの以前の壁紙はライブラリにありません。"}}}},
    "No wallpaper is running on this display." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede está rodando neste monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 실행 중인 배경화면이 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "No wallpaper is running on this display."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器上没有正在运行的壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器上沒有正在執行的桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイで実行中の壁紙はありません。"}}}},
    "The playlist changed. Refresh it and try reordering again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A playlist mudou. Atualize-a e tente reordenar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록이 변경되었습니다. 새로 고침한 후 순서를 다시 변경하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The playlist changed. Refresh it and try reordering again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "播放列表已变化。请刷新后重新排序。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "播放清單已變更。請重新整理後再排序。"}}, "ja": {"stringUnit": {"state": "translated", "value": "プレイリストが変更されました。更新してから並べ替えてください。"}}}},
    "Returns a chosen display to its previous wallpaper, or the target display when none is chosen." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Retorna um monitor escolhido ao papel de parede anterior, ou o monitor de destino quando nenhum for escolhido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 디스플레이를 이전 배경화면으로 되돌립니다. 선택한 디스플레이가 없으면 대상 디스플레이에 적용합니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Returns a chosen display to its previous wallpaper, or the target display when none is chosen."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将指定显示器切换回上一张壁纸；未指定时使用目标显示器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將指定顯示器切換回上一張桌布；未指定時使用目標顯示器。"}}, "ja": {"stringUnit": {"state": "translated", "value": "選んだディスプレイを前の壁紙に戻します。未選択の場合は対象ディスプレイを使用します。"}}}},
    "macOS is still loading the wallpaper renderer from another copy of WallpaperMachine. Close other running copies, then retry in this app." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS ainda está carregando o renderizador de papel de parede de outra cópia do WallpaperMachine. Feche as outras cópias abertas e tente novamente neste app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 여전히 다른 WallpaperMachine 사본의 배경화면 렌더러를 불러오고 있습니다. 실행 중인 다른 사본을 종료한 후 이 앱에서 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "macOS is still loading the wallpaper renderer from another copy of WallpaperMachine. Close other running copies, then retry in this app."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍在从另一个 WallpaperMachine 副本加载壁纸渲染器。请退出其他正在运行的副本，然后在此应用中重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍在從另一個 WallpaperMachine 副本載入桌布算繪器。請結束其他正在執行的副本，然後在此 App 中重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSは別のWallpaperMachineのコピーから壁紙レンダラを読み込み続けています。ほかの実行中のコピーを終了してから、このアプリで再試行してください。"}}}},
    "macOS could not register this app’s wallpaper renderer. Close other running copies of WallpaperMachine, then retry. If this persists, reinstall the app." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não conseguiu registrar o renderizador de papel de parede deste app. Feche as outras cópias abertas do WallpaperMachine e tente novamente. Se o problema persistir, reinstale o app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 이 앱의 배경화면 렌더러를 등록하지 못했습니다. 실행 중인 다른 WallpaperMachine 사본을 종료한 후 다시 시도하세요. 문제가 계속되면 앱을 다시 설치하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "macOS could not register this app’s wallpaper renderer. Close other running copies of WallpaperMachine, then retry. If this persists, reinstall the app."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 无法注册此应用的壁纸渲染器。请退出其他正在运行的 WallpaperMachine 副本后重试。如果问题持续，请重新安装应用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 無法註冊此 App 的桌布算繪器。請結束其他正在執行的 WallpaperMachine 副本後重試。如果問題持續，請重新安裝 App。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがこのアプリの壁紙レンダラを登録できませんでした。ほかの実行中のWallpaperMachineのコピーを終了してから、再試行してください。解決しない場合はアプリを再インストールしてください。"}}}},
    "macOS has WallpaperMachine’s lock-screen renderer switched off. Retry turns it back on." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS está com o renderizador da tela bloqueada do WallpaperMachine desativado. Tentar novamente o reativa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 WallpaperMachine의 잠금 화면 렌더러가 꺼져 있습니다. ‘다시 시도’를 선택하면 다시 켜집니다."}}, "en": {"stringUnit": {"state": "translated", "value": "macOS has WallpaperMachine’s lock-screen renderer switched off. Retry turns it back on."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 已关闭 WallpaperMachine 的锁定屏幕渲染器。点按“重试”即可重新打开。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 已關閉 WallpaperMachine 的鎖定畫面算繪器。按一下「重試」即可重新開啟。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSでWallpaperMachineのロック画面レンダラがオフになっています。「再試行」を押すとオンに戻します。"}}}},
    "macOS kept WallpaperMachine’s lock-screen renderer switched off. Turn it on in System Settings, then retry." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS manteve o renderizador da tela bloqueada do WallpaperMachine desativado. Ative-o nos Ajustes do Sistema e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 WallpaperMachine의 잠금 화면 렌더러가 계속 꺼져 있습니다. 시스템 설정에서 켠 후 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "macOS kept WallpaperMachine’s lock-screen renderer switched off. Turn it on in System Settings, then retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍将 WallpaperMachine 的锁定屏幕渲染器保持关闭。请在“系统设置”中将其打开，然后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍將 WallpaperMachine 的鎖定畫面算繪器保持關閉。請在「系統設定」中將其開啟，然後重試。"}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがWallpaperMachineのロック画面レンダラをオフのままにしました。「システム設定」でオンにしてから、再試行してください。"}}}},
    "Checking the system wallpaper renderer…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificando o renderizador de papel de parede do sistema…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 배경화면 렌더러 확인 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Checking the system wallpaper renderer…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在检查系统壁纸渲染器…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在檢查系統桌布算繪器…"}}, "ja": {"stringUnit": {"state": "translated", "value": "システムの壁紙レンダラを確認中…"}}}},
    "This display’s playlist has no other wallpaper to change to." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A playlist deste monitor não tem outro papel de parede para trocar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이의 재생목록에 전환할 다른 배경화면이 없습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This display’s playlist has no other wallpaper to change to."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此显示器的播放列表里没有可以换上的其他壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此顯示器的播放列表裡沒有可以換上的其他桌布。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このディスプレイのプレイリストには、切り替えられる別の壁紙がありません。"}}}},
    "SteamCMD stopped receiving the download. Check your connection and available disk space, then try again." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD parou de receber o download. Verifique sua conexão e o espaço disponível em disco e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 다운로드 수신을 중단했습니다. 연결과 사용 가능한 디스크 공간을 확인한 후 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "SteamCMD stopped receiving the download. Check your connection and available disk space, then try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "SteamCMD 已停止接收下载内容。请检查网络连接和磁盘空间后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "SteamCMD 已停止接收下載內容。請檢查網路連線和可用磁碟空間後再試一次。"}}, "ja": {"stringUnit": {"state": "translated", "value": "SteamCMDがダウンロードの受信を停止しました。ネットワーク接続とディスクの空き容量を確認してから、もう一度お試しください。"}}}},
    "Preparing update…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preparando atualização…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 준비 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Preparing update…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在准备更新…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在準備更新…"}}, "ja": {"stringUnit": {"state": "translated", "value": "アップデートを準備中…"}}}},
    "Another update installation is still running." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outra instalação de atualização ainda está em andamento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 업데이트가 아직 설치 중입니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Another update installation is still running."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "另一个更新安装仍在进行。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "另一個更新安裝仍在進行。"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のアップデートのインストールがまだ実行中です。"}}}},
    "Download paused" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Download pausado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 일시 정지됨"}}, "en": {"stringUnit": {"state": "translated", "value": "Download paused"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "下载已暂停"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "下載已暫停"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを一時停止中"}}}},
    "Pause download" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 일시 정지"}}, "en": {"stringUnit": {"state": "translated", "value": "Pause download"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停下载"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫停下載"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを一時停止"}}}},
    "Resume download" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Retomar download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 재개"}}, "en": {"stringUnit": {"state": "translated", "value": "Resume download"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "继续下载"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "繼續下載"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードを再開"}}}},
    "Pausing…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausando…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일시 정지 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Pausing…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在暂停…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在暫停…"}}, "ja": {"stringUnit": {"state": "translated", "value": "一時停止しています…"}}}},
    "Could not save the download queue: %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível salvar a fila de downloads: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 대기열을 저장하지 못했습니다: %@"}}, "en": {"stringUnit": {"state": "translated", "value": "Could not save the download queue: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存下载队列：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存下載佇列：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロードキューを保存できませんでした：%@"}}}},
    "Could not save partial download data: %@" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível salvar os dados parciais do download: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "부분 다운로드 데이터를 저장하지 못했습니다: %@"}}, "en": {"stringUnit": {"state": "translated", "value": "Could not save partial download data: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存已下载的数据：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存已下載的資料：%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "ダウンロード済みのデータを保存できませんでした：%@"}}}},
    "The wallpaper entry file is outside its project folder." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo de entrada do papel de parede está fora da pasta do projeto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 진입 파일이 프로젝트 폴더 외부에 있습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The wallpaper entry file is outside its project folder."}}, "ja": {"stringUnit": {"state": "translated", "value": "壁紙のエントリファイルがプロジェクトフォルダの外にあります。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "壁纸入口文件位于项目文件夹之外。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "桌布進入點檔案位於專案資料夾之外。"}}}},
    "The saved wallpaper file list could not be read. Your files have been kept." : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler a lista salva de arquivos do papel de parede. Seus arquivos foram mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 배경화면 파일 목록을 읽을 수 없습니다. 파일은 유지되었습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "The saved wallpaper file list could not be read. Your files have been kept."}}, "ja": {"stringUnit": {"state": "translated", "value": "保存された壁紙ファイルの一覧を読み込めませんでした。ファイルは保持されています。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取已保存的壁纸文件清单。你的文件已保留。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取已儲存的桌布檔案清單。你的檔案已保留。"}}}},
    "Signed in; checking Wallpaper Engine ownership…" : {"localizations": {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada; verificando a posse do Wallpaper Engine…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인했습니다. Wallpaper Engine 소유 여부 확인 중…"}}, "en": {"stringUnit": {"state": "translated", "value": "Signed in; checking Wallpaper Engine ownership…"}}, "ja": {"stringUnit": {"state": "translated", "value": "サインイン済み。Wallpaper Engineの所有を確認中…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已登录；正在检查是否拥有 Wallpaper Engine…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已登入；正在檢查是否擁有 Wallpaper Engine…"}}}},
    "macOS is still restoring the desktop wallpaper. Please try quitting again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS ainda está restaurando o papel de parede da mesa. Tente encerrar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 아직 데스크탑 배경화면을 복원하고 있습니다. 종료를 다시 시도하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "macOS is still restoring the desktop wallpaper. Please try quitting again."}}, "ja": {"stringUnit": {"state": "translated", "value": "macOSがデスクトップの壁紙を復元しています。もう一度終了を試してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 仍在恢复桌面壁纸。请再次尝试退出。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 仍在還原桌面桌布。請再次嘗試結束 App。"}}}
    },
    "The app and the lock-screen renderer use incompatible configuration versions. Quit other copies of WallpaperMachine and reopen the intended app, then retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O app e o renderizador da tela bloqueada usam versões de configuração incompatíveis. Encerre as outras cópias do WallpaperMachine, reabra o app pretendido e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱과 잠금 화면 렌더러의 구성 버전이 호환되지 않습니다. 다른 WallpaperMachine을 모두 종료하고 사용하려는 앱을 다시 연 후 다시 시도하세요."}}, "en":{"stringUnit":{"state":"translated","value":"The app and the lock-screen renderer use incompatible configuration versions. Quit other copies of WallpaperMachine and reopen the intended app, then retry."}},"ja":{"stringUnit":{"state":"translated","value":"アプリとロック画面レンダラの構成バージョンに互換性がありません。ほかのWallpaperMachineのコピーを終了し、使用するアプリを開き直してから、再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用与锁定屏幕渲染器使用的配置版本不兼容。请退出其他 WallpaperMachine 副本，重新打开要使用的应用，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 與鎖定畫面算繪器使用的設定版本不相容。請結束其他 WallpaperMachine 副本，重新開啟要使用的 App，然後重試。"}}}
    },
    "The lock-screen renderer could not load its configuration: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O renderizador da tela bloqueada não conseguiu carregar a configuração: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면 렌더러가 구성을 불러올 수 없습니다: %@"}}, "en":{"stringUnit":{"state":"translated","value":"The lock-screen renderer could not load its configuration: %@"}},"ja":{"stringUnit":{"state":"translated","value":"ロック画面レンダラが構成を読み込めませんでした：%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定屏幕渲染器无法加载其配置：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"鎖定畫面算繪器無法載入設定：%@"}}}
    },
    "The import file picker could not open." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível abrir o seletor de arquivos para importação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가져오기 파일 선택 창을 열 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The import file picker could not open."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込み用のファイル選択ウインドウを開けませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法打开导入文件选择窗口。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法開啟匯入檔案選擇視窗。"}}}
    },
    "This display uses a linked or unsupported native wallpaper configuration. Choose separate desktop and screen saver wallpapers in System Settings before enabling native wallpaper animation." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este monitor usa uma configuração de papel de parede nativo vinculada ou sem suporte. Escolha papéis de parede separados para a mesa e o protetor de tela nos Ajustes do Sistema antes de ativar a animação do papel de parede nativo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이는 연동된 시스템 배경화면 구성 또는 지원되지 않는 구성을 사용합니다. 시스템 배경화면 애니메이션을 켜기 전에 시스템 설정에서 데스크탑과 화면 보호기의 배경화면을 각각 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This display uses a linked or unsupported native wallpaper configuration. Choose separate desktop and screen saver wallpapers in System Settings before enabling native wallpaper animation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイは、リンクされた、または対応していないシステム壁紙の構成を使用しています。システム壁紙のアニメーションをオンにする前に、「システム設定」でデスクトップとスクリーンセーバの壁紙を別々に選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器使用了关联或不受支持的原生墙纸配置。请先在“系统设置”中为桌面和屏幕保护程序分别选择墙纸，再启用原生墙纸动画。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器使用連動或不受支援的原生桌布設定。請先在「系統設定」中為桌面和螢幕保護程式分別選擇桌布，再啟用原生桌布動畫。"}}}
    },
    "The web wallpaper entry or asset is outside its published folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A entrada ou um recurso do papel de parede web está fora da pasta publicada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면의 진입 파일 또는 리소스가 게시된 폴더 외부에 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper entry or asset is outside its published folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のエントリまたはアセットが公開済みフォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸的入口或资源位于已发布的文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布的進入點或資源位於已發佈的資料夾之外。"}}}
    },
    "The published web wallpaper properties are invalid." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As propriedades publicadas do papel de parede web são inválidas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "게시된 웹 배경화면 속성이 유효하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The published web wallpaper properties are invalid."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "公開済みWeb壁紙のプロパティが無効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已发布的网页壁纸属性无效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已發佈的網頁桌布屬性無效。"}}}
    },
    "This macOS version cannot host a live web wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta versão do macOS não pode hospedar um papel de parede web animado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 macOS 버전에서는 실시간 웹 배경화면을 실행할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS version cannot host a live web wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのmacOSではライブWeb壁紙を実行できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 版本无法运行实时网页壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 版本無法執行即時網頁桌布。"}}}
    },
    "The web wallpaper did not produce a frame in time." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede web não produziu um quadro a tempo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면이 제한 시간 내에 프레임을 생성하지 못했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper did not produce a frame in time."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙が時間内にフレームを生成しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸未能及时输出画面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布未能及時產生影格。"}}}
    },
    "The web wallpaper frame is unavailable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O quadro do papel de parede web não está disponível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면 프레임을 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper frame is unavailable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のフレームを利用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸的画面不可用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布的影格無法使用。"}}}
    },
    "The web wallpaper stopped unexpectedly." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede web parou inesperadamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면이 예기치 않게 정지되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper stopped unexpectedly."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙が予期せず停止しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸意外停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布意外停止。"}}}
    },
    "The web wallpaper could not suspend or resume playback." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede web não conseguiu suspender ou retomar a reprodução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면의 재생을 일시 정지하거나 재개할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper could not suspend or resume playback."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙の再生を一時停止または再開できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法暂停或恢复网页壁纸的播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法暫停或恢復網頁桌布的播放。"}}}
    },
    "Restore recovery found old files without its journal. Keep this support folder intact; the old files have not been deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A recuperação da restauração encontrou arquivos antigos sem o registro de controle. Mantenha esta pasta de suporte intacta; os arquivos antigos não foram apagados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원 복구 과정에서 저널이 없는 이전 파일을 발견했습니다. 이 지원 폴더를 변경하지 마세요. 이전 파일은 삭제되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Restore recovery found old files without its journal. Keep this support folder intact; the old files have not been deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元のリカバリーで、ジャーナルのない旧ファイルが見つかりました。このサポートフォルダを変更しないでください。旧ファイルは削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复修复发现旧文件但没有日志。请保持此支持文件夹完整；旧文件尚未删除。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原復原發現舊檔案但沒有日誌。請保持此支援資料夾完整；舊檔案尚未刪除。"}}}
    },
    "A previous restore failed. Preview and confirm the backup again to retry, or cancel the pending restore." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma restauração anterior falhou. Pré-visualize e confirme o backup novamente para tentar outra vez, ou cancele a restauração pendente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이전 복원에 실패했습니다. 백업을 다시 미리 보고 확인하여 재시도하거나 대기 중인 복원을 취소하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A previous restore failed. Preview and confirm the backup again to retry, or cancel the pending restore."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "以前の復元が失敗しました。バックアップを再度プレビューして確定し、再試行するか、保留中の復元を取り消してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "之前的恢复失败。请重新预览并确认备份以重试，或取消待执行恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "先前的還原失敗。請重新預覽並確認備份以重試，或取消待執行還原。"}}}
    },
    "Display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器"}}}
    },
    "Changes a chosen display to its next wallpaper, or the target display when none is chosen." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Troca um monitor escolhido para o próximo papel de parede, ou o monitor de destino quando nenhum for escolhido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 디스플레이를 다음 배경화면으로 변경합니다. 디스플레이를 선택하지 않으면 대상 디스플레이를 변경합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Changes a chosen display to its next wallpaper, or the target display when none is chosen."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したディスプレイを次の壁紙に切り替えます。未選択の場合は対象ディスプレイを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将所选显示器切换到下一张壁纸；未选择时使用目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將所選顯示器切換到下一張桌布；未選擇時使用目標顯示器。"}}}
    },
    "Applies an installed wallpaper to a chosen display, to every display, or to the target display when none is chosen." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplica um papel de parede instalado a um monitor escolhido, a todos os monitores ou ao monitor de destino quando nenhum for escolhido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 배경화면을 선택한 디스플레이나 모든 디스플레이에 적용합니다. 선택하지 않으면 대상 디스플레이에 적용합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Applies an installed wallpaper to a chosen display, to every display, or to the target display when none is chosen."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの壁紙を、選択したディスプレイ、すべてのディスプレイ、または未選択の場合は対象ディスプレイに適用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将已安装的壁纸应用到所选显示器、所有显示器；未选择时使用目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將已安裝的桌布套用到所選顯示器、所有顯示器；未選擇時使用目標顯示器。"}}}
    },
    "Target display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Monitor de destino"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대상 디스플레이"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Target display"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対象ディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "目标显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目標顯示器"}}}
    },
    "Checking this display at %u FPS, including its mirror group and global frame-rate cap." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificando este monitor a %u FPS, incluindo o grupo de espelhamento e o limite global de taxa de quadros."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미러 그룹과 전체 프레임률 상한을 반영하여 이 디스플레이를 %u FPS로 검사합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Checking this display at %u FPS, including its mirror group and global frame-rate cap."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ミラーグループと全体のフレームレート上限を含め、このディスプレイを %u FPS で確認します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以 %u FPS 检查此显示器，包括镜像组和全局帧率上限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以 %u FPS 檢查此顯示器，包括鏡像群組和全域影格率上限。"}}}
    },
    "Choose a connected, enabled independent display. A mirror follows its source wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um monitor independente conectado e ativado. Um espelho segue o papel de parede da origem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "연결되어 있고 활성화된 독립 디스플레이를 선택하세요. 미러링 디스플레이는 원본 디스플레이의 배경화면을 따릅니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a connected, enabled independent display. A mirror follows its source wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続され、有効な独立ディスプレイを選択してください。ミラーは元の壁紙に従います。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择已连接并启用的独立显示器。镜像显示器跟随来源壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇已連接並啟用的獨立顯示器。鏡像顯示器跟隨來源桌布。"}}}
    },
    "Lock screen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tela bloqueada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "잠금 화면"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Lock screen"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面"}}}
    },
    "This wallpaper type has no supported lock-screen route." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este tipo de papel de parede não tem um caminho compatível com a tela bloqueada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 유형에는 지원되는 잠금 화면 표시 방식이 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper type has no supported lock-screen route."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙の種類には、対応するロック画面での表示方法がありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸类型没有受支持的锁定屏幕方式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布類型沒有支援的鎖定畫面方式。"}}}
    },
    "Installed project" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Projeto instalado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 프로젝트"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Installed project"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みプロジェクト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装项目"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝專案"}}}
    },
    "The installed wallpaper identifier is not a safe library path." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O identificador do papel de parede instalado não é um caminho seguro da biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 배경화면 식별자는 안전한 보관함 경로가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The installed wallpaper identifier is not a safe library path."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済み壁紙の識別子は安全なライブラリパスではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装壁纸的标识符不是安全的库路径。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝桌布的識別碼不是安全的資料庫路徑。"}}}
    },
    "The project resolves outside the installed library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O projeto aponta para fora da biblioteca instalada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트 경로가 설치된 보관함 외부를 가리킵니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The project resolves outside the installed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの参照先がインストール済みライブラリの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目解析到已安装库之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案解析到已安裝資料庫之外。"}}}
    },
    "The installed wallpaper folder is missing or unreadable. Refresh or reinstall this wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta do papel de parede instalado está ausente ou ilegível. Atualize ou reinstale este papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 배경화면 폴더가 없거나 읽을 수 없습니다. 새로 고침하거나 이 배경화면을 재설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The installed wallpaper folder is missing or unreadable. Refresh or reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済み壁紙のフォルダが見つからないか、読み取れません。更新するか、この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装壁纸文件夹缺失或不可读。请刷新或重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝桌布資料夾遺失或無法讀取。請重新整理或重新安裝此桌布。"}}}
    },
    "project.json is missing, unreadable, too large or has no valid entry file. Reinstall this wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O project.json está ausente, ilegível, grande demais ou sem um arquivo de entrada válido. Reinstale este papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "project.json이 없거나 읽을 수 없거나 너무 크거나 유효한 진입 파일을 포함하지 않습니다. 이 배경화면을 다시 설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "project.json is missing, unreadable, too large or has no valid entry file. Reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.json が見つからない、読み取れない、大きすぎる、または有効なエントリファイルがありません。この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 缺失、不可读、过大或没有有效入口文件。请重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 遺失、無法讀取、過大或沒有有效入口檔案。請重新安裝此桌布。"}}}
    },
    "The manifest type no longer matches the library entry. Refresh your library before checking again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O tipo do manifesto não corresponde mais ao item da biblioteca. Atualize sua biblioteca antes de verificar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "매니페스트 유형이 보관함 항목과 더 이상 일치하지 않습니다. 보관함을 새로 고침한 후 다시 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The manifest type no longer matches the library entry. Refresh your library before checking again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "マニフェストの種類がライブラリ項目と一致しなくなりました。ライブラリを更新してから再確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清单类型与库条目不再匹配。请刷新壁纸库后重新检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "資訊清單類型與資料庫項目不再相符。請重新整理桌布庫後重新檢查。"}}}
    },
    "Entry resources" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recursos de entrada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진입점 리소스"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Entry resources"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エントリリソース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "入口资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "入口資源"}}}
    },
    "The declared entry resolves outside this wallpaper folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A entrada declarada aponta para fora da pasta deste papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선언된 진입 경로가 이 배경화면 폴더 외부를 가리킵니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry resolves outside this wallpaper folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリの参照先がこの壁紙フォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口解析到此壁纸文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口解析到此桌布資料夾之外。"}}}
    },
    "The installed manifest has a declared entry file." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O manifesto instalado tem um arquivo de entrada declarado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 매니페스트에 진입 파일이 선언되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The installed manifest has a declared entry file."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みマニフェストにエントリファイルが宣言されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装清单声明了入口文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝資訊清單宣告了入口檔案。"}}}
    },
    "The library reports this project type as unsupported." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca informa que este tipo de projeto não é compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함에 따르면 이 프로젝트 유형은 지원되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The library reports this project type as unsupported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリによると、このプロジェクトの種類は未対応です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库报告此项目类型不受支持。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫回報此專案類型不受支援。"}}}
    },
    "The declared entry file is installed and readable. This does not verify every authored dependency." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo de entrada declarado está instalado e legível. Isso não verifica todas as dependências definidas pelo autor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선언된 진입 파일이 설치되어 있으며 읽을 수 있습니다. 제작자가 지정한 모든 의존 리소스가 검증된 것은 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry file is installed and readable. This does not verify every authored dependency."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリファイルはインストール済みで読み取れます。すべての作者定義の依存リソースが検証されたわけではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口文件已安装且可读。这不代表所有作者依赖均已验证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口檔案已安裝且可讀取。這不代表所有作者相依資源均已驗證。"}}}
    },
    "A scene package is installed. Its internal entry and dependencies need the renderer's package parser; preflight cannot certify them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um pacote de cena está instalado. A entrada interna e as dependências precisam do analisador de pacotes do renderizador; a verificação prévia não pode certificá-las."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 패키지가 설치되어 있습니다. 내부 진입 항목과 의존성을 확인하려면 렌더러의 패키지 파서가 필요하며, 사전 검사로는 이를 보장할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A scene package is installed. Its internal entry and dependencies need the renderer's package parser; preflight cannot certify them."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンパッケージはインストール済みです。内部エントリと依存リソースにはレンダラーのパッケージ解析が必要で、事前確認では保証できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景包已安装。其内部入口和依赖需要渲染器的包解析器；预检无法认证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景套件已安裝。其內部入口和相依資源需要算繪器的套件解析器；預先檢查無法認證。"}}}
    },
    "The declared entry file is missing or unreadable. Reinstall this wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo de entrada declarado está ausente ou ilegível. Reinstale este papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선언된 진입 파일이 없거나 읽을 수 없습니다. 이 배경화면을 재설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The declared entry file is missing or unreadable. Reinstall this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "宣言されたエントリファイルが見つからないか、読み取れません。この壁紙を再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "声明的入口文件缺失或不可读。请重新安装此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "宣告的入口檔案遺失或無法讀取。請重新安裝此桌布。"}}}
    },
    "Shared scene resources" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recursos de cena compartilhados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 장면 리소스"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene resources"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享场景资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共用場景資源"}}}
    },
    "The required baseline shared shaders and material are installed. Authored resources are not fully validated." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os shaders e o material compartilhados básicos necessários estão instalados. Os recursos do autor não são totalmente validados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "필수 기본 공유 셰이더와 머티리얼이 설치되어 있습니다. 제작자가 정의한 리소스는 완전히 검증되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The required baseline shared shaders and material are installed. Authored resources are not fully validated."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "必要な基本共有シェーダーとマテリアルはインストール済みです。作者定義のリソースは完全には検証されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所需的基础共享着色器和材质已安装。作者资源尚未全面验证。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所需的基礎共用著色器和材質已安裝。作者資源尚未全面驗證。"}}}
    },
    "Baseline Wallpaper Engine shaders or materials are missing. Install or locate the complete scene assets folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Faltam shaders ou materiais básicos do Wallpaper Engine. Instale ou localize a pasta completa de recursos de cena."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기본 Wallpaper Engine 셰이더 또는 머티리얼이 없습니다. 완전한 장면 에셋 폴더를 설치하거나 위치를 지정하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Baseline Wallpaper Engine shaders or materials are missing. Install or locate the complete scene assets folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "基本の Wallpaper Engine シェーダーまたはマテリアルがありません。完全なシーンアセットフォルダをインストールするか、指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少基础 Wallpaper Engine 着色器或材质。请安装或定位完整的场景资源文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "缺少基礎 Wallpaper Engine 著色器或材質。請安裝或定位完整的場景資源資料夾。"}}}
    },
    "Scene shader and graph support" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Suporte a shaders e grafos de cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 셰이더 및 그래프 지원"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Scene shader and graph support"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンのシェーダーとグラフの対応"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景着色器和图支持"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景著色器和圖支援"}}}
    },
    "Web runtime" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ambiente de execução web"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 런타임"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Web runtime"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web 実行環境"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页运行时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁執行環境"}}}
    },
    "This video can be played, at its own frame rate. Actual player preparation and on-screen presentation are not verified by this check." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo pode ser reproduzido na própria taxa de quadros. A preparação real do reprodutor e a exibição na tela não são verificadas por esta checagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 동영상은 자체 프레임률로 재생할 수 있습니다. 실제 플레이어 준비와 화면 표시는 이 검사에서 확인하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This video can be played, at its own frame rate. Actual player preparation and on-screen presentation are not verified by this check."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオは再生できます。ビデオは動画自体のフレームレートで再生されます。実際のプレイヤーの準備や画面表示は、この確認では検証しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此视频可以播放，视频按自身帧率播放。此检查不验证实际播放器准备和屏幕显示。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此影片可以播放，影片會以自身的影格率播放。此檢查不驗證實際播放器準備和螢幕顯示。"}}}
    },
    "Video playback needs a supported installed video, a readable entry and a valid target display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A reprodução de vídeo precisa de um vídeo instalado compatível, uma entrada legível e um monitor de destino válido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상 재생에는 지원되는 설치된 동영상, 읽을 수 있는 진입 파일, 유효한 대상 디스플레이가 필요합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Video playback needs a supported installed video, a readable entry and a valid target display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ再生の確認には、対応するインストール済み動画、読み取れるエントリ、有効な対象ディスプレイが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频播放检查需要受支持的已安装视频、可读入口和有效目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片播放檢查需要支援的已安裝影片、可讀取入口和有效目標顯示器。"}}}
    },
    "The entry file check does not execute scripts or verify media, local dependencies or WebGL. These need runtime evaluation." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A verificação do arquivo de entrada não executa scripts nem verifica mídia, dependências locais ou WebGL. Isso exige avaliação em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진입 파일 검사는 스크립트를 실행하거나 미디어, 로컬 의존 리소스 또는 WebGL을 검증하지 않습니다. 이러한 항목은 실행 중 평가가 필요합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The entry file check does not execute scripts or verify media, local dependencies or WebGL. These need runtime evaluation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エントリファイルの確認では、スクリプトの実行やメディア、ローカル依存リソース、WebGL の検証は行いません。これらは実行時の評価が必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "入口文件检查不会执行脚本或验证媒体、本地依赖或 WebGL。这些需要运行时评估。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "入口檔案檢查不會執行指令碼或驗證媒體、本機相依資源或 WebGL。這些需要執行時評估。"}}}
    },
    "Wallpaper capability" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Capacidade do papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 지원 기능"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper capability"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の対応機能"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸能力"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布能力"}}}
    },
    "No supported renderer is declared for this wallpaper type." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum renderizador compatível foi declarado para este tipo de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 유형에 지원되는 렌더러가 선언되어 있지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No supported renderer is declared for this wallpaper type."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙の種類には対応するレンダラーが宣言されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸类型未声明受支持的渲染器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布類型未宣告支援的算繪器。"}}}
    },
    "Content changed" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Conteúdo alterado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "콘텐츠 변경됨"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Content changed"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コンテンツが変更されました"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "内容已变化"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "內容已變更"}}}
    },
    "Wallpaper files changed during this check. Retry against the new content." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os arquivos do papel de parede mudaram durante esta verificação. Tente novamente com o novo conteúdo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검사 중 배경화면 파일이 변경되었습니다. 새 콘텐츠로 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper files changed during this check. Retry against the new content."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認中に壁紙ファイルが変更されました。新しいコンテンツで再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "检查期间壁纸文件发生变化。请针对新内容重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "檢查期間桌布檔案發生變更。請針對新內容重試。"}}}
    },
    "Installed resources" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recursos instalados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 리소스"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Installed resources"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みリソース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已安装资源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝資源"}}}
    },
    "The resource check could not complete: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível concluir a verificação de recursos: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "리소스 검사를 완료할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The resource check could not complete: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リソースの確認を完了できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "资源检查无法完成：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "資源檢查無法完成：%@"}}}
    },
    "Image placement must use positions between 0 and 1 and zoom between 1 and 3." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O posicionamento da imagem precisa usar posições entre 0 e 1 e zoom entre 1 e 3."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 배치의 위치는 0~1, 확대 배율은 1~3 범위여야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Image placement must use positions between 0 and 1 and zoom between 1 and 3."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の位置は 0～1、ズームは 1～3 の範囲で指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图像位置必须在 0 到 1 之间，缩放必须在 1 到 3 之间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影像位置必須在 0 到 1 之間，縮放必須在 1 到 3 之間。"}}}
    },
    "Choose an installed image wallpaper and a valid display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um papel de parede de imagem instalado e um monitor válido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 이미지 배경화면과 유효한 디스플레이를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose an installed image wallpaper and a valid display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの画像壁紙と有効なディスプレイを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择已安装的图像壁纸和有效显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇已安裝的影像桌布和有效顯示器。"}}}
    },
    "The image wallpaper’s current properties could not be read." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler as propriedades atuais do papel de parede de imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 배경화면의 현재 속성을 읽을 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The image wallpaper’s current properties could not be read."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像壁紙の現在のプロパティを読み取れませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取图像壁纸的当前属性。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取影像桌布的目前屬性。"}}}
    },
    "Save the backup outside WallpaperMachine’s support folder with the .wmbackup extension." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salve o backup fora da pasta de suporte do WallpaperMachine, com a extensão .wmbackup."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 지원 폴더 외부에 .wmbackup 확장자로 백업을 저장하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Save the backup outside WallpaperMachine’s support folder with the .wmbackup extension."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップは WallpaperMachine のサポートフォルダの外に、拡張子 .wmbackup で保存してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请将备份保存到 WallpaperMachine 支持文件夹之外，并使用 .wmbackup 扩展名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請將備份儲存到 WallpaperMachine 支援資料夾之外，並使用 .wmbackup 副檔名。"}}}
    },
    "Restored preferences could not be saved. The previous state has been retained." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível salvar as preferências restauradas. O estado anterior foi mantido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원된 환경설정을 저장하지 못했습니다. 이전 상태가 유지되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Restored preferences could not be saved. The previous state has been retained."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元した環境設定を保存できませんでした。以前の状態は保持されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法保存恢复的偏好设置。已保留之前的状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法儲存還原的偏好設定。已保留先前的狀態。"}}}
    },
    "This is not a supported WallpaperMachine backup manifest." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este não é um manifesto de backup do WallpaperMachine compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지원되는 WallpaperMachine 백업 매니페스트가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This is not a supported WallpaperMachine backup manifest."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対応する WallpaperMachine のバックアップマニフェストではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这不是受支持的 WallpaperMachine 备份清单。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這不是支援的 WallpaperMachine 備份資訊清單。"}}}
    },
    "This backup version or source path is not supported." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta versão ou caminho de origem do backup não é compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 백업 버전 또는 소스 경로는 지원되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This backup version or source path is not supported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバックアップのバージョンまたはソースパスは未対応です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持此备份版本或来源路径。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援此備份版本或來源路徑。"}}}
    },
    "The backup contains preferences that WallpaperMachine does not allow restoring." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O backup contém preferências que o WallpaperMachine não permite restaurar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업에 WallpaperMachine에서 복원을 허용하지 않는 환경설정이 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The backup contains preferences that WallpaperMachine does not allow restoring."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップに WallpaperMachine が復元を許可しない環境設定が含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份包含 WallpaperMachine 不允许恢复的偏好设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份包含 WallpaperMachine 不允許還原的偏好設定。"}}}
    },
    "The previous preferences could not be saved. Restore recovery will retry at the next launch." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível salvar as preferências anteriores. A recuperação da restauração tentará novamente na próxima abertura."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이전 환경설정을 저장할 수 없습니다. 다음 실행 시 복원 복구를 다시 시도합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The previous preferences could not be saved. Restore recovery will retry at the next launch."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "以前の環境設定を保存できませんでした。復元のリカバリーは次回起動時に再試行します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法保存之前的偏好设置。恢复修复将在下次启动时重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法儲存先前的偏好設定。還原復原將在下次啟動時重試。"}}}
    },
    "Wallpaper %@ is not included or installed. Reinstall its project files after restoring." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede %@ não está incluído nem instalado. Reinstale os arquivos do projeto após a restauração."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 %@이(가) 포함되어 있지 않거나 설치되지 않았습니다. 복원 후 프로젝트 파일을 재설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper %@ is not included or installed. Reinstall its project files after restoring."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙 %@ は含まれていないか、インストールされていません。復元後にプロジェクトファイルを再インストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸 %@ 未包含或安装。请在恢复后重新安装其项目文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布 %@ 未包含或安裝。請在還原後重新安裝其專案檔案。"}}}
    },
    "A referenced managed resource is not included: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um recurso gerenciado referenciado não está incluído: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "참조된 관리 대상 리소스가 포함되어 있지 않습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A referenced managed resource is not included: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "参照されている管理対象リソースが含まれていません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未包含引用的托管资源：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未包含參照的受管理資源：%@"}}}
    },
    "An external file reference is unavailable on this Mac: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma referência a arquivo externo não está disponível neste Mac: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서 외부 파일 참조를 사용할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "An external file reference is unavailable on this Mac: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この Mac では外部ファイルの参照を使用できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 上的外部文件引用不可用：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 上的外部檔案參照無法使用：%@"}}}
    },
    "Shared scene shaders and materials are not included in backups. Install or locate Wallpaper Engine’s complete scene assets if they are unavailable on this Mac." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os shaders e materiais de cena compartilhados não são incluídos nos backups. Instale ou localize os recursos de cena completos do Wallpaper Engine se não estiverem disponíveis neste Mac."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 장면 셰이더와 머티리얼은 백업에 포함되지 않습니다. 이 Mac에 없다면 Wallpaper Engine의 전체 장면 에셋을 설치하거나 위치를 지정하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene shaders and materials are not included in backups. Install or locate Wallpaper Engine’s complete scene assets if they are unavailable on this Mac."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンシェーダーとマテリアルはバックアップに含まれません。この Mac にない場合は、完全な Wallpaper Engine シーンアセットをインストールするか、指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份不包含共享场景着色器和材质。如果此 Mac 上缺少它们，请安装或定位完整的 Wallpaper Engine 场景资源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份不包含共用場景著色器和材質。如果此 Mac 上缺少它們，請安裝或定位完整的 Wallpaper Engine 場景資源。"}}}
    },
    "Copying the local backup…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiando o backup local…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로컬 백업 복사 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Copying the local backup…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ローカルバックアップをコピー中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在复制本地备份…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在複製本機備份…"}}}
    },
    "Backup exported. Login sessions, caches and shared scene assets were not included." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Backup exportado. Sessões iniciadas, caches e recursos de cena compartilhados não foram incluídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업을 내보냈습니다. 로그인 세션, 캐시, 공유 장면 에셋은 포함되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Backup exported. Login sessions, caches and shared scene assets were not included."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップをエクスポートしました。ログインセッション、キャッシュ、共有シーンアセットは含まれていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份已导出。未包含登录会话、缓存和共享场景资源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份已匯出。未包含登入工作階段、快取和共用場景資源。"}}}
    },
    "Backup operation cancelled." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Operação de backup cancelada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업 작업이 취소되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Backup operation cancelled."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップ操作を取り消しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份操作已取消。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份操作已取消。"}}}
    },
    "Validating the backup and checking conflicts…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Validando o backup e verificando conflitos…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업 검증 및 충돌 확인 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Validating the backup and checking conflicts…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップの検証と競合の確認中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在验证备份并检查冲突…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在驗證備份並檢查衝突…"}}}
    },
    "Review the conflicts and missing resources before confirming. Restore takes effect at the next launch." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Revise os conflitos e os recursos ausentes antes de confirmar. A restauração entra em vigor na próxima abertura."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "확정하기 전에 충돌 항목과 누락된 리소스를 검토하세요. 복원은 다음 실행 시 적용됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Review the conflicts and missing resources before confirming. Restore takes effect at the next launch."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確定する前に競合と不足しているリソースを確認してください。復元は次回起動時に反映されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "确认前请检查冲突和缺失资源。恢复将在下次启动时生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "確認前請檢查衝突和遺失資源。還原將在下次啟動時生效。"}}}
    },
    "Preview a backup before confirming restore." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualize um backup antes de confirmar a restauração."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원을 확정하기 전에 백업을 미리 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preview a backup before confirming restore."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元を確定する前に、バックアップをプレビューしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "确认恢复前请先预览备份。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "確認還原前請先預覽備份。"}}}
    },
    "Staging the confirmed restore…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preparando a restauração confirmada…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "확정된 복원 준비 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Staging the confirmed restore…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確定した復元をステージング中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在暂存已确认的恢复…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在暫存已確認的還原…"}}}
    },
    "Restore is ready for the next launch. Current wallpapers and settings have not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A restauração está pronta para a próxima abertura. Os papéis de parede e ajustes atuais não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 실행 시 복원할 준비가 되었습니다. 현재 배경화면과 설정은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Restore is ready for the next launch. Current wallpapers and settings have not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回起動時の復元の準備ができました。現在の壁紙と設定は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复已准备就绪，将在下次启动时生效。当前壁纸和设置未改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原已準備就緒，將在下次啟動時生效。目前桌布和設定未變更。"}}}
    },
    "Pending restore cancelled. Current wallpapers and settings have not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restauração pendente cancelada. Os papéis de parede e ajustes atuais não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대기 중인 복원을 취소했습니다. 현재 배경화면과 설정은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Pending restore cancelled. Current wallpapers and settings have not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保留中の復元を取り消しました。現在の壁紙と設定は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "待执行恢复已取消。当前壁纸和设置未改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "待執行還原已取消。目前桌布和設定未變更。"}}}
    },
    "Another backup operation is already running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outra operação de backup já está em andamento."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 백업 작업이 이미 실행 중입니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Another backup operation is already running."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のバックアップ操作が実行中です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已有其他备份操作正在运行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已有其他備份操作正在執行。"}}}
    },
    "Export local backup" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Exportar backup local"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로컬 백업 내보내기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Export local backup"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ローカルバックアップを書き出す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导出本地备份"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯出本機備份"}}}
    },
    "Preview local backup" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualizar backup local"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로컬 백업 미리보기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preview local backup"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ローカルバックアップをプレビュー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览本地备份"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽本機備份"}}}
    },
    "Choose a .wmbackup package. No current settings will change until you confirm and launch the app again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um pacote .wmbackup. Nenhum ajuste atual será alterado até que você confirme e abra o app novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : ".wmbackup 패키지를 선택하세요. 확인한 후 앱을 다시 실행하기 전까지 현재 설정은 변경되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a .wmbackup package. No current settings will change until you confirm and launch the app again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : ".wmbackup パッケージを選択してください。確定してアプリを再起動するまで、現在の設定は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 .wmbackup 包。确认并重新启动应用前，当前设置不会改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 .wmbackup 套件。確認並重新啟動應用程式前，目前設定不會變更。"}}}
    },
    "Enter a name between 1 and 128 characters, on one line." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Insira um nome com 1 a 128 caracteres, em uma única linha."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "1~128자의 이름을 한 줄로 입력하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Enter a name between 1 and 128 characters, on one line."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1～128 文字の名前を 1 行で入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 1 到 128 个字符的单行名称。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入 1 到 128 個字元的單行名稱。"}}}
    },
    "This collection no longer exists. Refresh the library and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta coleção não existe mais. Atualize a biblioteca e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 컬렉션이 더 이상 존재하지 않습니다. 보관함을 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This collection no longer exists. Refresh the library and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコレクションは存在しません。ライブラリを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此收藏夹已不存在。请刷新壁纸库后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此收藏集已不存在。請重新整理桌布庫後重試。"}}}
    },
    "This playlist plan no longer exists. Refresh the library and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este plano de playlist não existe mais. Atualize a biblioteca e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 재생목록 계획이 더 이상 존재하지 않습니다. 보관함을 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This playlist plan no longer exists. Refresh the library and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプレイリストプランは存在しません。ライブラリを更新して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此播放列表方案已不存在。请刷新壁纸库后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此播放清單方案已不存在。請重新整理桌布庫後重試。"}}}
    },
    "The backup contains an invalid preference value." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O backup contém um valor de preferência inválido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업에 유효하지 않은 환경설정 값이 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The backup contains an invalid preference value."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップに無効な環境設定値が含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份包含无效的偏好设置值。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份包含無效的偏好設定值。"}}}
    },
    "Saved property presets could not be read. Restore a backup before saving new presets." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler as predefinições de propriedades salvas. Restaure um backup antes de salvar novas predefinições."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 속성 프리셋을 읽지 못했습니다. 새 프리셋을 저장하기 전에 백업을 복원하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Saved property presets could not be read. Restore a backup before saving new presets."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みのプロパティプリセットを読み取れませんでした。新しいプリセットを保存する前にバックアップを復元してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取已保存的属性预设。保存新预设前请恢复备份。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取已儲存的屬性預設。儲存新預設前請還原備份。"}}}
    },
    "This property preset no longer exists." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição de propriedades não existe mais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 속성 프리셋이 더 이상 존재하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset no longer exists."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセットは存在しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设已不存在。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設已不存在。"}}}
    },
    "Apply or revert pending edits before saving or applying a property preset." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplique ou reverta as edições pendentes antes de salvar ou aplicar uma predefinição de propriedades."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋을 저장하거나 적용하기 전에 대기 중인 편집 내용을 적용하거나 되돌리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Apply or revert pending edits before saving or applying a property preset."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを保存または適用する前に、保留中の編集を適用するか、元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存或应用属性预设前，请应用或撤销待处理的编辑。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存或套用屬性預設前，請套用或還原待處理的編輯。"}}}
    },
    "This property preset belongs to a different wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição de propriedades pertence a outro papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 속성 프리셋은 다른 배경화면용입니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset belongs to a different wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセットは別の壁紙用です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设属于其他壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設屬於其他桌布。"}}}
    },
    "Preset property %@ is unknown or its authored type has changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A propriedade %@ da predefinição é desconhecida ou o tipo definido pelo autor mudou."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋의 %@ 속성을 알 수 없거나 제작자가 지정한 유형이 변경되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ is unknown or its authored type has changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ が不明か、作者定義の型が変更されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 未知或其作者定义的类型已改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 未知或其作者定義的類型已變更。"}}}
    },
    "This property preset uses an unsupported format version." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta predefinição de propriedades usa uma versão de formato não compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 속성 프리셋은 지원되지 않는 형식 버전을 사용합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset uses an unsupported format version."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセットは未対応の形式バージョンを使用しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设使用不受支持的格式版本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設使用不支援的格式版本。"}}}
    },
    "External file references are not portable. Choose the files in the property editor and save a new preset." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Referências a arquivos externos não são portáteis. Escolha os arquivos no editor de propriedades e salve uma nova predefinição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "외부 파일 참조는 다른 기기로 옮길 수 없습니다. 속성 편집기에서 파일을 선택하고 새 프리셋을 저장하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "External file references are not portable. Choose the files in the property editor and save a new preset."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "外部ファイル参照は移行できません。プロパティエディタでファイルを選択し、新しいプリセットを保存してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外部文件引用不可移植。请在属性编辑器中选择文件并保存新预设。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "外部檔案參照無法攜帶至其他電腦。請在屬性編輯器中選擇檔案並儲存新預設。"}}}
    },
    "Enter a property preset name of 1–120 characters." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Insira um nome de predefinição de propriedades com 1 a 120 caracteres."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "1~120자의 속성 프리셋 이름을 입력하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Enter a property preset name of 1–120 characters."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1～120 文字のプロパティプリセット名を入力してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 1–120 个字符的属性预设名称。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入 1–120 個字元的屬性預設名稱。"}}}
    },
    "This property preset document is invalid or exceeds the supported limits." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este documento de predefinição de propriedades é inválido ou excede os limites compatíveis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 속성 프리셋 문서가 유효하지 않거나 지원 한도를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This property preset document is invalid or exceeds the supported limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプロパティプリセット文書は無効か、対応する上限を超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此属性预设文档无效或超过支持的限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此屬性預設文件無效或超過支援的限制。"}}}
    },
    "Preset property %@ does not match the current authored values or limits." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A propriedade %@ da predefinição não corresponde aos valores ou limites atuais definidos pelo autor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋의 %@ 속성이 현재 제작자가 지정한 값 또는 제한과 일치하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ does not match the current authored values or limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は、現在の作者定義の値または制限に一致しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 不符合当前作者定义的值或限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 不符合目前作者定義的值或限制。"}}}
    },
    "Preset property %@ is currently disabled. No preset changes were applied." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A propriedade %@ da predefinição está desativada no momento. Nenhuma alteração da predefinição foi aplicada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋의 %@ 속성이 현재 비활성화되어 있습니다. 프리셋 변경 사항은 적용되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ is currently disabled. No preset changes were applied."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は現在無効です。プリセットの変更は適用されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 当前已禁用。未应用任何预设更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 目前已停用。未套用任何預設變更。"}}}
    },
    "Preset property %@ references missing or unreadable assets. Choose the files again before applying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A propriedade %@ da predefinição referencia recursos ausentes ou ilegíveis. Escolha os arquivos novamente antes de aplicar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋의 %@ 속성이 없거나 읽을 수 없는 에셋을 참조합니다. 적용하기 전에 파일을 다시 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Preset property %@ references missing or unreadable assets. Choose the files again before applying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットのプロパティ %@ は、見つからないか読み取れないアセットを参照しています。適用前にファイルを再選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设属性 %@ 引用了缺失或不可读的资源。应用前请重新选择文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設屬性 %@ 參照了遺失或無法讀取的資源。套用前請重新選擇檔案。"}}}
    },
    "Portable property presets support up to 32 MB of managed assets. External files are not bundled." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinições de propriedades portáteis aceitam até 32 MB de recursos gerenciados. Arquivos externos não são incluídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이동 가능한 속성 프리셋에는 최대 32 MB의 관리 대상 에셋을 포함할 수 있습니다. 외부 파일은 포함되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Portable property presets support up to 32 MB of managed assets. External files are not bundled."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "移行可能なプロパティプリセットは、最大 32 MB の管理対象アセットに対応します。外部ファイルは同梱されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "便携属性预设支持最多 32 MB 的托管资源。外部文件不会打包。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可攜式屬性預設支援最多 32 MB 的受管理資源。外部檔案不會封裝。"}}}
    },
    "The backup contains an unsafe path, link or special file: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O backup contém um caminho, link ou arquivo especial inseguro: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업에 안전하지 않은 경로, 링크 또는 특수 파일이 포함되어 있습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The backup contains an unsafe path, link or special file: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップに安全でないパス、リンク、または特殊ファイルが含まれています：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份包含不安全的路径、链接或特殊文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份包含不安全的路徑、連結或特殊檔案：%@"}}}
    },
    "This backup exceeds the supported file, size or manifest limits." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este backup excede os limites compatíveis de arquivos, tamanho ou manifesto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 백업은 지원되는 파일 수, 크기 또는 매니페스트 한도를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This backup exceeds the supported file, size or manifest limits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバックアップは、対応するファイル数、サイズ、またはマニフェストの上限を超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此备份超过支持的文件、大小或清单限制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此備份超過支援的檔案、大小或資訊清單限制。"}}}
    },
    "The backup changed after it was reviewed. Preview it again before restoring." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O backup mudou depois de ser revisado. Pré-visualize-o novamente antes de restaurar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검토 후 백업이 변경되었습니다. 복원하기 전에 다시 미리보기를 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The backup changed after it was reviewed. Preview it again before restoring."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認後にバックアップが変更されました。復元前にもう一度プレビューしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份在检查后发生变化。恢复前请重新预览。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份在檢查後發生變更。還原前請重新預覽。"}}}
    },
    "Image placement requires an enabled independent display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O posicionamento da imagem exige um monitor independente ativado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지를 배치하려면 활성화된 독립 디스플레이가 필요합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Image placement requires an enabled independent display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の配置には、有効な独立ディスプレイが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图像位置设置需要已启用的独立显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影像位置設定需要已啟用的獨立顯示器。"}}}
    },
    "Image placement is available only for unmodified image pages generated by WallpaperMachine." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O posicionamento da imagem só está disponível para páginas de imagem não modificadas geradas pelo WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 배치는 WallpaperMachine이 생성한 후 수정되지 않은 이미지 페이지에서만 사용할 수 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Image placement is available only for unmodified image pages generated by WallpaperMachine."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の配置は、WallpaperMachine が生成した未変更の画像ページでのみ使用できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图像位置设置仅适用于 WallpaperMachine 生成且未经修改的图像页面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影像位置設定僅適用於 WallpaperMachine 產生且未經修改的影像頁面。"}}}
    },
    "This wallpaper is not an unmodified image page generated by WallpaperMachine." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede não é uma página de imagem não modificada gerada pelo WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면은 WallpaperMachine에서 생성한 수정되지 않은 이미지 페이지가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is not an unmodified image page generated by WallpaperMachine."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙は、WallpaperMachine が生成した未変更の画像ページではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸不是 WallpaperMachine 生成且未经修改的图像页面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布不是 WallpaperMachine 產生且未經修改的影像頁面。"}}}
    },
    "Saved the applied wallpaper properties." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As propriedades aplicadas do papel de parede foram salvas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "적용된 배경화면 속성을 저장했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Saved the applied wallpaper properties."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙プロパティを保存しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存已应用的壁纸属性。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存已套用的桌布屬性。"}}}
    },
    "The property preset failed: %@. Pending preset edits could not be reverted: %@. Refresh and revert before continuing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A predefinição de propriedades falhou: %@. Não foi possível reverter as edições pendentes da predefinição: %@. Atualize e reverta antes de continuar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋 적용에 실패했습니다: %@. 보류 중인 프리셋 편집 내용을 되돌릴 수 없습니다: %@. 새로 고침하고 되돌린 후 계속하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The property preset failed: %@. Pending preset edits could not be reverted: %@. Refresh and revert before continuing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットが失敗しました：%@。保留中のプリセット編集を元に戻せませんでした：%@。更新して編集を元に戻してから続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设失败：%@。无法撤销待处理的预设编辑：%@。请刷新并撤销后再继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設失敗：%@。無法還原待處理的預設編輯：%@。請重新整理並還原後再繼續。"}}}
    },
    "Property preset applied." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades aplicada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋을 적용했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Property preset applied."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを適用しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设已应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設已套用。"}}}
    },
    "Export Property Preset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Exportar Predefinição de Propriedades"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋 내보내기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Export Property Preset"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを書き出す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导出属性预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯出屬性預設"}}}
    },
    "Managed assets up to 32 MB are bundled. External file references are not portable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Recursos gerenciados de até 32 MB são incluídos. Referências a arquivos externos não são portáteis."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "최대 32 MB의 관리 대상 에셋이 함께 포함됩니다. 외부 파일 참조는 다른 기기로 옮길 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Managed assets up to 32 MB are bundled. External file references are not portable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最大 32 MB の管理対象アセットを同梱します。外部ファイル参照は移行できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最多 32 MB 的托管资源会打包。外部文件引用不可移植。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "最多 32 MB 的受管理資源會封裝。外部檔案參照無法攜帶至其他電腦。"}}}
    },
    "Property preset exported. External file references require choosing the files again after import." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades exportada. Referências a arquivos externos exigem escolher os arquivos novamente após a importação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋을 내보냈습니다. 외부 파일 참조는 가져온 후 파일을 다시 선택해야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Property preset exported. External file references require choosing the files again after import."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを書き出しました。外部ファイル参照は、読み込み後にファイルを再選択する必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设已导出。导入后需重新选择外部文件引用的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設已匯出。匯入後需重新選擇外部檔案參照的檔案。"}}}
    },
    "Import Property Preset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Importar Predefinição de Propriedades"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋 가져오기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Import Property Preset"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを読み込む"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入属性预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯入屬性預設"}}}
    },
    "Property preset imported. Apply it to change this wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades importada. Aplique-a para alterar este papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋을 가져왔습니다. 이 배경화면을 변경하려면 프리셋을 적용하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Property preset imported. Apply it to change this wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットを読み込みました。この壁紙を変更するには適用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设已导入。应用后才会更改此壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設已匯入。套用後才會變更此桌布。"}}}
    },
    "The link could not be opened. Please try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível abrir o link. Tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "링크를 열 수 없습니다. 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The link could not be opened. Please try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リンクを開けませんでした。もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法打开链接，请重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法開啟連結，請重試。"}}}
    },
    "Release notes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Notas da versão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "릴리스 노트"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Release notes"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "リリースノート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新说明"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新說明"}}}
    },
    "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não conseguiu concluir a avaliação de segurança do SteamCMD. Tente novamente após resolver o erro de segurança do sistema; uma aprovação explícita não pode contornar uma falha na avaliação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 SteamCMD 보안 평가를 완료하지 못했습니다. 시스템 보안 오류를 해결한 후 다시 시도하세요. 명시적으로 승인해도 평가 실패를 우회할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはSteamCMDのセキュリティ評価を完了できませんでした。システムのセキュリティエラーを解決してから再試行してください。明示的に承認しても、評価の失敗を回避することはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未能完成对 SteamCMD 的安全评估。请先解决系统安全错误再重试；手动批准无法跳过评估失败。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 無法完成 SteamCMD 的安全性評估。請先解決系統安全性錯誤再重試；即使手動核准，也無法略過評估失敗。"}}}
    },
    "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não aprovou o SteamCMD em %@. Revise e aprove esta cópia do SteamCMD, ou siga as orientações da Apple sobre segurança de apps, e depois clique em Tentar Novamente. Os ajustes de segurança do sistema não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 %@에 있는 SteamCMD를 승인하지 않았습니다. 이 SteamCMD 사본을 검토하고 승인하거나 Apple의 앱 보안 안내를 따른 후 ‘다시 시도’를 선택하세요. 시스템 보안 설정은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSは%@にあるSteamCMDを承認していません。このSteamCMDのコピーを確認して承認するか、Appleのアプリのセキュリティに関するガイダンスに従ってから、「再試行」をクリックしてください。システムのセキュリティ設定は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准位于 %@ 的 SteamCMD。请检查并批准这份副本，或按照 Apple 的安全指引操作，然后重试。系统安全设置没有被修改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未核准位於 %@ 的 SteamCMD。請檢查並核准這份 SteamCMD 副本，或依照 Apple 的 App 安全性指引操作，然後重試。系統安全性設定未經變更。"}}}
    },
    "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O candidato à aprovação do SteamCMD ou o registro privado de aprovação foi alterado ou não é seguro. Revise a cópia atual novamente; nenhuma aprovação foi salva."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "승인 대상 SteamCMD 또는 비공개 승인 기록이 변경되었거나 안전하지 않습니다. 현재 사본을 다시 검토하세요. 승인은 저장되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "承認対象のSteamCMD、または非公開の承認記録が変更されたか、安全ではありません。現在のコピーをもう一度確認してください。承認は保存されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "待批准的 SteamCMD 或批准记录已变化或不安全，本次没有保存批准。请重新检查当前副本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "待核准的 SteamCMD 或私人核准記錄已變更或不安全。請重新檢查目前的副本；未儲存任何核准。"}}}
    },
    "The retained SteamCMD candidate changed. Review it again before approving." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O candidato do SteamCMD retido foi alterado. Revise-o novamente antes de aprovar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관된 SteamCMD 후보가 변경되었습니다. 승인하기 전에 다시 검토하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The retained SteamCMD candidate changed. Review it again before approving."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されているSteamCMDの候補が変更されました。承認する前にもう一度確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留的 SteamCMD 已发生变化，请重新检查后再批准。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留的待核准 SteamCMD 已變更。核准前請重新檢查。"}}}
    },
    "Allow this SteamCMD installation?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permitir esta instalação do SteamCMD?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 SteamCMD 설치본을 허용할까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Allow this SteamCMD installation?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamCMDを許可しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要允许这份 SteamCMD 运行吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要允許這份 SteamCMD 安裝嗎？"}}}
    },
    "Allow This Copy and Continue" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permitir Esta Cópia e Continuar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 사본 허용 후 계속"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Allow This Copy and Continue"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコピーを許可して続ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许这份副本并继续"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "允許此副本並繼續"}}}
    },
    "Discard Download" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Descartar Download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 폐기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Discard Download"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードを破棄"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "捨棄下載"}}}
    },
    "Refresh all wallpaper state before applying again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualize todo o estado dos papéis de parede antes de aplicar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 적용하기 전에 모든 배경화면의 상태를 새로고침하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Refresh all wallpaper state before applying again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "もう一度適用する前に、すべての壁紙の状態を更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "再次应用前，请刷新所有壁纸状态。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "再次套用前，請重新整理所有桌布狀態。"}}}
    },
    "Choose Image" : {
