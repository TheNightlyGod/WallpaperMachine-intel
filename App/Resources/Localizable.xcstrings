    },
    "Wallpaper per Desktop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de Parede por Mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑별 배경화면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップごとの壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每个桌面独立壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個桌面獨立桌布"}}}
    },
    "Disk space, backups and troubleshooting." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Espaço em disco, backups e solução de problemas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스크 공간, 백업 및 문제 해결."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスク容量、バックアップ、トラブルシューティング。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "磁盘空间、备份与故障排除。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "磁碟空間、備份與疑難排解。"}}}
    },
    "Each display’s wallpaper, playlist and automatic changes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede, a playlist e as trocas automáticas de cada monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "각 디스플레이의 배경화면, 재생목록 및 자동 변경 설정입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "各ディスプレイの壁紙、プレイリスト、自動切り替え。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每台显示器的壁纸、播放列表和自动切换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每台顯示器的桌布、播放列表和自動切換。"}}}
    },
    "Energy use, picture quality and the renderers behind them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Consumo de energia, qualidade da imagem e os renderizadores por trás deles."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "에너지 사용량, 화질 및 이를 처리하는 렌더러 설정입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量、画質、それを支えるレンダラ。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗、画质，以及背后的渲染器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能耗、畫質，以及背後的渲染器。"}}}
    },
    "Group wallpapers to browse them together or play them in turn." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Agrupe papéis de parede para navegar por eles juntos ou reproduzi-los em sequência."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 그룹으로 묶어 함께 탐색하거나 차례로 재생합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をまとめて、一緒に閲覧したり順番に再生したりできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸分组，便于一起浏览，也可以轮流播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布分組，便於一起瀏覽，也可以輪流播放。"}}}
    },
    "Help" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ajuda"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "도움말"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ヘルプ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "帮助"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "說明"}}}
    },
    "Zoom In" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ampliar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "확대"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "拡大"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "放大"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "放大"}}}
    },
