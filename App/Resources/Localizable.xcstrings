    },
    "Scale factor" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Fator de escala"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배율 계수"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スケール倍率"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缩放系数"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "縮放係數"}}}
    },
