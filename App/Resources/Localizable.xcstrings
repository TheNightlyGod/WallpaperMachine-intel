      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "インターフェイス"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "界面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "介面"}}}
    },
