    },
    "The update is waiting to download." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A atualização está aguardando para ser baixada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 다운로드를 기다리고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートはダウンロード待ちです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新正在等待下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新正在等待下載。"}}}
    },
    "Its author updated it on the Workshop on %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O autor o atualizou no Workshop em %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제작자가 %@에 창작마당에서 업데이트했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "作成者が%@にワークショップでアップデートしました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "作者已于 %@ 在创意工坊中更新了它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "作者已於 %@ 在工作坊更新此桌布。"}}}
    },
    "Its author updated it on the Workshop." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O autor o atualizou no Workshop."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제작자가 창작마당에서 업데이트했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "作成者がワークショップでアップデートしました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "作者已在创意工坊中更新了它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "作者已在工作坊更新此桌布。"}}}
    },
    "Workshop updates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizações do Workshop"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창작마당 업데이트"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップのアップデート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创意工坊更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "工作坊更新"}}}
    },
    "Check once a day" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificar uma vez por dia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "하루에 한 번 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1日に1回確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每天检查一次"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每天檢查一次"}}}
    },
    "Asks Steam which of your installed Workshop wallpapers have changed since you got them. Only their ids are sent, and no sign-in is needed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pergunta à Steam quais dos seus papéis de parede instalados do Workshop mudaram desde que você os obteve. Apenas os IDs deles são enviados, e não é preciso iniciar sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 창작마당 배경화면 중 다운로드 이후 변경된 항목을 Steam에 확인합니다. 배경화면 ID만 전송되며 로그인은 필요하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みのワークショップ壁紙のうち、入手後に変更されたものをSteamに問い合わせます。送信されるのは壁紙のIDだけで、サインインは必要ありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "向 Steam 询问已安装的创意工坊壁纸中，哪些在你获取后有过更改。只会发送它们的 ID，无需登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "向 Steam 查詢已安裝的工作坊桌布中，有哪些在你取得後有所變更。只會傳送它們的 ID，且不需要登入。"}}}
    },
    "Last check" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Última verificação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "마지막 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "前回の確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上次检查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上次檢查"}}}
    },
    "Check Now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificar Agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "今すぐ確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "立即检查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "立即檢查"}}}
    },
