    },
    "Install timed out: the app did not quit and relaunch." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Install timed out: the app did not quit and relaunch."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールがタイムアウトしました：Appが終了して再起動しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装超时：应用没有退出并重新打开。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝逾時：App 未結束並重新開啟。"}}}
    },
    "macOS did not accept the desktop click preference. Change “Click wallpaper to reveal desktop” in System Settings › Desktop & Dock instead." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not accept the desktop click preference. Change “Click wallpaper to reveal desktop” in System Settings › Desktop & Dock instead."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがデスクトップのクリック設定を受け付けませんでした。代わりに「システム設定」›「デスクトップとDock」で「壁紙をクリックしてデスクトップを表示」を変更してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 没有接受这项设置。请在“系统设置 › 桌面与程序坞”中直接更改“点按墙纸以显示桌面”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受桌面點按偏好設定。請改在「系統設定 › 桌面與 Dock」中更改「按一下背景圖片來顯示桌面」。"}}}
    },
    "Steam returned status %lld for a preview image." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam returned status %lld for a preview image."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがプレビュー画像に対してステータス%lldを返しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回预览图时出错（状态码 %lld）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取得預覽圖時，Steam 傳回狀態碼 %lld。"}}}
    },
    "The preview image is too large to use as a thumbnail." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The preview image is too large to use as a thumbnail."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビュー画像が大きすぎるため、サムネイルとして使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图太大，无法用作缩略图。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽圖太大，無法用作縮圖。"}}}
    },
    "The original macOS wallpaper could not be recovered. Select your wallpaper again in System Settings." : {
      "localizations" : {"en": {"stringUnit": {"state": "translated", "value": "The original macOS wallpaper could not be recovered. Select your wallpaper again in System Settings."}}, "ja": {"stringUnit": {"state": "translated", "value": "元のmacOSの壁紙を復元できませんでした。システム設定で壁紙を選び直してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法恢复原来的 macOS 壁纸。请在系统设置中重新选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法還原原本的 macOS 桌布。請在系統設定中重新選擇桌布。"}}}
    },
    "The preview image could not be decoded." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The preview image could not be decoded."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビュー画像をデコードできませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法解码预览图。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法解碼預覽圖。"}}}
    },
