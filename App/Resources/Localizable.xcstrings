    },
    "Check compatibility" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Verificar compatibilidade"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "호환성 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "互換性をチェック"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "检查兼容性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "檢查相容性"}}}
    },
    "Reads the wallpaper’s files again and re-runs the checks" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Lê os arquivos do papel de parede de novo e refaz as verificações"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 파일을 다시 읽고 검사를 다시 실행합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のファイルを読み直して、チェックをやり直します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新读取壁纸文件并再次运行检查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新讀取桌布檔案並再次執行檢查"}}}
    },
    "Choose an enabled, independent target display to check this wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um monitor de destino ativado e independente para verificar este papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면을 검사하려면 활성화된 독립 대상 디스플레이를 선택하세요"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙をチェックするには、有効な独立した対象ディスプレイを選んでください"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择一台已启用的独立目标显示器来检查此壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇已啟用的獨立目標顯示器來檢查此桌布"}}}
    },
    "Reading the wallpaper’s files…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Lendo os arquivos do papel de parede…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 파일 읽는 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のファイルを読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在读取壁纸文件…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在讀取桌布檔案…"}}}
    },
    "Black bars" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tarjas pretas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "黑边"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "黑邊"}}}
    },
    "Some videos have black bars baked into the picture. Looking samples a few frames of the file; nothing is changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alguns vídeos têm tarjas pretas embutidas na imagem. A busca analisa alguns quadros do arquivo; nada é alterado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일부 비디오는 영상 자체에 검은 여백이 포함되어 있습니다. 확인할 때는 파일에서 몇 개의 프레임만 검사하며, 아무것도 변경하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオによっては、映像そのものに黒帯が焼き込まれていることがあります。確認ではファイルから数フレームを調べるだけで、何も変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "有些视频的画面本身就带有黑边。检查只会从文件中抽取几帧，不会更改任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "有些影片的畫面本身就帶有黑邊。檢查只會從檔案中擷取幾個影格，不會變更任何內容。"}}}
    },
    "Look for black bars" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Procurar tarjas pretas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯を確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "检查黑边"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "檢查黑邊"}}}
    },
    "Look again" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Procurar novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 확인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "もう一度確認"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新检查"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "再次檢查"}}}
    },
    "Looking for black bars…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Procurando tarjas pretas…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백 확인 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯を確認中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在检查黑边…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在檢查黑邊…"}}}
    },
    "No black bars found." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma tarja preta encontrada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백을 찾지 못했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯は見つかりませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未发现黑边。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未發現黑邊。"}}}
    },
    "Black bars found at the top and bottom, about %lld%% of the picture on each side." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tarjas pretas encontradas em cima e embaixo, com cerca de %lld%% da imagem em cada lado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "상하에 각각 영상의 약 %lld%%를 차지하는 검은 여백이 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "上下に黒帯が見つかりました。それぞれ映像の約%lld%%を占めています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在上方和下方发现黑边，各约占画面的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在上方與下方發現黑邊，各約佔畫面的 %lld%%。"}}}
    },
    "Black bars found at the left and right, about %lld%% of the picture on each side." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tarjas pretas encontradas à esquerda e à direita, com cerca de %lld%% da imagem em cada lado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "좌우에 각각 영상의 약 %lld%%를 차지하는 검은 여백이 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "左右に黒帯が見つかりました。それぞれ映像の約%lld%%を占めています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在左侧和右侧发现黑边，各约占画面的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在左側與右側發現黑邊，各約佔畫面的 %lld%%。"}}}
    },
    "Black bars found on all four sides, up to %lld%% of the picture." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tarjas pretas encontradas nos quatro lados, com até %lld%% da imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네 면 모두에 영상의 최대 %lld%%를 차지하는 검은 여백이 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "四辺すべてに黒帯が見つかりました。最大で映像の%lld%%を占めています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "四边都发现黑边，最宽占画面的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "四邊都發現黑邊，最寬佔畫面的 %lld%%。"}}}
    },
    "With Fill on this display, a scale factor of ×%@ hides them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Com Preencher neste monitor, um fator de escala de ×%@ as oculta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 ‘채우기’를 사용하고 배율을 ×%@로 설정하면 검은 여백을 가릴 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイで「画面いっぱいに表示」を選び、スケール倍率を×%@にすると隠せます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此显示器上选择“填充”并将缩放系数设为 ×%@，即可隐藏黑边。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此顯示器上選擇「填滿」並將縮放係數設為 ×%@，即可隱藏黑邊。"}}}
    },
    "Fill on this display already crops them out." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preencher neste monitor já as corta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서는 ‘채우기’가 이미 검은 여백을 잘라냅니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイでは、「画面いっぱいに表示」ですでに黒帯が切り取られます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此显示器上，“填充”已经会裁掉黑边。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此顯示器上，「填滿」已經會裁掉黑邊。"}}}
    },
    "This display uses %@ scaling. Black bars can be hidden with Fill and a scale factor." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este monitor usa a escala %@. As tarjas pretas podem ser ocultadas com Preencher e um fator de escala."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이는 %@ 크기 조절을 사용합니다. ‘채우기’와 배율을 사용하면 검은 여백을 가릴 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイのスケーリングモードは「%@」です。黒帯は「画面いっぱいに表示」とスケール倍率で隠せます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器的缩放模式为“%@”。黑边可通过“填充”和缩放系数来隐藏。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器的縮放模式為「%@」。黑邊可透過「填滿」和縮放係數來隱藏。"}}}
    },
    "The bars are uneven, so a scale factor could not hide them without cutting into the picture." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As tarjas são desiguais, então um fator de escala não conseguiria ocultá-las sem cortar a imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백의 크기가 고르지 않아 이미지 일부를 자르지 않고는 배율로 가릴 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯の幅が揃っていないため、スケール倍率で隠そうとすると映像の一部も切れてしまいます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "黑边宽度不均匀，用缩放系数隐藏会连同部分画面一起裁掉。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "黑邊寬度不均勻，用縮放係數隱藏會連同部分畫面一起裁掉。"}}}
    },
    "The bars look too large to be reliable, so nothing is suggested." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As tarjas parecem grandes demais para serem confiáveis, então nada é sugerido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검은 여백이 너무 커서 신뢰할 수 없으므로 제안하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "黒帯が大きすぎて信頼できないため、提案はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "黑边大得不太可信，因此不提供建议。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "黑邊大到不太可信，因此不提供建議。"}}}
    },
    "The sampled frames are too dark to tell." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os quadros analisados são escuros demais para saber."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "표본 프레임이 너무 어두워 판단할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "調べたフレームが暗すぎて判断できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "抽取的帧太暗，无法判断。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "擷取的影格太暗，無法判斷。"}}}
    },
    "The sampled frames do not agree on where the bars are." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os quadros analisados não concordam sobre onde estão as tarjas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "표본 프레임 간에 검은 여백의 위치가 일치하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "調べたフレーム間で黒帯の位置が一致しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "抽取的各帧对黑边位置的判断不一致。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "擷取的各影格對黑邊位置的判斷不一致。"}}}
    },
    "Too few different frames could be sampled to tell." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível analisar quadros diferentes suficientes para saber."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "서로 다른 프레임을 충분히 추출하지 못해 판단할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "判断するのに十分な数の異なるフレームを取得できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能抽取到的不同帧太少，无法判断。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能擷取到的不同影格太少，無法判斷。"}}}
    },
    "This video cannot be read here, so it cannot be checked." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo não pode ser lido aqui, então não pode ser verificado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "여기서는 이 동영상을 읽을 수 없어 검사할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオはここでは読み込めないため、確認できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法在此读取该视频，因此无法检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法在此讀取這部影片，因此無法檢查。"}}}
    },
    "Reading the video took too long." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A leitura do vídeo demorou demais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "비디오를 읽는 데 너무 오래 걸렸습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオの読み込みに時間がかかりすぎました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "读取视频耗时过长。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讀取影片耗時過長。"}}}
    },
    "The video changed while it was being checked. Look again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O vídeo mudou durante a verificação. Procure novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검사 중 동영상이 변경되었습니다. 다시 확인하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認中にビデオが変更されました。もう一度確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "检查期间视频发生了变化，请重新检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "檢查期間影片發生了變化，請再次檢查。"}}}
    },
    "Set scale factor to ×%@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Definir fator de escala como ×%@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배율 계수를 ×%@로 설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スケール倍率を×%@に設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将缩放系数设为 ×%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將縮放係數設為 ×%@"}}}
    },
    "Scale factor is set to ×%@. Choose Apply changes to keep it, or Revert to undo." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O fator de escala está definido como ×%@. Escolha Aplicar alterações para mantê-lo ou Reverter para desfazer."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배율 계수가 ×%@로 설정되었습니다. 유지하려면 ‘변경 사항 적용’을, 취소하려면 ‘되돌리기’를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スケール倍率を×%@に設定しました。保持するには「変更を適用」、取り消すには「元に戻す」を選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缩放系数已设为 ×%@。选择“应用修改”以保留，或选择“还原”以撤销。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "縮放係數已設為 ×%@。選擇「套用變更」以保留，或選擇「還原」以復原。"}}}
    },
    "Fills in this display’s Scale factor. Nothing is saved until you choose Apply changes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Preenche o Fator de escala deste monitor. Nada é salvo até você escolher Aplicar alterações."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이의 배율을 입력합니다. ‘변경 사항 적용’을 선택하기 전까지는 저장되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイのスケール倍率を入力します。「変更を適用」を選ぶまで保存されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "填入此显示器的缩放系数。在选择“应用修改”之前不会保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "填入此顯示器的縮放係數。在選擇「套用變更」之前不會儲存。"}}}
    },
    "Collection “%@”" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Coleção “%@”"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션 ‘%@’"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクション「%@」"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "合集“%@”"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏集「%@」"}}}
    },
    "A collection that no longer exists" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma coleção que não existe mais"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "더 이상 존재하지 않는 컬렉션"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "存在しないコレクション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已不存在的合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已不存在的收藏集"}}}
    },
    "a removed wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "um papel de parede removido"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제거된 배경화면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除された壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已移除的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已移除的桌布"}}}
    },
    "left as it is" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "sem alteração"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "그대로 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更しない"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保持不变"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保持不變"}}}
    },
    "%@, %@, %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@, %@, %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@, %@, %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@、%2$@、%3$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，%2$@，%3$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，%2$@，%3$@"}}}
    },
    "Day: %@ from %@; night: %@ from %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Dia: %@ a partir de %@; noite: %@ a partir de %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮: %@ (%@부터); 밤: %@ (%@부터)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "昼：%1$@（%2$@から）、夜：%3$@（%4$@から）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "白天：%1$@，从 %2$@ 起；夜晚：%3$@，从 %4$@ 起"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "白天：%1$@，自 %2$@ 起；夜晚：%3$@，自 %4$@ 起"}}}
    },
    "The collection this rotation used was deleted, so it plays nothing until you choose another source." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A coleção usada por esta rotação foi apagada, então nada é reproduzido até você escolher outra origem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 순환 재생에서 사용하던 컬렉션이 삭제되어 다른 소스를 선택할 때까지 아무것도 재생하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このローテーションで使っていたコレクションは削除されたため、別のソースを選ぶまで何も再生されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此轮换使用的合集已被删除，在你选择其他来源前不会播放任何壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此輪播所用的收藏集已被刪除，在你選擇其他來源前不會播放任何桌布。"}}}
    },
    "Collections you make in Installed appear here too." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As coleções que você cria em Instalados também aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘설치됨’에서 만든 컬렉션도 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「インストール済み」で作成したコレクションもここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你在“已安装”中创建的合集也会出现在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你在「已安裝」中建立的收藏集也會出現在這裡。"}}}
    },
    "Playlist name" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nome da playlist"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록 이름"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリスト名"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放列表名称"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放列表名稱"}}}
    },
    "Saved playlist for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlist salva para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 저장된 재생목록"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の保存済みプレイリスト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的已保存播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的已儲存播放列表"}}}
    },
    "Choose a saved playlist…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher uma playlist salva…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록 선택…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みプレイリストを選択…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择已保存的播放列表…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇已儲存的播放列表…"}}}
    },
    "No saved playlists yet" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma playlist salva"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 저장된 재생목록 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みプレイリストはまだありません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有已保存的播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無已儲存的播放列表"}}}
    },
    "Save as…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar como…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "별도 저장…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別名で保存…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "存为…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存為…"}}}
    },
    "Using “%@”. Changing a setting above keeps this display’s copy and detaches it from the saved playlist." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usando “%@”. Alterar um ajuste acima mantém a cópia deste monitor e a desvincula da playlist salva."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’ 사용 중입니다. 위 설정을 변경하면 이 디스플레이의 사본은 유지되며 저장된 재생목록과의 연결은 해제됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を使用中です。上の設定を変更すると、このディスプレイはコピーを保持したまま、保存済みプレイリストから切り離されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用“%@”。更改上方任一设置后，此显示器会保留自己的副本，并与已保存的播放列表脱离关联。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用「%@」。更改上方任一設定後，此顯示器會保留自己的副本，並與已儲存的播放列表脫離關聯。"}}}
    },
    "Turn the playlist on to save it, or apply a saved one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ative a playlist para salvá-la ou aplique uma salva."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록을 켜서 저장하거나, 저장된 재생목록을 적용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレイリストをオンにすると保存できます。保存済みのものを適用することもできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "开启播放列表后即可保存，或应用一个已保存的播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟播放列表後即可儲存，或套用已儲存的播放列表。"}}}
    },
    "Applying a saved playlist copies its settings to this display. Save as… keeps the settings above under a name." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar uma playlist salva copia os ajustes dela para este monitor. Salvar como… guarda os ajustes acima com um nome."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록을 적용하면 해당 설정이 이 디스플레이에 복사됩니다. ‘별도 저장…’은 위 설정에 이름을 붙여 저장합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みプレイリストを適用すると、その設定がこのディスプレイにコピーされます。「別名で保存…」は上の設定に名前を付けて保存します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用已保存的播放列表会把它的设置复制到此显示器。“存为…”会用一个名称保存上方的设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用已儲存的播放列表會將其設定拷貝到此顯示器。「儲存為…」會以一個名稱保存上方的設定。"}}}
    },
    "On 1 display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em 1 monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 1대에서 사용 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1台のディスプレイで使用中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "用于 1 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "用於 1 台顯示器"}}}
    },
    "On %lld displays" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em %lld monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 %lld대에서 사용 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld台のディスプレイで使用中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "用于 %lld 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "用於 %lld 台顯示器"}}}
    },
    "Delete “%@”? Displays using it keep their current playlist." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar “%@”? Os monitores que a usam mantêm a playlist atual."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’을(를) 삭제할까요? 이를 사용하는 디스플레이는 현재 재생목록을 유지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を削除しますか？使用中のディスプレイは現在のプレイリストを保持します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要删除“%@”吗？正在使用它的显示器会保留当前的播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要刪除「%@」嗎？正在使用它的顯示器會保留目前的播放列表。"}}}
    },
    "Delete “%@”?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar “%@”?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’을(를) 삭제할까요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を削除しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要删除“%@”吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要刪除「%@」嗎？"}}}
    },
    "Saved playlists" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Playlists salvas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 재생목록"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みプレイリスト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的播放列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的播放列表"}}}
    },
    "No saved playlists yet. Set up a display’s playlist above, then choose Save as…." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma playlist salva. Configure a playlist de um monitor acima e escolha Salvar como…."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 저장된 재생목록이 없습니다. 위에서 디스플레이의 재생목록을 설정한 다음 ‘별도 저장…’을 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みプレイリストはまだありません。上でディスプレイのプレイリストを設定してから「別名で保存…」を選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有已保存的播放列表。先在上方设置某台显示器的播放列表，再选取“存为…”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無已儲存的播放列表。請先在上方設定某台顯示器的播放列表，再選擇「儲存為…」。"}}}
    },
    "Backup" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Backup"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份"}}}
    },
    "Back up settings" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Fazer backup dos ajustes"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 백업"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定をバックアップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份設定"}}}
    },
    "Saves a .wmbackup package with the renderer settings, every wallpaper’s options, playlists, collections, presets, favorites and the files you chose for wallpapers. Steam sign-ins, passwords, logs and caches are never included." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva um pacote .wmbackup com os ajustes do renderizador, as opções de cada papel de parede, playlists, coleções, predefinições, favoritos e os arquivos que você escolheu para papéis de parede. Inícios de sessão da Steam, senhas, registros e caches nunca são incluídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "렌더러 설정, 각 배경화면의 옵션, 재생목록, 컬렉션, 프리셋, 즐겨찾기 및 배경화면용으로 선택한 파일을 .wmbackup 패키지로 저장합니다. Steam 로그인 정보, 암호, 로그 및 캐시는 절대 포함되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラの設定、各壁紙のオプション、プレイリスト、コレクション、プリセット、お気に入り、壁紙用に選んだファイルをまとめた.wmbackupパッケージを保存します。Steamのサインイン情報、パスワード、ログ、キャッシュは含まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存一个 .wmbackup 包，包含渲染器设置、每张壁纸的选项、播放列表、合集、预设、收藏，以及你为壁纸选择的文件。绝不会包含 Steam 登录信息、密码、日志和缓存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存一個 .wmbackup 套件，內含渲染器設定、每張桌布的選項、播放列表、收藏集、預設集、最愛，以及你為桌布選擇的檔案。絕不會包含 Steam 登入資訊、密碼、記錄檔和快取。"}}}
    },
    "Include the wallpaper library" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Incluir a biblioteca de papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 포함"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを含める"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "包含壁纸库"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "包含桌布庫"}}}
    },
    "Copies every installed wallpaper as well, which can take a lot of space. Without it, a restore lists the wallpapers to download or import again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copia também todos os papéis de parede instalados, o que pode ocupar muito espaço. Sem isso, uma restauração lista os papéis de parede a baixar ou importar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 모든 배경화면도 복사하므로 많은 공간이 필요할 수 있습니다. 포함하지 않으면 복원 시 다시 다운로드하거나 가져와야 할 배경화면 목록이 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの壁紙もすべてコピーするため、容量を大きく使うことがあります。含めない場合、復元時にダウンロードや読み込みをやり直す壁紙の一覧が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "同时复制每张已安装的壁纸，可能占用大量空间。不包含时，恢复会列出需要重新下载或导入的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "同時拷貝每張已安裝的桌布，可能佔用大量空間。若不包含，回復時會列出需要重新下載或匯入的桌布。"}}}
    },
    "Made %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Criado em %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 생성됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に作成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创建于 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "製作於 %@"}}}
    },
    "%lld preset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld predefinição"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセット%lld個"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個預設集"}}}
    },
    "%lld presets" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld predefinições"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセット%lld個"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個預設集"}}}
    },
    "%lld collection" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld coleção"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクション%lld個"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個收藏集"}}}
    },
    "%lld collections" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld coleções"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクション%lld個"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個收藏集"}}}
    },
    "wallpaper library included" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "biblioteca de papéis de parede incluída"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 보관함 포함"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ライブラリを含む"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "包含壁纸库"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "包含桌布庫"}}}
    },
    "no wallpaper files" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "sem arquivos de papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 파일 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ファイルなし"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不含壁纸文件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不含桌布檔案"}}}
    },
    "Where the backup and this Mac disagree" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Onde o backup e este Mac divergem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업과 이 Mac의 내용이 다른 항목"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップとこのMacで内容が異なる場合"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份与这台 Mac 不一致时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份與這台 Mac 不一致時"}}}
    },
    "Keep what is on this Mac" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Manter o que está neste Mac"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac의 항목 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacの内容を残す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留这台 Mac 上的内容"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留這台 Mac 上的內容"}}}
    },
    "Replace with the backup" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Substituir pelo backup"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업으로 대치"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップで置き換える"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "用备份替换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以備份取代"}}}
    },
    "Backup to restore" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Backup a restaurar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원할 백업"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元するバックアップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要恢复的备份"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要回復的備份"}}}
    },
    "Already on this Mac" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Já está neste Mac"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에 이미 있음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacにすでにあるもの"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台 Mac 上已有"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這台 Mac 上已有"}}}
    },
    "These items exist here and in the backup. Keep what is on this Mac, or replace it with the backup’s version." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Estes itens existem aqui e no backup. Mantenha o que está neste Mac ou substitua pela versão do backup."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 항목은 이 Mac과 백업에 모두 있습니다. 이 Mac의 항목을 유지하거나 백업의 버전으로 교체하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "これらの項目はこのMacとバックアップの両方にあります。このMacの内容を残すか、バックアップの内容で置き換えるかを選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这些项目在这台 Mac 和备份中都存在。可以保留这台 Mac 上的内容，或用备份中的版本替换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這些項目在這台 Mac 和備份中都存在。可以保留這台 Mac 上的內容，或以備份中的版本取代。"}}}
    },
    "Before you restore" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Antes de restaurar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원하기 전에"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元の前に"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复前请注意"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回復前請注意"}}}
    },
    "Restore at next launch" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaurar na próxima abertura"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 실행 시 복원"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次回起動時に復元"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下次启动时恢复"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下次啟動時回復"}}}
    },
    "Choose another…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher outro…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 항목 선택…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のものを選択…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "另选一个…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另選一個…"}}}
    },
    "Nothing changes until you quit and reopen WallpaperMachine. The restore is applied before anything else loads, keeps the current files until it has finished, and puts them back if it fails." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nada muda até você encerrar e reabrir o WallpaperMachine. A restauração é aplicada antes de qualquer outra coisa carregar, mantém os arquivos atuais até terminar e os devolve se falhar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine을 종료한 후 다시 열기 전까지는 아무것도 변경되지 않습니다. 다른 항목을 불러오기 전에 복원을 먼저 수행하며, 완료될 때까지 현재 파일을 보관하고 실패하면 원래대로 되돌립니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを終了して開き直すまで何も変わりません。復元はほかの何よりも先に実行され、完了するまで現在のファイルを保持し、失敗した場合は元に戻します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在你退出并重新打开 WallpaperMachine 之前不会有任何改动。恢复会在其他内容加载前执行，完成前保留当前文件，失败时会将其放回原处。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在你結束並重新開啟 WallpaperMachine 之前不會有任何變動。回復會在其他內容載入前執行，完成前保留目前的檔案，失敗時會將其放回原處。"}}}
    },
    "Restore" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaurar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回復"}}}
    },
    "Cancel restore" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar restauração"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元をキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消恢复"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消回復"}}}
    },
    "A restore is ready and will be applied the next time you open WallpaperMachine. Quit and reopen the app when you are ready; it does not restart on its own." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma restauração está pronta e será aplicada na próxima vez que você abrir o WallpaperMachine. Encerre e reabra o app quando quiser; ele não reinicia sozinho."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원 준비가 완료되었으며 다음에 WallpaperMachine을 열 때 적용됩니다. 준비가 되면 앱을 종료한 후 다시 여세요. 앱이 자동으로 재시작되지는 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元の準備ができています。次回WallpaperMachineを開いたときに実行されます。準備ができたらAppを終了して開き直してください。Appが自動で再起動することはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复已准备就绪，会在下次打开 WallpaperMachine 时执行。准备好后请退出并重新打开应用；应用不会自行重启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回復已準備就緒，會在下次開啟 WallpaperMachine 時執行。準備好後請結束並重新開啟 App；App 不會自行重新啟動。"}}}
    },
    "Choose backup…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher backup…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업 선택…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップを選択…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择备份…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇備份…"}}}
    },
    "Pick a .wmbackup package to see what it holds before anything is restored." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um pacote .wmbackup para ver o que ele contém antes que algo seja restaurado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : ".wmbackup 패키지를 선택하면 복원하기 전에 내용을 확인할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : ".wmbackupパッケージを選ぶと、復元する前に内容を確認できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择一个 .wmbackup 包，在恢复任何内容前先查看其中包含什么。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇一個 .wmbackup 套件，在回復任何內容前先查看其中包含什麼。"}}}
    },
    "In progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em andamento"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진행 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "処理中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "进行中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "進行中"}}}
    },
    "Working…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trabalhando…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "처리 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "処理中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在处理…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "處理中…"}}}
    },
    "Backup progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso do backup"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份進度"}}}
    },
    "Output controls are separate from system-audio response." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os controles de saída são separados da resposta ao áudio do sistema."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "출력 제어와 시스템 오디오 반응은 별개의 기능입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "出力の制御とシステム音声への反応は別の機能です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "输出控制与系统音频响应相互独立。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "輸出控制與系統音訊反應相互獨立。"}}}
    },
    "Volume sets the level of the audio and video the page plays through media elements. Sound the page makes with Web Audio does not follow it; only Mute does." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O volume define o nível do áudio e do vídeo que a página reproduz por elementos de mídia. O som que a página produz com Web Audio não o segue; só Silenciar o afeta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음량은 페이지에서 미디어 요소로 재생하는 오디오 및 동영상의 소리 크기를 설정합니다. Web Audio로 생성하는 소리에는 적용되지 않으며, ‘소리 끄기’만 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "音量は、ページがメディア要素で再生するオーディオやビデオの音量を設定します。ページがWeb Audioで鳴らす音には効かず、消音だけが効きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "音量会设置网页通过媒体元素播放的音频和视频的音量。网页用 Web Audio 发出的声音不受它控制，只受静音控制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "音量會設定網頁透過媒體元素播放的音訊和視訊的音量。網頁以 Web Audio 發出的聲音不受它控制，只受靜音控制。"}}}
    },
    "Media volume cannot be changed for this page on this version of macOS." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O volume de mídia não pode ser alterado para esta página nesta versão do macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 macOS 버전에서는 이 페이지의 미디어 음량을 변경할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのmacOSでは、このページのメディア音量を変更できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此版本的 macOS 上无法调整此网页的媒体音量。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此版本的 macOS 上無法調整此網頁的媒體音量。"}}}
    },
    "How far Volume reaches is confirmed once the wallpaper is running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O alcance do volume é confirmado quando o papel de parede estiver em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음량 조절이 적용되는 범위는 배경화면 실행 후 확인됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "音量がどこまで効くかは、壁紙の実行中に確認されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸运行后才能确认音量控制的作用范围。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布執行後才能確認音量控制的作用範圍。"}}}
    },
    "Mute silences the whole page, including sound made with Web Audio." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar emudece a página inteira, inclusive o som produzido com Web Audio."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음소거는 Web Audio로 생성한 소리를 포함하여 페이지 전체의 소리를 끕니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消音はWeb Audioで鳴らす音も含め、ページ全体を消音します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音会让整个网页静音，包括用 Web Audio 发出的声音。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音會讓整個網頁靜音，包括以 Web Audio 發出的聲音。"}}}
    },
    "Whole-page mute is not available on this version of macOS, so this page cannot be muted reliably." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar a página inteira não está disponível nesta versão do macOS, então esta página não pode ser silenciada com segurança."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 macOS 버전에서는 전체 페이지 음소거를 사용할 수 없어 이 페이지의 소리를 확실하게 끌 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このバージョンのmacOSではページ全体の消音を利用できないため、このページを確実に消音することはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此版本的 macOS 不支持整页静音，因此无法可靠地将此网页静音。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此版本的 macOS 不支援整頁靜音，因此無法可靠地將此網頁靜音。"}}}
    },
    "Whether the whole page can be muted is confirmed once the wallpaper is running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Se a página inteira pode ser silenciada é confirmado quando o papel de parede estiver em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 실행되면 전체 페이지의 소리를 끌 수 있는지 확인합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ページ全体を消音できるかどうかは、壁紙の実行中に確認されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸运行后才能确认能否将整个网页静音。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布執行後才能確認能否將整個網頁靜音。"}}}
    },
    "Apply %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用 %@"}}}
    },
    "Close history" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Fechar histórico"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기록 닫기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "履歴を閉じる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭历史记录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉歷史記錄"}}}
    },
    "No recent wallpapers for this display. Apply a wallpaper to start its history." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede recente para este monitor. Aplique um papel de parede para iniciar o histórico."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 최근 사용한 배경화면이 없습니다. 배경화면을 적용하면 기록이 시작됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイには履歴がありません。壁紙を適用すると記録されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器还没有使用记录。应用一张壁纸后，这里会开始记录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器還沒有使用記錄。套用一張桌布後，這裡會開始記錄。"}}}
    },
    "Keeps the last 50 wallpapers used on this display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Guarda os últimos 50 papéis de parede usados neste monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 최근 사용한 배경화면 50개를 기록합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイで最近使った50枚の壁紙を保存します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留此显示器最近使用的 50 张壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留此顯示器最近使用的 50 張桌布。"}}}
    },
    "Drag wallpapers to reorder them, or use Move up and Move down." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arraste os papéis de parede para reordená-los ou use Mover para cima e Mover para baixo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 드래그하거나 ‘위로 이동’과 ‘아래로 이동’을 사용하여 순서를 변경하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ドラッグするか、「上へ」「下へ」で壁紙の順序を変更できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "拖动壁纸调整顺序，也可以使用“上移”和“下移”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "拖曳桌布調整順序，也可以使用「上移」和「下移」。"}}}
    },
    "Drag to reorder" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arraste para reordenar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "드래그하여 순서 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ドラッグして並べ替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "拖动调整顺序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "拖曳調整順序"}}}
    },
    "Move up" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover para cima"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "위로 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "上へ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上移"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上移"}}}
    },
    "Move down" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover para baixo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아래로 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "下へ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下移"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下移"}}}
    },
    "Move %@ up" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover %@ para cima"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 위로 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を上へ移動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "上移 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "上移 %@"}}}
    },
    "Move %@ down" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover %@ para baixo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 아래로 이동"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を下へ移動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下移 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下移 %@"}}}
    },
    "Remove %@ from playlist" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover %@ da playlist"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생목록에서 %@ 제거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@をプレイリストから削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从播放列表移除 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從播放清單移除 %@"}}}
    },
    "Temporarily skipped (%lld)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ignorados temporariamente (%lld)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일시적으로 건너뜀(%lld개)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一時的にスキップ（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂时跳过（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫時略過（%lld）"}}}
    },
    "Failed wallpapers are skipped for 15 minutes. You can still apply one manually." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede com falha são ignorados por 15 minutos. Você ainda pode aplicar um manualmente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실패한 배경화면은 15분 동안 건너뜁니다. 수동으로는 계속 적용할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用に失敗した壁紙は15分間スキップします。手動での適用は引き続き可能です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用失败的壁纸会跳过 15 分钟。你仍可以手动应用它。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用失敗的桌布會略過 15 分鐘。你仍可以手動套用它。"}}}
    },
    "Allow these wallpapers again" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permitir estes papéis de parede novamente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면 다시 허용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "これらの壁紙を再び候補にする"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新允许轮播这些壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新允許輪播這些桌布"}}}
    },
    "Preview wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pré-visualizar papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 미리보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をプレビュー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽桌布"}}}
    },
    "Open a live preview without changing your desktop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir uma pré-visualização ao vivo sem alterar sua mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑을 변경하지 않고 실시간 미리보기 열기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップを変更せずにライブプレビューを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开动态预览，不更改桌面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟動態預覽，不變更桌面"}}}
    },
    "Center" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Centralizar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중앙"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "中央に配置"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "居中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "置中"}}}
    },
    "Center the wallpaper on the display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Centralizar o papel de parede no monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 디스플레이 중앙에 배치합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をディスプレイの中央に配置します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸在显示器上居中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布在顯示器上置中"}}}
    },
    "Choose which part of the wallpaper stays in view when it is larger than the display, or where it sits when it is smaller. Nothing moves when it already fits the display exactly." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha qual parte do papel de parede fica visível quando ele é maior que o monitor, ou onde ele fica quando é menor. Nada se move quando ele já se ajusta exatamente ao monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 디스플레이보다 크면 표시할 부분을, 작으면 배치할 위치를 선택하세요. 이미 디스플레이에 정확히 맞는 경우에는 이동하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙がディスプレイより大きいときは表示する部分を、小さいときは置く位置を選びます。ディスプレイにぴったり収まる壁紙は動きません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸比显示器大时，选择保留哪一部分在画面内；比显示器小时，选择它摆放的位置。壁纸与显示器完全吻合时不会移动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布比顯示器大時，選擇要保留哪一部分在畫面內；比顯示器小時，選擇它擺放的位置。桌布與顯示器完全吻合時不會移動。"}}}
    },
    "Active Display Only" : {
