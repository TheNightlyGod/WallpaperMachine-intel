    },
    "Library & Steam" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリとSteam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库与 Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫與 Steam"}}}
    },
    "Storage" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ストレージ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "存储"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存空間"}}}
    },
    "About" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "情報"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关于"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關於"}}}
    },
    "Settings categories" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "設定のカテゴリ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置分类"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定類別"}}}
    },
    "Settings are unavailable. Try refreshing the library." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "設定を利用できません。ライブラリを更新してみてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置不可用。请尝试刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用設定。請嘗試重新整理桌布庫。"}}}
    },
    "Refresh" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刷新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新整理"}}}
    },
    "Language" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "言語"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "语言"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "語言"}}}
    },
    "The interface and import picker switch at once. Quit and reopen the app to switch menus and other dialogs." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画面と読み込み用のファイル選択ウインドウはすぐに切り替わります。メニューとその他のダイアログを切り替えるには、Appを終了して開き直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "界面和导入文件选择窗口会立即切换。菜单和其他对话框需要退出并重新打开应用后切换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "介面與匯入檔案選擇視窗會立即切換。選單和其他對話框需要結束並重新開啟 App 後切換。"}}}
    },
    "Launch at login" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン時に起動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录时启动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入時啟動"}}}
    },
    "Move the app to Applications to enable." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "有効にするには、Appを「アプリケーション」フォルダに移動してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将应用移到“应用程序”文件夹后即可启用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將 App 移到「應用程式」資料夾後即可啟用。"}}}
    },
    "Allow WallpaperMachine in System Settings → General → Login Items to launch it at login." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン時に起動するには、「システム設定」→「一般」→「ログイン項目」でWallpaperMachineを許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要在登录时启动，请在“系统设置 → 通用 → 登录项”中允许 WallpaperMachine。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "若要在登入時啟動，請在「系統設定」→「一般」→「登入項目」中允許 WallpaperMachine。"}}}
    },
    "Open Login Items…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ログイン項目を開く…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开登录项…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開登入項目…"}}}
    },
    "Keep windows in place when clicking the wallpaper" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をクリックしたときにウインドウを移動しない"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "点击壁纸时保持窗口不动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "按一下桌布時讓視窗保持原位"}}}
    },
    "Hide window after applying a wallpaper" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用したあとにウインドウを隠す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸后隐藏窗口"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用桌布後隱藏視窗"}}}
    },
    "Show property edits on the desktop as I make them" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のプロパティの編集をデスクトップに即時表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在桌面上实时显示我所做的属性修改"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在桌面上即時顯示我所做的屬性變更"}}}
    },
    "While you edit a wallpaper’s properties, your displays follow each change before you press Apply changes, and Revert puts the saved look back. Pictures and options that switch an effect on or off still wait for Apply changes. The lock screen and the Mission Control picture keep the saved look until you apply." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のプロパティを編集している間、「変更を適用」を押す前でも、ディスプレイが変更に追従します。「元に戻す」を押すと保存済みの見た目に戻ります。画像や、エフェクトのオン・オフを切り替えるオプションは、「変更を適用」を押すまで反映されません。ロック画面とMission Controlの画像は、適用するまで保存済みの見た目のままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "编辑壁纸的属性时，显示器会在你按下“应用修改”之前跟随每一项更改，“还原”会恢复已保存的外观。图片，以及用来开关某个效果的选项，仍要等到“应用修改”才会生效。锁定屏幕和调度中心的画面在你应用之前保持已保存的外观。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "編輯桌布的屬性時，顯示器會在你按下「套用變更」之前跟隨每一項變更，「還原」會恢復已儲存的外觀。圖片，以及用來開關某個效果的選項，仍要等到「套用變更」才會生效。鎖定畫面和指揮中心的畫面在你套用之前會維持已儲存的外觀。"}}}
    },
    "Turns off macOS’s “Click wallpaper to reveal desktop” so clicks reach interactive wallpapers." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSの「壁紙をクリックしてデスクトップを表示」をオフにして、クリックがインタラクティブな壁紙に届くようにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭 macOS 的“点按墙纸以显示桌面”，让点击可以传到可交互的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉 macOS 的「按一下背景圖片來顯示桌面」，讓可互動的桌布能接收到滑鼠點按。"}}}
    },
    "Use the wallpaper as the macOS desktop picture" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をmacOSのデスクトップピクチャとして使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸用作 macOS 桌面图片"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布用作 macOS 桌面圖片"}}}
    },
    "Mission Control and the moment before a wallpaper loads show a still frame of the wallpaper. Turn this off to leave macOS’s own wallpaper settings alone; your own picture comes back at once." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlと壁紙の読み込み前の一瞬には、壁紙の静止画が表示されます。オフにすると、WallpaperMachineはmacOS自体の壁紙設定を変更せず、元のデスクトップピクチャがすぐに戻ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "调度中心以及壁纸加载前的片刻会显示壁纸的静态画面。关闭后，WallpaperMachine 不再改动 macOS 自己的壁纸设置，你自己的桌面图片会立即恢复。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指揮中心以及桌布載入前的片刻會顯示桌布的靜態畫面。關閉後，WallpaperMachine 不再更動 macOS 自己的桌布設定，你自己的桌面圖片會立即恢復。"}}}
    },
    "Animate lock screen sets the desktop picture itself, so this cannot be changed while it is on." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「ロック画面をアニメーション表示」がオンの間は、デスクトップピクチャがその機能によって設定されるため、この設定は変更できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“锁定屏幕动态壁纸”会自行设置桌面图片，因此它开启期间无法更改此项。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「鎖定畫面動態桌布」會自行設定桌面圖片，因此它開啟期間無法變更此項目。"}}}
    },
    "Update the Mission Control picture every 5 minutes" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlの画像を5分ごとに更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每 5 分钟更新调度中心中的画面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每 5 分鐘更新指揮中心中的畫面"}}}
    },
    "Mission Control shows a still picture of the wallpaper, retaken when it starts, changes or resumes. This also retakes it while it plays. Not used while the lock screen is animated." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Mission Controlには壁紙の静止画が表示され、壁紙の開始時、変更時、再開時に撮り直されます。オンにすると再生中にも撮り直します。ロック画面のアニメーション表示中は使われません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "调度中心显示的是壁纸的静态画面，会在壁纸开始、更改或恢复播放时重新截取。打开后，播放期间也会重新截取。锁定屏幕动态壁纸开启时不使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指揮中心顯示的是桌布的靜態畫面，會在桌布開始、變更或恢復播放時重新擷取。開啟後，播放期間也會重新擷取。鎖定畫面動態桌布開啟時不使用。"}}}
    },
    "Animate lock screen" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面をアニメーション表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕动态壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面動態桌布"}}}
    },
    "Experimental" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性"}}}
    },
    "Lock screen status" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面の状態"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面狀態"}}}
    },
    "Updating" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "更新中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在更新"}}}
    },
    "Experimental. Applies right away." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実験的機能です。すぐに適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "实验性功能，立即生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "實驗性功能，會立即生效。"}}}
    },
    "Compatibility & permissions" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "互換性とアクセス権"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "兼容性与权限"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "相容性與權限"}}}
    },
    "Lock screen animation uses private macOS APIs and may stop working after a macOS update. While it is on, the app takes over only the Desktop wallpaper selection on displays with an applied scene or video wallpaper, and reloads the macOS wallpaper service. The screen saver is a separate choice below. Turning this off restores the Desktop choices; quitting restores all choices the app changed and keeps other wallpaper changes." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ロック画面のアニメーションはmacOSの非公開APIを使用しているため、macOSのアップデート後に動作しなくなる可能性があります。オンの間は、シーンまたはビデオ壁紙を適用しているディスプレイのDesktop（デスクトップ）の壁紙選択だけをこのAppが管理し、macOSの壁紙サービスを再読み込みします。スクリーンセーバは下の設定で個別に選択できます。この機能をオフにするとDesktopの選択が元に戻ります。Appを終了すると、このAppが変更したすべての選択が元に戻り、それ以外の壁紙の変更は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕动画使用 macOS 私有接口，系统更新后可能失效。开启后，本应用只接管已应用场景或视频壁纸的显示器的 Desktop（桌面）墙纸选项，并重新加载 macOS 墙纸服务。屏幕保护程序可在下方独立设置。关闭此功能会还原桌面选项；退出应用会还原本应用改动的所有选项，并保留其他墙纸更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面動畫使用 macOS 私有 API，macOS 更新後可能會失效。開啟時，本 App 只接管已套用場景或影片桌布之顯示器的 Desktop（桌面）桌布選項，並重新載入 macOS 桌布服務。螢幕保護程式可在下方獨立設定。關閉此功能會還原桌面選項；結束 App 會還原本 App 變更的所有選項，並保留其他桌布變更。"}}}
    },
    "It keeps separate copies of wallpaper files, which uses extra disk space, and may not render on every macOS version. Pause and battery settings still apply." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙ファイルのコピーを別に保持するため、追加のディスク容量を使用します。また、すべてのmacOSバージョンで表示されるとは限りません。一時停止とバッテリーの設定は引き続き適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它会另存一份壁纸文件，需要额外磁盘空间，且不保证在每个 macOS 版本上都能显示。暂停和电池设置同样适用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此功能會另存一份桌布檔案，因此會佔用額外的磁碟空間，且不一定能在每個 macOS 版本上顯示。暫停與電池設定仍然適用。"}}}
    },
    "Screen saver" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式"}}}
    },
    "Use wallpaper as screen saver" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をスクリーンセーバに使用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸用作屏幕保护程序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布用作螢幕保護程式"}}}
    },
    "Screen saver status" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバの状態"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式狀態"}}}
    },
    "Requires macOS 26 or later. Uses each display’s applied wallpaper as its screen saver, including scenes, videos, web wallpapers and still images. This experimental feature uses private macOS APIs and may stop working after an update." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26以降が必要です。各ディスプレイに適用中のシーン、ビデオ、Web壁紙、静止画像をスクリーンセーバに使用します。この実験的機能はmacOSの非公開APIを使用しているため、アップデート後に動作しなくなる可能性があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或更高版本。将各显示器当前应用的壁纸用作屏幕保护程序，支持场景、视频、网页壁纸和静态图片。此实验性功能使用 macOS 私有接口，系统更新后可能失效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或以上版本。將各顯示器目前套用的桌布用作螢幕保護程式，包含場景、影片、網頁桌布及靜態圖片。此實驗性功能使用 macOS 私有 API，系統更新後可能會失效。"}}}
    },
    "The screen saver choice is independent of lock screen animation. It changes only the Idle wallpaper selection and reloads the macOS wallpaper service. Turning it off restores the previous screen saver without changing the Desktop selection, and keeps screen saver changes made elsewhere. Pause and battery settings still apply." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリーンセーバの選択はロック画面のアニメーションとは独立しています。Idle（アイドル時）の壁紙選択だけを変更し、macOSの壁紙サービスを再読み込みします。オフにすると、Desktop（デスクトップ）の選択を変更せずに、以前のスクリーンセーバが復元されます。ほかで行ったスクリーンセーバの変更は保持されます。一時停止とバッテリーの設定は引き続き適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕保护程序与锁定屏幕动画可独立选择。此功能只更改 Idle（闲置）墙纸选项，并重新加载 macOS 墙纸服务。关闭后会还原原来的屏幕保护程序，不会更改 Desktop（桌面）选项，并保留你在别处更改的屏幕保护程序设置。暂停和电池设置同样适用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕保護程式與鎖定畫面動畫可獨立選擇。此功能只變更 Idle（閒置）桌布選項，並重新載入 macOS 桌布服務。關閉後會還原原本的螢幕保護程式，不會變更 Desktop（桌面）選項，並保留你在其他地方變更的螢幕保護程式設定。暫停與電池設定仍然適用。"}}}
    },
    "Playback" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放"}}}
    },
    "When windows cover the desktop" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ウインドウがデスクトップを覆っているとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "桌面被窗口盖住时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "視窗遮住桌面時"}}}
    },
    "Covered means windows hide everything but the menu bar and the screen edges. Pause keeps the last frame there. Wallpapers you can’t see at all always pause." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「覆っている」とは、メニューバーと画面の端以外をウインドウがすべて隠している状態です。「一時停止」では、見えている部分が最後のフレームのまま止まります。まったく見えない壁紙は常に一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "窗口挡住除菜单栏和屏幕边缘以外的全部桌面，就算盖住。选“暂停”时，露出的地方停在最后一帧。完全看不见的壁纸总是会暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "當視窗擋住選單列與螢幕邊緣以外的所有區域，就視為「遮住」。「暫停」會讓露出的部分停在最後一個影格。完全看不到的桌布一律會暫停。"}}}
    },
    "When another app plays sound" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppがサウンドを再生しているとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用播放声音时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 播放聲音時"}}}
    },
    "Reduced quality" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質"}}}
    },
    "Stop" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "停止"}}}
    },
    "Mute silences scene and video wallpapers, and Web wallpapers when page-output mute is available. Pause applies to every wallpaper." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ミュートはシーンと動画の音を消し、ページ全体のミュートに対応したWeb壁紙にも適用されます。一時停止はすべての壁紙に適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音会关闭场景和视频壁纸的声音；网页壁纸在支持整页静音时也适用。暂停适用于所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音會關閉場景和影片桌布的聲音；網頁桌布在支援整頁靜音時也適用。暫停適用於所有桌布。"}}}
    },
    "When displays sleep" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイがスリープしたとき"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器休眠时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器進入睡眠時"}}}
    },
    "Stop frees renderer memory and reloads the wallpaper when the display wakes. Pause keeps it loaded." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「停止」ではレンダラのメモリを解放し、ディスプレイのスリープ解除時に壁紙を再読み込みします。「一時停止」では読み込んだままにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止会释放渲染器占用的内存，显示器唤醒后再重新加载壁纸。暂停则保持已加载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「停止」會釋放渲染器的記憶體，並在顯示器喚醒時重新載入桌布。「暫停」則會讓桌布保持載入。"}}}
    },
    "Reduced quality uses the scale and frame rate below instead of your usual quality settings. Pause stops wallpapers until you plug in." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「画質を下げる」では、通常の画質設定の代わりに下のスケールとフレームレートを使用します。「一時停止」では、電源に接続するまで壁紙を停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质会用下方的渲染比例和帧率代替平时的画质设置。暂停会在接上电源前停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「降低畫質」會使用下方的渲染比例與影格率，取代平時的畫質設定。「暫停」會停止桌布，直到接上電源為止。"}}}
    },
    "On battery. Reduced quality is in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用电池，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用電池，已啟用「降低畫質」。"}}}
    },
    "Low Power Mode is on. Reduced quality is in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，已啟用「降低畫質」。"}}}
    },
    "The Mac is hot. Reduced quality is in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，已啟用「降低畫質」。"}}}
    },
    "The battery is low. Reduced quality is in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少なくなっています。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，已啟用「降低畫質」。"}}}
    },
    "The Mac is hot. Wallpapers are paused." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，桌布已暫停。"}}}
    },
    "The Mac is hot. Wallpapers are stopped." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温です。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，桌布已停止。"}}}
    },
    "Low Power Mode is on. Wallpapers are paused." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，桌布已暫停。"}}}
    },
    "Low Power Mode is on. Wallpapers are stopped." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードがオンです。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式已开启，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式已開啟，桌布已停止。"}}}
    },
    "The battery is low. Wallpapers are paused." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少なくなっています。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，桌布已暫停。"}}}
    },
    "The battery is low. Wallpapers are stopped." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少なくなっています。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，桌布已停止。"}}}
    },
    "In effect now. Reduced quality is in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。画質を下げて実行しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，已启用降低画质。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，已啟用「降低畫質」。"}}}
    },
    "In effect now. Wallpapers are paused." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。壁紙を一時停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，壁纸已暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，桌布已暫停。"}}}
    },
    "In effect now. Wallpapers are stopped." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，桌布已停止。"}}}
    },
    "App rules" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 規則"}}}
    },
    "Pause, mute or stop wallpapers while a chosen app is running or in front." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したAppが実行中または最前面にあるときに、壁紙を一時停止、消音、または停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在所选应用正在运行或位于前台时，暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在所選 App 執行中或位於前景時，暫停、靜音或停止桌布。"}}}
    },
    "Edit…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "編集…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "编辑…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "編輯…"}}}
    },
    "Running" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "執行中"}}}
    },
    "In front" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "最前面"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "位于前台"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "位於前景"}}}
    },
    "Condition for %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の条件"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的条件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的條件"}}}
    },
    "Action for %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@のアクション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的动作"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的動作"}}}
    },
    "App" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "App"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "應用程式"}}}
    },
    "Remove" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移除"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "移除"}}}
    },
    "Add app…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Appを追加…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "添加应用…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加入 App…"}}}
    },
    "No app rules yet. Add an app to pause, mute or stop wallpapers while it is running or in front." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルールはまだありません。Appを追加すると、そのAppが実行中または最前面にあるときに壁紙を一時停止、消音、または停止できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有应用规则。添加一个应用，在它运行或位于前台时暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無 App 規則。加入 App 後，即可在它執行中或位於前景時暫停、靜音或停止桌布。"}}}
    },
    "Quality" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質"}}}
    },
    "Quality preset" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質プリセット"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質預設集"}}}
    },
    "Low" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低"}}}
    },
    "Medium" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "中"}}}
    },
    "High" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "高"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "高"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "高"}}}
    },
    "Custom" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "カスタム"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自定义"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自訂"}}}
    },
    "Low, Medium and High set the frame-rate limit and render scale together. Custom means the current values match none of those." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「低」「中」「高」は、フレームレートの上限とレンダリングスケールをまとめて設定します。「カスタム」は、現在の値がどのプリセットにも一致しないことを示します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低、中、高会同时设置帧率上限和渲染比例。自定义表示当前数值与这些预设都不相符。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「低」、「中」、「高」會同時設定影格率上限與渲染比例。「自訂」表示目前的數值不符合任何一個預設集。"}}}
    },
    "Frame rate limit" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームレートの上限"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "帧率上限"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影格率上限"}}}
    },
    "No limit" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "制限なし"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不限制"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無限制"}}}
    },
    "%lld fps" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}}
    },
    "At the top of the slider there is no limit, and each display runs at its own frame rate: up to 60 fps unless you chose more for it. A lower value caps every display; saved per-display frame rates are not rewritten." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "スライダの一番上では制限がなく、各ディスプレイがそれぞれのフレームレートで動作します（個別により高い値を選択していない限り最大60 fps）。低い値にするとすべてのディスプレイに上限が適用されます。ディスプレイごとに保存されたフレームレートは書き換えられません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "滑块最顶端表示不限制，每台显示器按各自的帧率运行：除非你为它选了更高的帧率，否则最高 60 fps。更低的值会限制每台显示器，但不会改写各显示器已保存的帧率。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "滑桿拉到最頂端時沒有限制，每台顯示器會以各自的影格率執行：除非你為它選擇了更高的值，否則最高為 60 fps。較低的值會限制每台顯示器，但不會改寫各顯示器已儲存的影格率。"}}}
    },
    "Limited to %lld fps by Performance settings" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンス設定により%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "受性能设置限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已由「效能」設定限制為 %lld fps"}}}
    },
    "Limited to %lld fps while the Mac is hot" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温のため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，限制為 %lld fps"}}}
    },
    "Limited to %lld fps in Low Power Mode" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードのため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式下限制為 %lld fps"}}}
    },
    "Limited to %lld fps while the battery is low" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，限制為 %lld fps"}}}
    },
    "Limited to %lld fps on battery" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中のため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時限制為 %lld fps"}}}
    },
    "Open Performance" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンス設定を開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开性能设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟效能設定"}}}
    },
    "Keep wallpapers running, lower their quality, or pause them while on battery." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中に、壁紙の実行を続けるか、画質を下げるか、一時停止するかを選択します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时可以继续运行壁纸、降低画质，或暂停它们。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時，可讓桌布繼續執行、降低畫質或暫停。"}}}
    },
    "Wallpapers you can’t see, such as behind a full-screen app, pause on their own. When windows cover the desktop, Pause keeps the last frame and Keep running keeps it moving in the gaps." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "フルスクリーンのAppの背後など、見えない壁紙は自動的に一時停止します。ウインドウがデスクトップを覆っているとき、「一時停止」では最後のフレームで止まり、「実行を続ける」では隙間に見える部分が動き続けます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "看不见的壁纸（比如在全屏应用后面）会自行暂停。桌面被窗口盖住时，选“暂停”会停在最后一帧，选“继续运行”则在露出的地方继续播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "看不到的桌布（例如被全螢幕 App 擋住的桌布）會自動暫停。視窗遮住桌面時，「暫停」會停在最後一個影格，「繼續執行」則會讓露出的部分繼續播放。"}}}
    },
    "When another app plays sound, Mute uses each wallpaper’s output mute channel. Web mute availability is shown in its details. Pause stops every wallpaper until that sound ends." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppが音を再生している間、ミュートは各壁紙の出力ミュート機能を使います。Web壁紙で利用できるかどうかは詳細に表示されます。一時停止はその音が終わるまですべての壁紙を停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用播放声音时，静音会使用各壁纸的输出静音通道。网页静音是否可用会显示在壁纸详情中。暂停会在声音结束前停止所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 播放聲音時，靜音會使用各桌布的輸出靜音通道。網頁靜音是否可用會顯示在桌布詳細資訊中。暫停會在聲音結束前停止所有桌布。"}}}
    },
    "When displays sleep, Pause keeps wallpapers loaded. Stop frees renderer memory and reloads them when the display wakes." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイがスリープしたとき、「一時停止」では壁紙を読み込んだままにします。「停止」ではレンダラのメモリを解放し、ディスプレイのスリープ解除時に再読み込みします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器休眠时，暂停会保持壁纸已加载。停止会释放渲染器占用的内存，并在显示器唤醒后重新加载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器進入睡眠時，「暫停」會讓桌布保持載入。「停止」會釋放渲染器的記憶體，並在顯示器喚醒時重新載入桌布。"}}}
    },
    "On battery, Keep running leaves quality alone, Reduced quality uses the battery scale and frame rate, and Pause stops wallpapers until you plug in. None of these promises a measured power saving." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中、「実行を続ける」では画質を変更せず、「画質を下げる」ではバッテリー用のスケールとフレームレートを使用し、「一時停止」では電源に接続するまで壁紙を停止します。いずれも、実測に基づく省電力効果を保証するものではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时，继续运行不改变画质，降低画质会使用电池模式的渲染比例和帧率，暂停则会在接上电源前停止壁纸。这些都不是经过测量的省电承诺。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時，「繼續執行」不會變更畫質，「降低畫質」會使用電池模式的渲染比例與影格率，「暫停」則會停止桌布，直到接上電源為止。以上選項都不代表經過實際測量的省電效果。"}}}
    },
    "App rules pause, mute or stop wallpapers while a chosen app is running or in front. Your own Play and Pause are not changed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルールは、選択したAppが実行中または最前面にあるときに壁紙を一時停止、消音、または停止します。手動での再生と一時停止は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用规则会在所选应用正在运行或位于前台时暂停、静音或停止壁纸，不会改动你自己的播放和暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 規則會在所選 App 執行中或位於前景時暫停、靜音或停止桌布，不會變更你自己的播放與暫停操作。"}}}
    },
    "A quality preset sets the frame-rate limit and render scale together. The frame-rate limit caps every display without rewriting the frame rate saved for each wallpaper. Internal render scale sets how many pixels are rendered before the image is scaled to fit." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質プリセットは、フレームレートの上限とレンダリングスケールをまとめて設定します。フレームレートの上限はすべてのディスプレイに適用され、壁紙ごとに保存されたフレームレートは書き換えられません。内部レンダリングスケールは、画像を画面に合わせて拡大縮小する前に描画するピクセル数を設定します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质预设会同时设置帧率上限和渲染比例。帧率上限限制每台显示器，但不会改写各壁纸已保存的帧率。内部渲染比例决定放大到屏幕之前要渲染多少像素。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質預設集會同時設定影格率上限與渲染比例。影格率上限會限制每台顯示器，但不會改寫各桌布已儲存的影格率。內部渲染比例決定影像縮放至適當大小前要渲染多少像素。"}}}
    },
    "Video playback picks a backend for each wallpaper. Native is used only for videos it supports; the rest play in Compatibility." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ再生では、壁紙ごとにバックエンドを選択します。「ネイティブ」は対応しているビデオにのみ使用され、それ以外は互換モードで再生されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频播放会为每张壁纸选择后端。原生模式只用于它支持的视频，其余使用兼容模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片播放會為每張桌布選擇後端。「原生」只用於它支援的影片，其餘影片會以「相容模式」播放。"}}}
    },
    "Scene render optimisation reuses work inside a scene and produces the same picture. It only affects scene wallpapers." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダリングの最適化は、シーン内の処理を再利用して同じ画像を生成します。影響するのはシーン壁紙のみです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染优化会复用场景内部的工作并得到同样的画面，只影响场景壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染最佳化會重複使用場景內的運算結果，產生相同的畫面，且只影響場景桌布。"}}}
    },
    "Video backend" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオバックエンド"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频后端"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片後端"}}}
    },
    "Video playback" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片播放"}}}
    },
    "Compatibility" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "互換モード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "兼容模式"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "相容模式"}}}
    },
    "Native video preferred" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブビデオを優先"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "优先原生视频"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "優先使用原生影片"}}}
    },
    "Native Metal preferred" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalを優先"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "优先原生 Metal"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "優先使用原生 Metal"}}}
    },
    "Renderer compatibility" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "レンダラの互換性"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "渲染器兼容性"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "渲染器相容性"}}}
    },
    "Unsupported scenes use Compatibility. Lock screen playback always uses Compatibility." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "対応していないシーンには互換モードが使用されます。ロック画面での再生には常に互換モードが使用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持的场景会使用兼容模式。锁屏播放始终使用兼容模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援的場景會使用相容模式。鎖定畫面播放一律使用相容模式。"}}}
    },
    "Native Metal" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetal"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal"}}}
    },
    "Native plays supported videos through macOS and uses Compatibility for the rest." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「ネイティブ」は対応しているビデオをmacOS経由で再生し、それ以外には互換モードを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生模式通过 macOS 播放支持的视频，其余自动使用兼容模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「原生」會透過 macOS 播放支援的影片，其餘影片則使用相容模式。"}}}
    },
    "In use now" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在使用中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前使用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前使用中"}}}
    },
    "No video wallpaper is running." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中のビデオ壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的视频壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有正在執行的影片桌布。"}}}
    },
    "Display %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイ%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器 %@"}}}
    },
    "(fallback: %@)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "（フォールバック：%@）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "（回退：%@）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "（備援：%@）"}}}
    },
    "Internal render scale" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "内部レンダリングスケール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "内部渲染比例"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "內部渲染比例"}}}
    },
    "100% (native)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "100%（ネイティブ）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "100%（原生）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "100%（原生）"}}}
    },
    "Renders at a lower resolution and scales the result to fill the same area. Size and position on screen don’t change." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低い解像度でレンダリングし、結果を拡大して同じ領域を埋めます。画面上のサイズと位置は変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以较低的分辨率渲染，再放大到同样的区域。壁纸在屏幕上的尺寸和位置不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以較低的解析度渲染，再將結果放大填滿相同的區域。桌布在螢幕上的大小與位置不會改變。"}}}
    },
    "Not applicable to the wallpapers currently running" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在実行中の壁紙には適用されません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不适用于当前正在运行的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不適用於目前執行中的桌布"}}}
    },
    "Effective now" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の有効値"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前生效"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前生效"}}}
    },
    "2D scene resolution" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "2Dシーンの解像度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "2D 场景分辨率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "2D 場景解析度"}}}
    },
    "Display resolution draws a 2D scene at the size it covers on your display, as Wallpaper Engine does, which keeps it sharp on a high-resolution screen. Canvas size draws it at the size its author made it and stretches the result, which uses the least GPU and memory. Internal render scale applies on top. Perspective scenes and videos aren’t affected." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "「ディスプレイの解像度」では、Wallpaper Engineと同様に、2Dシーンをディスプレイ上で占めるサイズで描画するため、高解像度の画面でも鮮明に表示されます。「キャンバスサイズ」では、制作者が作成したサイズで描画して結果を引き伸ばすため、GPUとメモリの使用量が最も少なくなります。内部レンダリングスケールはその上にさらに適用されます。透視投影のシーンとビデオは影響を受けません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“显示器分辨率”会按 2D 场景在显示器上占据的大小来绘制，与 Wallpaper Engine 一致，在高分辨率屏幕上也能保持清晰。“画布尺寸”按作者制作时的大小绘制，再将结果拉伸，占用的 GPU 和内存最少。内部渲染比例会在此基础上再生效。透视场景和视频不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「顯示器解析度」會依 2D 場景在顯示器上佔據的大小來繪製，與 Wallpaper Engine 一致，在高解析度螢幕上也能保持清晰。「畫布尺寸」依作者製作時的大小繪製，再將結果拉伸，使用的 GPU 與記憶體最少。內部渲染比例會在此基礎上再套用。透視場景與影片不受影響。"}}}
    },
    "Display resolution" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの解像度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器分辨率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器解析度"}}}
    },
    "Canvas size" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "キャンバスサイズ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画布尺寸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫布尺寸"}}}
    },
    "%@ on battery. Your setting is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ in Low Power Mode. Your setting is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード中は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式下為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ while the Mac is hot. Your setting is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温の間は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ while the battery is low. Your setting is %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ない間は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@. Your setting of %@ is not in effect right now." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@です。設定した%2$@は現在適用されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，你设置的 %2$@ 目前未生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。你設定的 %2$@ 目前未生效。"}}}
    },
    "Render scale when reduced" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げるときのレンダリングスケール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质时的渲染比例"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質時的渲染比例"}}}
    },
    "Frame rate when reduced" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げるときのフレームレート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质时的帧率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質時的影格率"}}}
    },
    "Every Reduced quality choice on this page uses this render scale and frame rate." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このページの「画質を下げる」の選択はすべて、このレンダリングスケールとフレームレートを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此页面上每个“降低画质”选项都使用这一渲染比例和帧率。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此頁面上每個「降低畫質」選項都會使用這個渲染比例和影格率。"}}}
    },
    "On battery" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池"}}}
    },
    "Your usual quality settings are in use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "通常の画質設定を使用しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用平时的画质设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用平時的畫質設定。"}}}
    },
    "Energy use" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量"}}}
    },
    "This app, last few seconds" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このApp、直近数秒間"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "本应用，最近几秒"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 App，最近幾秒"}}}
    },
    "Right after you apply a wallpaper, these figures include loading it, which can take several watts for a few seconds." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用した直後は、その読み込み分も値に含まれ、数秒間は数ワットに達することがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刚应用壁纸后，这些读数会包含加载壁纸的耗电，几秒内可能达到数瓦。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "剛套用桌布後，這些數值會包含載入桌布的耗電，幾秒內可能達到數瓦。"}}}
    },
    "How it’s measured" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "測定方法"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "如何测量"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "如何測量"}}}
    },
    "macOS shares GPU energy between apps by GPU time." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはGPUの使用時間に応じて、各AppにGPUのエネルギーを割り当てます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 按各应用占用 GPU 的时间分摊 GPU 能耗。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 依各 App 使用 GPU 的時間分攤 GPU 能源用量。"}}}
    },
    "Includes the control panel, the lock screen and the CPU side of video decoding. Screen compositing, the hardware video decoder, videos played with Native video, memory and the display itself are not included." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネル、ロック画面、ビデオデコードのCPU処理を含みます。画面の合成処理、ハードウェアビデオデコーダ、ネイティブビデオで再生中のビデオ、メモリ、ディスプレイ本体は含まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "包含控制面板、锁屏以及视频解码的 CPU 部分，不包含屏幕合成、硬件视频解码器、以原生视频播放的视频、内存和显示屏本身的耗电。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "包含控制面板、鎖定畫面，以及影片解碼的 CPU 部分；不包含畫面合成、硬體影片解碼器、以原生影片播放的影片、記憶體及顯示器本身的耗電。"}}}
    },
    "Low: below 0.5 W. Medium: 0.5 W to below 2 W. High: 2 W or more." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "低：0.5 W未満。中：0.5 W以上、2 W未満。高：2 W以上。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低：低于 0.5 W。中：0.5 W 至不足 2 W。高：2 W 及以上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低：低於 0.5 W。中：0.5 W 至低於 2 W。高：2 W 以上（含 2 W）。"}}}
    },
    "Change a quality setting below to compare energy use." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "下の画質設定を変更すると、変更前後のエネルギー使用量を比較できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改下方的画质设置，即可比较修改前后的能耗。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更下方的畫質設定，即可比較變更前後的能源用量。"}}}
    },
    "Measuring…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "測定中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在测量…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在測量…"}}}
    },
    "Unavailable on this Mac" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでは利用できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 不支持"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 無法使用"}}}
    },
    "CPU" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}}
    },
    "GPU" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}}
    },
    "%@ mW" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}}
    },
    "%@ W" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}}
    },
    "GPU shared with other apps" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppとGPUを共有中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "GPU 正与其他应用共享"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "GPU 正與其他 App 共用"}}}
    },
    "Native video not counted" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブビデオは計測対象外"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生视频未计入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生影片未計入"}}}
    },
    "macOS decodes and draws videos played with Native video and charges none of that to this app, so these figures leave most of it out. The grade and any comparison are off while one plays." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブビデオで再生するビデオはmacOSがデコードと描画を行い、その分はこのAppに計上されないため、これらの値にはその大部分が含まれません。再生中は評価と比較を行いません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以原生视频播放的视频由 macOS 解码和绘制，这部分耗电不会计入本应用，因此这些读数不包含其中的大部分。播放期间不给出等级和前后对比。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以原生影片播放的影片由 macOS 解碼與繪製，這部分耗電不會計入此 App，因此這些數值不包含其中的大部分。播放期間不會顯示等級與前後比較。"}}}
    },
    "Other apps are keeping the GPU busy, so the GPU figure reads higher than this app’s own share. The grade and any comparison wait until the GPU is free." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppがGPUを使用しているため、GPUの値がこのApp自身の使用分より高く表示されています。GPUが空くまで、評価と比較は保留されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用正在大量占用 GPU，因此 GPU 读数会高于本应用实际的份额。等 GPU 空闲后再给出等级和前后对比。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 正在大量使用 GPU，因此 GPU 數值會高於此 App 本身的份額。等級與前後比較會等到 GPU 空閒時才顯示。"}}}
    },
    "Low energy use" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：低"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗低"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量低"}}}
    },
    "Medium energy use" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗中等"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量中等"}}}
    },
    "High energy use" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：高"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗高"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量高"}}}
    },
    "Less than 1% of a full battery charge per hour." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間あたりの消費はフル充電の1%未満です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每小时耗电不到满电量的 1%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每小時耗電不到電池充飽電量的 1%。"}}}
    },
    "About %lld%% of a full battery charge per hour." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間あたりフル充電の約%lld%%を消費します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每小时约耗满电量的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每小時約耗用電池充飽電量的 %lld%%。"}}}
    },
    "Measuring the effect of your change. Before it: %@." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "変更の効果を測定しています。変更前：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在测量这次修改的效果。修改前：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在測量變更的效果。變更前：%@。"}}}
    },
    "Before your change: %@. Now: %@, about the same." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "変更前：%1$@。現在：%2$@（ほぼ同じ）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改前：%1$@。现在：%2$@，基本持平。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更前：%1$@。目前：%2$@，大致相同。"}}}
    },
    "Before your change: %@. Now: %@ (%@)." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "変更前：%1$@。現在：%2$@（%3$@）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改前：%1$@。现在：%2$@（%3$@）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更前：%1$@。目前：%2$@（%3$@）。"}}}
    },
    "1 display" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "1台のディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "1 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "1 台顯示器"}}}
    },
    "%lld displays" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld台のディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 台顯示器"}}}
    },
    "each display’s own frame rate" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "各ディスプレイ固有のフレームレート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "各显示器自身的帧率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "各顯示器本身的影格率"}}}
    },
    "%@, about %@. Measured while it played alone on %@ at %@, %@ render scale, with this window closed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（約%2$@）。このウインドウを閉じ、この壁紙のみを%3$@、%4$@、レンダリングスケール%5$@で再生して測定しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，约 %2$@。在关闭本窗口、仅播放这张壁纸时测得：%3$@，%4$@，渲染比例 %5$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，約 %2$@。測量條件：關閉此視窗並單獨播放此桌布，%3$@，%4$@，渲染比例 %5$@。"}}}
    },
    "%@, about %@. %@ Measured while it played alone on %@ at %@, %@ render scale, with this window closed." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（約%2$@）。%3$@このウインドウを閉じ、この壁紙のみを%4$@、%5$@、レンダリングスケール%6$@で再生して測定しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，约 %2$@。%3$@在关闭本窗口、仅播放这张壁纸时测得：%4$@，%5$@，渲染比例 %6$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，約 %2$@。%3$@測量條件：關閉此視窗並單獨播放此桌布，%4$@，%5$@，渲染比例 %6$@。"}}}
    },
    "Scene wallpapers" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景桌布"}}}
    },
    "Scene render optimisation" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダリングの最適化"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染优化"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染最佳化"}}}
    },
    "Skips rendering work that wouldn’t change the picture, such as parts of a scene that stay the same. Resolution, frame rate and animation speed are unaffected. Works with both scene renderers. Turn it off to compare." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン内の変化しない部分など、画像に影響しないレンダリング処理を省略します。解像度、フレームレート、アニメーションの速度は変わりません。どちらのシーンレンダラでも機能します。オフにすると比較できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过不影响画面的渲染工作，比如场景中没有变化的部分。分辨率、帧率和动画速度都不受影响。两种场景渲染器都支持，可以关掉对比效果。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過不會改變畫面的渲染工作，例如場景中保持不變的部分。解析度、影格率與動畫速度皆不受影響。兩種場景渲染器都支援此功能。可關閉此功能來比較差異。"}}}
    },
    "How much can be skipped depends on the scene. If everything in it moves, nothing is skipped." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "省略できる量はシーンによって異なります。シーン内のすべてが動いている場合は、何も省略されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能跳过多少取决于场景本身。如果画面里的内容都在动，就没有可以跳过的部分。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能略過多少取決於場景本身。如果場景中的所有內容都在移動，就沒有可略過的部分。"}}}
    },
    "In force now" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の適用状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前生效"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前生效"}}}
    },
    "Saved on" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "設定：オン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置为开启"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已設為開啟"}}}
    },
    "Saved off" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "設定：オフ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置为关闭"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已設為關閉"}}}
    },
    "%@; applying to %lld of %lld running scenes on their next frame." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%3$lld個のシーンのうち%2$lld個に、次のフレームで適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 个运行中的场景里有 %2$lld 个将在下一帧生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 個執行中的場景有 %2$lld 個將在下一個影格套用。"}}}
    },
    "%@; %lld of %lld running scenes confirmed, the rest could not be read." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%3$lld個のシーンのうち%2$lld個で確認済みです。残りは読み取れませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 个运行中的场景里已确认 %2$lld 个，其余无法读取。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 個執行中的場景已確認 %2$lld 個，其餘無法讀取。"}}}
    },
    "%@ and in force on the running scene." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%@。実行中のシーンに適用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@，已在运行中的场景生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@，已在執行中的場景生效。"}}}
    },
    "%@ and in force on all %lld running scenes." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%2$lld個のシーンすべてに適用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，已在全部 %2$lld 个运行中的场景生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，已在全部 %2$lld 個執行中的場景生效。"}}}
    },
    "Update only when the scene changes" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンが変化したときのみ更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在场景变化时更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在場景變化時更新"}}}
    },
    "When a scene has nothing left to animate, it stops drawing until something changes. Scenes that are still moving keep running normally, and scripts, sound and input keep working." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン内にアニメーションするものがなくなると、何かが変化するまで描画を停止します。動いているシーンは通常どおり実行され、スクリプト、サウンド、入力も引き続き機能します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景没有需要更新的内容时停止绘制，等有变化再继续。仍在动的场景照常运行，脚本、声音和输入不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景中沒有需要播放的動畫時，會停止繪製，直到有內容變化為止。仍在移動的場景會照常執行，指令碼、聲音與輸入也會繼續運作。"}}}
    },
    "Updating now" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の更新状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前更新状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前更新狀態"}}}
    },
    "No scene wallpaper is running." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中のシーン壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的场景壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有正在執行的場景桌布。"}}}
    },
    "wallpaper" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布"}}}
    },
    "starting — no frame drawn yet" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "起動中 — まだフレームが描画されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在启动 — 尚未绘制任何帧"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在啟動 — 尚未繪製任何影格"}}}
    },
    "state reported as %@" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "報告された状態：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "报告的状态为 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "回報的狀態為 %@"}}}
    },
    "a script" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "スクリプト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "脚本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指令碼"}}}
    },
    "animation" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "アニメーション"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "动画"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "動畫"}}}
    },
    "particles" : {
