    },
    "Setting up SteamCMD…" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDをセットアップ中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在设置 SteamCMD…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在設定 SteamCMD…"}}}
    },
    "All downloads are complete." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてのダウンロードが完了しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有下载都已完成。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有下載皆已完成。"}}}
    },
    "No downloads yet. Pick a Workshop wallpaper and choose Download." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "まだダウンロードはありません。ワークショップの壁紙を選んで「ダウンロード」を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有下载。在创意工坊中选一张壁纸并点击“下载”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無下載項目。請在工作坊中挑選一張桌布，然後選擇「下載」。"}}}
    },
    "Downloads" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載項目"}}}
    },
    "Hide completed" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "完了済みを非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏已完成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏已完成項目"}}}
    },
    "Show completed (%lld)" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "完了済みを表示（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示已完成（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示已完成項目（%lld）"}}}
    },
    "Clear finished" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "終了した項目を消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除已结束"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除已結束項目"}}}
    },
    "Show download logs" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードログを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示下载日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示下載記錄"}}}
    },
    "Up to %lld downloads run at once and share your saved sign-in; the rest wait in order. Steam may still ask you to approve a sign-in." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "最大%lld件のダウンロードが同時に実行され、保存されたサインインを共有します。残りは順番に待機します。それでもSteamからサインインの承認を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最多同时进行 %lld 项下载，共用已保存的登录，其余排队等待。Steam 仍可能要求你批准登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "最多同時進行 %lld 項下載，並共用已儲存的登入；其餘項目依序等待。Steam 仍可能要求你核准登入。"}}}
    },
    "Downloads run one at a time; the rest wait in order. Steam may still ask you to approve a sign-in." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードは1件ずつ実行され、残りは順番に待機します。それでもSteamからサインインの承認を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载逐个进行，其余排队等待。Steam 仍可能要求你批准登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載會逐一進行，其餘項目依序等待。Steam 仍可能要求你核准登入。"}}}
    },
    "Downloads at once" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "同時ダウンロード数"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "同时下载数"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "同時下載數"}}}
    },
    "Each download signs in to Steam on its own. More at once mostly helps batches of small wallpapers; large ones share your connection." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "各ダウンロードは個別にSteamにサインインします。同時ダウンロード数を増やすと主に小さな壁紙をまとめてダウンロードするときに効果があります。大きな壁紙は接続を共有します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每项下载都会单独登录 Steam。同时下载更多主要对成批的小壁纸有帮助；大壁纸会共享你的网络带宽。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每項下載都會各自登入 Steam。同時下載較多項目主要有助於大量的小型桌布；大型桌布則會共用你的網路連線。"}}}
    },
    "Steam ended one of the sessions, so downloads run one at a time until you reopen the app." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがセッションの1つを終了したため、アプリを開き直すまでダウンロードは1件ずつ実行されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 断开了其中一个会话，因此在重新打开应用前，下载会逐个进行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束了其中一個工作階段，因此在你重新開啟此 App 前，下載會逐一進行。"}}}
    },
    "Remove %@ from downloads" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードから%@を取り除く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从下载中移除 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從下載項目中移除 %@"}}}
    },
    "Close import" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みを閉じる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭导入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉匯入"}}}
    },
    "Choose wallpaper folders, videos, images or web pages. Imports copy the source files into your library and leave the originals untouched." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙フォルダ、ビデオ、画像、Webページを選択します。読み込むとソースファイルがライブラリにコピーされ、元のファイルはそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸文件夹、视频、图片或网页。导入时会复制到壁纸库，原文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布資料夾、影片、圖片或網頁。匯入時會將來源檔案拷貝到桌布庫，原始檔案不會受到影響。"}}}
    },
    "You can also drop them on WallpaperMachine in the Dock." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "DockのWallpaperMachineにドロップすることもできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "也可以把它们拖到程序坞中的 WallpaperMachine 图标上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你也可以將它們拖放到 Dock 中的 WallpaperMachine 上。"}}}
    },
    "If a wallpaper already exists" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙がすでに存在する場合"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已存在时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "若桌布已存在"}}}
    },
    "Skip duplicates" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "重複をスキップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过重复项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過重複項目"}}}
    },
    "Keep both copies" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "両方とも残す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留两份"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留兩份"}}}
    },
    "Replace if changed" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "変更されていれば置き換える"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "有变化时替换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "有變更時取代"}}}
    },
    "Choose wallpapers" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇桌布"}}}
    },
    "Cancel import" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消导入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消匯入"}}}
    },
    "%lld imported · %lld skipped" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld件読み込み済み · %2$lld件スキップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已导入 %1$lld 项 · 已跳过 %2$lld 项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已匯入 %1$lld 項 · 已略過 %2$lld 項"}}}
    },
