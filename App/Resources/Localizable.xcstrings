      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD already exists. Confirm Reinstall SteamCMD before replacing it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはすでに存在します。置き換えるには「SteamCMDを再インストール」で確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已存在。替换前，请确认“重新安装 SteamCMD”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已存在。取代之前，請先確認「重新安裝 SteamCMD」。"}}}
    },
