    },
    "Create" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Criar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "생성"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "作成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创建"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "建立"}}}
    },
    "Save" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存"}}}
    },
    "Delete" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "삭제"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "删除"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "刪除"}}}
    },
    "Delete “%@”? Its wallpapers stay in your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar “%@”? Os papéis de parede dela continuam na sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’을(를) 삭제할까요? 포함된 배경화면은 보관함에 남습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を削除しますか？含まれる壁紙はライブラリに残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要删除“%@”吗？其中的壁纸仍会保留在壁纸库中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要刪除「%@」嗎？其中的桌布仍會保留在桌布庫中。"}}}
    },
    "Rename…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Renomear…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이름 변경…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "名前を変更…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重命名…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新命名…"}}}
    },
    "Delete…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "삭제…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "删除…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "刪除…"}}}
    },
    "New collection…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nova coleção…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "새 컬렉션…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "新規コレクション…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "新建合集…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "新增收藏集…"}}}
    },
    "Add to collection" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adicionar à coleção"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션에 추가"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションに追加"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "加入合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加入收藏集"}}}
    },
    "Add to collection…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adicionar à coleção…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션에 추가…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションに追加…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "加入合集…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加入收藏集…"}}}
    },
    "Add %lld to collection…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adicionar %lld à coleção…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld개를 컬렉션에 추가…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個をコレクションに追加…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将 %lld 个加入合集…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將 %lld 張加入收藏集…"}}}
    },
    "Adds the selected wallpapers to a collection" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adiciona os papéis de parede selecionados a uma coleção"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 배경화면을 컬렉션에 추가합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した壁紙をコレクションに追加します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将所选壁纸加入某个合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將所選桌布加入某個收藏集"}}}
    },
    "Remove from “%@”" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover de “%@”"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’에서 제거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」から削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从“%@”中移除"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從「%@」移除"}}}
    },
    "No collections yet. Collections group wallpapers for browsing and for playlists." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ainda não há coleções. Coleções agrupam papéis de parede para navegação e para playlists."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 컬렉션이 없습니다. 컬렉션으로 배경화면을 그룹화하여 탐색하거나 재생목록에 사용할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションはまだありません。コレクションで壁紙をまとめると、ブラウズやプレイリストに使えます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有合集。合集可以把壁纸分组，便于浏览，也可用于播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無收藏集。收藏集可以將桌布分組，方便瀏覽，也可用於播放列表。"}}}
    },
    "“%@” has no wallpapers yet. Select wallpapers and choose Add to collection." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "“%@” ainda não tem papéis de parede. Selecione papéis de parede e escolha Adicionar à coleção."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’에 아직 배경화면이 없습니다. 배경화면을 선택하고 ‘컬렉션에 추가’를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」にはまだ壁紙がありません。壁紙を選択して「コレクションに追加」を選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“%@”中还没有壁纸。选择壁纸后，选取“加入合集”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「%@」中還沒有桌布。選取桌布後，選擇「加入收藏集」。"}}}
    },
    "Show all wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar todos os papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 배경화면 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての壁紙を表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示全部壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示所有桌布"}}}
    },
    "Deleted “%@”." : {
