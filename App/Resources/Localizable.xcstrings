    },
    "Add app…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adicionar app…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 추가…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appを追加…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "添加应用…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加入 App…"}}}
    },
    "No app rules yet. Add an app to pause, mute or stop wallpapers while it is running or in front." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma regra de app ainda. Adicione um app para pausar, silenciar ou parar os papéis de parede enquanto ele estiver em execução ou em primeiro plano."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 앱 규칙이 없습니다. 앱을 추가하면 해당 앱이 실행 중이거나 맨 앞에 있을 때 배경화면을 일시 정지, 음소거 또는 정지할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルールはまだありません。Appを追加すると、そのAppが実行中または最前面にあるときに壁紙を一時停止、消音、または停止できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有应用规则。添加一个应用，在它运行或位于前台时暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無 App 規則。加入 App 後，即可在它執行中或位於前景時暫停、靜音或停止桌布。"}}}
    },
    "Quality" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qualidade"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質"}}}
    },
    "Quality preset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de qualidade"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질 프리셋"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質プリセット"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画质预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫質預設集"}}}
    },
    "Low" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低"}}}
    },
    "Medium" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Média"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "中"}}}
    },
    "High" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alta"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "높음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "高"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "高"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "高"}}}
    },
    "Custom" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Personalizada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용자화"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "カスタム"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "自定义"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "自訂"}}}
    },
    "Low, Medium and High set the frame-rate limit and render scale together. Custom means the current values match none of those." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixa, Média e Alta definem juntas o limite da taxa de quadros e a escala de renderização. Personalizada significa que os valores atuais não correspondem a nenhuma delas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘낮음’, ‘중간’, ‘높음’은 프레임률 제한과 렌더링 배율을 함께 설정합니다. ‘사용자화’는 현재 값이 어느 프리셋과도 일치하지 않음을 뜻합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「低」「中」「高」は、フレームレートの上限とレンダリングスケールをまとめて設定します。「カスタム」は、現在の値がどのプリセットにも一致しないことを示します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低、中、高会同时设置帧率上限和渲染比例。自定义表示当前数值与这些预设都不相符。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「低」、「中」、「高」會同時設定影格率上限與渲染比例。「自訂」表示目前的數值不符合任何一個預設集。"}}}
    },
    "Frame rate limit" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limite da taxa de quadros"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프레임률 제한"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フレームレートの上限"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "帧率上限"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影格率上限"}}}
    },
    "No limit" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sem limite"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제한 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "制限なし"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不限制"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無限制"}}}
    },
    "%lld fps" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps"}}}
    },
    "Limited to %lld fps by Performance settings" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limitado a %lld fps pelos ajustes de Desempenho"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "성능 설정에 따라 %lld fps로 제한됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンス設定により%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "受性能设置限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已由「效能」設定限制為 %lld fps"}}}
    },
    "Limited to %lld fps while the Mac is hot" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limitado a %lld fps enquanto o Mac está quente"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 뜨거워 %lld fps로 제한됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温のため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热，限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱，限制為 %lld fps"}}}
    },
    "Limited to %lld fps in Low Power Mode" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limitado a %lld fps no Modo de Pouca Energia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드에서 %lld fps로 제한됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モードのため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式下限制為 %lld fps"}}}
    },
    "Limited to %lld fps while the battery is low" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limitado a %lld fps enquanto a bateria está fraca"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리가 부족하여 %lld fps로 제한됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ないため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低，限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低，限制為 %lld fps"}}}
    },
    "Limited to %lld fps on battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limitado a %lld fps na bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 중 %lld fps로 제한됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中のため%lld fpsに制限されています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时限制为 %lld fps"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時限制為 %lld fps"}}}
    },
    "This video is drawn by the native video player, which leaves the bars black. Choose Compatibility for Video playback in Performance settings to blur them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este vídeo é desenhado pelo reprodutor de vídeo nativo, que deixa as barras pretas. Escolha Compatibilidade em Reprodução de vídeo nos ajustes de Desempenho para desfocá-las."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 동영상은 네이티브 동영상 플레이어로 표시되므로 여백이 검은색으로 남습니다. 여백을 흐리게 채우려면 성능 설정의 ‘동영상 재생’에서 ‘호환성’을 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このビデオはネイティブのビデオプレーヤーで描画されるため、余白は黒のままです。余白をぼかすには、パフォーマンス設定の「ビデオ再生」で「互換モード」を選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此视频由原生视频播放器绘制，空白处保持黑色。要用模糊画面填充，请在“性能”设置中将“视频播放”选为“兼容模式”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此影片由原生影片播放器繪製，空白處維持黑色。若要以模糊畫面填滿，請在「效能」設定中將「影片播放」選為「相容模式」。"}}}
    },
    "Open Performance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir Desempenho"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "성능 설정 열기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "パフォーマンス設定を開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开性能设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟效能設定"}}}
    },
    "Keep wallpapers running, lower their quality, or pause them while on battery." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mantenha os papéis de parede rodando, reduza a qualidade deles ou pause-os enquanto estiver na bateria."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 중 배경화면을 계속 실행하거나, 화질을 낮추거나, 일시 정지하도록 선택합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中に、壁紙の実行を続けるか、画質を下げるか、一時停止するかを選択します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时可以继续运行壁纸、降低画质，或暂停它们。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時，可讓桌布繼續執行、降低畫質或暫停。"}}}
    },
    "Wallpapers you can’t see, such as behind a full-screen app, pause on their own. When windows cover the desktop, Pause keeps the last frame and Keep running keeps it moving in the gaps." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede que você não consegue ver, como atrás de um app em tela cheia, pausam sozinhos. Quando janelas cobrem a mesa, Pausar mantém o último quadro e Manter em execução o mantém em movimento nos espaços livres."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전체 화면 앱 뒤에 있는 등 보이지 않는 배경화면은 자동으로 일시 정지됩니다. 윈도우가 데스크탑을 가릴 때 ‘일시 정지’는 마지막 프레임을 유지하고, ‘계속 실행’은 틈새에서도 움직임을 유지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フルスクリーンのAppの背後など、見えない壁紙は自動的に一時停止します。ウインドウがデスクトップを覆っているとき、「一時停止」では最後のフレームで止まり、「実行を続ける」では隙間に見える部分が動き続けます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "看不见的壁纸（比如在全屏应用后面）会自行暂停。桌面被窗口盖住时，选“暂停”会停在最后一帧，选“继续运行”则在露出的地方继续播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "看不到的桌布（例如被全螢幕 App 擋住的桌布）會自動暫停。視窗遮住桌面時，「暫停」會停在最後一個影格，「繼續執行」則會讓露出的部分繼續播放。"}}}
    },
    "When another app plays sound, Reduce volume plays each wallpaper at the share of its own volume you chose, and Mute uses each wallpaper’s output mute channel. Web mute availability is shown in its details. Pause stops every wallpaper until that sound ends." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando outro app reproduz som, Reduzir volume toca cada papel de parede na proporção do próprio volume que você escolheu, e Silenciar usa o canal de silenciamento de saída de cada papel de parede. A disponibilidade do silenciamento web aparece nos detalhes dele. Pausar interrompe todos os papéis de parede até esse som terminar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱이 소리를 재생할 때 ‘음량 줄이기’는 각 배경화면을 자체 음량에서 선택한 비율로 재생하고, ‘소리 끄기’는 각 배경화면의 출력 음소거 채널을 사용합니다. 웹 배경화면의 음소거 지원 여부는 세부사항에 표시됩니다. ‘일시 정지’는 해당 소리가 끝날 때까지 모든 배경화면을 일시 정지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppが音を再生している間、「音量を下げる」は各壁紙を、それぞれの音量に対して選んだ割合で再生し、ミュートは各壁紙の出力ミュート機能を使います。Web壁紙でミュートを利用できるかどうかは詳細に表示されます。一時停止はその音が終わるまですべての壁紙を停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用播放声音时，降低音量会让各壁纸以自身音量的所选比例播放，静音会使用各壁纸的输出静音通道。网页静音是否可用会显示在壁纸详情中。暂停会在声音结束前停止所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 播放聲音時，降低音量會讓各桌布以自身音量的所選比例播放，靜音會使用各桌布的輸出靜音通道。網頁靜音是否可用會顯示在桌布詳細資訊中。暫停會在聲音結束前停止所有桌布。"}}}
    },
    "When another app is in front, Mute or Pause lasts until you click the desktop or return to this app. Pause on battery does the same only while the Mac runs on battery, and plugging in ends it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando outro app está em primeiro plano, Silenciar ou Pausar dura até você clicar na mesa ou voltar para este app. Pausar na bateria faz o mesmo apenas enquanto o Mac usa a bateria, e conectar à energia encerra a pausa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱이 맨 앞에 있을 때 음소거 또는 일시 정지는 데스크탑을 클릭하거나 이 앱으로 돌아올 때까지 유지됩니다. ‘배터리 사용 시 일시 정지’는 Mac이 배터리로 작동하는 동안에만 같은 방식으로 작동하며, 전원을 연결하면 끝납니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppが最前面にあるとき、消音または一時停止は、デスクトップをクリックするかこのAppに戻るまで続きます。「バッテリー駆動中は一時停止」は、Macがバッテリーで動作している間だけ同じように働き、電源に接続すると終わります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用位于前台时，静音或暂停会持续到你点击桌面或回到本应用为止。“使用电池时暂停”只在 Mac 使用电池时这样做，接上电源即结束。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 位於前景時，靜音或暫停會持續到你按一下桌面或回到本 App 為止。「使用電池時暫停」只在 Mac 使用電池時這樣做，接上電源即結束。"}}}
    },
    "When displays sleep, Pause keeps wallpapers loaded. Stop frees renderer memory and reloads them when the display wakes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando os monitores entram em repouso, Pausar mantém os papéis de parede carregados. Parar libera a memória do renderizador e os recarrega quando o monitor desperta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이가 잠자기 상태일 때 ‘일시 정지’는 배경화면을 불러온 상태로 유지합니다. ‘정지’는 렌더러 메모리를 확보하고 디스플레이가 깨어나면 배경화면을 다시 불러옵니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイがスリープしたとき、「一時停止」では壁紙を読み込んだままにします。「停止」ではレンダラのメモリを解放し、ディスプレイのスリープ解除時に再読み込みします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器休眠时，暂停会保持壁纸已加载。停止会释放渲染器占用的内存，并在显示器唤醒后重新加载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器進入睡眠時，「暫停」會讓桌布保持載入。「停止」會釋放渲染器的記憶體，並在顯示器喚醒時重新載入桌布。"}}}
    },
    "When the Mac is inactive, wallpapers pause or stop once there has been no keyboard, mouse or trackpad input for the time you chose, and resume at your next input. Your own Play and Pause are not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando o Mac está inativo, os papéis de parede pausam ou param depois de passar o tempo escolhido sem entrada de teclado, mouse ou trackpad, e retomam na sua próxima entrada. Seus próprios comandos Reproduzir e Pausar não são alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac이 비활성 상태일 때는 선택한 시간 동안 키보드, 마우스 또는 트랙패드 입력이 없으면 배경화면이 일시 정지되거나 정지되고, 다음에 입력하면 재개됩니다. 직접 설정한 재생 및 일시 정지 상태는 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macを操作していないときは、選んだ時間のあいだキーボード、マウス、トラックパッドの入力がないと壁紙が一時停止または停止し、次に入力すると再開します。手動での再生と一時停止は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 闲置时，如果在你所选的时间内没有键盘、鼠标或触控板输入，壁纸会暂停或停止，并在你再次输入时恢复。不会改动你自己的播放和暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 閒置時，如果在你所選的時間內沒有鍵盤、滑鼠或觸控式軌跡板輸入，桌布會暫停或停止，並在你再次輸入時恢復。不會變更你自己的播放與暫停操作。"}}}
    },
    "On battery, Keep running leaves quality alone, Reduced quality uses the battery scale and frame rate, and Pause stops wallpapers until you plug in. None of these promises a measured power saving." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na bateria, Manter em execução não altera a qualidade, Qualidade reduzida usa a escala e a taxa de quadros da bateria, e Pausar interrompe os papéis de parede até você conectar o Mac à energia. Nenhuma dessas opções garante uma economia de energia mensurável."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시 ‘계속 실행’은 화질을 그대로 유지하고, ‘화질 낮추기’는 배터리용 배율과 프레임률을 사용하며, ‘일시 정지’는 전원을 연결할 때까지 배경화면을 멈춥니다. 어느 옵션도 실측에 근거한 절전 효과를 보장하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中、「実行を続ける」では画質を変更せず、「画質を下げる」ではバッテリー用のスケールとフレームレートを使用し、「一時停止」では電源に接続するまで壁紙を停止します。いずれも、実測に基づく省電力効果を保証するものではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时，继续运行不改变画质，降低画质会使用电池模式的渲染比例和帧率，暂停则会在接上电源前停止壁纸。这些都不是经过测量的省电承诺。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時，「繼續執行」不會變更畫質，「降低畫質」會使用電池模式的渲染比例與影格率，「暫停」則會停止桌布，直到接上電源為止。以上選項都不代表經過實際測量的省電效果。"}}}
    },
    "App rules pause, mute or stop wallpapers while a chosen app is running or in front. Your own Play and Pause are not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As regras de apps pausam, silenciam ou param os papéis de parede enquanto um app escolhido está em execução ou em primeiro plano. Seus próprios comandos Reproduzir e Pausar não são alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 규칙은 선택한 앱이 실행 중이거나 맨 앞에 있을 때 배경화면을 일시 정지하거나 음소거하거나 정지합니다. 직접 설정한 재생 및 일시 정지 상태는 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルールは、選択したAppが実行中または最前面にあるときに壁紙を一時停止、消音、または停止します。手動での再生と一時停止は変更されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用规则会在所选应用正在运行或位于前台时暂停、静音或停止壁纸，不会改动你自己的播放和暂停。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 規則會在所選 App 執行中或位於前景時暫停、靜音或停止桌布，不會變更你自己的播放與暫停操作。"}}}
    },
    "Scene render optimisation reuses work inside a scene and produces the same picture. It only affects scene wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A otimização de renderização de cena reaproveita trabalho dentro de uma cena e produz a mesma imagem. Afeta apenas papéis de parede de cena."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 렌더링 최적화는 장면 내의 처리 결과를 재사용하여 동일한 이미지를 생성합니다. 장면 배경화면에만 영향을 줍니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダリングの最適化は、シーン内の処理を再利用して同じ画像を生成します。影響するのはシーン壁紙のみです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染优化会复用场景内部的工作并得到同样的画面，只影响场景壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染最佳化會重複使用場景內的運算結果，產生相同的畫面，且只影響場景桌布。"}}}
    },
    "Video playback" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reprodução de vídeo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상 재생"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片播放"}}}
    },
    "it uses something Native Metal can't draw" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "usa algo que o Native Metal não consegue desenhar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal로 그릴 수 없는 요소가 포함되어 있습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalで描画できない要素が含まれています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其中包含原生 Metal 无法绘制的内容"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其中包含原生 Metal 無法繪製的內容"}}}
    },
    "Native Metal couldn't start" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "o Native Metal não conseguiu iniciar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal을 시작할 수 없었습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalを開始できませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 无法启动"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 無法啟動"}}}
    },
    "its shaders didn't compile for Metal" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "seus shaders não compilaram para Metal"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "셰이더가 Metal용으로 컴파일되지 않았습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダがMetal用にコンパイルされませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其着色器无法编译为 Metal"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其著色器無法編譯為 Metal"}}}
    },
    "a frame failed in Native Metal" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "um quadro falhou no Native Metal"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal에서 프레임 그리기에 실패했습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalでフレームの描画に失敗しました"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 绘制某一帧失败"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 繪製某個影格失敗"}}}
    },
    "Native Metal couldn't take the new display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "o Native Metal não conseguiu assumir o novo monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "네이티브 Metal이 새 디스플레이를 이어받지 못했습니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ネイティブMetalが新しいディスプレイを引き継げませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 无法接管新的显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生 Metal 無法接手新的顯示器"}}}
    },
    "it stopped (%@)" : {
