    },
    "In use now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em uso agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 사용 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在使用中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前使用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前使用中"}}}
    },
    "No video wallpaper is running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede de vídeo em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실행 중인 동영상 배경화면이 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中のビデオ壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的视频壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有正在執行的影片桌布。"}}}
    },
    "Display %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Monitor %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイ%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器 %@"}}}
    },
    "(fallback: %@)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "(alternativa: %@)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "(대체: %@)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "（フォールバック：%@）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "（回退：%@）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "（備援：%@）"}}}
    },
    "Internal render scale" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escala de renderização interna"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "내부 렌더링 배율"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "内部レンダリングスケール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "内部渲染比例"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "內部渲染比例"}}}
    },
    "100% (native)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "100% (nativo)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "100% (기본 해상도)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "100%（ネイティブ）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "100%（原生）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "100%（原生）"}}}
    },
    "Renders at a lower resolution and scales the result to fill the same area. Size and position on screen don’t change." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Renderiza em uma resolução menor e amplia o resultado para preencher a mesma área. O tamanho e a posição na tela não mudam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "더 낮은 해상도로 렌더링한 후 같은 영역을 채우도록 확대합니다. 화면상의 크기와 위치는 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低い解像度でレンダリングし、結果を拡大して同じ領域を埋めます。画面上のサイズと位置は変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以较低的分辨率渲染，再放大到同样的区域。壁纸在屏幕上的尺寸和位置不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以較低的解析度渲染，再將結果放大填滿相同的區域。桌布在螢幕上的大小與位置不會改變。"}}}
    },
    "Not applicable to the wallpapers currently running" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não se aplica aos papéis de parede em execução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 실행 중인 배경화면에는 적용되지 않음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在実行中の壁紙には適用されません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不适用于当前正在运行的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不適用於目前執行中的桌布"}}}
    },
    "Effective now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em vigor agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 적용 값"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の有効値"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前生效"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前生效"}}}
    },
    "2D scene resolution" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Resolução de cenas 2D"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "2D 장면 해상도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "2Dシーンの解像度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "2D 场景分辨率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "2D 場景解析度"}}}
    },
    "Display resolution draws a 2D scene at the size it covers on your display, as Wallpaper Engine does, which keeps it sharp on a high-resolution screen. Canvas size draws it at the size its author made it and stretches the result, which uses the least GPU and memory. Internal render scale applies on top. Perspective scenes and videos aren’t affected." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Resolução do monitor desenha uma cena 2D no tamanho que ela ocupa no seu monitor, como o Wallpaper Engine faz, o que a mantém nítida em uma tela de alta resolução. Tamanho do canvas a desenha no tamanho em que o autor a criou e estica o resultado, o que usa menos GPU e memória. A escala de renderização interna se aplica por cima. Cenas em perspectiva e vídeos não são afetados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘디스플레이 해상도’는 Wallpaper Engine처럼 2D 장면을 디스플레이에서 차지하는 크기로 렌더링하여 고해상도 화면에서도 선명하게 표시합니다. ‘캔버스 크기’는 제작자가 만든 크기로 렌더링한 후 결과를 늘이므로 GPU와 메모리를 가장 적게 사용합니다. 내부 렌더링 배율은 여기에 추가로 적용됩니다. 원근 투영 장면과 동영상에는 영향을 주지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ディスプレイの解像度」では、Wallpaper Engineと同様に、2Dシーンをディスプレイ上で占めるサイズで描画するため、高解像度の画面でも鮮明に表示されます。「キャンバスサイズ」では、制作者が作成したサイズで描画して結果を引き伸ばすため、GPUとメモリの使用量が最も少なくなります。内部レンダリングスケールはその上にさらに適用されます。透視投影のシーンとビデオは影響を受けません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“显示器分辨率”会按 2D 场景在显示器上占据的大小来绘制，与 Wallpaper Engine 一致，在高分辨率屏幕上也能保持清晰。“画布尺寸”按作者制作时的大小绘制，再将结果拉伸，占用的 GPU 和内存最少。内部渲染比例会在此基础上再生效。透视场景和视频不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「顯示器解析度」會依 2D 場景在顯示器上佔據的大小來繪製，與 Wallpaper Engine 一致，在高解析度螢幕上也能保持清晰。「畫布尺寸」依作者製作時的大小繪製，再將結果拉伸，使用的 GPU 與記憶體最少。內部渲染比例會在此基礎上再套用。透視場景與影片不受影響。"}}}
    },
    "Display resolution" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Resolução do monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 해상도"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの解像度"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示器分辨率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示器解析度"}}}
    },
    "Canvas size" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tamanho do canvas"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "캔버스 크기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャンバスサイズ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "画布尺寸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "畫布尺寸"}}}
    },
    "%@ on battery. Your setting is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ na bateria. Seu ajuste é %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 중에는 %@입니다. 설정한 값은 %@입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ in Low Power Mode. Your setting is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ no Modo de Pouca Energia. Seu ajuste é %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저전력 모드에서는 %@입니다. 설정한 값은 %@입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低電力モード中は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低电量模式下为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低耗電模式下為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ while the Mac is hot. Your setting is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ enquanto o Mac está quente. Seu ajuste é %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac 온도가 높은 동안은 %@입니다. 설정한 값은 %@입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが高温の間は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 过热时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 過熱時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@ while the battery is low. Your setting is %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ enquanto a bateria está fraca. Seu ajuste é %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 잔량이 부족한 동안은 %@입니다. 설정한 값은 %@입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー残量が少ない間は%1$@です。設定値は%2$@です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "电量低时为 %1$@，你的设置是 %2$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "電量低時為 %1$@。你的設定是 %2$@。"}}}
    },
    "%@. Your setting of %@ is not in effect right now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@. Seu ajuste de %@ não está em vigor agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@입니다. 설정한 %@은(는) 현재 적용되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@です。設定した%2$@は現在適用されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，你设置的 %2$@ 目前未生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。你設定的 %2$@ 目前未生效。"}}}
    },
    "Render scale when reduced" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escala de renderização reduzida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질을 낮출 때의 렌더링 배율"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げるときのレンダリングスケール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质时的渲染比例"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質時的渲染比例"}}}
    },
    "Frame rate when reduced" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Taxa de quadros reduzida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질을 낮출 때의 프레임률"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げるときのフレームレート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质时的帧率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質時的影格率"}}}
    },
    "Every Reduced quality choice on this page uses this render scale and frame rate." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todas as opções de Qualidade reduzida desta página usam esta escala de renderização e taxa de quadros."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 페이지의 모든 ‘화질 낮추기’ 옵션은 이 렌더링 배율과 프레임률을 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このページの「画質を下げる」の選択はすべて、このレンダリングスケールとフレームレートを使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此页面上每个“降低画质”选项都使用这一渲染比例和帧率。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此頁面上每個「降低畫質」選項都會使用這個渲染比例和影格率。"}}}
    },
    "On battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池"}}}
    },
    "Your usual quality settings are in use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seus ajustes de qualidade habituais estão em uso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "평소 화질 설정을 사용하고 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "通常の画質設定を使用しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用平时的画质设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用平時的畫質設定。"}}}
    },
    "Energy use" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Consumo de energia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "에너지 사용량"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量"}}}
    },
    "This app, last few seconds" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este app, últimos segundos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 앱, 최근 몇 초간"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このApp、直近数秒間"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "本应用，最近几秒"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 App，最近幾秒"}}}
    },
    "Right after you apply a wallpaper, these figures include loading it, which can take several watts for a few seconds." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Logo após você aplicar um papel de parede, estes valores incluem o carregamento dele, que pode consumir vários watts por alguns segundos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 적용 직후에는 불러오기에 사용한 전력도 수치에 포함되며, 몇 초 동안 수 와트에 이를 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用した直後は、その読み込み分も値に含まれ、数秒間は数ワットに達することがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刚应用壁纸后，这些读数会包含加载壁纸的耗电，几秒内可能达到数瓦。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "剛套用桌布後，這些數值會包含載入桌布的耗電，幾秒內可能達到數瓦。"}}}
    },
    "How it’s measured" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Como é medido"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "측정 방법"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "測定方法"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "如何测量"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "如何測量"}}}
    },
    "macOS shares GPU energy between apps by GPU time." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS divide a energia da GPU entre os apps pelo tempo de GPU."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS는 GPU 사용 시간에 따라 GPU 에너지 사용량을 앱별로 배분합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはGPUの使用時間に応じて、各AppにGPUのエネルギーを割り当てます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 按各应用占用 GPU 的时间分摊 GPU 能耗。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 依各 App 使用 GPU 的時間分攤 GPU 能源用量。"}}}
    },
    "Includes the control panel, the lock screen and the CPU side of video decoding. Screen compositing, the hardware video decoder, memory and the display itself are not included." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inclui o painel de controle, a tela bloqueada e a parte de CPU da decodificação de vídeo. A composição da tela, o decodificador de vídeo por hardware, a memória e o próprio monitor não estão incluídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제어 패널, 잠금 화면, 동영상 디코딩의 CPU 처리를 포함합니다. 화면 합성, 하드웨어 동영상 디코더, 메모리, 디스플레이 자체는 포함되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Includes the control panel, the lock screen and the CPU side of video decoding. Screen compositing, the hardware video decoder, memory and the display itself are not included."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネル、ロック画面、ビデオデコードのCPU処理を含みます。画面の合成処理、ハードウェアビデオデコーダ、メモリ、ディスプレイ本体は含まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "包含控制面板、锁屏以及视频解码的 CPU 部分，不包含屏幕合成、硬件视频解码器、内存和显示屏本身的耗电。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "包含控制面板、鎖定畫面，以及影片解碼的 CPU 部分；不包含畫面合成、硬體影片解碼器、記憶體及顯示器本身的耗電。"}}}
    },
    "Low: below 0.5 W. Medium: 0.5 W to below 2 W. High: 2 W or more." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixo: abaixo de 0,5 W. Médio: de 0,5 W a menos de 2 W. Alto: 2 W ou mais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮음: 0.5 W 미만. 중간: 0.5 W 이상 2 W 미만. 높음: 2 W 이상."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "低：0.5 W未満。中：0.5 W以上、2 W未満。高：2 W以上。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低：低于 0.5 W。中：0.5 W 至不足 2 W。高：2 W 及以上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低：低於 0.5 W。中：0.5 W 至低於 2 W。高：2 W 以上（含 2 W）。"}}}
    },
    "Change a quality setting below to compare energy use." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Altere um ajuste de qualidade abaixo para comparar o consumo de energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "에너지 사용량을 비교하려면 아래 화질 설정을 변경하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "下の画質設定を変更すると、変更前後のエネルギー使用量を比較できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改下方的画质设置，即可比较修改前后的能耗。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更下方的畫質設定，即可比較變更前後的能源用量。"}}}
    },
    "Measuring…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Medindo…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "측정 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "測定中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在测量…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在測量…"}}}
    },
    "Unavailable on this Mac" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Indisponível neste Mac"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Mac에서 사용 불가"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでは利用できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 不支持"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Mac 無法使用"}}}
    },
    "CPU" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "CPU"}}}
    },
    "GPU" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "GPU"}}}
    },
    "%@ mW" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ mW"}}}
    },
    "%@ W" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ W"}}}
    },
    "GPU shared with other apps" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "GPU compartilhada com outros apps"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱과 GPU 공유 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppとGPUを共有中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "GPU 正与其他应用共享"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "GPU 正與其他 App 共用"}}}
    },
    "Video not counted" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vídeo não contabilizado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상은 집계되지 않음"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Video not counted"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオは計測対象外"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频未计入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片未計入"}}}
    },
    "macOS decodes and draws videos and charges none of that to this app, so these figures leave most of it out. The grade and any comparison are off while one plays." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS decodifica e desenha os vídeos sem atribuir nada disso a este app, então estes valores deixam a maior parte de fora. A classificação e qualquer comparação ficam desativadas enquanto um vídeo é reproduzido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상의 디코딩과 그리기는 macOS가 처리하며 그 부담은 이 앱에 반영되지 않으므로, 이 수치에는 대부분이 빠져 있습니다. 동영상이 재생되는 동안에는 등급과 비교가 꺼집니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS decodes and draws videos and charges none of that to this app, so these figures leave most of it out. The grade and any comparison are off while one plays."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオのデコードと描画はmacOSが行い、その分はこのAppに計上されないため、これらの値にはその大部分が含まれません。再生中は評価と比較を行いません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频由 macOS 解码和绘制，这部分耗电不会计入本应用，因此这些读数不包含其中的大部分。播放期间不给出等级和前后对比。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片由 macOS 解碼與繪製，這部分耗電不會計入此 App，因此這些數值不包含其中的大部分。播放期間不會顯示等級與前後比較。"}}}
    },
    "Other apps are keeping the GPU busy, so the GPU figure reads higher than this app’s own share. The grade and any comparison wait until the GPU is free." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outros apps estão mantendo a GPU ocupada, então o valor da GPU aparece mais alto do que a parcela deste app. A classificação e qualquer comparação aguardam até a GPU ficar livre."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱이 GPU를 사용하고 있어 GPU 수치가 이 앱의 실제 사용량보다 높게 표시됩니다. GPU가 여유로워질 때까지 등급 평가와 비교를 보류합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppがGPUを使用しているため、GPUの値がこのApp自身の使用分より高く表示されています。GPUが空くまで、評価と比較は保留されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用正在大量占用 GPU，因此 GPU 读数会高于本应用实际的份额。等 GPU 空闲后再给出等级和前后对比。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "其他 App 正在大量使用 GPU，因此 GPU 數值會高於此 App 本身的份額。等級與前後比較會等到 GPU 空閒時才顯示。"}}}
    },
    "Low energy use" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixo consumo de energia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "낮은 에너지 사용량"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：低"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗低"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量低"}}}
    },
    "Medium energy use" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Consumo de energia médio"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중간 에너지 사용량"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗中等"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量中等"}}}
    },
    "High energy use" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alto consumo de energia"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "높은 에너지 사용량"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "エネルギー使用量：高"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能耗高"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能源用量高"}}}
    },
    "Less than 1% of a full battery charge per hour." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Menos de 1% de uma carga completa da bateria por hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시간당 완충 배터리 용량의 1% 미만입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間あたりの消費はフル充電の1%未満です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每小时耗电不到满电量的 1%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每小時耗電不到電池充飽電量的 1%。"}}}
    },
    "About %lld%% of a full battery charge per hour." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cerca de %lld%% de uma carga completa da bateria por hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시간당 완충 배터리 용량의 약 %lld%%를 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1時間あたりフル充電の約%lld%%を消費します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每小时约耗满电量的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每小時約耗用電池充飽電量的 %lld%%。"}}}
    },
    "Pause on battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar na bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시 일시 정지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中は一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時暫停"}}}
    },
    "Always pause on battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sempre pausar na bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시 항상 일시 정지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中は常に一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时始终暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時始終暫停"}}}
    },
    "On Battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na Bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時"}}}
    },
    "Keep Running" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Continuar em Execução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계속 실행"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行を続ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續執行"}}}
    },
    "Reduced Quality" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qualidade Reduzida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화질 낮추기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画質を下げる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "降低画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "降低畫質"}}}
    },
    "Pause While Using Other Apps" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar ao Usar Outros Apps"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱 사용 중 일시 정지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppの使用中は一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用其他应用时暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用其他 App 時暫停"}}}
    },
    "Save battery when your Mac is unplugged?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Economizar bateria com o Mac fora da tomada?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Mac에 전원이 연결되어 있지 않을 때 배터리를 아낄까요?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macが電源に接続されていないときにバッテリーを節約しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 未接电源时节省电池电量？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 未接電源時節省電池電量？"}}}
    },
    "Wallpapers now play on battery just as they do plugged in. Nothing changes unless you choose." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Na bateria, os papéis de parede rodam como na tomada. Nada muda se você não escolher."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 중에도 배경화면이 전원 연결 시와 똑같이 재생됩니다. 선택하지 않으면 아무것도 바뀌지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、バッテリー駆動中も壁紙は電源接続時と同じように再生されます。選択しない限り何も変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "目前使用电池时，壁纸会和接上电源时一样播放。除非你做出选择，否则不会有任何改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前使用電池時，桌布會和接上電源時一樣播放。除非你做出選擇，否則不會有任何改變。"}}}
    },
    "The wallpaper playing now uses about %lld%% of a full battery charge per hour." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede atual gasta cerca de %lld%% da bateria cheia por hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금 재생 중인 배경화면은 시간당 완충 배터리 용량의 약 %lld%%를 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "いま再生中の壁紙は、1時間あたりフル充電の約%lld%%を消費します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前播放的壁纸每小时约耗满电量的 %lld%%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前播放的桌布每小時約耗用電池充飽電量的 %lld%%。"}}}
    },
    "The wallpaper playing now uses less than 1% of a full battery charge per hour." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede atual gasta menos de 1% da bateria cheia por hora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금 재생 중인 배경화면은 시간당 완충 배터리 용량의 1% 미만을 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "いま再生中の壁紙の消費は、1時間あたりフル充電の1%未満です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前播放的壁纸每小时耗电不到满电量的 1%。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前播放的桌布每小時耗電不到電池充飽電量的 1%。"}}}
    },
    "Pause while I use other apps" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar enquanto uso outros apps"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱을 사용하는 동안 일시 정지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ほかのAppを使っている間は一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "我使用其他应用时暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "我使用其他 App 時暫停"}}}
    },
    "Animates only while you look at the desktop." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Só se move enquanto você olha para a mesa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑을 볼 때만 움직입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップを見ているときだけ動きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只在你查看桌面时播放动画。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只在你查看桌面時播放動畫。"}}}
    },
    "Lower quality on battery" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reduzir a qualidade na bateria"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배터리 사용 시 화질 낮추기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バッテリー駆動中は画質を下げる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用电池时降低画质"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用電池時降低畫質"}}}
    },
    "Plays at %lld fps and %lld%% render scale." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Roda a %lld fps com escala de renderização de %lld%%."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps, 렌더링 배율 %lld%%로 재생합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld fps、レンダリングスケール%lld%%で再生します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "以 %lld fps 和 %lld%% 渲染比例播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "以 %lld fps 和 %lld%% 渲染比例播放。"}}}
    },
    "Wallpapers hold still until you plug in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ficam parados até você conectar o Mac à energia."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "전원을 연결할 때까지 배경화면이 멈춥니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "電源に接続するまで壁紙は止まったままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸会保持静止，直到你接上电源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布會保持靜止，直到你接上電源。"}}}
    },
    "Measuring the effect of your change. Before it: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Medindo o efeito da sua alteração. Antes dela: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 효과를 측정하고 있습니다. 변경 전: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更の効果を測定しています。変更前：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在测量这次修改的效果。修改前：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在測量變更的效果。變更前：%@。"}}}
    },
    "Before your change: %@. Now: %@, about the same." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Antes da sua alteração: %@. Agora: %@, praticamente igual."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 전: %@. 현재: %@, 거의 동일합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更前：%1$@。現在：%2$@（ほぼ同じ）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改前：%1$@。现在：%2$@，基本持平。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更前：%1$@。目前：%2$@，大致相同。"}}}
    },
    "Before your change: %@. Now: %@ (%@)." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Antes da sua alteração: %@. Agora: %@ (%@)."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "변경 전: %@. 현재: %@ (%@)."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更前：%1$@。現在：%2$@（%3$@）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "修改前：%1$@。现在：%2$@（%3$@）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "變更前：%1$@。目前：%2$@（%3$@）。"}}}
    },
    "1 display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "1 monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 1대"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1台のディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "1 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "1 台顯示器"}}}
    },
    "%lld displays" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 %lld대"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld台のディスプレイ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 台显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 台顯示器"}}}
    },
    "each display’s own frame rate" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "a taxa de quadros de cada monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "각 디스플레이의 개별 프레임률"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "各ディスプレイ固有のフレームレート"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "各显示器自身的帧率"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "各顯示器本身的影格率"}}}
    },
    "%@, about %@. Measured while it played alone on %@ at %@, %@ render scale, with this window closed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@, cerca de %@. Medido enquanto rodava sozinho em %@ com %@, escala de renderização de %@, com esta janela fechada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@, 약 %@. 이 창을 닫고 이 배경화면만 %@에서 %@, 렌더링 배율 %@로 재생하여 측정했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（約%2$@）。このウインドウを閉じ、この壁紙のみを%3$@、%4$@、レンダリングスケール%5$@で再生して測定しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，约 %2$@。在关闭本窗口、仅播放这张壁纸时测得：%3$@，%4$@，渲染比例 %5$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，約 %2$@。測量條件：關閉此視窗並單獨播放此桌布，%3$@，%4$@，渲染比例 %5$@。"}}}
    },
    "%@, about %@. %@ Measured while it played alone on %@ at %@, %@ render scale, with this window closed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@, cerca de %@. %@ Medido enquanto rodava sozinho em %@ com %@, escala de renderização de %@, com esta janela fechada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@, 약 %@. %@ 이 창을 닫고 이 배경화면만 %@에서 %@, 렌더링 배율 %@로 재생하여 측정했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（約%2$@）。%3$@このウインドウを閉じ、この壁紙のみを%4$@、%5$@、レンダリングスケール%6$@で再生して測定しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，约 %2$@。%3$@在关闭本窗口、仅播放这张壁纸时测得：%4$@，%5$@，渲染比例 %6$@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，約 %2$@。%3$@測量條件：關閉此視窗並單獨播放此桌布，%4$@，%5$@，渲染比例 %6$@。"}}}
    },
    "Scene wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede de cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 배경화면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景桌布"}}}
    },
    "MetalFX upscaling" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ampliação com MetalFX"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "MetalFX 업스케일링"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "MetalFX アップスケーリング"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "MetalFX 放大"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "MetalFX 放大"}}}
    },
    "Below 100%, scenes are brought back to full size with Apple’s MetalFX upscaler instead of being stretched. Hard edges can look slightly sharper, but every frame needs extra GPU work, which can raise energy use noticeably. Web and video wallpapers aren’t affected." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abaixo de 100%, as cenas voltam ao tamanho total com o ampliador MetalFX da Apple em vez de serem esticadas. Bordas nítidas podem ficar um pouco mais definidas, mas cada quadro exige trabalho extra da GPU, o que pode aumentar bastante o consumo de energia. Papéis de parede web e de vídeo não são afetados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "100% 미만일 때 장면을 단순히 늘리지 않고 Apple의 MetalFX 업스케일러로 원래 크기로 되돌립니다. 선명한 가장자리는 조금 더 또렷해 보일 수 있지만, 매 프레임마다 추가 GPU 작업이 필요해 에너지 사용량이 눈에 띄게 늘어날 수 있습니다. 웹 및 동영상 배경화면에는 영향을 주지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "100% 未満のとき、シーンを単に引き伸ばす代わりに Apple の MetalFX アップスケーラーで元のサイズに戻します。くっきりした輪郭はわずかにシャープに見えることがありますが、毎フレーム追加の GPU 処理が必要になり、エネルギー使用量が目立って増えることがあります。Web 壁紙と動画壁紙には影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "低于 100% 时，场景会用 Apple 的 MetalFX 放大器恢复到完整尺寸，而不是直接拉伸。清晰的边缘可能会略微锐利一些，但每一帧都需要额外的 GPU 工作，能耗可能明显增加。网页壁纸和视频壁纸不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "低於 100% 時，場景會用 Apple 的 MetalFX 放大器恢復到完整尺寸，而不是直接拉伸。清晰的邊緣可能會略微銳利一些，但每一幀都需要額外的 GPU 工作，能耗可能明顯增加。網頁桌布與影片桌布不受影響。"}}}
    },
    "Scene render optimisation" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Otimização de renderização de cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 렌더링 최적화"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンレンダリングの最適化"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景渲染优化"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景渲染最佳化"}}}
    },
    "How much can be skipped depends on the scene. If everything in it moves, nothing is skipped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quanto pode ser pulado depende da cena. Se tudo nela se move, nada é pulado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "생략할 수 있는 양은 장면에 따라 다릅니다. 장면의 모든 요소가 움직이면 아무것도 생략하지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "省略できる量はシーンによって異なります。シーン内のすべてが動いている場合は、何も省略されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "能跳过多少取决于场景本身。如果画面里的内容都在动，就没有可以跳过的部分。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "能略過多少取決於場景本身。如果場景中的所有內容都在移動，就沒有可略過的部分。"}}}
    },
    "In force now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em vigor agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 적용 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の適用状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前生效"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前生效"}}}
    },
    "Saved on" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvo como ativado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 설정: 켬"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定：オン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置为开启"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已設為開啟"}}}
    },
    "Saved off" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvo como desativado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 설정: 끔"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定：オフ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置为关闭"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已設為關閉"}}}
    },
    "%@; applying to %lld of %lld running scenes on their next frame." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@; aplicando a %lld de %lld cenas em execução no próximo quadro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@이며 실행 중인 장면 %3$lld개 중 %2$lld개의 다음 프레임에 적용됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%3$lld個のシーンのうち%2$lld個に、次のフレームで適用されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 个运行中的场景里有 %2$lld 个将在下一帧生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 個執行中的場景有 %2$lld 個將在下一個影格套用。"}}}
    },
    "%@; %lld of %lld running scenes confirmed, the rest could not be read." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@; %lld de %lld cenas em execução confirmadas, não foi possível ler as demais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@이며 실행 중인 장면 %3$lld개 중 %2$lld개에서 확인되었습니다. 나머지는 읽지 못했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%3$lld個のシーンのうち%2$lld個で確認済みです。残りは読み取れませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 个运行中的场景里已确认 %2$lld 个，其余无法读取。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@；%3$lld 個執行中的場景已確認 %2$lld 個，其餘無法讀取。"}}}
    },
    "%@ and in force on the running scene." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ e em vigor na cena em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@이며 실행 중인 장면에 적용되어 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@。実行中のシーンに適用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@，已在运行中的场景生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@，已在執行中的場景生效。"}}}
    },
    "%@ and in force on all %lld running scenes." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ e em vigor em todas as %lld cenas em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@이며 실행 중인 장면 %lld개 모두에 적용되어 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。実行中の%2$lld個のシーンすべてに適用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，已在全部 %2$lld 个运行中的场景生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@，已在全部 %2$lld 個執行中的場景生效。"}}}
    },
    "Update only when the scene changes" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizar só quando a cena mudar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면이 변경될 때만 갱신"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーンが変化したときのみ更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅在场景变化时更新"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅在場景變化時更新"}}}
    },
    "When a scene has nothing left to animate, it stops drawing until something changes. Scenes that are still moving keep running normally, and scripts, sound and input keep working." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Quando uma cena não tem mais nada para animar, ela para de desenhar até algo mudar. Cenas que ainda estão em movimento continuam rodando normalmente, e scripts, som e entrada continuam funcionando."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면에서 더 이상 움직일 요소가 없으면 변경이 생길 때까지 그리기를 멈춥니다. 계속 움직이는 장면은 정상적으로 실행되며, 스크립트, 소리 및 입력도 계속 작동합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン内にアニメーションするものがなくなると、何かが変化するまで描画を停止します。動いているシーンは通常どおり実行され、スクリプト、サウンド、入力も引き続き機能します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景没有需要更新的内容时停止绘制，等有变化再继续。仍在动的场景照常运行，脚本、声音和输入不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景中沒有需要播放的動畫時，會停止繪製，直到有內容變化為止。仍在移動的場景會照常執行，指令碼、聲音與輸入也會繼續運作。"}}}
    },
    "Updating now" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizando agora"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 갱신 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の更新状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前更新状态"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前更新狀態"}}}
    },
    "No scene wallpaper is running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede de cena em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실행 중인 장면 배경화면이 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中のシーン壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的场景壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有正在執行的場景桌布。"}}}
