    },
    "An active wallpaper display is no longer connected. Refresh displays before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "An active wallpaper display is no longer connected. Refresh displays before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を表示中のディスプレイが接続されていません。ディスプレイを更新してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一台正在播放壁纸的显示器已断开连接。请先刷新显示器再重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "一台正在顯示桌布的顯示器已中斷連接。請先重新整理顯示器再重試。"}}}
    },
    "This wallpaper type cannot be presented by the native wallpaper provider." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper type cannot be presented by the native wallpaper provider."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この種類の壁紙はシステム壁紙プロバイダで表示できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生墙纸提供程序无法显示此类型的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布提供者無法顯示此類型的桌布。"}}}
    },
    "The web wallpaper entry must be a readable file inside its project." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The web wallpaper entry must be a readable file inside its project."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙のエントリは、プロジェクト内の読み取り可能なファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸的入口必须是项目内可读取的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "網頁桌布的進入點必須是專案內可讀取的檔案。"}}}
    },
    "The committed wallpaper does not declare a project type." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not declare a project type."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙にプロジェクトの種類が宣言されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有声明项目类型。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布未宣告專案類型。"}}}
    },
    "The committed wallpaper does not reference project.json." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not reference project.json."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙がproject.jsonを参照していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有引用 project.json。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布未參照 project.json。"}}}
    },
    "The committed wallpaper contains a non-absolute source path." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper contains a non-absolute source path."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用済みの壁紙に、絶対パスではないソースパスが含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸包含非绝对路径的来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已套用的桌布包含非絕對路徑的來源。"}}}
    },
    "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがロック画面のレンダラを読み込みませんでした。元の壁紙が復元されました。ほかの壁紙Appや、競合するシステム全体の壁紙設定がないか確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 没有加载锁定屏幕渲染器，已恢复原来的墙纸。请检查是否有其他墙纸应用，或冲突的全局墙纸设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未載入鎖定畫面渲染器，已還原原本的桌布。請檢查是否有其他桌布 App，或有衝突的全系統桌布選擇。"}}}
    },
    "Wallpaper assets changed while preparing native playback. Retry after the download or edit finishes." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper assets changed while preparing native playback. Retry after the download or edit finishes."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムによる再生の準備中に壁紙のアセットが変更されました。ダウンロードまたは編集が完了してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备原生播放时壁纸文件发生了变化。请等下载或编辑完成后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "準備原生播放時，桌布資源發生變更。請等下載或編輯完成後再重試。"}}}
    },
    "Cannot create native wallpaper asset: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot create native wallpaper asset: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のアセットを作成できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建原生墙纸文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法建立原生桌布資源：%@"}}}
    },
    "Native wallpaper assets cannot contain symbolic links or special files: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Native wallpaper assets cannot contain symbolic links or special files: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のアセットにシンボリックリンクや特殊ファイルを含めることはできません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "原生墙纸文件不能包含符号链接或特殊文件：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布資源不能包含符號連結或特殊檔案：%@"}}}
    },
    "Cannot enumerate wallpaper assets: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot enumerate wallpaper assets: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のアセットを列挙できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取壁纸文件列表：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法列舉桌布資源：%@"}}}
    },
    "The wallpaper asset source must be a real directory: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper asset source must be a real directory: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のアセットのソースは実際のディレクトリである必要があります：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸文件来源必须是真实的文件夹：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布資源的來源必須是實際的資料夾：%@"}}}
    },
    "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "有効なワークショップの壁紙を選択してください。アプリケーション壁紙はWindowsプログラムを実行するため、macOSでは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择有效的创意工坊壁纸。应用程序类壁纸需要运行 Windows 程序，无法在 macOS 上使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇有效的工作坊桌布。應用程式桌布會執行 Windows 程式，無法在 macOS 上使用。"}}}
    },
    "Downloaded, but the library could not refresh: %@. Refresh the library before applying it." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but the library could not refresh: %@. Refresh the library before applying it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、ライブラリを更新できませんでした：%@。適用する前にライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但壁纸库未能刷新：%@。请先刷新壁纸库再应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但桌布庫無法重新整理：%@。請先重新整理桌布庫再套用。"}}}
    },
    "Downloaded, but not applied because you chose another wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but not applied because you chose another wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、ほかの壁紙を選んだため適用しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但你选择了其他壁纸，因此没有应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但你選擇了其他桌布，因此沒有套用。"}}}
    },
    "Downloaded, but not applied because the download took more than an hour." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but not applied because the download took more than an hour."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、完了まで1時間以上かかったため適用しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但下载用时超过一小时，因此没有应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但下載耗時超過一小時，因此沒有套用。"}}}
    },
    "Downloaded, but it could not be applied: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but it could not be applied: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしましたが、適用できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但无法应用：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已下載，但無法套用：%@"}}}
    },
    "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウントのログイン名（表示名ではありません）を入力してください。Wallpaper Engineを所有するアカウントが必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 Steam 账户的登录名（不是昵称）。需要拥有 Wallpaper Engine 的账户。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入你的 Steam 帳號登入名稱（不是顯示名稱）。需要使用擁有 Wallpaper Engine 的帳號。"}}}
    },
    "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがタイムアウトしました。Steam Guardが完了していない場合は、もう一度サインインして新しいリクエストを承認するか、新しいコードを入力してください。それ以外の場合は、ネットワーク接続とディスクの空き容量を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 超时。如果 Steam 令牌验证没有完成，请重新登录并批准新的请求或输入新的验证码；否则请检查网络连接和磁盘空间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 逾時。如果尚未完成 Steam Guard 驗證，請重新登入並核准新的請求，或輸入新的驗證碼；否則請檢查網路連線和可用磁碟空間。"}}}
    },
    "Steam closed the session without confirming the sign-in. Check the account name and password, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam closed the session without confirming the sign-in. Check the account name and password, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインを確認せずにセッションを閉じました。アカウント名とパスワードを確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未确认登录就关闭了会话。请检查账户名和密码后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未確認登入就關閉了工作階段。請檢查帳號名稱和密碼後重試。"}}}
    },
    "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWallpaper Engineのインストール完了を確認せずに終了しました。共有シーンリソースのインストールを再試行してください。既存のリソースは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认 Wallpaper Engine 已完整安装。请重新安装场景资源，现有资源没有被改动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束時未確認 Wallpaper Engine 已完整安裝。請重新安裝場景資源；現有資源未被更動。"}}}
    },
    "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamはワークショップのダウンロード完了を確認せずに終了しました。再試行してください。不完全な壁紙はライブラリに追加されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认创意工坊下载已完成。请重试，未完成的壁纸不会加入壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束時未確認工作坊下載已完成。請重試；沒有任何不完整的桌布加入你的桌布庫。"}}}
    },
    "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがサインインを確認する前に終了しました。アカウント名とパスワードを確認し、Steam Guardで承認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在确认登录前就退出了。请检查账户名和密码，批准 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在確認登入前就已結束。請檢查帳號名稱和密碼，核准 Steam Guard 後重試。"}}}
    },
    "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがダウンロードを完了する前に終了しました。このアカウントがWallpaper Engineを所有していることを確認し、Steam Guardで承認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在下载完成前就退出了。请确认此账户拥有 Wallpaper Engine，批准 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在完成下載前就已結束。請確認此帳號擁有 Wallpaper Engine，核准 Steam Guard 後重試。"}}}
    },
    "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの専用ターミナルを非ブロッキングで読み取れませんでした。WallpaperMachineを再起動してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取 SteamCMD 的终端输出。请重新打开 WallpaperMachine 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法在不阻斷的情況下讀取 SteamCMD 的私有終端機。請重新啟動 WallpaperMachine 後重試。"}}}
    },
    "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD用の専用ターミナルを作成できませんでした。WallpaperMachineを再起動してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法为 SteamCMD 创建终端。请重新打开 WallpaperMachine 后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法為 SteamCMD 建立私有終端機。請重新啟動 WallpaperMachine 後重試。"}}}
    },
    "Cannot launch SteamCMD: %@. Reinstall SteamCMD in Settings → Library & Steam to get Valve’s Apple silicon version." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot launch SteamCMD: %@. Reinstall SteamCMD in Settings → Library & Steam to get Valve’s Apple silicon version."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDを起動できません：%@。設定 → ライブラリとSteamでSteamCMDを再インストールし、ValveのAppleシリコン版を入手してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法启动 SteamCMD：%@。请在设置 → 壁纸库与 Steam 中重新安装 SteamCMD，以获取 Valve 的 Apple 芯片版本。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法啟動 SteamCMD：%@。請在設定 → 桌布庫與 Steam 中重新安裝 SteamCMD，以取得 Valve 的 Apple 晶片版本。"}}}
    },
    "Lost the connection to SteamCMD’s login terminal. Retry signing in." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lost the connection to SteamCMD’s login terminal. Retry signing in."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのログインターミナルとの接続が切れました。もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "与 SteamCMD 登录终端的连接已断开。请重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "與 SteamCMD 登入終端機的連線已中斷。請重新登入。"}}}
    },
    "SteamCMD closed its login prompt. Retry signing in to start a new session." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD closed its login prompt. Retry signing in to start a new session."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがログインプロンプトを閉じました。新しいセッションを開始するには、もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 关闭了登录提示。请重新登录以开始新的会话。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已關閉登入提示。請重新登入以開始新的工作階段。"}}}
    },
    "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアカウントがほかの場所でサインインしたため、Steamがこのセッションを終了しました。ほかの場所でのサインインが終わってから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在其他地方登录，Steam 结束了本次会话。等另一处登录结束后再重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "由於此帳號在其他地方登入，Steam 已結束此工作階段。請在另一處登入完成後再重試。"}}}
    },
    "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがこのダウンロードを拒否しました。Wallpaper Engineを所有し、このワークショップアイテムにアクセスできるアカウントでサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了此次下载。请使用拥有 Wallpaper Engine 且可以访问此创意工坊项目的账户登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒絕了此次下載。請使用擁有 Wallpaper Engine 且可存取此工作坊項目的帳號登入。"}}}
    },
    "Steam could not download this wallpaper. Downloads require a Steam account that has purchased Wallpaper Engine. Buy it on Steam or sign in with an account that already owns it, then retry. If this account already owns it, the wallpaper may be private or removed; check its Workshop page." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not download this wallpaper. Downloads require a Steam account that has purchased Wallpaper Engine. Buy it on Steam or sign in with an account that already owns it, then retry. If this account already owns it, the wallpaper may be private or removed; check its Workshop page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamはこの壁紙をダウンロードできませんでした。ダウンロードには、Wallpaper Engineを購入済みのSteamアカウントが必要です。Steamで購入するか、すでに所有しているアカウントでサインインしてから再試行してください。このアカウントで購入済みの場合は、壁紙が非公開または削除済みの可能性があります。ワークショップのページを確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法下载这张壁纸。下载需要使用已购买 Wallpaper Engine 的 Steam 账户。请在 Steam 上购买，或使用已拥有它的账户登录后重试。如果此账户已经拥有它，壁纸可能已设为私密或已被删除；请查看它的创意工坊页面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法下載這張桌布。下載需要使用已購買 Wallpaper Engine 的 Steam 帳號。請在 Steam 上購買，或使用已擁有它的帳號登入後重試。如果此帳號已經擁有它，桌布可能已設為私人或已被移除；請查看其工作坊頁面。"}}}
    },
    "Not enough free disk space: this download needs about %@ and only %@ is available on the disk that holds your library. Free up space, then try again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Not enough free disk space: this download needs about %@ and only %@ is available on the disk that holds your library. Free up space, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスクの空き容量が足りません：このダウンロードには約%@必要ですが、ライブラリがあるディスクの空きは%@しかありません。空き容量を増やしてから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "磁盘可用空间不足：此下载大约需要 %@，而存放壁纸库的磁盘只剩 %@ 可用。请腾出空间后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "磁碟可用空間不足：此下載大約需要 %@，而存放桌布庫的磁碟只剩 %@ 可用。請釋出空間後再試一次。"}}}
    },
    "Connection lost; retrying (%lld of %lld)…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Connection lost; retrying (%lld of %lld)…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "接続が切れました。再試行しています（%lld/%lld）…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "连接已中断，正在重试（第 %lld 次，共 %lld 次）…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "連線已中斷，正在重試（第 %lld 次，共 %lld 次）…"}}}
    },
    "The connection to Steam dropped while downloading. Check your connection and try again; what was already downloaded is kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The connection to Steam dropped while downloading. Check your connection and try again; what was already downloaded is kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード中にSteamとの接続が切れました。ネットワーク接続を確認してから、もう一度お試しください。ダウンロード済みの分は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载过程中与 Steam 的连接中断了。请检查网络连接后重试；已下载的内容会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載過程中與 Steam 的連線中斷了。請檢查網路連線後再試一次；已下載的內容會保留。"}}}
    },
    "The connection to Steam stopped responding after the Mac woke from sleep. Check your connection and try again; what was already downloaded is kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The connection to Steam stopped responding after the Mac woke from sleep. Check your connection and try again; what was already downloaded is kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Macがスリープから復帰した後、Steamとの接続が応答しなくなりました。ネットワーク接続を確認してから、もう一度お試しください。ダウンロード済みの分は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Mac 从睡眠中唤醒后，与 Steam 的连接不再响应。请检查网络连接后重试；已下载的内容会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Mac 從睡眠中喚醒後，與 Steam 的連線不再回應。請檢查網路連線後再試一次；已下載的內容會保留。"}}}
    },
    "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamはWallpaper Engineの共有リソースをインストールできませんでした。Wallpaper Engineを所有していることとディスクの空き容量を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法安装 Wallpaper Engine 的共享资源。请确认账户拥有 Wallpaper Engine 并检查磁盘空间后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法安裝 Wallpaper Engine 的共用資源。請確認你擁有 Wallpaper Engine 並檢查可用磁碟空間後重試。"}}}
    },
    "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みのSteamのサインイン情報が期限切れか、取り消されました。もう一度試して、Steamにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的 Steam 登录已过期或被撤销。请重试并重新登录 Steam。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的 Steam 登入資訊已過期或已被撤銷。請再試一次並登入 Steam。"}}}
    },
    "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guardが拒否されたか、キャンセルされたか、期限切れになりました。もう一度試してパスワードを入力し、新しいリクエストを承認するか新しいコードを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 令牌验证被拒绝、已取消或已过期。请重试，输入密码后批准新的请求或使用新的验证码。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard 驗證遭拒、已取消或已過期。請再試一次，輸入密碼後核准新的請求，或使用新的驗證碼。"}}}
    },
    "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamが時間内に接続またはサインインを完了できませんでした。ネットワーク接続とSteam Guardの承認を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没能及时完成连接或登录。请检查网络连接和 Steam 令牌验证后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 無法及時完成連線或登入。請檢查網路連線及 Steam Guard 核准狀態後重試。"}}}
    },
    "Steam has temporarily limited sign-in attempts. Wait before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam has temporarily limited sign-in attempts. Wait before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインの試行を一時的に制限しています。しばらく待ってから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 暂时限制了登录尝试，请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 暫時限制了登入嘗試次數。請稍候再重試。"}}}
    },
    "SteamCMD could not complete the request. Check your connection and try again. If it keeps failing, export a diagnostics report from Settings." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD could not complete the request. Check your connection and try again. If it keeps failing, export a diagnostics report from Settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがリクエストを完了できませんでした。ネットワーク接続を確認して再試行してください。失敗が続く場合は、設定から診断レポートを書き出してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 未能完成请求。请检查网络连接后重试。如果仍然失败，请从设置中导出诊断报告。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 未能完成請求。請檢查網路連線後重試。如果仍然失敗，請從設定中匯出診斷報告。"}}}
    },
    "Steam rejected the sign-in. Check your account login name and password, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam rejected the sign-in. Check your account login name and password, then retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがサインインを拒否しました。アカウントのログイン名とパスワードを確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了登录。请检查登录名和密码后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒絕了登入。請檢查帳號登入名稱和密碼後重試。"}}}
    },
    "Steam allows one session at a time for this account; waiting to retry" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam allows one session at a time for this account; waiting to retry"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアカウントでSteamが許可するセッションは一度に1つだけです。再試行を待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在 Steam 上同时只能有一个会话，正在等待重试"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 對此帳號一次只允許一個工作階段；正在等待重試"}}}
    },
    "Waiting for a free download slot" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for a free download slot"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの空きを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待空闲的下载名额"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待可用的下載名額"}}}
    },
    "Waiting for the current sign-in to finish" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the current sign-in to finish"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のサインインが終わるのを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待当前登录完成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待目前的登入完成"}}}
    },
    "Waiting for the previous download" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the previous download"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "前のダウンロードを待っています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待上一项下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在等待上一個下載項目"}}}
    },
    "Wait for active and queued downloads to finish before changing saved sign-in settings." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for active and queued downloads to finish before changing saved sign-in settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みのサインイン設定を変更する前に、実行中およびキュー内のダウンロードが完了するまで待ってください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请等进行中和排队的下载完成后，再更改已保存的登录设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請等候進行中及佇列中的下載完成後，再更改已儲存的登入設定。"}}}
    },
    "No system media provider is configured." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No system media provider is configured."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムのメディアプロバイダが設定されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有可用的系统媒体来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未設定系統媒體提供者。"}}}
    },
    "The folder name cannot be used as a library identifier." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The folder name cannot be used as a library identifier."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダ名はライブラリの識別子として使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹名称无法用作壁纸库标识符。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾名稱無法用作桌布庫識別碼。"}}}
    },
    "Choose a source outside WallpaperMachine’s managed library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a source outside WallpaperMachine’s managed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineが管理するライブラリの外にあるソースを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 WallpaperMachine 壁纸库以外的来源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇 WallpaperMachine 所管理桌布庫以外的來源。"}}}
    },
    "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップアイテム%1$@をライブラリに追加できませんでした：%2$@。ダウンロードの一時領域とライブラリは同じボリューム上にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法添加创意工坊项目 %1$@：%2$@。下载的临时目录和壁纸库必须在同一个磁盘卷上。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法將工作坊項目 %1$@ 加入桌布庫：%2$@。下載暫存區和桌布庫必須位於同一個卷宗。"}}}
    },
    "Download staging must be outside the managed library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Download staging must be outside the managed library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードの一時領域は、管理対象のライブラリの外にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的临时目录必须位于壁纸库之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載暫存區必須位於受管理的桌布庫之外。"}}}
    },
    "Choose a valid numeric Workshop item identifier." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid numeric Workshop item identifier."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "数字のみの有効なワークショップアイテムIDを指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请使用有效的数字创意工坊项目 ID。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請使用有效的工作坊項目數字 ID。"}}}
    },
    "Download directories must be real folders, not symbolic links or special files: %@." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Download directories must be real folders, not symbolic links or special files: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード先のディレクトリは、シンボリックリンクや特殊ファイルではなく実際のフォルダである必要があります：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载目录必须是真实的文件夹，不能是符号链接或特殊文件：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載目錄必須是實際的資料夾，不能是符號連結或特殊檔案：%@。"}}}
    },
    "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたプロジェクトに含められるのは通常のファイルとフォルダのみで、シンボリックリンクや特殊ファイルは含められません：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的项目只能包含普通文件和文件夹，不能包含符号链接或特殊文件：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載的專案只能包含一般檔案和資料夾，不能包含符號連結或特殊檔案：%@。"}}}
    },
    "No project.json found. Choose a wallpaper project, a folder containing projects, a Steam library or a Wallpaper Engine folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No project.json found. Choose a wallpaper project, a folder containing projects, a Steam library or a Wallpaper Engine folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonが見つかりません。壁紙プロジェクト、プロジェクトを含むフォルダ、Steamライブラリ、またはWallpaper Engineのフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "找不到 project.json。请选择壁纸项目、包含项目的文件夹、Steam 库或 Wallpaper Engine 文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "找不到 project.json。請選擇桌布專案、包含專案的資料夾、Steam 收藏庫或 Wallpaper Engine 資料夾。"}}}
    },
    "Symbolic links are not imported. Choose the original folder or file instead." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported. Choose the original folder or file instead."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シンボリックリンクは読み込まれません。代わりに元のフォルダまたはファイルを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接。请选择原始文件夹或文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不會匯入符號連結。請改為選擇原始資料夾或檔案。"}}}
    },
    "The project’s file field must be a relative filename." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must be a relative filename."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトのfileフィールドは相対ファイル名である必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须是相对文件名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案的 file 欄位必須是相對檔名。"}}}
    },
    "The preview path must remain inside the wallpaper folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The preview path must remain inside the wallpaper folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビューのパスは壁紙フォルダ内にある必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图路径必须位于壁纸文件夹内。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽圖路徑必須位於桌布資料夾內。"}}}
    },
    "Project dependency paths may not escape their folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Project dependency paths may not escape their folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの依存関係のパスは、そのフォルダの外を指すことはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目依赖路径不能指向其文件夹之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案相依項目的路徑不能超出其資料夾。"}}}
    },
    "Missing project content: %@. Copy the complete wallpaper folder, not just project.json." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Missing project content: %@. Copy the complete wallpaper folder, not just project.json."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトの内容が見つかりません：%@。project.jsonだけでなく、壁紙フォルダ全体をコピーしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少项目内容：%@。请复制完整的壁纸文件夹，而不只是 project.json。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "缺少專案內容：%@。請拷貝完整的桌布資料夾，而不只是 project.json。"}}}
    },
    "The project’s file field must point inside its own folder (no absolute paths or parent traversal)." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must point inside its own folder (no absolute paths or parent traversal)."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロジェクトのfileフィールドは自身のフォルダ内を指す必要があります（絶対パスや親ディレクトリへの移動は使用できません）。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须指向自身文件夹内的文件（不能用绝对路径或上级目录）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "專案的 file 欄位必須指向其資料夾內的檔案（不可使用絕對路徑或上層目錄）。"}}}
    },
    "This preset names itself as the wallpaper it is based on, so it cannot be used." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This preset names itself as the wallpaper it is based on, so it cannot be used."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットは自分自身を元の壁紙として指定しているため、使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设将自身指定为所基于的壁纸，因此无法使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集將自身指定為所依據的桌布，因此無法使用。"}}}
    },
    "This preset is based on another preset (Workshop item %@). Presets of presets are not supported." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This preset is based on another preset (Workshop item %@). Presets of presets are not supported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットは別のプリセット（ワークショップアイテム %@）を元にしています。プリセットを元にしたプリセットには対応していません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设基于另一个预设（创意工坊项目 %@）。不支持基于预设的预设。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集依據另一個預設集（工作坊項目 %@）。不支援依據預設集的預設集。"}}}
    },
    "This preset is based on Workshop item %@, which is not in your library. Download or import that wallpaper first, then try again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This preset is based on Workshop item %@, which is not in your library. Download or import that wallpaper first, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットはワークショップアイテム %@ を元にしていますが、ライブラリにありません。先にその壁紙をダウンロードまたは読み込んでから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此预设基于创意工坊项目 %@，但它不在你的资源库中。请先下载或导入该壁纸，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此預設集依據工作坊項目 %@，但它不在你的資料庫中。請先下載或匯入該桌布，然後再試一次。"}}}
    },
    "The preset downloaded, but the wallpaper it is based on (Workshop item %@) did not, so nothing was added to your library. %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The preset downloaded, but the wallpaper it is based on (Workshop item %@) did not, so nothing was added to your library. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットはダウンロードできましたが、元になっている壁紙（ワークショップアイテム%1$@）がダウンロードできなかったため、ライブラリには何も追加されていません。%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预设已下载，但它所基于的壁纸（创意工坊项目 %1$@）没有下载成功，因此没有向壁纸库添加任何内容。%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預設集已下載，但它所依據的桌布（工作坊項目 %1$@）沒有下載成功，因此沒有任何內容加入你的桌布庫。%2$@"}}}
    },
    "Downloading the wallpaper this preset is based on…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloading the wallpaper this preset is based on…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このプリセットの元になる壁紙をダウンロード中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载此预设所基于的壁纸…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載此預設集所依據的桌布…"}}}
    },
    "project.json must describe a scene, video, or web wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must describe a scene, video, or web wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonはシーン、ビデオ、またはWeb壁紙を記述している必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须描述场景、视频或网页壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須描述場景、影片或網頁桌布。"}}}
    },
    "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonはBOM（バイトオーダーマーク）なしのUTF-8エンコーディングである必要があります。マニフェストを変換してから、もう一度読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须使用不带 BOM 的 UTF-8 编码。请转换后重新导入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須使用不含 BOM（位元組順序記號）的 UTF-8 編碼。請轉換此資訊清單後重新匯入。"}}}
    },
    "project.json must be a regular JSON file smaller than 16 MB." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must be a regular JSON file smaller than 16 MB."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonは16 MB未満の通常のJSONファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须是小于 16 MB 的普通 JSON 文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須是小於 16 MB 的一般 JSON 檔案。"}}}
    },
    "Could not create %@. Check available disk space and folder permissions." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create %@. Check available disk space and folder permissions."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を作成できませんでした。ディスクの空き容量とフォルダのアクセス権を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建 %@。请检查磁盘空间和文件夹权限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法建立 %@。請檢查可用磁碟空間和資料夾權限。"}}}
    },
    "Unsupported special file: %@. Only regular files and folders can be imported." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unsupported special file: %@. Only regular files and folders can be imported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対応していない特殊ファイルです：%@。読み込めるのは通常のファイルとフォルダのみです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持的特殊文件：%@。只能导入普通文件和文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援的特殊檔案：%@。只能匯入一般檔案和資料夾。"}}}
    },
    "Symbolic links are not imported: %@. Copy the original content into the project folder first." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported: %@. Copy the original content into the project folder first."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シンボリックリンクは読み込まれません：%@。先に元の内容をプロジェクトフォルダにコピーしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接：%@。请先把原始内容复制到项目文件夹中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不會匯入符號連結：%@。請先將原始內容拷貝到專案資料夾中。"}}}
    },
    "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがユーザ所有の壁紙サービスの再読み込みを拒否しました（errno %d）。復元ジャーナルは保持されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 拒绝重新加载墙纸服务（errno %d）。恢复记录已保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 拒絕重新載入使用者擁有的桌布服務（errno %d）。已保留還原記錄。"}}}
    },
    "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のユーザが所有していると確実に確認できたWallpaperAgentが実行されていません。システムの壁紙選択を有効にできませんでした。復元ジャーナルは保持されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有找到可确认属于当前用户的 WallpaperAgent 进程，无法启用锁定屏幕墙纸。恢复记录已保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有執行中且經確認屬於目前使用者的 WallpaperAgent。無法啟用原生桌布選擇；已保留其還原記錄。"}}}
    },
    "Unable to identify the wallpaper service safely." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to identify the wallpaper service safely."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙サービスを安全に特定できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全识别墙纸服务。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全地識別桌布服務。"}}}
    },
    "Unable to enumerate the wallpaper service." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to enumerate the wallpaper service."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙サービスを列挙できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法列出墙纸服务进程。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法列舉桌布服務。"}}}
    },
    "This macOS Space has an unsupported wallpaper configuration." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS Space has an unsupported wallpaper configuration."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このmacOSの操作スペースには、対応していない壁紙構成があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个 macOS 桌面空间的墙纸配置不受支持。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 空間的桌布設定不受支援。"}}}
    },
    "The system wallpaper was changed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again; external choices will be preserved." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper was changed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again; external choices will be preserved."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙がWallpaperMachineの外部で変更されました。該当する壁紙機能を一度オフにしてから、もう一度オンにしてください。外部で行った選択は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "系统墙纸在 WallpaperMachine 之外被更改了。请先关闭受影响的壁纸功能，再重新开启；你在别处做的选择会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "系統桌布已在 WallpaperMachine 之外被更改。請先關閉受影響的桌布功能再重新開啟；你在外部所做的選擇會保留。"}}}
    },
    "The native wallpaper restoration journal is invalid." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The native wallpaper restoration journal is invalid."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙の復元ジャーナルが無効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸恢复记录无效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布還原記錄無效。"}}}
    },
    "A native wallpaper override was removed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper override was removed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のオーバーライドがWallpaperMachineの外部で削除されました。該当する壁紙機能を一度オフにしてから、もう一度オンにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸设置在 WallpaperMachine 之外被移除了。请先关闭受影响的壁纸功能，再重新开启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布覆寫設定已在 WallpaperMachine 之外被移除。請先關閉受影響的桌布功能再重新開啟。"}}}
    },
    "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙を選択している間に、システムの壁紙が変更されました。再試行してください。同時に行われた変更は上書きされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置过程中系统墙纸发生了变化。请重试，其间的更改没有被覆盖。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "進行原生桌布選擇時，系統桌布發生變更。請重試；同時進行的變更均未被覆寫。"}}}
    },
    "This macOS wallpaper store format is unsupported. Native selection was not changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS wallpaper store format is unsupported. Native selection was not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このmacOSの壁紙ストア形式には対応していません。システムの壁紙選択は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持这个版本的 macOS 墙纸存储格式，墙纸设置没有被更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援此 macOS 桌布儲存格式。原生桌布選擇未變更。"}}}
    },
    "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling native wallpaper animation; the existing global wallpaper was not changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling native wallpaper animation; the existing global wallpaper was not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、システム全体でリンクされた壁紙が個々のディスプレイの設定より優先されています。システム壁紙のアニメーションをオンにする前に、その壁紙Appまたはその「すべてのディスプレイ」設定をオフにしてください。既存のグローバル壁紙は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前有一个全局墙纸覆盖了所有显示器。请先关闭那个墙纸应用或它的“所有显示器”设置，再启用原生墙纸动画。现有的全局墙纸没有被更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前有全系統連動的桌布覆蓋了個別顯示器。請先關閉該桌布 App 或其「所有顯示器」設定，再啟用原生桌布動畫；現有的全域桌布未變更。"}}}
    },
    "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling native wallpaper animation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling native wallpaper animation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙選択に、復元ジャーナルも残存するシステムのフォールバックもありません。システム壁紙のアニメーションをオンにする前に、このディスプレイのシステム壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台显示器的墙纸设置没有可用的恢复记录或系统备选。请先为它选择一张系统墙纸，再启用原生墙纸动画。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布選擇沒有還原記錄，也沒有留存的系統備用桌布。請先為此顯示器選擇系統桌布，再啟用原生桌布動畫。"}}}
    },
    "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はダウンロード済みですが、Wallpaper Engineの共有シーンリソースがインストールされていません。壁紙の詳細で「共有リソースを入手」を選択するか、「設定」→「ライブラリとSteam」に移動してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已下载，但还没有安装 Wallpaper Engine 的共享场景资源。请在壁纸详情中点击“获取共享资源”，或前往“设置 → 壁纸库与 Steam”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已下載，但尚未安裝 Wallpaper Engine 的共用場景資源。請在桌布詳細資訊中選擇「取得共用資源」，或前往「設定 → 桌布庫與 Steam」。"}}}
    },
    "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダにはWallpaper Engineの共有シェーダとマテリアルが含まれていません。完全なassetsフォルダを選択するか、Steamで共有シーンリソースをインストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹不包含 Wallpaper Engine 的共享着色器和材质。请选择完整的 assets 文件夹，或通过 Steam 安装场景资源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾不含 Wallpaper Engine 的共用著色器和材質。請選擇完整的 assets 資料夾，或透過 Steam 安裝場景資源。"}}}
    },
    "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから完全な共有シーンリソースを取得できませんでした。このアカウントがWallpaper Engineを所有していることを確認してから再試行してください。既存のリソースは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没有提供完整的场景资源。请确认此账户拥有 Wallpaper Engine 后重试，现有资源没有被改动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未產生完整的場景資源。請確認此帳號擁有 Wallpaper Engine 後重試。現有資源未被更動。"}}}
    },
    "This wallpaper is not a folder in the managed library. Nothing was deleted." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is not a folder in the managed library. Nothing was deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙は管理対象のライブラリ内のフォルダではありません。何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸不是壁纸库中的文件夹，没有删除任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布不是受管理桌布庫中的資料夾。未刪除任何內容。"}}}
    },
    "Invalid wallpaper ID. Nothing was deleted." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Invalid wallpaper ID. Nothing was deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙IDが無効です。何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸 ID 无效，没有删除任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布 ID 無效。未刪除任何內容。"}}}
    },
    "Restoration also failed: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Restoration also failed: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元にも失敗しました：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复也失败了：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原也失敗了：%@"}}}
    },
    "Next Wallpaper" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Next Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下一张壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下一張桌布"}}}
    },
    "Lock Screen" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lock Screen"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面をロック"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面"}}}
    },
    "Requires macOS 26 or later" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Requires macOS 26 or later"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26以降が必要です"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或更高版本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或以上版本"}}}
    },
    "Unavailable" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unavailable"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "利用できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不可用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用"}}}
    },
    "That app rule no longer exists." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "That app rule no longer exists."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "そのAppルールはもう存在しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "该应用规则已不存在。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "該 App 規則已不存在。"}}}
    },
    "Couldn’t reach pixiv: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t reach pixiv: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivに接続できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法连接 pixiv：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法連線至 pixiv：%@"}}}
    },
    "pixiv has nothing at this address any more. The work may have been deleted, or the ranking has no more pages." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv has nothing at this address any more. The work may have been deleted, or the ranking has no more pages."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアドレスにはpixivのコンテンツがもうありません。作品が削除されたか、ランキングにこれ以上のページがない可能性があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 上已没有这个地址的内容。作品可能已被删除，或者排行榜没有更多页了。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 上此位址已沒有內容。作品可能已被刪除，或排行榜已沒有更多頁面。"}}}
    },
    "pixiv is limiting requests from this network right now. Wait a minute, then try again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv is limiting requests from this network right now. Wait a minute, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivは現在、このネットワークからのリクエストを制限しています。1分ほど待ってから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 目前正在限制来自此网络的请求。请稍等一分钟后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 目前正在限制來自此網路的請求。請稍候一分鐘再試一次。"}}}
    },
    "pixiv denied access to this request (HTTP 403). Check access in your browser and your network or proxy connection before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv denied access to this request (HTTP 403). Check access in your browser and your network or proxy connection before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがこのリクエストへのアクセスを拒否しました（HTTP 403）。ブラウザでpixivにアクセスできるか、ネットワークやプロキシの接続を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 拒绝了此请求的访问（HTTP 403）。请检查浏览器能否访问 pixiv，以及网络或代理连接，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 拒絕了此請求的存取（HTTP 403）。請檢查瀏覽器能否存取 pixiv，以及網路或代理連線，然後重試。"}}}
    },
    "pixiv returned status %lld. Try again later." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv returned status %lld. Try again later."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがステータス%lldを返しました。あとでもう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回了状态码 %lld。请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回狀態碼 %lld。請稍後再試。"}}}
    },
    "pixiv sent an answer this version of WallpaperMachine can’t read. Try again, or open the work on pixiv." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv sent an answer this version of WallpaperMachine can’t read. Try again, or open the work on pixiv."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから、このバージョンのWallpaperMachineでは読み取れない応答が返されました。もう一度試すか、pixivで作品を開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回的内容无法被此版本的 WallpaperMachine 读取。请重试，或在 pixiv 上打开该作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回的回應無法由此版本的 WallpaperMachine 讀取。請再試一次，或在 pixiv 上打開該作品。"}}}
    },
    "pixiv shows this work only to signed-in members, or only to the artist’s followers. Sign in to pixiv, or open the work there." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv shows this work only to signed-in members, or only to the artist’s followers. Sign in to pixiv, or open the work there."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この作品は、pixivにサインインしている会員、または作者のフォロワーにのみ公開されています。pixivにサインインするか、pixivで作品を開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 仅向已登录的会员或作者的关注者展示此作品。请登录 pixiv，或在 pixiv 上打开该作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 只向已登入的會員或作者的追蹤者顯示此作品。請登入 pixiv，或在 pixiv 上打開該作品。"}}}
    },
    "The image is larger than the %lld MB WallpaperMachine accepts." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The image is larger than the %lld MB WallpaperMachine accepts."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像がWallpaperMachineで扱える上限の%lld MBを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片超过了 WallpaperMachine 可接受的 %lld MB 上限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片超過 WallpaperMachine 可接受的 %lld MB 上限。"}}}
    },
    "pixiv sent a file that is not a JPEG, PNG or GIF image." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv sent a file that is not a JPEG, PNG or GIF image."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから送られたファイルは、JPEG、PNG、GIFのいずれの画像でもありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 发送的文件不是 JPEG、PNG 或 GIF 图片。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳送的檔案不是 JPEG、PNG 或 GIF 圖片。"}}}
    },
    "The downloaded image couldn’t be read. Try downloading it again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The downloaded image couldn’t be read. Try downloading it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードした画像を読み取れませんでした。もう一度ダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的图片无法读取。请重新下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取下載的圖片。請重新下載。"}}}
    },
    "pixiv didn’t accept the sign-in. Sign in to pixiv again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv didn’t accept the sign-in. Sign in to pixiv again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがサインインを受け付けませんでした。もう一度pixivにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 未接受此次登录。请重新登录 pixiv。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 未接受此次登入。請重新登入 pixiv。"}}}
    },
    "pixiv won’t show R-18 works to this account. Turn them on in pixiv’s settings under Viewing restrictions, then refresh." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv won’t show R-18 works to this account. Turn them on in pixiv’s settings under Viewing restrictions, then refresh."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivはこのアカウントにR-18作品を表示しません。pixivの設定の「閲覧制限」でオンにしてから、更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 不会向此账户显示 R-18 作品。请在 pixiv 设置的“浏览限制”中开启，然后刷新。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 不會向此帳號顯示 R-18 作品。請在 pixiv 設定的「瀏覽限制」中開啟，然後重新整理。"}}}
    },
    "Signed in, but the keychain didn’t keep the sign-in, so you’ll need to sign in again after WallpaperMachine quits." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Signed in, but the keychain didn’t keep the sign-in, so you’ll need to sign in again after WallpaperMachine quits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしましたが、キーチェーンにサインイン情報を保存できなかったため、WallpaperMachineの終了後にもう一度サインインする必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已登录，但钥匙串未能保存登录信息，WallpaperMachine 退出后需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已登入，但鑰匙圈未保存登入資訊，因此 WallpaperMachine 結束後你需要重新登入。"}}}
    },
    "Sign in to pixiv" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign in to pixiv"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivにサインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 pixiv"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 pixiv"}}}
    },
    "Choose a video, image, HTML file, or Wallpaper Engine project folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a video, image, HTML file, or Wallpaper Engine project folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ、画像、HTMLファイル、またはWallpaper Engineのプロジェクトフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择视频、图片、HTML 文件或 Wallpaper Engine 项目文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇影片、圖片、HTML 檔案或 Wallpaper Engine 專案資料夾。"}}}
    },
    "Choose videos, images, HTML files, project folders or a Steam library. Your original files are kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose videos, images, HTML files, project folders or a Steam library. Your original files are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ、画像、HTMLファイル、プロジェクトフォルダ、またはSteamライブラリを選択してください。元のファイルは保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择视频、图片、HTML 文件、项目文件夹或 Steam 库。原始文件会被保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇影片、圖片、HTML 檔案、專案資料夾或 Steam 收藏庫。原始檔案會保留。"}}}
    },
    "Images must be regular files between 1 byte and 512 MB." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Images must be regular files between 1 byte and 512 MB."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像は1バイトから512 MBまでの通常のファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片必须是 1 字节到 512 MB 之间的普通文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片必須是介於 1 位元組到 512 MB 之間的一般檔案。"}}}
    },
    "This image could not be read. Choose a picture that opens in Preview." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This image could not be read. Choose a picture that opens in Preview."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この画像を読み取れませんでした。「プレビュー」で開ける画像を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取这张图片。请选择能在“预览”中打开的图片。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取此圖片。請選擇可在「預覽程式」中打開的圖片。"}}}
    },
    "Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布"}}}
    },
    "Pause, mute or stop wallpapers while this Focus is on." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Pause, mute or stop wallpapers while this Focus is on."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この集中モードがオンのあいだ、壁紙を一時停止、消音、または停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此专注模式开启时暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此專注模式開啟時，暫停、靜音或停止桌布。"}}}
    },
    "Wallpaper playback" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper playback"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布播放"}}}
    },
    "Keep running" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Keep running"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行を続ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續執行"}}}
    },
    "Mute" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Mute"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音"}}}
    },
    "Stop (free memory)" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Stop (free memory)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "停止（メモリを解放）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止（释放内存）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "停止（釋放記憶體）"}}}
    },
    "This display has no rotating playlist to move along." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This display has no rotating playlist to move along."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイには、次に進めるローテーション中のプレイリストがありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器没有可轮换的播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器沒有可切換的輪播播放列表。"}}}
    },
    "Steam answered the request for Workshop details in a form this app does not read." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam answered the request for Workshop details in a form this app does not read."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからのワークショップの詳細に関する応答は、このAppでは読み取れない形式でした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回的创意工坊详情格式无法识别。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 傳回的工作坊詳細資訊格式無法由此 App 讀取。"}}}
    },
    "Steam did not answer the request for Workshop details. Check your connection and try again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not answer the request for Workshop details. Check your connection and try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがワークショップの詳細のリクエストに応答しませんでした。ネットワーク接続を確認して、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未响应创意工坊详情请求。请检查网络连接后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未回應工作坊詳細資訊請求。請檢查網路連線後再試一次。"}}}
    },
    "Couldn’t check the Workshop for updates: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t check the Workshop for updates: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップのアップデートを確認できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法检查创意工坊更新：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法檢查工作坊更新：%@"}}}
    },
    "Could not replace Workshop item %@ with its update: %@. The installed version is unchanged." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not replace Workshop item %@ with its update: %@. The installed version is unchanged."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップアイテム%@をアップデートで置き換えられませんでした：%@。インストール済みのバージョンは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法用更新替换创意工坊项目 %@：%@。已安装的版本保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法以更新取代工作坊項目 %@：%@。已安裝的版本維持不變。"}}}
    },
    "Could not replace %@ with the imported copy: %@ The installed version is unchanged." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not replace %@ with the imported copy: %@ The installed version is unchanged."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を読み込んだコピーで置き換えられませんでした：%@ インストール済みのバージョンは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法用导入的副本替换 %@：%@ 已安装的版本保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法以匯入的副本取代 %@：%@ 已安裝的版本維持不變。"}}}
    },
    "Its folder in the library has no project.json, so it is not an installed wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Its folder in the library has no project.json, so it is not an installed wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリ内のそのフォルダにはproject.jsonがないため、インストール済みの壁紙ではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它在壁纸库中的文件夹没有 project.json，因此不是已安装的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它在桌布庫中的資料夾沒有 project.json，因此不是已安裝的桌布。"}}}
    },
    "Play or pause wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Play or pause wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停桌布"}}}
    },
    "Next wallpaper" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Next wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下一张壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下一張桌布"}}}
    },
    "Open the control panel" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Open the control panel"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネルを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开控制面板"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開控制面板"}}}
    },
    "Another app already uses this shortcut. Record a different one." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Another app already uses this shortcut. Record a different one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このショートカットはほかのAppですでに使用されています。別のショートカットを記録してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用已在使用这个快捷键。请录制另一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另一個 App 已在使用此快速鍵。請錄製其他快速鍵。"}}}
    },
    "macOS did not accept this shortcut (error %lld). Record a different one." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not accept this shortcut (error %lld). Record a different one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがこのショートカットを受け付けませんでした（エラー%lld）。別のショートカットを記録してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 不接受这个快捷键（错误 %lld）。请录制另一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受此快速鍵（錯誤 %lld）。請錄製其他快速鍵。"}}}
    },
    "Hold ⌘, ⌥ or ⌃ with the key, so the shortcut doesn’t take it away from typing." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Hold ⌘, ⌥ or ⌃ with the key, so the shortcut doesn’t take it away from typing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "通常の文字入力を妨げないよう、キーと一緒に⌘、⌥、または⌃を押してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请与 ⌘、⌥ 或 ⌃ 一起按下按键，以免快捷键占用正常输入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請同時按住 ⌘、⌥ 或 ⌃ 與該按鍵，以免快速鍵影響一般輸入。"}}}
    },
    "This key can’t be used for a shortcut. Try a letter, a number or a function key." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This key can’t be used for a shortcut. Try a letter, a number or a function key."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このキーはショートカットに使用できません。文字、数字、またはファンクションキーを試してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个按键不能用作快捷键。请试试字母、数字或功能键。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此按鍵無法用作快速鍵。請試試字母、數字或功能鍵。"}}}
    },
    "That shortcut is already used for “%@”." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "That shortcut is already used for “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "そのショートカットはすでに「%@」に使用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个快捷键已用于“%@”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此快速鍵已用於「%@」。"}}}
    },
    "WallpaperMachine is still starting, or its renderer could not start. Try again in a moment." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine is still starting, or its renderer could not start. Try again in a moment."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineが起動中か、レンダラを起動できませんでした。しばらくしてからもう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仍在启动，或其渲染器无法启动。请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仍在啟動中，或其渲染器無法啟動。請稍後再試。"}}}
    },
    "No installed wallpaper has the id “%@”." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No installed wallpaper has the id “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ID「%@」のインストール済みの壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有 ID 为“%@”的已安装壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有 ID 為「%@」的已安裝桌布。"}}}
    },
    "No enabled display showing its own wallpaper has the id “%@”." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No enabled display showing its own wallpaper has the id “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "独自の壁紙を表示している有効なディスプレイに、ID「%@」のものはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有 ID 为“%@”且显示自身壁纸的已启用显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有 ID 為「%@」且顯示其專屬桌布的已啟用顯示器。"}}}
    },
    "Wallpaper" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布"}}}
    },
    "Pause Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Pause Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停桌布"}}}
    },
    "Pauses every wallpaper, as Pause in the menu bar does." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Pauses every wallpaper, as Pause in the menu bar does."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューバーの「一時停止」と同様に、すべての壁紙を一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停所有壁纸，与菜单栏中的“暂停”相同。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停所有桌布，與選單列中的「暫停」相同。"}}}
    },
    "Resume Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Resume Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再開"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续播放壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續播放桌布"}}}
    },
    "Plays every wallpaper again after a pause." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Plays every wallpaper again after a pause."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一時停止後に、すべての壁紙を再び再生します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停后重新播放所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停後重新播放所有桌布。"}}}
    },
    "Play or Pause Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Play or Pause Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停桌布"}}}
    },
    "Pauses wallpapers that are playing, and plays them when paused." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Pauses wallpapers that are playing, and plays them when paused."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生中の壁紙を一時停止し、一時停止中の場合は再生します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停正在播放的壁纸；已暂停时则开始播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停正在播放的桌布；若已暫停則開始播放。"}}}
    },
    "Changes the target display to its next wallpaper: its playlist's next when it rotates, otherwise the next one in your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Changes the target display to its next wallpaper: its playlist's next when it rotates, otherwise the next one in your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対象ディスプレイを次の壁紙に切り替えます。プレイリストがローテーション中の場合はプレイリストの次の壁紙、それ以外の場合はライブラリの次の壁紙になります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将目标显示器切换到下一张壁纸：若其播放列表在轮换，则为列表中的下一张，否则为壁纸库中的下一张。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將目標顯示器切換至下一張桌布：若其播放列表正在輪播，則為列表中的下一張，否則為桌布庫中的下一張。"}}}
    },
    "Apply Wallpaper" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Apply Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用桌布"}}}
    },
    "Applies an installed wallpaper to the target display." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Applies an installed wallpaper to the target display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの壁紙を対象ディスプレイに適用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将已安装的壁纸应用到目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將已安裝的桌布套用到目標顯示器。"}}}
    },
    "Apply ${wallpaper}" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Apply ${wallpaper}"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "${wallpaper}を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用 ${wallpaper}"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用 ${wallpaper}"}}}
    },
    "Open WallpaperMachine" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Open WallpaperMachine"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開 WallpaperMachine"}}}
    },
    "Opens the control panel." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Opens the control panel."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネルを開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开控制面板。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開控制面板。"}}}
    },
    "Play or Pause" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Play or Pause"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停"}}}
    },
    "Mute Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Mute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音"}}}
    },
    "Unmute Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unmute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の消音を解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消桌布靜音"}}}
    },
    "Mute or Unmute Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or Unmute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を消音／消音を解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音或取消靜音"}}}
    },
    "Silences every wallpaper without changing their saved sound settings." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Silences every wallpaper without changing their saved sound settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されたサウンド設定は変えずに、すべての壁紙を消音します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音，不更改它们已保存的声音设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音，不更改它們已儲存的聲音設定。"}}}
    },
    "Lets every wallpaper play its saved sound again after Mute Wallpapers." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lets every wallpaper play its saved sound again after Mute Wallpapers."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「壁紙を消音」のあと、すべての壁紙が保存済みのサウンド設定で再び音を出すようにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“壁纸静音”之后，让每个壁纸按已保存的声音设置重新发声。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「桌布靜音」之後，讓每個桌布依已儲存的聲音設定重新發聲。"}}}
    },
    "Silences every wallpaper, or lets them play their saved sound again when they are already silenced." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Silences every wallpaper, or lets them play their saved sound again when they are already silenced."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての壁紙を消音します。すでに消音している場合は、保存済みのサウンド設定で再び音を出します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音；若已静音，则让它们按已保存的声音设置重新发声。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音；若已靜音，則讓它們依已儲存的聲音設定重新發聲。"}}}
    },
    "Mute or unmute wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or unmute wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の消音／消音解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音或取消靜音"}}}
    },
    "Mute or Unmute" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or Unmute"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消音／消音解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音或取消靜音"}}}
    },
    "Downloads: %lld in progress, %lld%%" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld in progress, %lld%%"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード：%lld件を実行中、%lld%%"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载：%lld 项进行中，%lld%%"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載：%lld 項進行中，%lld%%"}}}
    },
    "Downloads: %lld in progress" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld in progress"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード：%lld件を実行中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载：%lld 项进行中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載：%lld 項進行中"}}}
    },
    "A collection can’t be downloaded as one. Open it to download its wallpapers." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A collection can’t be downloaded as one. Open it to download its wallpapers."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションはまとめてダウンロードできません。コレクションを開いて、含まれる壁紙をダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "合集无法整体下载。请打开合集，下载其中的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏集無法整個下載。請打開收藏集以下載其中的桌布。"}}}
    },
    "Every wallpaper you subscribe to is already in your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Every wallpaper you subscribe to is already in your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サブスクライブ中の壁紙はすべてライブラリにあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你订阅的每个壁纸都已在库中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你訂閱的所有桌布都已在桌布庫中。"}}}
    },
    "Sign in to Steam" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign in to Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamにサインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 Steam"}}}
    },
    "Steam asked you to sign in again. Sign in to Steam to see your subscriptions." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam asked you to sign in again. Sign in to Steam to see your subscriptions."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから再度サインインするよう求められました。サブスクライブ中のアイテムを表示するには、Steamにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求你重新登录。登录 Steam 后即可查看你的订阅。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求你重新登入。登入 Steam 即可查看你的訂閱項目。"}}}
    },
    "Steam no longer serves this collection." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this collection."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコレクションはSteamで提供されなくなりました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供这个合集。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此收藏集。"}}}
    },
    "This link is not a Wallpaper Engine item." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This link is not a Wallpaper Engine item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このリンクはWallpaper Engineのアイテムではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个链接指向的不是 Wallpaper Engine 的项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此連結指向的不是 Wallpaper Engine 的項目。"}}}
    },
    "Steam no longer serves this Workshop item." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this Workshop item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このワークショップアイテムはSteamで提供されなくなりました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供这个创意工坊项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此工作坊項目。"}}}
    },
    "Application wallpapers run Windows programs and can’t be used on macOS." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Application wallpapers run Windows programs and can’t be used on macOS."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アプリケーション壁紙はWindowsプログラムを実行するため、macOSでは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用程序类壁纸需要运行 Windows 程序，无法在 macOS 上使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "應用程式桌布會執行 Windows 程式，無法在 macOS 上使用。"}}}
    },
    "Steam’s sign-in finished without a session this app can use. Try signing in again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam’s sign-in finished without a session this app can use. Try signing in again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインインは完了しましたが、このAppで使用できるセッションを取得できませんでした。もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登录已结束，但没有得到本应用可用的会话。请再试一次登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登入已完成，但未取得此 App 可用的工作階段。請再次嘗試登入。"}}}
    },
    "This Steam account id is not one Steam uses." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This Steam account id is not one Steam uses."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamアカウントIDは、Steamで使われているIDではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这不是 Steam 使用的账户 ID。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 帳號 ID 並非 Steam 使用的有效 ID。"}}}
    },
    "The library’s folder for Workshop item %@ holds no project.json, so it is not an installed wallpaper and the new copy was not put in its place. Move the folder out of the library and download the item again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The library’s folder for Workshop item %@ holds no project.json, so it is not an installed wallpaper and the new copy was not put in its place. Move the folder out of the library and download the item again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリにあるワークショップアイテム%@のフォルダにはproject.jsonがないため、インストール済みの壁紙ではなく、新しいコピーで置き換えませんでした。フォルダをライブラリの外に移動してから、アイテムをもう一度ダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库中创意工坊项目 %@ 的文件夹没有 project.json，因此不是已安装的壁纸，未用新副本替换它。请将该文件夹移出壁纸库，然后重新下载该项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫中工作坊項目 %@ 的資料夾沒有 project.json，因此不是已安裝的桌布，沒有以新副本取代它。請將該資料夾移出桌布庫，再重新下載該項目。"}}}
    },
    "The wallpaper properties changed while preparing this preset. Refresh and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper properties changed while preparing this preset. Refresh and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットの準備中に壁紙のプロパティが変更されました。更新してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备预设时壁纸属性发生了变化。请刷新后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "準備預設時桌布屬性發生了變更。請重新整理後再試。"}}}
    },
    "Property preset applied, but unused retained assets could not be cleaned up: %@." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Property preset applied, but unused retained assets could not be cleaned up: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットは適用されましたが、未使用の保持ファイルを削除できませんでした：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设已应用，但无法清理未使用的保留素材：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設已套用，但無法清理未使用的保留素材：%@。"}}}
    },
    "A backup resource has no local authorization or retained copy. Reselect it in the wallpaper’s properties before restoring: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A backup resource has no local authorization or retained copy. Reselect it in the wallpaper’s properties before restoring: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップのリソースに、このMacでの許可または保持されたコピーがありません。復元前に壁紙のプロパティで選び直してください：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份中的资源没有本机授权或保留副本。请在恢复前到壁纸属性中重新选择：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份中的資源沒有本機授權或保留副本。請在還原前到桌布屬性中重新選擇：%@"}}}
    },
    "A retained resource will use its backed-up bytes instead of authorizing its original source: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A retained resource will use its backed-up bytes instead of authorizing its original source: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されたリソースは元の場所を許可せず、バックアップしたデータを使用します：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留资源将使用备份中的数据，不会授权读取其原始来源：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留資源將使用備份中的資料，不會授權讀取其原始來源：%@"}}}
    },
    "The scene assets folder remains the one already selected on this Mac. Reselect it in Settings if needed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The scene assets folder remains the one already selected on this Mac. Reselect it in Settings if needed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン素材フォルダは、このMacで選択済みの場所を引き続き使用します。必要なら設定で選び直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景资源文件夹仍使用本机原先选定的位置。如有需要，请在设置中重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景資源資料夾仍使用本機原先選定的位置。如有需要，請在設定中重新選擇。"}}}
    },
    "The retained resource is unavailable. Select the original resource again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The retained resource is unavailable. Select the original resource again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されたリソースを利用できません。元のファイルまたはフォルダを選び直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留的资源不可用。请重新选择原始文件或文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留的資源無法使用。請重新選擇原始檔案或資料夾。"}}}
    },
    "Retained asset permissions could not be read safely. Refresh before continuing." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Retained asset permissions could not be read safely. Refresh before continuing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持ファイルのアクセス許可を安全に読み取れませんでした。更新してから続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全读取保留素材的访问权限。请刷新后继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全讀取保留素材的存取權限。請重新整理後繼續。"}}}
    },
    "The asset selection failed: %@. Its permissions could not be restored: %@. Refresh before continuing." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The asset selection failed: %@. Its permissions could not be restored: %@. Refresh before continuing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "素材の選択に失敗しました：%@。アクセス許可を元に戻せませんでした：%@。更新してから続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "素材选择失败：%@。无法恢复其访问权限：%@。请刷新后继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "素材選擇失敗：%@。無法還原其存取權限：%@。請重新整理後繼續。"}}}
    },
    "WallpaperMachine is already running" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine is already running"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineはすでに起動しています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 已在运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 已在執行中"}}}
    },
    "Another copy of WallpaperMachine is using this library. Quit it before opening this one." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Another copy of WallpaperMachine is using this library. Quit it before opening this one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のWallpaperMachineが同じライブラリを使用しています。そちらを終了してから、このコピーを開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "另一个 WallpaperMachine 副本正在使用同一个壁纸库。请先退出它，再打开这一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另一個 WallpaperMachine 副本正在使用同一個桌布庫。請先結束它，再打開這一個。"}}}
    },
    "The video changed since it was checked. Look for black bars again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The video changed since it was checked. Look for black bars again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認したあとでビデオが変更されました。もう一度黒帯を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频在检查之后发生了变化。请重新检查黑边。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片在檢查之後發生了變化。請再次檢查黑邊。"}}}
    }
