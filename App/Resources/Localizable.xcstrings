    },
    "Which backend draws it is known once it plays on this display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Qual back-end o desenha só é conhecido quando ele é reproduzido neste monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서 재생하면 어떤 백엔드로 그리는지 알 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "どのバックエンドで描画されるかは、このディスプレイで再生されるとわかります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此显示器上播放后，才能知道由哪个后端绘制。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在此顯示器上播放後，才會知道由哪個後端繪製。"}}}
    },
    "Not checked yet on this display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ainda não verificado neste monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에서는 아직 확인하지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイではまだチェックしていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未在此显示器上检查。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未在此顯示器上檢查。"}}}
