      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Progresso da instalação do SteamCMD"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 설치 진행 상황"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのインストールの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安装进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安裝進度"}}}
    },
