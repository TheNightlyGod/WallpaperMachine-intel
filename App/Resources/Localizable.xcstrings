    },
    "Select All" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Selecionar Tudo"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모두 선택"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Select All"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてを選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "全选"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "全選"}}}
    },
    "Shared scene assets were not installed, so scene wallpapers cannot play yet." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os recursos de cena compartilhados não foram instalados, então os papéis de parede de cena ainda não podem ser reproduzidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 장면 에셋이 설치되지 않아 아직 장면 배경화면을 재생할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene assets were not installed, so scene wallpapers cannot play yet."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソースがインストールされなかったため、シーン壁紙はまだ再生できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共享场景资源没有安装成功，场景壁纸暂时无法播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未能安裝共用場景資源，因此暫時無法播放場景桌布。"}}}
    },
    "Shared scene assets are still missing, so scene wallpapers cannot play yet: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os recursos de cena compartilhados ainda estão ausentes, então os papéis de parede de cena ainda não podem ser reproduzidos: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공유 장면 에셋이 아직 없어 장면 배경화면을 재생할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene assets are still missing, so scene wallpapers cannot play yet: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソースがまだ不足しているため、シーン壁紙はまだ再生できません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仍缺少共享场景资源，场景壁纸暂时无法播放：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "仍缺少共用場景資源，因此暫時無法播放場景桌布：%@"}}}
    },
    "No update is available to download." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não há atualização disponível para baixar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드할 수 있는 업데이트가 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No update is available to download."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードできるアップデートはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有可下载的更新。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有可供下載的更新。"}}}
    },
    "No downloaded update is ready to install." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma atualização baixada está pronta para instalar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 업데이트 중 설치할 준비가 된 항목이 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No downloaded update is ready to install."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールできるダウンロード済みのアップデートはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有已下载、可安装的更新。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有已下載且可供安裝的更新。"}}}
    },
    "Install timed out: the app did not quit and relaunch." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A instalação expirou: o app não foi encerrado e reaberto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치 시간이 초과되었습니다. 앱이 종료 후 다시 실행되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Install timed out: the app did not quit and relaunch."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールがタイムアウトしました：Appが終了して再起動しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装超时：应用没有退出并重新打开。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝逾時：App 未結束並重新開啟。"}}}
    },
    "macOS did not accept the desktop click preference. Change “Click wallpaper to reveal desktop” in System Settings › Desktop & Dock instead." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não aceitou a preferência de clique na mesa. Altere “Clicar no papel de parede para mostrar a mesa” em Ajustes do Sistema › Mesa e Dock."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 데스크탑 클릭 설정을 적용하지 않았습니다. 대신 시스템 설정 › 데스크탑 및 Dock에서 ‘배경화면을 클릭하여 데스크탑 표시’를 변경하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not accept the desktop click preference. Change “Click wallpaper to reveal desktop” in System Settings › Desktop & Dock instead."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがデスクトップのクリック設定を受け付けませんでした。代わりに「システム設定」›「デスクトップとDock」で「壁紙をクリックしてデスクトップを表示」を変更してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 没有接受这项设置。请在“系统设置 › 桌面与程序坞”中直接更改“点按墙纸以显示桌面”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受桌面點按偏好設定。請改在「系統設定 › 桌面與 Dock」中更改「按一下背景圖片來顯示桌面」。"}}}
    },
    "Steam returned status %lld for a preview image." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam retornou o status %lld para uma imagem de pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 미리보기 이미지에 대해 반환한 상태 코드: %lld."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam returned status %lld for a preview image."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがプレビュー画像に対してステータス%lldを返しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回预览图时出错（状态码 %lld）。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取得預覽圖時，Steam 傳回狀態碼 %lld。"}}}
    },
    "The preview image is too large to use as a thumbnail." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A imagem de pré-visualização é grande demais para ser usada como miniatura."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 이미지가 너무 커서 축소판으로 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The preview image is too large to use as a thumbnail."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビュー画像が大きすぎるため、サムネイルとして使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图太大，无法用作缩略图。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽圖太大，無法用作縮圖。"}}}
    },
    "The original macOS wallpaper could not be recovered. Select your wallpaper again in System Settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível recuperar o papel de parede original do macOS. Selecione seu papel de parede novamente em Ajustes do Sistema."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "원래 macOS 배경화면을 복구할 수 없습니다. 시스템 설정에서 배경화면을 다시 선택하세요."}}, "en": {"stringUnit": {"state": "translated", "value": "The original macOS wallpaper could not be recovered. Select your wallpaper again in System Settings."}}, "ja": {"stringUnit": {"state": "translated", "value": "元のmacOSの壁紙を復元できませんでした。システム設定で壁紙を選び直してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法恢复原来的 macOS 壁纸。请在系统设置中重新选择壁纸。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法還原原本的 macOS 桌布。請在系統設定中重新選擇桌布。"}}}
    },
    "The preview image could not be decoded." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível decodificar a imagem de pré-visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 이미지를 디코딩할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The preview image could not be decoded."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビュー画像をデコードできませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法解码预览图。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法解碼預覽圖。"}}}
    },
    "The preview image is a single still frame." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A imagem de pré-visualização é um único quadro estático."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "미리보기 이미지는 하나의 정지 프레임입니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The preview image is a single still frame."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プレビュー画像は1フレームだけの静止画です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图只有一帧静止画面。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "預覽圖只有一個靜止影格。"}}}
    },
    "The update download redirected outside GitHub." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O download da atualização foi redirecionado para fora do GitHub."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 다운로드가 GitHub 외부로 리디렉션되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The update download redirected outside GitHub."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートのダウンロードがGitHub以外の場所にリダイレクトされました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新下载被重定向到了 GitHub 以外的地址。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新下載被重新導向至 GitHub 以外的位置。"}}}
    },
    "The update archive exceeds the allowed size." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo da atualização excede o tamanho permitido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 아카이브가 허용 크기를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The update archive exceeds the allowed size."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アップデートのアーカイブが許容サイズを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新包超过了允许的大小。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新封存檔超過允許的大小。"}}}
    },
    "The update download is empty or truncated." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O download da atualização está vazio ou incompleto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 업데이트가 비어 있거나 불완전합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The update download is empty or truncated."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたアップデートが空か、途中で切れています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的更新为空或不完整。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載的更新是空的或不完整。"}}}
    },
    "Neither Music nor Spotify reported what is playing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nem a Música nem o Spotify informaram o que está tocando."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음악 앱과 Spotify 모두에서 재생 중인 항목 정보를 받지 못했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Neither Music nor Spotify reported what is playing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ミュージック」とSpotifyのどちらからも再生中の情報を取得できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“音乐”和 Spotify 都没有提供正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「音樂」App 和 Spotify 都未回報正在播放的內容。"}}}
    },
    "No music player this app can read is running." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum reprodutor de música que este app consegue ler está em execução."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 앱에서 정보를 읽을 수 있는 음악 플레이어가 실행 중이 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No music player this app can read is running."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このAppで読み取れる音楽プレーヤーが実行されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有正在运行的、本应用可读取的音乐播放器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前沒有執行中且此 App 可讀取的音樂播放程式。"}}}
    },
    "Web wallpaper “%@” could not load: its entry file is outside the project folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível carregar o papel de parede web “%@”: o arquivo de entrada está fora da pasta do projeto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "웹 배경화면 ‘%@’을(를) 불러올 수 없습니다. 진입 파일이 프로젝트 폴더 외부에 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Web wallpaper “%@” could not load: its entry file is outside the project folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Web壁紙「%@」を読み込めませんでした：エントリファイルがプロジェクトフォルダの外にあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "网页壁纸“%@”无法加载：入口文件不在项目文件夹内。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法載入網頁桌布「%@」：其入口檔案位於專案資料夾之外。"}}}
    },
    "This wallpaper has an identifier that cannot be used as a folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede tem um identificador que não pode ser usado como pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면의 식별자는 폴더 이름으로 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper has an identifier that cannot be used as a folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙の識別子はフォルダ名として使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸的标识符无法用作文件夹名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布的識別碼無法用作資料夾名稱。"}}}
    },
    "%@ could not be copied into the app's asset folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível copiar %@ para a pasta de recursos do app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@을(를) 앱의 에셋 폴더에 복사하지 못했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "%@ could not be copied into the app's asset folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」をAppのアセットフォルダにコピーできませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法将 %@ 复制到应用的资源文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法將 %@ 拷貝到 App 的資源資料夾。"}}}
    },
    "Importing %@…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Importando %@…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 가져오는 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Importing %@…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を読み込み中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在导入 %@…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在匯入 %@…"}}}
    },
    "Downloading SteamCMD…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixando o SteamCMD…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 다운로드 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloading SteamCMD…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDをダウンロード中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在下载 SteamCMD…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在下載 SteamCMD…"}}}
    },
    "Saving installation…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvando instalação…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치 내용 저장 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Saving installation…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールを保存しています…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在保存安装…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在儲存安裝內容…"}}}
    },
    "Installation cancelled" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Instalação cancelada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치 취소됨"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Installation cancelled"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールがキャンセルされました"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装已取消"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已取消安裝"}}}
    },
    "Setup needs attention" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A configuração precisa de atenção"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정 확인 필요"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Setup needs attention"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップに対応が必要です"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置需要处理"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝需要處理"}}}
    },
    "Move %@ to Trash?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover %@ para o Lixo?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 항목을 휴지통으로 이동하시겠습니까?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Move %@ to Trash?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」をゴミ箱に入れますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要将“%@”移到废纸篓吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要將「%@」丟到垃圾桶嗎？"}}}
    },
    "It is removed from your library and stops playing. The original files you imported are not affected." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ele será removido da sua biblioteca e deixará de ser reproduzido. Os arquivos originais que você importou não são afetados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함에서 제거되고 재생이 정지됩니다. 가져온 원본 파일에는 영향을 주지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "It is removed from your library and stops playing. The original files you imported are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリから削除され、再生が停止します。読み込んだ元のファイルには影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它会从壁纸库中移除并停止播放，导入时的原始文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它會從桌布庫中移除並停止播放。你匯入的原始檔案不受影響。"}}}
    },
    "Move %lld wallpapers to Trash?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mover %lld papéis de parede para o Lixo?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 %lld개를 휴지통으로 이동하시겠습니까?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Move %lld wallpapers to Trash?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld枚の壁紙をゴミ箱に入れますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要将 %lld 张壁纸移到废纸篓吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要將 %lld 張桌布丟到垃圾桶嗎？"}}}
    },
    "They are removed from your library and stop playing. The original files you imported are not affected." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Eles serão removidos da sua biblioteca e deixarão de ser reproduzidos. Os arquivos originais que você importou não são afetados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함에서 제거되고 재생이 정지됩니다. 가져온 원본 파일에는 영향을 주지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "They are removed from your library and stop playing. The original files you imported are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリから削除され、再生が停止します。読み込んだ元のファイルには影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它们会从壁纸库中移除并停止播放，导入时的原始文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它們會從桌布庫中移除並停止播放。你匯入的原始檔案不受影響。"}}}
    },
    "Moved %lld of %lld wallpapers to Trash. Couldn’t move %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld de %lld papéis de parede movidos para o Lixo. Não foi possível mover %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 %2$lld개 중 %1$lld개를 휴지통으로 이동했습니다. 이동하지 못한 항목: %3$@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Moved %lld of %lld wallpapers to Trash. Couldn’t move %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%2$lld枚中%1$lld枚の壁紙をゴミ箱に入れました。移動できなかった壁紙：%3$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已将 %2$lld 张壁纸中的 %1$lld 张移到废纸篓。以下壁纸未能移动：%3$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已將 %2$lld 張桌布中的 %1$lld 張丟到垃圾桶。無法移動：%3$@"}}}
    },
    "Locate Scene Assets" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Localizar Recursos de Cena"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 에셋 위치 지정"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Locate Scene Assets"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンリソースの場所を指定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择场景资源位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指定場景資源位置"}}}
    },
    "Clear shader cache?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar o cache de shaders?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "셰이더 캐시를 지울까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear shader cache?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダキャッシュを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除着色器缓存吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除著色器快取嗎？"}}}
    },
    "Shaders are rebuilt the next time wallpapers need them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os shaders serão recriados na próxima vez que os papéis de parede precisarem deles."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "셰이더는 다음에 배경화면에서 필요할 때 다시 생성됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Shaders are rebuilt the next time wallpapers need them."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シェーダは、次に壁紙で必要になったときに再構築されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸下次需要时会重新生成着色器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "著色器會在桌布下次需要時重新建立。"}}}
    },
    "Clear Cache" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar Cache"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "캐시 지우기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Cache"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャッシュを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除快取"}}}
    },
    "Clear logs?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar os registros?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그를 지울까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear logs?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除日志吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除記錄嗎？"}}}
    },
    "Only diagnostic logs are removed. Wallpapers and settings are not affected." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apenas os registros de diagnóstico são removidos. Papéis de parede e ajustes não são afetados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진단 로그만 삭제합니다. 배경화면과 설정에는 영향을 주지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Only diagnostic logs are removed. Wallpapers and settings are not affected."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのは診断ログのみです。壁紙と設定には影響しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除诊断日志，不影响壁纸和设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除診斷記錄，桌布和設定不受影響。"}}}
    },
    "Clear Logs" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar Registros"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그 지우기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Logs"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除記錄"}}}
    },
    "Export Diagnostics" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Exportar Diagnóstico"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "진단 정보 내보내기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Export Diagnostics"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "診断情報を書き出す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导出诊断报告"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯出診斷資料"}}}
    },
    "Attach this file to your bug report." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Anexe este arquivo ao seu relatório de erro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "버그 보고서에 이 파일을 첨부하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Attach this file to your bug report."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このファイルをバグレポートに添付してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请将此文件附在问题报告中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請將此檔案附加到你的錯誤回報中。"}}}
    },
    "Clear unused caches?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar os caches não usados?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용하지 않는 캐시를 지울까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear unused caches?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "未使用のキャッシュを消去しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要清除未使用的缓存吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除未使用的快取嗎？"}}}
    },
    "Only caches that can be rebuilt are removed. Files you chose in wallpaper settings are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apenas os caches que podem ser recriados são removidos. Os arquivos que você escolheu nos ajustes dos papéis de parede são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 생성할 수 있는 캐시만 삭제합니다. 배경화면 설정에서 선택한 파일은 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Only caches that can be rebuilt are removed. Files you chose in wallpaper settings are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのは再構築できるキャッシュのみです。壁紙の設定で選択したファイルは保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除可以重新生成的缓存，你在壁纸设置中选择的文件会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除可重新建立的快取，你在桌布設定中選擇的檔案會保留。"}}}
    },
    "Clear Caches" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar Caches"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "캐시 지우기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Clear Caches"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャッシュを消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除缓存"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除快取"}}}
    },
    "The new copy replaces the current one only after it passes validation. Wallpapers and your saved sign-in are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A nova cópia só substitui a atual depois de passar na validação. Os papéis de parede e o seu início de sessão salvo são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "새 사본은 검증을 통과한 후에만 현재 사본을 교체합니다. 배경화면과 저장된 로그인 정보는 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The new copy replaces the current one only after it passes validation. Wallpapers and your saved sign-in are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "新しいコピーは、検証に合格した後にのみ現在のものと置き換えられます。壁紙と保存済みのサインイン情報は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "新副本通过验证后才会替换当前的 SteamCMD，壁纸和已保存的登录都会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "新的副本通過驗證後才會取代目前的副本。桌布和已儲存的登入資訊都會保留。"}}}
    },
    "Reinstall" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reinstalar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다시 설치"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Reinstall"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再インストール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新安装"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新安裝"}}}
    },
    "Reinstall this wallpaper?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reinstalar este papel de parede?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면을 다시 설치할까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Reinstall this wallpaper?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙を再インストールしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要重新安装此壁纸吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要重新安裝此桌布嗎？"}}}
    },
    "WallpaperMachine downloads it again from the Steam Workshop and swaps it in when the download is complete. Your settings for it are kept, and if the download fails the installed copy stays." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine o baixa novamente do Workshop da Steam e faz a troca quando o download termina. Os ajustes dele são mantidos e, se o download falhar, a cópia instalada permanece."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 Steam 창작마당에서 다시 다운로드한 후 다운로드가 완료되면 교체합니다. 해당 배경화면의 설정은 유지되며, 다운로드에 실패하면 설치된 사본이 그대로 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine downloads it again from the Steam Workshop and swaps it in when the download is complete. Your settings for it are kept, and if the download fails the installed copy stays."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineがSteamワークショップからもう一度ダウンロードし、ダウンロードが完了したら置き換えます。この壁紙の設定は引き継がれ、ダウンロードに失敗した場合はインストール済みのコピーがそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 会从 Steam 创意工坊重新下载此壁纸，并在下载完成后替换现有副本。它的设置会保留；如果下载失败，已安装的副本不会改变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 會從 Steam 工作坊重新下載此桌布，並在下載完成後取代現有副本。它的設定會保留；如果下載失敗，已安裝的副本不會改變。"}}}
    },
    "Steam did not say who made this wallpaper, so their other wallpapers can’t be shown." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não informou quem criou este papel de parede, então os outros papéis de parede dessa pessoa não podem ser mostrados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이 배경화면의 제작자를 알려 주지 않아 제작자의 다른 배경화면을 표시할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not say who made this wallpaper, so their other wallpapers can’t be shown."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがこの壁紙の作者を返さなかったため、作者のほかの壁紙を表示できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未提供此壁纸的作者，因此无法显示该作者的其他壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未提供此桌布的作者，因此無法顯示該作者的其他桌布。"}}}
    },
    "Steam no longer serves this wallpaper, so it can’t be reinstalled." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não disponibiliza mais este papel de parede, então ele não pode ser reinstalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이 배경화면을 더 이상 제공하지 않아 다시 설치할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this wallpaper, so it can’t be reinstalled."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがこの壁紙を提供しなくなったため、再インストールできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此壁纸，因此无法重新安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此桌布，因此無法重新安裝。"}}}
    },
    "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não aprovou este software, e executá-lo pode colocar seus dados em risco. Apenas arquivos que correspondem a esta impressão digital são permitidos, e o atributo de quarentena é removido somente desta cópia. O Gatekeeper e as verificações de assinatura continuam ativos para todo o resto.\n\nCaminho: %@\nSHA-256: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 이 소프트웨어를 승인하지 않았으며, 실행하면 데이터가 위험에 노출될 수 있습니다. 이 지문과 일치하는 파일만 허용되며, 격리 플래그는 이 사본에서만 제거됩니다. 그 외 모든 항목에는 Gatekeeper 및 서명 검사가 계속 적용됩니다.\n\n경로: %@\nSHA-256: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSはこのソフトウェアを承認していないため、実行するとデータが危険にさらされる可能性があります。このフィンガープリントに一致するファイルのみが許可され、検疫フラグはこのコピーからのみ削除されます。そのほかのすべてについては、Gatekeeperと署名の確認は有効のままです。\n\nパス：%1$@\nSHA-256：%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准此软件，运行它可能危及你的数据。只允许与此指纹一致的文件，并且只移除这份副本的隔离标记。Gatekeeper 和签名检查对其他软件照常生效。\n\n路径：%1$@\nSHA-256：%2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未核准此軟體，執行它可能會危及你的資料。只會允許符合此指紋的檔案，且只會移除這份副本的隔離標記。其他所有項目仍會進行 Gatekeeper 和簽署檢查。\n\n路徑：%1$@\nSHA-256：%2$@"}}}
    },
    "Discard downloaded SteamCMD?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Descartar o SteamCMD baixado?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 SteamCMD를 폐기할까요?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Discard downloaded SteamCMD?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたSteamCMDを破棄しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要丢弃下载的 SteamCMD 吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要丟棄已下載的 SteamCMD 嗎？"}}}
    },
    "Only this downloaded copy is removed. The installed SteamCMD and your saved sign-in are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apenas esta cópia baixada é removida. O SteamCMD instalado e o seu início de sessão salvo são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 이 사본만 삭제합니다. 설치된 SteamCMD와 저장된 로그인 정보는 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Only this downloaded copy is removed. The installed SteamCMD and your saved sign-in are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "削除されるのはダウンロードしたこのコピーのみです。インストール済みのSteamCMDと保存済みのサインイン情報は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只删除这份下载的副本，已安装的 SteamCMD 和已保存的登录都会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會移除這份下載的副本，已安裝的 SteamCMD 和已儲存的登入資訊都會保留。"}}}
    },
    "This wallpaper is no longer installed. Refresh your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede não está mais instalado. Atualize a sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면이 더 이상 설치되어 있지 않습니다. 보관함을 새로 고침하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is no longer installed. Refresh your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はもうインストールされていません。ライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸已不在壁纸库中，请刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已不在桌布庫中。請重新整理桌布庫。"}}}
    },
    "Some selected wallpapers are no longer installed. Refresh your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Alguns papéis de parede selecionados não estão mais instalados. Atualize a sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 배경화면 중 일부가 더 이상 설치되어 있지 않습니다. 보관함을 새로고침하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Some selected wallpapers are no longer installed. Refresh your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択した壁紙の一部はもうインストールされていません。ライブラリを更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "部分所选壁纸已不在壁纸库中，请刷新壁纸库。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "部分所選桌布已不在桌布庫中。請重新整理桌布庫。"}}}
    },
