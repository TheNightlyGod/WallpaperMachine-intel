    },
    "Delete preset “%@”? The wallpaper keeps its current values." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar predefinição “%@”? O papel de parede mantém os valores atuais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋 ‘%@’을(를) 삭제할까요? 배경화면의 현재 값은 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセット「%@」を削除しますか？壁紙の現在の値はそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要删除预设“%@”吗？壁纸会保留当前的值。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要刪除預設集「%@」嗎？桌布會保留目前的值。"}}}
    },
    "Save current…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar atual…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 설정 저장…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の設定を保存…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存当前设置…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存目前設定…"}}}
    },
    "Saves the values the wallpaper is using now as a new preset" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva os valores que o papel de parede está usando agora como uma nova predefinição"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 현재 사용하는 값을 새 프리셋으로 저장합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙が現在使用している値を新しいプリセットとして保存します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将壁纸当前使用的值保存为新预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將桌布目前使用的值儲存為新的預設集"}}}
    },
    "Import…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Importar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가져오기…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込む…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯入…"}}}
    },
    "Adds a preset from a file exported by WallpaperMachine" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Adiciona uma predefinição de um arquivo exportado pelo WallpaperMachine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine에서 내보낸 파일로 프리셋을 추가합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineで書き出したファイルからプリセットを追加します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从 WallpaperMachine 导出的文件中添加预设"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從 WallpaperMachine 匯出的檔案加入預設集"}}}
    },
    "Saves “%@” as a file you can share or keep" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva “%@” como um arquivo que você pode compartilhar ou guardar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’ 항목을 공유하거나 보관할 수 있는 파일로 저장합니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を共有や保管に使えるファイルとして保存します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将“%@”存为可分享或留存的文件"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將「%@」儲存為可分享或保存的檔案"}}}
    },
    "Apply or revert your changes before saving or applying a preset." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplique ou reverta suas alterações antes de salvar ou aplicar uma predefinição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프리셋을 저장하거나 적용하기 전에 변경 사항을 적용하거나 되돌리세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットを保存または適用する前に、変更を適用するか元に戻してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存或应用预设前，请先应用或还原你的修改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存或套用預設集前，請先套用或還原你的變更。"}}}
    },
    "Position on screen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Posição na tela"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면상의 위치"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面上の位置"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "屏幕上的位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "螢幕上的位置"}}}
    },
    "This picture cannot be positioned on the target display right now." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta imagem não pode ser posicionada no monitor de destino agora."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지금은 대상 디스플레이에서 이 이미지의 위치를 조정할 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、対象ディスプレイでこの画像の位置を調整できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "目前无法在目标显示器上调整这张图片的位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前無法在目標顯示器上調整這張圖片的位置。"}}}
    },
    "draggable picture" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "imagem arrastável"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "드래그할 수 있는 이미지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ドラッグできる画像"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可拖动的图片"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可拖移的圖片"}}}
    },
    "Picture position on %@: %@ across, %@ down, %@ zoom. Drag, or use the arrow keys to move it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Posição da imagem em %@: %@ na horizontal, %@ na vertical, zoom de %@. Arraste ou use as teclas de seta para movê-la."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 이미지 위치: 가로 %@, 세로 %@, 확대/축소 %@. 드래그하거나 화살표 키로 이동하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@上の画像の位置：横%2$@、縦%3$@、ズーム%4$@。ドラッグするか、矢印キーで動かせます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ 上的图片位置：横向 %2$@，纵向 %3$@，缩放 %4$@。拖动图片，或用方向键移动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ 上的圖片位置：橫向 %2$@，直向 %3$@，縮放 %4$@。拖移圖片，或用方向鍵移動。"}}}
    },
    "The wallpaper also fills the edges with a blurred copy of the picture; the frame shows the picture alone." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede também preenche as bordas com uma cópia desfocada da imagem; o quadro mostra apenas a imagem."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면에서는 이미지를 흐리게 복제하여 가장자리도 채웁니다. 이 프레임에는 원래 이미지만 표시합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙では画像をぼかしたコピーで縁も埋められますが、この枠には画像だけを表示します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸还会用模糊的图片副本填满边缘；此处只显示图片本身。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布還會用模糊的圖片副本填滿邊緣；此處只顯示圖片本身。"}}}
    },
    "Original size cannot be previewed exactly here; the frame shows the picture fitted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O tamanho original não pode ser pré-visualizado com exatidão aqui; o quadro mostra a imagem ajustada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "여기에서는 원본 크기를 정확하게 미리 볼 수 없어 이미지를 프레임에 맞춰 표시합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ここでは元のサイズを正確にプレビューできないため、枠内には画像を画面に合わせて表示します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此处无法精确预览原始大小；框内按适应方式显示图片。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此處無法精確預覽原始大小；框內以符合大小的方式顯示圖片。"}}}
    },
    "On %@. Drag the picture in the frame, or use the sliders. Each display keeps its own position." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em %@. Arraste a imagem no quadro ou use os controles deslizantes. Cada monitor mantém sua própria posição."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 표시됩니다. 프레임 안의 이미지를 드래그하거나 슬라이더를 사용하세요. 위치는 디스플레이별로 저장됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@上。枠の中で画像をドラッグするか、スライダを使います。位置はディスプレイごとに保存されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 上。在框内拖动图片，或使用滑块。每台显示器各自记住位置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 %@ 上。在框內拖移圖片，或使用滑桿。每台顯示器各自記住位置。"}}}
    },
    "Horizontal position" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Posição horizontal"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가로 위치"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "横方向の位置"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "水平位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "水平位置"}}}
    },
    "Vertical position" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Posição vertical"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "세로 위치"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "縦方向の位置"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "垂直位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "垂直位置"}}}
    },
    "Zoom" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Zoom"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "확대/축소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ズーム"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缩放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "縮放"}}}
    },
    "Reset to Image fit" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Redefinir para Ajuste da imagem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 맞춤으로 재설정"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像の表示方法に戻す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复为图片适配"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重設為圖片顯示方式"}}}
    },
    "Puts the picture back where Image fit alone places it" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Coloca a imagem de volta onde o Ajuste da imagem sozinho a posiciona"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지를 ‘이미지 맞춤’만으로 정해지는 위치로 되돌립니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「画像の表示方法」だけで決まる位置に画像を戻します"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让图片回到仅由“图片适配”决定的位置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓圖片回到僅由「圖片顯示方式」決定的位置"}}}
