    "In effect now. Wallpapers are stopped." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em vigor agora. Os papéis de parede estão parados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 적용 중입니다. 배경화면이 정지되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在適用中です。壁紙を停止しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "现已生效，壁纸已停止。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前已生效，桌布已停止。"}}}
    },
    "App rules" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Regras de apps"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "앱 규칙"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Appルール"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用规则"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "App 規則"}}}
    },
    "Pause, mute or stop wallpapers while a chosen app is running or in front." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pause, silencie ou pare os papéis de parede enquanto um app escolhido estiver em execução ou em primeiro plano."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 앱이 실행 중이거나 맨 앞에 있을 때 배경화면을 일시 정지하거나 소리를 끄거나 중지합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したAppが実行中または最前面にあるときに、壁紙を一時停止、消音、または停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在所选应用正在运行或位于前台时，暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在所選 App 執行中或位於前景時，暫停、靜音或停止桌布。"}}}
    },
    "Edit…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Editar…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "편집…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "編集…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "编辑…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "編輯…"}}}
    },
    "Running" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em execução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실행 중"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "執行中"}}}
    },
    "In front" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em primeiro plano"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "맨 앞에 있을 때"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最前面"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "位于前台"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "位於前景"}}}
    },
