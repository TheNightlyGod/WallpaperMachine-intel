    },
    "Finish signing in in the pixiv window." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Conclua o início de sessão na janela do pixiv."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 윈도우에서 로그인을 완료하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivのウインドウでサインインを完了してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请在 pixiv 窗口中完成登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請在 pixiv 視窗中完成登入。"}}}
    },
    "Show sign-in window" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar janela de início de sessão"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 창 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインウインドウを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示登录窗口"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示登入視窗"}}}
    },
    "Signing in shows works pixiv keeps for members, and R-18 works if your account allows them. You sign in on pixiv’s own page; WallpaperMachine keeps only the session, in your keychain." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão mostra obras que o pixiv reserva para membros, e obras R-18 se sua conta permitir. Você inicia a sessão na própria página do pixiv; o WallpaperMachine guarda apenas a sessão, no seu chaveiro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인하면 pixiv 회원 전용 작품과 계정에서 허용한 경우 R-18 작품을 볼 수 있습니다. 로그인은 pixiv의 공식 페이지에서 진행하며, WallpaperMachine은 키체인에 세션만 저장합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインすると、pixivが会員限定にしている作品や、アカウントで許可されていればR-18作品も表示されます。サインインはpixiv自身のページで行います。WallpaperMachineはセッションだけをキーチェーンに保存します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录后可以看到 pixiv 仅向会员展示的作品；如果账户允许，还能看到 R-18 作品。登录在 pixiv 自己的页面上完成，WallpaperMachine 只把登录会话保存在你的钥匙串中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入後可顯示 pixiv 僅提供給會員的作品；若你的帳號允許，也會顯示 R-18 作品。你會在 pixiv 自己的網頁上登入；WallpaperMachine 只會保留工作階段，並存放在你的鑰匙圈中。"}}}
    },
    "Sign in to pixiv…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão no pixiv…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에 로그인…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivにサインイン…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 pixiv…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 pixiv…"}}}
    },
    "AI-generated" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Gerado por IA"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "AI 생성"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AI生成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "AI 生成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "AI 生成"}}}
    },
    "Hide AI-generated works" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar obras geradas por IA"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "AI 생성 작품 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AI生成作品を非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏 AI 生成的作品"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏 AI 生成的作品"}}}
    },
    "Applies to search; pixiv keeps AI-generated works out of its rankings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Vale para a busca; o pixiv deixa obras geradas por IA fora dos rankings."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검색에 적용됩니다. pixiv는 순위에서 AI 생성 작품을 제외합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "検索に適用されます。pixivのランキングにはもともとAI生成作品は含まれません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅对搜索生效；pixiv 的排行榜本身不含 AI 生成的作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅適用於搜尋；pixiv 的排行榜本身不包含 AI 生成的作品。"}}}
    },
