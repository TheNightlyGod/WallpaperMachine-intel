      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta deste papel de parede é somente leitura, então o arquivo não pode ser preparado para ele."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면의 폴더가 읽기 전용이므로 파일을 준비할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper’s folder is read-only, so the file cannot be prepared for it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙のフォルダは読み出し専用のため、ファイルを準備できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸的文件夹是只读的，无法准备所选文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布的資料夾為唯讀，因此無法為其準備檔案。"}}}
