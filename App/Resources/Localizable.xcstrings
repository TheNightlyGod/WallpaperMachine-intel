    },
    "Setting up SteamCMD…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Configurando o SteamCMD…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 설정 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDをセットアップ中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在设置 SteamCMD…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在設定 SteamCMD…"}}}
    },
    "All downloads are complete." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os downloads foram concluídos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 다운로드가 완료되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてのダウンロードが完了しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有下载都已完成。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "所有下載皆已完成。"}}}
    },
    "No downloads yet. Pick a Workshop wallpaper and choose Download." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum download ainda. Escolha um papel de parede do Workshop e selecione Baixar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 다운로드한 항목이 없습니다. 창작마당 배경화면을 고르고 ‘다운로드’를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まだダウンロードはありません。ワークショップの壁紙を選んで「ダウンロード」を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有下载。在创意工坊中选一张壁纸并点击“下载”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無下載項目。請在工作坊中挑選一張桌布，然後選擇「下載」。"}}}
    },
    "Downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Downloads"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載項目"}}}
    },
    "Hide completed" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ocultar concluídos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완료된 항목 가리기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "完了済みを非表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐藏已完成"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱藏已完成項目"}}}
    },
    "Show completed (%lld)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar concluídos (%lld)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완료된 항목 보기(%lld)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "完了済みを表示（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示已完成（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示已完成項目（%lld）"}}}
    },
    "Clear finished" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Limpar concluídos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "종료된 항목 지우기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "終了した項目を消去"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除已结束"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除已結束項目"}}}
    },
    "Retry failed (%lld)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tentar novamente as que falharam (%lld)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "실패한 항목 다시 시도(%lld)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "失敗した項目を再試行（%lld）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重试失败项（%lld）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重試失敗項目（%lld）"}}}
    },
    "Download next" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixar em seguida"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음에 다운로드"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次にダウンロード"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下一个下载"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下一個下載"}}}
    },
    "Show download logs" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar registros de download"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드 로그 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードログを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示下载日志"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示下載記錄"}}}
    },
    "Up to %lld downloads run at once and share your saved sign-in; the rest wait in order. Steam may still ask you to approve a sign-in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Até %lld downloads rodam ao mesmo tempo e compartilham seu início de sessão salvo; os demais aguardam na fila. A Steam ainda pode pedir que você aprove um início de sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "최대 %lld개의 다운로드가 동시에 실행되며 저장된 로그인 정보를 공유합니다. 나머지는 순서대로 기다립니다. Steam에서 로그인 승인을 다시 요청할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "最大%lld件のダウンロードが同時に実行され、保存されたサインインを共有します。残りは順番に待機します。それでもSteamからサインインの承認を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最多同时进行 %lld 项下载，共用已保存的登录，其余排队等待。Steam 仍可能要求你批准登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "最多同時進行 %lld 項下載，並共用已儲存的登入；其餘項目依序等待。Steam 仍可能要求你核准登入。"}}}
    },
    "Downloads run one at a time; the rest wait in order. Steam may still ask you to approve a sign-in." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os downloads rodam um de cada vez; os demais aguardam na fila. A Steam ainda pode pedir que você aprove um início de sessão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드는 한 번에 하나씩 진행되며, 나머지는 순서대로 대기합니다. Steam에서 로그인 승인을 요청할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードは1件ずつ実行され、残りは順番に待機します。それでもSteamからサインインの承認を求められる場合があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载逐个进行，其余排队等待。Steam 仍可能要求你批准登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載會逐一進行，其餘項目依序等待。Steam 仍可能要求你核准登入。"}}}
    },
    "Downloads at once" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Downloads simultâneos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동시 다운로드 수"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "同時ダウンロード数"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "同时下载数"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "同時下載數"}}}
    },
    "Each download signs in to Steam on its own. More at once mostly helps batches of small wallpapers; large ones share your connection." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cada download inicia sessão na Steam por conta própria. Mais downloads simultâneos ajudam principalmente em lotes de papéis de parede pequenos; os grandes dividem sua conexão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드마다 Steam에 개별적으로 로그인합니다. 동시 다운로드 수를 늘리면 주로 작은 배경화면을 여러 개 받을 때 유용하며, 큰 배경화면은 연결 대역폭을 나누어 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "各ダウンロードは個別にSteamにサインインします。同時ダウンロード数を増やすと主に小さな壁紙をまとめてダウンロードするときに効果があります。大きな壁紙は接続を共有します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每项下载都会单独登录 Steam。同时下载更多主要对成批的小壁纸有帮助；大壁纸会共享你的网络带宽。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每項下載都會各自登入 Steam。同時下載較多項目主要有助於大量的小型桌布；大型桌布則會共用你的網路連線。"}}}
    },
    "Steam ended one of the sessions, so downloads run one at a time until you reopen the app." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam encerrou uma das sessões, então os downloads rodam um de cada vez até você reabrir o app."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 세션 하나를 종료하여 앱을 다시 열 때까지 다운로드가 한 번에 하나씩 진행됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがセッションの1つを終了したため、アプリを開き直すまでダウンロードは1件ずつ実行されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 断开了其中一个会话，因此在重新打开应用前，下载会逐个进行。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 結束了其中一個工作階段，因此在你重新開啟此 App 前，下載會逐一進行。"}}}
    },
    "Remove %@ from downloads" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Remover %@ dos downloads"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드에서 %@ 제거"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードから%@を取り除く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "从下载中移除 %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "從下載項目中移除 %@"}}}
    },
    "Close import" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Fechar importação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가져오기 닫기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みを閉じる"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭导入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關閉匯入"}}}
    },
    "Folders, videos, images or web pages" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pastas, vídeos, imagens ou páginas web"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "폴더, 동영상, 이미지 또는 웹 페이지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フォルダ、ビデオ、画像、Webページ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "文件夹、视频、图片或网页"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "資料夾、影片、圖片或網頁"}}}
    },
    "Duplicates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Duplicados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중복 항목"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "重複"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重复项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重複項目"}}}
    },
    "The library gets its own copy; your originals stay untouched." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A biblioteca recebe sua própria cópia; os originais não são alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함에 사본이 저장되며 원본은 변경되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリにはコピーが保存され、元のファイルはそのまま残ります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库会保存一份拷贝，原文件不受影响。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫會保存一份拷貝，原始檔案不會受到影響。"}}}
    },
    "If a wallpaper already exists" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Se um papel de parede já existir"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면이 이미 있는 경우"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙がすでに存在する場合"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已存在时"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "若桌布已存在"}}}
    },
    "Skip duplicates" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ignorar duplicados"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "중복 항목 건너뛰기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "重複をスキップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跳过重复项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "略過重複項目"}}}
    },
    "Keep both copies" : {
