    },
    "Cancel import" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cancelar importação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가져오기 취소"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "読み込みをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消导入"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消匯入"}}}
    },
