    },
    "Any whole number of minutes, up to %lld." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld分までの範囲で、分単位の整数を入力できます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "可输入任意整数分钟，最多 %lld 分钟。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "可輸入任意整數分鐘，最多 %lld 分鐘。"}}}
    },
    "The list is empty. In Installed, select wallpapers and choose Add to playlist, or use the list button in a wallpaper’s details." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "リストは空です。「インストール済み」で壁紙を選択して「プレイリストに追加」を選ぶか、壁紙の詳細にあるリストボタンを使用してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "列表为空。在“已安装”中选择壁纸后点按“加入播放列表”，或使用壁纸详情中的列表按钮。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "列表是空的。請在「已安裝」中選取桌布並選擇「加入播放列表」，或使用桌布詳細資訊中的列表按鈕。"}}}
    },
    "Next change" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "次回の切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下次更换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下次更換"}}}
    },
    "Change now" : {
