    },
    "Missing — this folder is no longer at %@. Reselect it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ausente — esta pasta não está mais em %@. Escolha-a novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "누락됨 — 이 폴더가 더 이상 %@에 없습니다. 다시 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "見つかりません — このフォルダはもう%@にありません。選択し直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺失 — 此文件夹已不在 %@。请重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遺失 — 此資料夾已不在 %@。請重新選取。"}}}
    },
    "Missing — this file is no longer at %@. Reselect it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ausente — este arquivo não está mais em %@. Escolha-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "누락됨 — 이 파일이 더 이상 %@에 없습니다. 다시 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "見つかりません — このファイルはもう%@にありません。選択し直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺失 — 此文件已不在 %@。请重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遺失 — 此檔案已不在 %@。請重新選取。"}}}
    },
    "Missing — this folder can no longer be found. Reselect it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ausente — esta pasta não pode mais ser encontrada. Escolha-a novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "누락됨 — 이 폴더를 더 이상 찾을 수 없습니다. 다시 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "見つかりません — このフォルダの場所を特定できなくなりました。選択し直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺失 — 找不到此文件夹。请重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遺失 — 找不到此資料夾。請重新選取。"}}}
    },
    "Missing — this file can no longer be found. Reselect it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ausente — este arquivo não pode mais ser encontrado. Escolha-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "누락됨 — 이 파일을 더 이상 찾을 수 없습니다. 다시 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "見つかりません — このファイルの場所を特定できなくなりました。選択し直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺失 — 找不到此文件。请重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "遺失 — 找不到此檔案。請重新選取。"}}}
    },
    "No image selected" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhuma imagem selecionada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 이미지 없음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像が選択されていません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未选择图片"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未選取圖片"}}}
    },
    "Choose image" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolher imagem"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지 선택"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像を選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择图片"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇圖片"}}}
