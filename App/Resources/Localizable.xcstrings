    },
    "Shared scene shaders and materials are not included in backups. Install or locate Wallpaper Engine’s complete scene assets if they are unavailable on this Mac." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Shared scene shaders and materials are not included in backups. Install or locate Wallpaper Engine’s complete scene assets if they are unavailable on this Mac."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "共有シーンシェーダーとマテリアルはバックアップに含まれません。この Mac にない場合は、完全な Wallpaper Engine シーンアセットをインストールするか、指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份不包含共享场景着色器和材质。如果此 Mac 上缺少它们，请安装或定位完整的 Wallpaper Engine 场景资源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份不包含共用場景著色器和材質。如果此 Mac 上缺少它們，請安裝或定位完整的 Wallpaper Engine 場景資源。"}}}
