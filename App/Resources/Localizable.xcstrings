    },
    "This downloaded copy needs your approval before it can run:" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたこのコピーは、実行する前に承認が必要です："}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这份已下载的副本需要你批准后才能运行："}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這份下載的副本需要你核准後才能執行："}}}
    },
    "A downloaded copy is retained but not usable yet:" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたコピーは保持されていますが、まだ使用できません："}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保留一份下载的副本，但尚不可用："}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已保留一份下載的副本，但目前尚無法使用："}}}
    },
    "SteamCMD is Valve’s download tool. Install it here, or point to a copy you already have. Installing it does not sign you in." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはValveのダウンロードツールです。ここでインストールするか、手持ちのコピーの場所を指定してください。インストールしてもサインインはされません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下载工具。可以在这里安装，也可以指定你已有的副本。安装时不需要登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 是 Valve 的下載工具。你可以在這裡安裝，或指定你已有的副本。安裝時不會登入你的帳號。"}}}
    },
    "SteamCMD is ready." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの準備ができました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已就绪。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已準備就緒。"}}}
    },
    "SteamCMD is not installed yet." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはまだインストールされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "尚未安装 SteamCMD。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚未安裝 SteamCMD。"}}}
    },
    "SteamCMD installation progress" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのインストールの進行状況"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安装进度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安裝進度"}}}
    },
    "Allow this SteamCMD" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamCMDを許可"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许这份 SteamCMD"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "允許這份 SteamCMD"}}}
    },
    "Locate a copy" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "既存のコピーを指定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择已有副本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指定現有副本"}}}
    },
    "Cancel setup" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "セットアップをキャンセル"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消设置"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消設定"}}}
    },
    "Not now" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "今はしない"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂不"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "現在不要"}}}
    },
    "Show it in Finder" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Finderに表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在访达中显示"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Finder 中顯示"}}}
    },
    "Discard it" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "破棄"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "丟棄"}}}
    },
    "Approval applies only to the exact copy you allow. Gatekeeper and signature checks stay in force." : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "承認は許可したコピーにのみ適用されます。Gatekeeperと署名の確認は引き続き有効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "批准只对这一份副本有效，Gatekeeper 和签名检查照常生效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "核准只適用於你允許的這一份副本。Gatekeeper 與簽章檢查仍會照常生效。"}}}
    },
    "Steam account name" : {
      "localizations" : {"ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamアカウント名"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 账户名"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 帳號名稱"}}}
    },
