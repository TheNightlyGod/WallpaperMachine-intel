    },
    "Restore default: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaurar padrão: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기본값 복원: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デフォルトに戻す：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复默认值：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原預設值：%@"}}}
    },
    "Restore all defaults" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Restaurar todos os padrões"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 기본값 복원"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべてデフォルトに戻す"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "全部恢复默认值"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "全部還原預設值"}}}
    },
    "Stages the default for every property except chosen files and folders. Revert undoes it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Prepara o padrão de todas as propriedades, exceto arquivos e pastas escolhidos. Reverter desfaz isso."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 파일과 폴더를 제외한 모든 속성을 기본값으로 변경하도록 준비합니다. ‘되돌리기’로 취소할 수 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "選択したファイルとフォルダを除くすべてのプロパティについて、デフォルト値に戻す変更を準備します。「元に戻す」で取り消せます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "为除所选文件和文件夹外的每个属性暂存默认值。“还原”可撤销此操作。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "為除所選檔案和資料夾外的每個屬性暫存預設值。「還原」可取消此動作。"}}}
    },
    "Modified" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Modificado"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "수정됨"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "変更済み"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已修改"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已修改"}}}
    },
