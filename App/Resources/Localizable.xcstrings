    },
    "Location Services is turned off on this Mac. Turn it on in System Settings → Privacy & Security → Location Services." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Location Services is turned off on this Mac. Turn it on in System Settings → Privacy & Security → Location Services."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacでは位置情報サービスがオフです。システム設定 → プライバシーとセキュリティ → 位置情報サービスでオンにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台 Mac 的定位服务已关闭。请在「系统设置 → 隐私与安全性 → 定位服务」中打开。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這台 Mac 的定位服務已關閉。請在「系統設定 → 隱私權與安全性 → 定位服務」中開啟。"}}}
    },
    "Allow location access to calculate sunrise and sunset for this Mac." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allow location access to calculate sunrise and sunset for this Mac."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このMacの日の出と日の入りを計算するために、位置情報へのアクセスを許可してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请允许访问位置，以计算这台 Mac 所在地的日出和日落时间。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請允許存取位置，以計算這台 Mac 所在地的日出和日落時間。"}}}
