    },
    "%lld favorites" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld favoritos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "お気に入り%lld件"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已收藏 %lld 项"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已收藏 %lld 項"}}}
    },
    "Sign in to see your favorites" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Inicie sessão para ver seus favoritos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기를 보려면 로그인"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしてお気に入りを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录以查看你的收藏"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入以查看你的收藏"}}}
    },
    "Your favorites are read from your own Steam account. You sign in on Steam’s own page, and WallpaperMachine uses the session only to read your lists." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seus favoritos são lidos da sua própria conta Steam. Você inicia sessão na própria página da Steam, e o WallpaperMachine usa a sessão só para ler suas listas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기는 본인의 Steam 계정에서 읽어 옵니다. 로그인은 Steam 자체 페이지에서 하며, WallpaperMachine은 이 세션을 목록을 읽는 데만 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "お気に入りはご自身のSteamアカウントから読み込みます。サインインはSteam自身のページで行い、WallpaperMachineはそのセッションをリストの読み込みにのみ使います。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "收藏列表读取自你自己的 Steam 账户。你在 Steam 自己的页面上登录，WallpaperMachine 只用这个会话读取你的列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏清單讀取自你自己的 Steam 帳號。你在 Steam 自己的頁面上登入，WallpaperMachine 只用這個工作階段讀取你的清單。"}}}
    },
    "Wallpapers you favorite on the Steam Workshop appear here." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os papéis de parede que você favorita no Workshop da Steam aparecem aqui."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 창작마당에서 즐겨찾기한 배경화면이 여기에 표시됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamワークショップでお気に入りにした壁紙がここに表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你在 Steam 创意工坊收藏的壁纸会显示在这里。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你在 Steam 工作坊收藏的桌布會顯示在這裡。"}}}
    },
    "Sort favorites" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ordenar favoritos"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기 정렬"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "お気に入りを並べ替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "收藏排序"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "排序收藏"}}}
    },
    "Date favorited" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Data em que favoritou"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "즐겨찾기한 날짜순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "お気に入りに追加した順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "收藏时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏時間"}}}
    },
    "Alphabetical" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ordem alfabética"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이름순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "名前順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "按名称"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "依名稱"}}}
    },
    "Date updated" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Data de atualização"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "업데이트 날짜순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "更新日順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "更新时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "更新時間"}}}
    },
    "Date created" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Data de criação"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "생성 날짜순"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "作成日順"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创建时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "建立時間"}}}
    },
    "Steam shows the wallpapers you subscribe to only to you. You sign in on Steam’s own page; WallpaperMachine keeps the session only until it quits, and uses it only to read this list." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam mostra os papéis de parede em que você está inscrito apenas para você. Você inicia a sessão na própria página da Steam; o WallpaperMachine guarda a sessão só até ser encerrado e a usa apenas para ler esta lista."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam은 구독한 배경화면을 본인에게만 표시합니다. 로그인은 Steam의 공식 페이지에서 진행합니다. WallpaperMachine은 종료할 때까지만 세션을 유지하며, 이 목록을 읽는 용도로만 사용합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでは、サブスクライブ中の壁紙は本人にのみ表示されます。サインインはSteam自身のページで行います。WallpaperMachineはセッションをAppの終了時までしか保持せず、このリストの読み込みにのみ使用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 只向你本人显示你订阅的壁纸。你在 Steam 自己的页面上登录；WallpaperMachine 只在退出前保留该会话，且只用它读取这份列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 只會向你本人顯示你訂閱的桌布。你會在 Steam 自己的網頁上登入；WallpaperMachine 只會保留該工作階段直到結束執行，且只用它來讀取這份列表。"}}}
    },
    "This is separate from the SteamCMD sign-in in Settings, which only downloads wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Isso é separado do início de sessão do SteamCMD nos Ajustes, que apenas baixa papéis de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이는 배경화면 다운로드에만 사용하는 설정의 SteamCMD 로그인과는 별개입니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "これは、壁紙のダウンロードだけに使う「設定」のSteamCMDサインインとは別のサインインです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "本次登录与“设置”里用于下载壁纸的 SteamCMD 登录相互独立。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這次登入與「設定」中用來下載桌布的 SteamCMD 登入彼此獨立。"}}}
    },
    "Sign in to Steam…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão na Steam…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에 로그인…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamにサインイン…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 Steam…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 Steam…"}}}
    },
    "Open collection" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir coleção"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션 열기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开合集"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開收藏集"}}}
    },
    "A collection is a list of Workshop items put together by its author. Open it to see and download them." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma coleção é uma lista de itens do Workshop reunidos pelo autor. Abra-a para vê-los e baixá-los."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션은 제작자가 모아 놓은 창작마당 항목 목록입니다. 열어서 항목을 확인하고 다운로드하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションは、作成者がまとめたワークショップアイテムのリストです。開くと、アイテムを表示してダウンロードできます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "合集是作者整理的一组创意工坊项目。打开它即可查看并下载其中的项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏集是由作者整理的一組工作坊項目。打開即可查看並下載其中的項目。"}}}
    },
    "1 item" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "1 item"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "항목 1개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1個のアイテム"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "1 个项目"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "1 個項目"}}}
    },
    "%lld items" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%lld itens"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "항목 %lld개"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld個のアイテム"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%lld 个项目"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%lld 個項目"}}}
    },
    "More by this author" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mais deste autor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 제작자의 다른 작품"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この作成者のその他の作品"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "该作者的更多作品"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此作者的更多作品"}}}
    },
    "Collection name" : {
