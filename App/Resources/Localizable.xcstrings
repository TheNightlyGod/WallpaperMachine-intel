    },
    "Wait for child process" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguardar processo filho"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자식 프로세스 대기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for child process"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "子プロセスの待機"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "等待子进程"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "等待子程序"}}}
    },
    "SteamCMD timed out. Check the connection and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD excedeu o tempo limite. Verifique a conexão e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 응답 시간이 초과되었습니다. 연결을 확인하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD timed out. Check the connection and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDがタイムアウトしました。接続を確認して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已超时。请检查网络连接后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已逾時。請檢查網路連線後重試。"}}}
    },
    "SteamCMD already exists. Confirm Reinstall SteamCMD before replacing it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O SteamCMD já existe. Confirme Reinstalar o SteamCMD antes de substituí-lo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD가 이미 있습니다. 교체하려면 ‘SteamCMD 재설치’를 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD already exists. Confirm Reinstall SteamCMD before replacing it."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDはすでに存在します。置き換えるには「SteamCMDを再インストール」で確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已存在。替换前，请确认“重新安装 SteamCMD”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 已存在。取代之前，請先確認「重新安裝 SteamCMD」。"}}}
    },
    "Could not create a private SteamCMD installation directory." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível criar um diretório de instalação privado do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 전용 설치 디렉토리를 생성하지 못했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create a private SteamCMD installation directory."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "専用のSteamCMDインストールディレクトリを作成できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建 SteamCMD 私有安装目录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法建立 SteamCMD 的私人安裝目錄。"}}}
    },
    "The SteamCMD archive could not be listed safely." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível listar o arquivo compactado do SteamCMD com segurança."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브의 내용을 안전하게 나열할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive could not be listed safely."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブの内容を安全に一覧表示できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全列出 SteamCMD 压缩包内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全地列出 SteamCMD 壓縮檔的內容。"}}}
    },
    "The SteamCMD archive's expanded size could not be checked safely." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível verificar com segurança o tamanho expandido do arquivo compactado do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브의 압축 해제 후 크기를 안전하게 확인할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive's expanded size could not be checked safely."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブの展開後のサイズを安全に確認できませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全检查 SteamCMD 压缩包的展开大小。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全地檢查 SteamCMD 壓縮檔解壓縮後的大小。"}}}
    },
    "SteamCMD extraction failed. %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A extração do SteamCMD falhou. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 압축 해제에 실패했습니다. %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD extraction failed. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの展開に失敗しました。%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 解压失败。%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 解壓縮失敗。%@"}}}
    },
    "Valve’s SteamCMD packages are missing %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Está faltando %@ nos pacotes do SteamCMD da Valve."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Valve의 SteamCMD 패키지에 %@이(가) 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Valve’s SteamCMD packages are missing %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ValveのSteamCMDパッケージに%@がありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 安装包缺少 %@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 安裝套件缺少 %@。"}}}
    },
    "Valve’s SteamCMD package manifest is malformed or incomplete. Try again later; nothing was installed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O manifesto de pacotes do SteamCMD da Valve está malformado ou incompleto. Tente novamente mais tarde; nada foi instalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Valve의 SteamCMD 패키지 매니페스트 형식이 잘못되었거나 불완전합니다. 나중에 다시 시도하세요. 아무것도 설치되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Valve’s SteamCMD package manifest is malformed or incomplete. Try again later; nothing was installed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ValveのSteamCMDパッケージマニフェストが不正か不完全です。後でもう一度お試しください。何もインストールされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 安装包清单格式错误或不完整。请稍后重试；未安装任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Valve 的 SteamCMD 套件清單格式錯誤或不完整。請稍後重試；未安裝任何內容。"}}}
    },
    "The SteamCMD package %@ does not match Valve’s published checksum. Nothing was installed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pacote %@ do SteamCMD não corresponde ao checksum publicado pela Valve. Nada foi instalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 패키지 %@의 체크섬이 Valve에서 공개한 값과 일치하지 않습니다. 아무것도 설치되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD package %@ does not match Valve’s published checksum. Nothing was installed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDパッケージ%@がValveの公開チェックサムと一致しません。何もインストールされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安装包 %@ 与 Valve 公布的校验和不匹配。未安装任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 套件 %@ 與 Valve 公布的校驗碼不符。未安裝任何內容。"}}}
    },
    "SteamCMD packages contain the same file more than once." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os pacotes do SteamCMD contêm o mesmo arquivo mais de uma vez."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 패키지에 같은 파일이 중복으로 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD packages contain the same file more than once."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDパッケージに同じファイルが重複しています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 安装包中包含重复文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 套件中包含重複檔案。"}}}
    },
    "SteamCMD's no-login verification exited with status %d. %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A verificação sem sessão do SteamCMD terminou com o status %d. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD의 로그인 없는 검증이 상태 코드 %d로 종료되었습니다. %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD's no-login verification exited with status %d. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのログインなしの検証がステータス%dで終了しました。%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 免登录验证已退出，状态码为 %d。%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 免登入驗證已結束，狀態碼為 %d。%@"}}}
    },
    "Another SteamCMD installation appeared. Confirm replacement and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outra instalação do SteamCMD apareceu. Confirme a substituição e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 SteamCMD 설치본이 발견되었습니다. 교체를 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Another SteamCMD installation appeared. Confirm replacement and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のSteamCMDのインストールが検出されました。置き換えを確認して再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "检测到另一个 SteamCMD 安装。请确认替换后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "偵測到另一份 SteamCMD 安裝。請確認取代後重試。"}}}
    },
    "SteamCMD replacement and recovery failed. The previous installation backup is at %@. %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A substituição e a recuperação do SteamCMD falharam. O backup da instalação anterior está em %@. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 교체와 복구에 실패했습니다. 이전 설치의 백업은 %@에 있습니다. %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD replacement and recovery failed. The previous installation backup is at %@. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDの置き換えと復元に失敗しました。以前のインストールのバックアップは%@にあります。%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 替换与恢复均失败。此前安装的备份位于 %@。%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 取代與復原皆失敗。先前安裝的備份位於 %@。%@"}}}
    },
    "SteamCMD could not be replaced. %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível substituir o SteamCMD. %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD를 교체할 수 없습니다. %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD could not be replaced. %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDを置き換えられませんでした。%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法替换 SteamCMD。%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法取代 SteamCMD。%@"}}}
    },
    "Unsafe installation directory: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Diretório de instalação inseguro: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "안전하지 않은 설치 디렉토리: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unsafe installation directory: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "安全ではないインストールディレクトリ：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装目录不安全：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "安裝目錄不安全：%@"}}}
    },
    "Cannot access installation directory: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível acessar o diretório de instalação: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치 디렉토리에 접근할 수 없습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot access installation directory: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストールディレクトリにアクセスできません：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法访问安装目录：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法取用安裝目錄：%@"}}}
    },
    "The SteamCMD archive listing is empty or unreadable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A listagem do arquivo compactado do SteamCMD está vazia ou ilegível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브 내용 목록이 비어 있거나 읽을 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive listing is empty or unreadable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブの内容一覧が空か、読み取れません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包的内容列表为空或无法读取。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔的內容列表為空或無法讀取。"}}}
    },
    "The SteamCMD archive contains an unsafe path." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo compactado do SteamCMD contém um caminho inseguro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브에 안전하지 않은 경로가 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive contains an unsafe path."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブに安全ではないパスが含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包包含不安全的路径。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔包含不安全的路徑。"}}}
    },
    "The SteamCMD archive's size listing is unreadable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A listagem de tamanhos do arquivo compactado do SteamCMD está ilegível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브의 크기 목록을 읽을 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive's size listing is unreadable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブのサイズ一覧を読み取れません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取 SteamCMD 压缩包的大小列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取 SteamCMD 壓縮檔的大小列表。"}}}
    },
    "The SteamCMD archive contains an unparseable size or unsupported entry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo compactado do SteamCMD contém um tamanho impossível de interpretar ou um item sem suporte."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브에 구문을 분석할 수 없는 크기 값 또는 지원되지 않는 항목이 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive contains an unparseable size or unsupported entry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブに、解析できないサイズまたは対応していない項目が含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包包含无法解析的大小或不支持的条目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔包含無法解析的大小或不支援的項目。"}}}
    },
    "The expanded SteamCMD archive exceeds 256 MiB." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo compactado do SteamCMD expandido excede 256 MiB."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "압축을 해제한 SteamCMD 아카이브가 256 MiB를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The expanded SteamCMD archive exceeds 256 MiB."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "展開後のSteamCMDアーカイブが256 MiBを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包展开后的大小超过 256 MiB。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔解壓縮後超過 256 MiB。"}}}
    },
    "Cannot inspect extracted SteamCMD file." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível inspecionar o arquivo extraído do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "압축 해제된 SteamCMD 파일을 검사할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot inspect extracted SteamCMD file."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "展開されたSteamCMDファイルを検査できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法检查解压后的 SteamCMD 文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法檢查解壓縮後的 SteamCMD 檔案。"}}}
    },
    "Hard-linked SteamCMD files are not allowed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivos do SteamCMD com link físico não são permitidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "하드 링크된 SteamCMD 파일은 허용되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Hard-linked SteamCMD files are not allowed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ハードリンクされたSteamCMDファイルは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不允许 SteamCMD 文件为硬链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不允許硬連結的 SteamCMD 檔案。"}}}
    },
    "Cannot preserve downloaded-file security metadata: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não é possível preservar os metadados de segurança do arquivo baixado: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 파일의 보안 메타데이터를 보존할 수 없습니다: %@."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot preserve downloaded-file security metadata: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードしたファイルのセキュリティメタデータを保持できません：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法保留下载文件的安全元数据：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法保留已下載檔案的安全性後設資料：%@。"}}}
    },
    "The SteamCMD archive contains an external or unresolved symbolic link." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo compactado do SteamCMD contém um link simbólico externo ou não resolvido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브에 외부를 가리키거나 해석할 수 없는 심볼릭 링크가 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive contains an external or unresolved symbolic link."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブに、外部を指すか解決できないシンボリックリンクが含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包包含指向外部或无法解析的符号链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔包含指向外部或無法解析的符號連結。"}}}
    },
    "The SteamCMD archive contains a cyclic symbolic link." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O arquivo compactado do SteamCMD contém um link simbólico cíclico."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 아카이브에 순환 심볼릭 링크가 포함되어 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD archive contains a cyclic symbolic link."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブに循環するシンボリックリンクが含まれています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包包含循环符号链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔包含循環的符號連結。"}}}
    },
    "Special files are not allowed in SteamCMD archives." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivos especiais não são permitidos em arquivos compactados do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 압축 파일에는 특수 파일을 포함할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Special files are not allowed in SteamCMD archives."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDアーカイブに特殊ファイルを含めることはできません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 压缩包中不允许包含特殊文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 壓縮檔中不允許包含特殊檔案。"}}}
    },
    "SteamCMD download redirected outside the official HTTPS host." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O download do SteamCMD foi redirecionado para fora do host HTTPS oficial."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 다운로드가 공식 HTTPS 호스트 외부로 리디렉션되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD download redirected outside the official HTTPS host."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのダウンロードが公式のHTTPSホスト以外にリダイレクトされました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下载被重定向到了官方 HTTPS 主机之外。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下載被重新導向至官方 HTTPS 主機以外的位置。"}}}
    },
    "The official SteamCMD server did not return HTTP 200." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O servidor oficial do SteamCMD não retornou HTTP 200."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "공식 SteamCMD 서버가 HTTP 200을 반환하지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The official SteamCMD server did not return HTTP 200."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "公式のSteamCMDサーバがHTTP 200を返しませんでした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "官方 SteamCMD 服务器未返回 HTTP 200。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "官方 SteamCMD 伺服器未傳回 HTTP 200。"}}}
    },
    "A SteamCMD download is larger than Valve’s package manifest allows." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um download do SteamCMD é maior do que o manifesto de pacotes da Valve permite."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 다운로드 파일이 Valve의 패키지 매니페스트에서 허용하는 크기를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A SteamCMD download is larger than Valve’s package manifest allows."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのダウンロードサイズがValveのパッケージマニフェストで許可されたサイズを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下载大小超过 Valve 安装包清单允许的大小。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下載大小超過 Valve 套件清單允許的大小。"}}}
    },
    "A SteamCMD download is empty or truncated." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um download do SteamCMD está vazio ou truncado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 다운로드 파일이 비어 있거나 일부가 누락되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A SteamCMD download is empty or truncated."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMDのダウンロードが空か、途中で切れています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下载为空或不完整。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 下載為空或不完整。"}}}
    },
    "%@ is not a macOS Mach-O SteamCMD executable." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ não é um executável Mach-O do SteamCMD para macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@은(는) macOS용 Mach-O 형식의 SteamCMD 실행 파일이 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "%@ is not a macOS Mach-O SteamCMD executable."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@はmacOS用のMach-O形式のSteamCMD実行ファイルではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是 macOS Mach-O 格式的 SteamCMD 可执行文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是 macOS Mach-O 格式的 SteamCMD 可執行檔。"}}}
    },
    "%@ is not a valid Mach-O runtime component." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ não é um componente de ambiente Mach-O válido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@은(는) 유효한 Mach-O 런타임 구성 요소가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "%@ is not a valid Mach-O runtime component."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@は有効なMach-Oランタイムコンポーネントではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是有效的 Mach-O 运行时组件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不是有效的 Mach-O 執行環境元件。"}}}
    },
    "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@ precisa da dependência de ambiente ausente ou externa %@. Conclua a instalação oficial do SteamCMD."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 필요한 런타임 의존성 %@이(가) 없거나 런타임 외부에 있습니다. 공식 SteamCMD 설치를 완료하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に必要なランタイム依存関係%@が見つからないか、ランタイム外にあります。公式のSteamCMDのインストールを完了してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的运行时依赖 %@ 缺失或位于运行时目录之外。请完成官方 SteamCMD 安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的執行環境相依項目 %@ 遺失或位於外部。請完成官方的 SteamCMD 安裝。"}}}
    },
    "%@: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "%@: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "%@: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@：%@"}}}
    },
    "Could not log out of Steam: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível sair da Steam: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 로그아웃하지 못했습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not log out of Steam: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトできませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法退出 Steam 登录：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法登出 Steam：%@"}}}
    },
    "Wait for active and queued downloads to finish before logging out of Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aguarde os downloads ativos e na fila terminarem antes de sair da Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 로그아웃하기 전에 진행 중이거나 대기 중인 다운로드가 완료될 때까지 기다리세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for active and queued downloads to finish before logging out of Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトする前に、実行中およびキュー内のダウンロードが完了するまでお待ちください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请等待进行中和排队的下载完成后再退出 Steam 登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請等待進行中和佇列中的下載完成後，再登出 Steam。"}}}
    },
    "Log out of Steam?" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sair da Steam?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 로그아웃하시겠습니까?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Log out of Steam?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからログアウトしますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要退出 Steam 登录吗？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要登出 Steam 嗎？"}}}
    },
    "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again." : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O início de sessão salvo de %@ será removido deste Mac. Outros dispositivos Steam continuam com a sessão iniciada, e o próximo download pedirá que você inicie sessão novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 저장된 로그인 정보가 이 Mac에서 제거됩니다. 다른 Steam 기기는 로그인 상태를 유지하며, 다음 다운로드 시 다시 로그인해야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The saved sign-in for %@ will be removed from this Mac. Other Steam devices stay signed in, and the next download asks you to sign in again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されている%@のサインイン情報がこのMacから削除されます。ほかのSteamデバイスはサインインしたままで、次回のダウンロード時に再度サインインを求められます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将从这台 Mac 移除 %@ 的已保存登录。其他 Steam 设备保持登录，下次下载时需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將從這部 Mac 移除 %@ 已儲存的登入資訊。其他 Steam 裝置會維持登入狀態，下次下載時會要求你重新登入。"}}}
    },
    "Log Out" : {
      "extractionState" : "manual",
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sair"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그아웃"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Log Out"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ログアウト"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "退出登录"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登出"}}}
    },
    "Steam authentication information retained on this device could not be updated (%@); you may need to sign in again later." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As informações de autenticação da Steam mantidas neste dispositivo não puderam ser atualizadas (%@); talvez seja necessário iniciar sessão novamente mais tarde."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 기기에 보관된 Steam 인증 정보를 업데이트할 수 없었습니다(%@). 나중에 다시 로그인해야 할 수 있습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "Steam authentication information retained on this device could not be updated (%@); you may need to sign in again later."}}, "ja": {"stringUnit": {"state": "translated", "value": "このデバイスに保持されているSteam認証情報を更新できなかったため（%@）、後で再度ログインが必要になる場合があります。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法更新此设备保留的 Steam 身份验证信息（%@）；之后可能需要重新登录。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法更新此裝置保留的 Steam 驗證資訊（%@）；之後可能需要重新登入。"}}}
    },
    "This Steam sign-in did not provide reusable authentication information, so you may be asked to sign in again later." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este início de sessão na Steam não forneceu informações de autenticação reutilizáveis, então talvez seja pedido que você inicie sessão novamente mais tarde."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이번 Steam 로그인에서는 재사용할 수 있는 인증 정보가 제공되지 않았으므로 나중에 다시 로그인하라는 요청을 받을 수 있습니다."}}, "en": {"stringUnit": {"state": "translated", "value": "This Steam sign-in did not provide reusable authentication information, so you may be asked to sign in again later."}}, "ja": {"stringUnit": {"state": "translated", "value": "今回のSteamログインでは再利用できる認証情報が得られなかったため、後で再度ログインを求められる場合があります。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本次 Steam 登录未提供可重复使用的身份验证信息，因此之后可能会要求您重新登录。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "本次 Steam 登入未提供可重複使用的驗證資訊，因此之後可能會要求您重新登入。"}}}
    },
    "Saved Steam sign-in expired; waiting for fresh authentication…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O início de sessão salvo na Steam expirou; aguardando nova autenticação…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 Steam 로그인 정보가 만료되었습니다. 새 인증 대기 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているSteamのサインイン情報の有効期限が切れました。新たな認証を待機中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的 Steam 登录已失效，等待重新验证…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的 Steam 登入資訊已過期；正在等待重新驗證…"}}}
    },
    "Using your saved Steam sign-in…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Usando seu início de sessão salvo na Steam…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 Steam 로그인 정보 사용 중…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されているSteamのサインイン情報を使用中…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在使用已保存的 Steam 登录…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在使用你已儲存的 Steam 登入資訊…"}}}
    },
    "Steam sign-in storage must be a private directory, not a symbolic link." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O armazenamento do início de sessão na Steam deve ser um diretório privado, não um link simbólico."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 로그인 정보 저장 위치는 심볼릭 링크가 아닌 비공개 디렉터리여야 합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインイン情報の保存先は、シンボリックリンクではなく非公開のディレクトリである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登录保存位置必须是私有目录，不能是符号链接。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登入資訊的儲存位置必須是私人目錄，不能是符號連結。"}}}
    },
    "Steam sign-in files cannot be read through symbolic links." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os arquivos de início de sessão na Steam não podem ser lidos por meio de links simbólicos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 로그인 파일은 심볼릭 링크를 통해 읽을 수 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインインファイルはシンボリックリンク経由では読み取れません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不能通过符号链接读取 Steam 登录文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法透過符號連結讀取 Steam 登入檔案。"}}}
    },
    "Steam sign-in storage contains an unsafe file." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O armazenamento do início de sessão na Steam contém um arquivo inseguro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 로그인 정보 저장 위치에 안전하지 않은 파일이 있습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインイン情報の保存先に安全ではないファイルがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登录保存目录包含不安全的文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登入資訊的儲存位置包含不安全的檔案。"}}}
    },
