    },
    "GitHub's hourly limit for anonymous update checks is used up on this network (60 requests an hour, shared by every app and device on the same public IP). Try again after %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub's hourly limit for anonymous update checks is used up on this network (60 requests an hour, shared by every app and device on the same public IP). Try again after %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークで、GitHubの匿名アップデート確認の1時間あたりの上限に達しました（1時間あたり60リクエスト。同じパブリックIPを使用するすべてのAppとデバイスで共有）。%@以降にもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前网络的 GitHub 免登录每小时访问额度已用完（同一公网 IP 下的所有设备和应用共享 60 次/小时）。请在 %@ 之后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此網路的 GitHub 匿名檢查更新每小時次數上限已用完（每小時 60 次，由同一公用 IP 上的所有 App 與裝置共用）。請於 %@ 後再試一次。"
          }
        }
      }
    },
