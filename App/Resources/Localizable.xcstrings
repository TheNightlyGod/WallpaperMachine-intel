    },
    "Comments" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "댓글"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Comments"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コメント"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Comentários"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "评论"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "留言"}}}
    },
    "Loading comments…" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "댓글 불러오는 중…"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Loading comments…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コメントを読み込み中…"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Carregando comentários…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在载入评论…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "正在載入留言…"}}}
    },
    "No comments yet" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 댓글이 없습니다"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No comments yet"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "まだコメントはありません"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ainda não há comentários"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有评论"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "尚無留言"}}}
    },
    "Read all comments on Steam" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 모든 댓글 보기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Read all comments on Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamですべてのコメントを読む"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ler todos os comentários na Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 查看全部评论"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 查看所有留言"}}}
    },
    "Steam did not subscribe you to this item. Try again, or subscribe on its Steam page." : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 이 항목을 구독하지 않았습니다. 다시 시도하거나 Steam 페이지에서 구독하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not subscribe you to this item. Try again, or subscribe on its Steam page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでこのアイテムをサブスクライブできませんでした。もう一度試すか、Steamのページでサブスクライブしてください。"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não inscreveu você neste item. Tente novamente ou inscreva-se na página dele na Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没有为你订阅此项目。请重试，或在它的 Steam 页面上订阅。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 沒有為你訂閱此項目。請再試一次，或在它的 Steam 頁面上訂閱。"}}}
    },
    "Steam did not unsubscribe you from this item. Try again, or unsubscribe on its Steam page." : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 이 항목의 구독을 취소하지 않았습니다. 다시 시도하거나 Steam 페이지에서 구독을 취소하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not unsubscribe you from this item. Try again, or unsubscribe on its Steam page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでこのアイテムのサブスクライブを解除できませんでした。もう一度試すか、Steamのページで解除してください。"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não cancelou sua inscrição neste item. Tente novamente ou cancele a inscrição na página dele na Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没有取消你对此项目的订阅。请重试，或在它的 Steam 页面上取消订阅。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 沒有取消你對此項目的訂閱。請再試一次，或在它的 Steam 頁面上取消訂閱。"}}}
    },
    "Steam could not be reached to change your subscription. Check your connection and try again." : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "구독을 변경하려고 Steam에 연결하지 못했습니다. 연결을 확인하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not be reached to change your subscription. Check your connection and try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サブスクライブを変更するためにSteamに接続できませんでした。接続を確認してもう一度試してください。"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível acessar a Steam para alterar sua inscrição. Verifique sua conexão e tente novamente."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法连接 Steam 来更改订阅。请检查网络连接后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法連線 Steam 來變更訂閱。請檢查網路連線後再試一次。"}}}
    },
    "Steam has no comments to show for this item." : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에 이 항목에 대해 표시할 댓글이 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam has no comments to show for this item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamにはこのアイテムに表示できるコメントがありません。"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não tem comentários para mostrar deste item."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 上没有此项目可显示的评论。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 上沒有此項目可顯示的留言。"}}}
    },
    "Steam’s comments could not be read. Try again, or read them on the item’s Steam page." : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 댓글을 읽을 수 없습니다. 다시 시도하거나 항목의 Steam 페이지에서 읽어 보세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam’s comments could not be read. Try again, or read them on the item’s Steam page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのコメントを読み込めませんでした。もう一度試すか、アイテムのSteamページで読んでください。"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler os comentários da Steam. Tente novamente ou leia-os na página do item na Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取 Steam 评论。请重试，或在此项目的 Steam 页面上查看。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取 Steam 留言。請再試一次，或在此項目的 Steam 頁面上查看。"}}}
    },
    "project.json must describe a scene, video, or web wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O project.json precisa descrever um papel de parede de cena, de vídeo ou web."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "project.json에는 장면, 비디오 또는 웹 배경화면이 정의되어 있어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must describe a scene, video, or web wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonはシーン、ビデオ、またはWeb壁紙を記述している必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须描述场景、视频或网页壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須描述場景、影片或網頁桌布。"}}}
    },
    "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O project.json precisa usar a codificação UTF-8 sem marca de ordem de bytes. Converta o manifesto e importe-o novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "project.json은 바이트 순서 표시(BOM)가 없는 UTF-8 인코딩을 사용해야 합니다. 매니페스트를 변환한 후 다시 가져오세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonはBOM（バイトオーダーマーク）なしのUTF-8エンコーディングである必要があります。マニフェストを変換してから、もう一度読み込んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须使用不带 BOM 的 UTF-8 编码。请转换后重新导入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須使用不含 BOM（位元組順序記號）的 UTF-8 編碼。請轉換此資訊清單後重新匯入。"}}}
    },
    "project.json must be a regular JSON file smaller than 16 MB." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O project.json precisa ser um arquivo JSON comum com menos de 16 MB."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "project.json은 16 MB 미만의 일반 JSON 파일이어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must be a regular JSON file smaller than 16 MB."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "project.jsonは16 MB未満の通常のJSONファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须是小于 16 MB 的普通 JSON 文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必須是小於 16 MB 的一般 JSON 檔案。"}}}
    },
    "Could not create %@. Check available disk space and folder permissions." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível criar %@. Verifique o espaço disponível em disco e as permissões da pasta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@을(를) 생성하지 못했습니다. 디스크 여유 공간과 폴더 권한을 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create %@. Check available disk space and folder permissions."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を作成できませんでした。ディスクの空き容量とフォルダのアクセス権を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建 %@。请检查磁盘空间和文件夹权限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法建立 %@。請檢查可用磁碟空間和資料夾權限。"}}}
    },
    "Unsupported special file: %@. Only regular files and folders can be imported." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Arquivo especial não compatível: %@. Apenas arquivos e pastas comuns podem ser importados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지원되지 않는 특수 파일: %@. 일반 파일과 폴더만 가져올 수 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unsupported special file: %@. Only regular files and folders can be imported."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対応していない特殊ファイルです：%@。読み込めるのは通常のファイルとフォルダのみです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持的特殊文件：%@。只能导入普通文件和文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援的特殊檔案：%@。只能匯入一般檔案和資料夾。"}}}
    },
    "Symbolic links are not imported: %@. Copy the original content into the project folder first." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Links simbólicos não são importados: %@. Copie primeiro o conteúdo original para a pasta do projeto."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "심볼릭 링크는 가져오지 않습니다: %@. 먼저 원본 콘텐츠를 프로젝트 폴더에 복사하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported: %@. Copy the original content into the project folder first."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シンボリックリンクは読み込まれません：%@。先に元の内容をプロジェクトフォルダにコピーしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接：%@。请先把原始内容复制到项目文件夹中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不會匯入符號連結：%@。請先將原始內容拷貝到專案資料夾中。"}}}
    },
    "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS se recusou a recarregar o serviço de papel de parede do usuário (errno %d). O registro de restauração foi mantido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 사용자 소유 배경화면 서비스의 다시 불러오기를 거부했습니다(errno %d). 복원 저널은 유지되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがユーザ所有の壁紙サービスの再読み込みを拒否しました（errno %d）。復元ジャーナルは保持されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 拒绝重新加载墙纸服务（errno %d）。恢复记录已保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 拒絕重新載入使用者擁有的桌布服務（errno %d）。已保留還原記錄。"}}}
    },
    "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum WallpaperAgent do usuário verificado positivamente está em execução. Não foi possível ativar a seleção nativa; o registro de restauração dela foi mantido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용자 소유임이 확실하게 확인된 WallpaperAgent가 실행 중이 아닙니다. 시스템 배경화면 선택을 활성화하지 못했습니다. 복원 저널은 유지되었습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のユーザが所有していると確実に確認できたWallpaperAgentが実行されていません。システムの壁紙選択を有効にできませんでした。復元ジャーナルは保持されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有找到可确认属于当前用户的 WallpaperAgent 进程，无法启用锁定屏幕墙纸。恢复记录已保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有執行中且經確認屬於目前使用者的 WallpaperAgent。無法啟用原生桌布選擇；已保留其還原記錄。"}}}
    },
    "Unable to identify the wallpaper service safely." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível identificar o serviço de papel de parede com segurança."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 서비스를 안전하게 식별할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to identify the wallpaper service safely."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙サービスを安全に特定できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全识别墙纸服务。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全地識別桌布服務。"}}}
    },
    "Unable to enumerate the wallpaper service." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível enumerar o serviço de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 서비스를 나열할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to enumerate the wallpaper service."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙サービスを列挙できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法列出墙纸服务进程。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法列舉桌布服務。"}}}
    },
    "This macOS Space has an unsupported wallpaper configuration." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este Space do macOS tem uma configuração de papel de parede não compatível."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 macOS 데스크탑 공간의 배경화면 구성은 지원되지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS Space has an unsupported wallpaper configuration."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このmacOSの操作スペースには、対応していない壁紙構成があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个 macOS 桌面空间的墙纸配置不受支持。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 macOS 空間的桌布設定不受支援。"}}}
    },
    "The system wallpaper was changed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again; external choices will be preserved." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede do sistema foi alterado fora do WallpaperMachine. Desative o recurso de papel de parede afetado antes de ativá-lo novamente; as escolhas externas serão preservadas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 외부에서 시스템 배경화면이 변경되었습니다. 해당 배경화면 기능을 끈 후 다시 켜세요. 외부에서 선택한 내용은 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper was changed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again; external choices will be preserved."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙がWallpaperMachineの外部で変更されました。該当する壁紙機能を一度オフにしてから、もう一度オンにしてください。外部で行った選択は保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "系统墙纸在 WallpaperMachine 之外被更改了。请先关闭受影响的壁纸功能，再重新开启；你在别处做的选择会保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "系統桌布已在 WallpaperMachine 之外被更改。請先關閉受影響的桌布功能再重新開啟；你在外部所做的選擇會保留。"}}}
    },
    "The native wallpaper restoration journal is invalid." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O registro de restauração do papel de parede nativo é inválido."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 배경화면 복원 저널이 유효하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The native wallpaper restoration journal is invalid."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙の復元ジャーナルが無効です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸恢复记录无效。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布還原記錄無效。"}}}
    },
    "A native wallpaper override was removed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma substituição de papel de parede nativo foi removida fora do WallpaperMachine. Desative o recurso de papel de parede afetado antes de ativá-lo novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 외부에서 시스템 배경화면 재정의가 제거되었습니다. 해당 배경화면 기능을 껐다가 다시 켜세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper override was removed outside WallpaperMachine. Disable the affected wallpaper feature before enabling it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システム壁紙のオーバーライドがWallpaperMachineの外部で削除されました。該当する壁紙機能を一度オフにしてから、もう一度オンにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸设置在 WallpaperMachine 之外被移除了。请先关闭受影响的壁纸功能，再重新开启。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布覆寫設定已在 WallpaperMachine 之外被移除。請先關閉受影響的桌布功能再重新開啟。"}}}
    },
    "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede do sistema mudou durante a seleção nativa. Tente novamente; nenhuma alteração simultânea foi sobrescrita."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 배경화면 선택 중 시스템 배경화면이 변경되었습니다. 다시 시도하세요. 동시에 이루어진 변경 사항은 덮어쓰지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙を選択している間に、システムの壁紙が変更されました。再試行してください。同時に行われた変更は上書きされていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置过程中系统墙纸发生了变化。请重试，其间的更改没有被覆盖。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "進行原生桌布選擇時，系統桌布發生變更。請重試；同時進行的變更均未被覆寫。"}}}
    },
    "This macOS wallpaper store format is unsupported. Native selection was not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este formato de armazenamento de papéis de parede do macOS não é compatível. A seleção nativa não foi alterada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 macOS 배경화면 저장소 형식은 지원되지 않습니다. 시스템 배경화면 선택은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS wallpaper store format is unsupported. Native selection was not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このmacOSの壁紙ストア形式には対応していません。システムの壁紙選択は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持这个版本的 macOS 墙纸存储格式，墙纸设置没有被更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "不支援此 macOS 桌布儲存格式。原生桌布選擇未變更。"}}}
    },
    "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling native wallpaper animation; the existing global wallpaper was not changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um papel de parede vinculado em todo o sistema está substituindo os monitores individuais no momento. Desative esse app de papel de parede ou o ajuste dele para todos os monitores antes de ativar a animação nativa de papel de parede; o papel de parede global existente não foi alterado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 시스템 전체에 연동된 배경화면이 개별 디스플레이 설정보다 우선 적용됩니다. 시스템 배경화면 애니메이션을 켜기 전에 해당 배경화면 앱이나 앱의 모든 디스플레이 설정을 끄세요. 기존 전체 배경화면은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling native wallpaper animation; the existing global wallpaper was not changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在、システム全体でリンクされた壁紙が個々のディスプレイの設定より優先されています。システム壁紙のアニメーションをオンにする前に、その壁紙Appまたはその「すべてのディスプレイ」設定をオフにしてください。既存のグローバル壁紙は変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前有一个全局墙纸覆盖了所有显示器。请先关闭那个墙纸应用或它的“所有显示器”设置，再启用原生墙纸动画。现有的全局墙纸没有被更改。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "目前有全系統連動的桌布覆蓋了個別顯示器。請先關閉該桌布 App 或其「所有顯示器」設定，再啟用原生桌布動畫；現有的全域桌布未變更。"}}}
    },
    "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling native wallpaper animation." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma seleção de papel de parede nativo não tem registro de restauração nem papel de parede de reserva do sistema. Escolha um papel de parede do sistema para este monitor antes de ativar a animação nativa de papel de parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "선택한 시스템 배경화면에 복원 기록이나 남아 있는 시스템 대체 배경화면이 없습니다. 시스템 배경화면 애니메이션을 켜기 전에 이 디스플레이의 시스템 배경화면을 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling native wallpaper animation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの壁紙選択に、復元ジャーナルも残存するシステムのフォールバックもありません。システム壁紙のアニメーションをオンにする前に、このディスプレイのシステム壁紙を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台显示器的墙纸设置没有可用的恢复记录或系统备选。请先为它选择一张系统墙纸，再启用原生墙纸动画。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "原生桌布選擇沒有還原記錄，也沒有留存的系統備用桌布。請先為此顯示器選擇系統桌布，再啟用原生桌布動畫。"}}}
    },
    "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede foi baixado, mas os recursos de cena compartilhados do Wallpaper Engine não estão instalados. Escolha Obter recursos compartilhados nos detalhes do papel de parede ou acesse Ajustes → Biblioteca e Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면은 다운로드되었지만 Wallpaper Engine의 공유 장면 리소스가 설치되지 않았습니다. 배경화면 세부사항에서 ‘공유 리소스 받기’를 선택하거나 설정 → 보관함 및 Steam으로 이동하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙はダウンロード済みですが、Wallpaper Engineの共有シーンリソースがインストールされていません。壁紙の詳細で「共有リソースを入手」を選択するか、「設定」→「ライブラリとSteam」に移動してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已下载，但还没有安装 Wallpaper Engine 的共享场景资源。请在壁纸详情中点击“获取共享资源”，或前往“设置 → 壁纸库与 Steam”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布已下載，但尚未安裝 Wallpaper Engine 的共用場景資源。請在桌布詳細資訊中選擇「取得共用資源」，或前往「設定 → 桌布庫與 Steam」。"}}}
    },
    "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta pasta não contém os shaders e materiais compartilhados do Wallpaper Engine. Escolha a pasta de recursos completa ou instale os recursos de cena pela Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 폴더에는 Wallpaper Engine의 공유 셰이더와 머티리얼이 없습니다. 완전한 assets 폴더를 선택하거나 Steam을 통해 장면 리소스를 설치하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このフォルダにはWallpaper Engineの共有シェーダとマテリアルが含まれていません。完全なassetsフォルダを選択するか、Steamで共有シーンリソースをインストールしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹不包含 Wallpaper Engine 的共享着色器和材质。请选择完整的 assets 文件夹，或通过 Steam 安装场景资源。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此資料夾不含 Wallpaper Engine 的共用著色器和材質。請選擇完整的 assets 資料夾，或透過 Steam 安裝場景資源。"}}}
    },
    "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não gerou recursos de cena completos. Confirme que esta conta possui o Wallpaper Engine e tente novamente. Os recursos existentes não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 완전한 장면 에셋을 받지 못했습니다. 이 계정이 Wallpaper Engine을 소유하고 있는지 확인한 후 다시 시도하세요. 기존 에셋은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから完全な共有シーンリソースを取得できませんでした。このアカウントがWallpaper Engineを所有していることを確認してから再試行してください。既存のリソースは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没有提供完整的场景资源。请确认此账户拥有 Wallpaper Engine 后重试，现有资源没有被改动。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未產生完整的場景資源。請確認此帳號擁有 Wallpaper Engine 後重試。現有資源未被更動。"}}}
    },
    "This wallpaper is not a folder in the managed library. Nothing was deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este papel de parede não é uma pasta na biblioteca gerenciada. Nada foi apagado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 배경화면은 관리되는 보관함 내부의 폴더가 아닙니다. 아무것도 삭제되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is not a folder in the managed library. Nothing was deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この壁紙は管理対象のライブラリ内のフォルダではありません。何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸不是壁纸库中的文件夹，没有删除任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌布不是受管理桌布庫中的資料夾。未刪除任何內容。"}}}
    },
    "Invalid wallpaper ID. Nothing was deleted." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "ID de papel de parede inválido. Nada foi apagado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 ID가 유효하지 않습니다. 아무것도 삭제되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Invalid wallpaper ID. Nothing was deleted."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙IDが無効です。何も削除されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸 ID 无效，没有删除任何内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布 ID 無效。未刪除任何內容。"}}}
    },
    "Restoration also failed: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A restauração também falhou: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "복원도 실패했습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Restoration also failed: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "復元にも失敗しました：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复也失败了：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還原也失敗了：%@"}}}
    },
    "Next Wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Próximo Papel de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 배경화면"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Next Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下一张壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下一張桌布"}}}
    },
    "Lock Screen" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Tela Bloqueada"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "화면 잠금"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Lock Screen"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画面をロック"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "鎖定畫面"}}}
    },
    "Requires macOS 26 or later" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Requer macOS 26 ou posterior"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26 이상 필요"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Requires macOS 26 or later"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOS 26以降が必要です"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或更高版本"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要 macOS 26 或以上版本"}}}
    },
    "Unavailable" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Indisponível"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용 불가"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unavailable"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "利用できません"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不可用"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用"}}}
    },
    "That app rule no longer exists." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Essa regra de app não existe mais."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "해당 앱 규칙이 더 이상 존재하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "That app rule no longer exists."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "そのAppルールはもう存在しません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "该应用规则已不存在。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "該 App 規則已不存在。"}}}
    },
    "Couldn’t reach pixiv: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível acessar o pixiv: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에 연결하지 못했습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t reach pixiv: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivに接続できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法连接 pixiv：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法連線至 pixiv：%@"}}}
    },
    "The connection to %@ was cut off or refused. This usually means WallpaperMachine’s traffic to it isn’t going through your proxy or VPN: turn on its system proxy or TUN mode, or route this domain through the proxy, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A conexão com %@ foi interrompida ou recusada. Isso geralmente significa que o tráfego do WallpaperMachine até ele não está passando pelo seu proxy ou VPN: ative o proxy do sistema ou o modo TUN dele, ou encaminhe este domínio pelo proxy, e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 대한 연결이 끊기거나 거부되었습니다. 대개 WallpaperMachine의 트래픽이 프록시나 VPN을 거치지 않는다는 뜻입니다. 프록시/VPN의 시스템 프록시 또는 TUN 모드를 켜거나 이 도메인을 프록시로 라우팅한 다음 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The connection to %@ was cut off or refused. This usually means WallpaperMachine’s traffic to it isn’t going through your proxy or VPN: turn on its system proxy or TUN mode, or route this domain through the proxy, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@ への接続が切断されたか、拒否されました。多くの場合、WallpaperMachine の通信がプロキシや VPN を経由していないことを意味します。プロキシ/VPN のシステムプロキシまたは TUN モードをオンにするか、このドメインをプロキシ経由にしてから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "与 %@ 的连接被中断或拒绝。这通常表示 WallpaperMachine 访问它的流量没有经过你的代理或 VPN：请开启代理/VPN 的系统代理或 TUN 模式，或将该域名设为走代理，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "與 %@ 的連線被中斷或拒絕。這通常表示 WallpaperMachine 存取它的流量沒有經過你的代理或 VPN：請開啟代理/VPN 的系統代理或 TUN 模式，或將此網域設為經由代理，然後再試一次。"}}}
    },
    "Couldn’t open the sign-in page" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível abrir a página de login"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인 페이지를 열 수 없습니다"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t open the sign-in page"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインページを開けませんでした"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法打开登录页面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法開啟登入頁面"}}}
    },
    "pixiv has nothing at this address any more. The work may have been deleted, or the ranking has no more pages." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv não tem mais nada neste endereço. A obra pode ter sido apagada, ou o ranking não tem mais páginas."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 주소에는 더 이상 pixiv 콘텐츠가 없습니다. 작품이 삭제되었거나 랭킹에 더 이상 페이지가 없을 수 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv has nothing at this address any more. The work may have been deleted, or the ranking has no more pages."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアドレスにはpixivのコンテンツがもうありません。作品が削除されたか、ランキングにこれ以上のページがない可能性があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 上已没有这个地址的内容。作品可能已被删除，或者排行榜没有更多页了。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 上此位址已沒有內容。作品可能已被刪除，或排行榜已沒有更多頁面。"}}}
    },
    "pixiv is limiting requests from this network right now. Wait a minute, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv está limitando as solicitações desta rede no momento. Aguarde um minuto e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv가 현재 이 네트워크의 요청을 제한하고 있습니다. 1분 정도 기다린 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv is limiting requests from this network right now. Wait a minute, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivは現在、このネットワークからのリクエストを制限しています。1分ほど待ってから、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 目前正在限制来自此网络的请求。请稍等一分钟后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 目前正在限制來自此網路的請求。請稍候一分鐘再試一次。"}}}
    },
    "pixiv denied access to this request (HTTP 403). Check access in your browser and your network or proxy connection before retrying." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv negou o acesso a esta solicitação (HTTP 403). Verifique o acesso no seu navegador e a sua conexão de rede ou proxy antes de tentar novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv가 이 요청의 접근을 거부했습니다(HTTP 403). 브라우저에서 접근할 수 있는지와 네트워크 또는 프록시 연결을 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv denied access to this request (HTTP 403). Check access in your browser and your network or proxy connection before retrying."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがこのリクエストへのアクセスを拒否しました（HTTP 403）。ブラウザでpixivにアクセスできるか、ネットワークやプロキシの接続を確認してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 拒绝了此请求的访问（HTTP 403）。请检查浏览器能否访问 pixiv，以及网络或代理连接，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 拒絕了此請求的存取（HTTP 403）。請檢查瀏覽器能否存取 pixiv，以及網路或代理連線，然後重試。"}}}
    },
    "pixiv’s protection service blocked this connection (Cloudflare error %lld). It blocks some networks and proxy nodes even when a browser still opens pixiv. Switch to another proxy node or network, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O serviço de proteção do pixiv bloqueou esta conexão (erro %lld do Cloudflare). Ele bloqueia algumas redes e nós de proxy mesmo quando um navegador ainda abre o pixiv. Mude para outro nó de proxy ou rede e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv의 보호 서비스가 이 연결을 차단했습니다(Cloudflare 오류 %lld). 브라우저에서 pixiv가 열리더라도 일부 네트워크와 프록시 노드는 차단됩니다. 다른 프록시 노드나 네트워크로 전환한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv’s protection service blocked this connection (Cloudflare error %lld). It blocks some networks and proxy nodes even when a browser still opens pixiv. Switch to another proxy node or network, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivの保護サービスがこの接続をブロックしました（Cloudflareエラー %lld）。ブラウザでpixivを開ける場合でも、一部のネットワークやプロキシノードはブロックされます。別のプロキシノードまたはネットワークに切り替えてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 的防护服务拦截了此连接（Cloudflare 错误 %lld）。即使浏览器仍能打开 pixiv，它也会拦截部分网络和代理节点。请切换到其他代理节点或网络，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 的防護服務封鎖了此連線（Cloudflare 錯誤 %lld）。即使瀏覽器仍能開啟 pixiv，它也會封鎖部分網路和代理節點。請切換到其他代理節點或網路，然後重試。"}}}
    },
    "pixiv’s protection service blocked this connection with a browser check WallpaperMachine can’t complete. It blocks some networks and proxy nodes even when a browser still opens pixiv. Switch to another proxy node or network, then try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O serviço de proteção do pixiv bloqueou esta conexão com uma verificação de navegador que o WallpaperMachine não consegue concluir. Ele bloqueia algumas redes e nós de proxy mesmo quando um navegador ainda abre o pixiv. Mude para outro nó de proxy ou rede e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv의 보호 서비스가 이 연결에 브라우저 확인을 요구했지만 WallpaperMachine은 이를 완료할 수 없습니다. 브라우저에서 pixiv가 열리더라도 일부 네트워크와 프록시 노드는 차단됩니다. 다른 프록시 노드나 네트워크로 전환한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv’s protection service blocked this connection with a browser check WallpaperMachine can’t complete. It blocks some networks and proxy nodes even when a browser still opens pixiv. Switch to another proxy node or network, then try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivの保護サービスがこの接続にブラウザ確認を求めましたが、WallpaperMachineでは完了できません。ブラウザでpixivを開ける場合でも、一部のネットワークやプロキシノードはブロックされます。別のプロキシノードまたはネットワークに切り替えてから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 的防护服务要求此连接通过浏览器验证，WallpaperMachine 无法完成该验证。即使浏览器仍能打开 pixiv，它也会拦截部分网络和代理节点。请切换到其他代理节点或网络，然后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 的防護服務要求此連線通過瀏覽器驗證，WallpaperMachine 無法完成此驗證。即使瀏覽器仍能開啟 pixiv，它也會封鎖部分網路和代理節點。請切換到其他代理節點或網路，然後重試。"}}}
    },
    "pixiv returned status %lld. Try again later." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv retornou o status %lld. Tente novamente mais tarde."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 반환한 상태 코드: %lld. 나중에 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv returned status %lld. Try again later."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがステータス%lldを返しました。あとでもう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回了状态码 %lld。请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回狀態碼 %lld。請稍後再試。"}}}
    },
    "pixiv sent an answer this version of WallpaperMachine can’t read. Try again, or open the work on pixiv." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv enviou uma resposta que esta versão do WallpaperMachine não consegue ler. Tente novamente ou abra a obra no pixiv."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 이 버전의 WallpaperMachine이 읽을 수 없는 응답을 보냈습니다. 다시 시도하거나 pixiv에서 작품을 여세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv sent an answer this version of WallpaperMachine can’t read. Try again, or open the work on pixiv."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから、このバージョンのWallpaperMachineでは読み取れない応答が返されました。もう一度試すか、pixivで作品を開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 返回的内容无法被此版本的 WallpaperMachine 读取。请重试，或在 pixiv 上打开该作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳回的回應無法由此版本的 WallpaperMachine 讀取。請再試一次，或在 pixiv 上打開該作品。"}}}
    },
    "pixiv shows this work only to signed-in members, or only to the artist’s followers. Sign in to pixiv, or open the work there." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv mostra esta obra apenas para membros com sessão iniciada ou apenas para seguidores do artista. Inicie sessão no pixiv ou abra a obra lá."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 이 작품은 로그인한 회원 또는 작가의 팔로워에게만 공개됩니다. pixiv에 로그인하거나 pixiv에서 작품을 여세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv shows this work only to signed-in members, or only to the artist’s followers. Sign in to pixiv, or open the work there."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この作品は、pixivにサインインしている会員、または作者のフォロワーにのみ公開されています。pixivにサインインするか、pixivで作品を開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 仅向已登录的会员或作者的关注者展示此作品。请登录 pixiv，或在 pixiv 上打开该作品。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 只向已登入的會員或作者的追蹤者顯示此作品。請登入 pixiv，或在 pixiv 上打開該作品。"}}}
    },
    "The image is larger than the %lld MB WallpaperMachine accepts." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A imagem é maior que o limite de %lld MB aceito pelo WallpaperMachine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지가 WallpaperMachine에서 허용하는 %lld MB를 초과합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The image is larger than the %lld MB WallpaperMachine accepts."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像がWallpaperMachineで扱える上限の%lld MBを超えています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片超过了 WallpaperMachine 可接受的 %lld MB 上限。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片超過 WallpaperMachine 可接受的 %lld MB 上限。"}}}
    },
    "pixiv sent a file that is not a JPEG, PNG or GIF image." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv enviou um arquivo que não é uma imagem JPEG, PNG ou GIF."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에서 전송한 파일은 JPEG, PNG 또는 GIF 이미지가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv sent a file that is not a JPEG, PNG or GIF image."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivから送られたファイルは、JPEG、PNG、GIFのいずれの画像でもありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 发送的文件不是 JPEG、PNG 或 GIF 图片。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 傳送的檔案不是 JPEG、PNG 或 GIF 圖片。"}}}
    },
    "The downloaded image couldn’t be read. Try downloading it again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler a imagem baixada. Tente baixá-la novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드한 이미지를 읽을 수 없습니다. 다시 다운로드하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The downloaded image couldn’t be read. Try downloading it again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードした画像を読み取れませんでした。もう一度ダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的图片无法读取。请重新下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取下載的圖片。請重新下載。"}}}
    },
    "pixiv didn’t accept the sign-in. Sign in to pixiv again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv não aceitou o início de sessão. Inicie sessão no pixiv novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv가 로그인을 수락하지 않았습니다. pixiv에 다시 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv didn’t accept the sign-in. Sign in to pixiv again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivがサインインを受け付けませんでした。もう一度pixivにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 未接受此次登录。请重新登录 pixiv。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 未接受此次登入。請重新登入 pixiv。"}}}
    },
    "pixiv won’t show R-18 works to this account. Turn them on in pixiv’s settings under Viewing restrictions, then refresh." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O pixiv não mostra obras R-18 para esta conta. Ative-as nos ajustes do pixiv em Restrições de visualização e depois atualize."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv가 이 계정에 R-18 작품을 표시하지 않습니다. pixiv 설정의 ‘열람 제한’에서 표시를 허용한 후 새로고침하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "pixiv won’t show R-18 works to this account. Turn them on in pixiv’s settings under Viewing restrictions, then refresh."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivはこのアカウントにR-18作品を表示しません。pixivの設定の「閲覧制限」でオンにしてから、更新してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 不会向此账户显示 R-18 作品。请在 pixiv 设置的“浏览限制”中开启，然后刷新。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "pixiv 不會向此帳號顯示 R-18 作品。請在 pixiv 設定的「瀏覽限制」中開啟，然後重新整理。"}}}
    },
    "Signed in, but the keychain didn’t keep the sign-in, so you’ll need to sign in again after WallpaperMachine quits." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Sessão iniciada, mas o chaveiro não guardou o início de sessão, então será necessário iniciar sessão novamente depois que o WallpaperMachine for encerrado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "로그인했지만 키체인에 로그인 정보가 저장되지 않아 WallpaperMachine을 종료하면 다시 로그인해야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Signed in, but the keychain didn’t keep the sign-in, so you’ll need to sign in again after WallpaperMachine quits."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サインインしましたが、キーチェーンにサインイン情報を保存できなかったため、WallpaperMachineの終了後にもう一度サインインする必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已登录，但钥匙串未能保存登录信息，WallpaperMachine 退出后需要重新登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已登入，但鑰匙圈未保存登入資訊，因此 WallpaperMachine 結束後你需要重新登入。"}}}
    },
    "Sign in to pixiv" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão no pixiv"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "pixiv에 로그인"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Sign in to pixiv"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "pixivにサインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 pixiv"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 pixiv"}}}
    },
    "Choose a video, image, HTML file, or Wallpaper Engine project folder." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha um vídeo, imagem, arquivo HTML ou pasta de projeto do Wallpaper Engine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상, 이미지, HTML 파일 또는 Wallpaper Engine 프로젝트 폴더를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a video, image, HTML file, or Wallpaper Engine project folder."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ、画像、HTMLファイル、またはWallpaper Engineのプロジェクトフォルダを選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择视频、图片、HTML 文件或 Wallpaper Engine 项目文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請選擇影片、圖片、HTML 檔案或 Wallpaper Engine 專案資料夾。"}}}
    },
    "Choose videos, images, HTML files, project folders or a Steam library. Your original files are kept." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha vídeos, imagens, arquivos HTML, pastas de projeto ou uma biblioteca da Steam. Os seus arquivos originais são mantidos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "동영상, 이미지, HTML 파일, 프로젝트 폴더 또는 Steam 보관함을 선택하세요. 원본 파일은 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Choose videos, images, HTML files, project folders or a Steam library. Your original files are kept."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ビデオ、画像、HTMLファイル、プロジェクトフォルダ、またはSteamライブラリを選択してください。元のファイルは保持されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择视频、图片、HTML 文件、项目文件夹或 Steam 库。原始文件会被保留。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "選擇影片、圖片、HTML 檔案、專案資料夾或 Steam 收藏庫。原始檔案會保留。"}}}
    },
    "Images must be regular files between 1 byte and 512 MB." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As imagens precisam ser arquivos comuns entre 1 byte e 512 MB."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이미지는 크기가 1바이트~512 MB인 일반 파일이어야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Images must be regular files between 1 byte and 512 MB."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "画像は1バイトから512 MBまでの通常のファイルである必要があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "图片必须是 1 字节到 512 MB 之间的普通文件。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "圖片必須是介於 1 位元組到 512 MB 之間的一般檔案。"}}}
    },
    "This image could not be read. Choose a picture that opens in Preview." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler esta imagem. Escolha uma imagem que abra no Pré-Visualização."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 이미지를 읽을 수 없습니다. 미리보기 앱에서 열 수 있는 이미지를 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This image could not be read. Choose a picture that opens in Preview."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この画像を読み取れませんでした。「プレビュー」で開ける画像を選択してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取这张图片。请选择能在“预览”中打开的图片。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法讀取此圖片。請選擇可在「預覽程式」中打開的圖片。"}}}
    },
    "Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布"}}}
    },
    "Pause, mute or stop wallpapers while this Focus is on." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pause, silencie ou pare os papéis de parede enquanto este Foco estiver ativo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 집중 모드가 켜져 있는 동안 배경화면을 일시 정지하거나 소리를 끄거나 중지합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Pause, mute or stop wallpapers while this Focus is on."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この集中モードがオンのあいだ、壁紙を一時停止、消音、または停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此专注模式开启时暂停、静音或停止壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此專注模式開啟時，暫停、靜音或停止桌布。"}}}
    },
    "Wallpaper playback" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reprodução de papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재생"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper playback"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸播放"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布播放"}}}
    },
    "Keep running" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Continuar em execução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계속 실행"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Keep running"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "実行を続ける"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續執行"}}}
    },
    "Mute" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음소거"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Mute"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音"}}}
    },
    "Stop (free memory)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Parar (liberar memória)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "정지(메모리 확보)"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Stop (free memory)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "停止（メモリを解放）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "停止（释放内存）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "停止（釋放記憶體）"}}}
    },
    "This display has no rotating playlist to move along." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este monitor não tem uma playlist em rotação para avançar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 디스플레이에는 순서를 이동할 순환 재생목록이 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This display has no rotating playlist to move along."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このディスプレイには、次に進めるローテーション中のプレイリストがありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此显示器没有可轮换的播放列表。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此顯示器沒有可切換的輪播播放列表。"}}}
    },
    "Steam answered the request for Workshop details in a form this app does not read." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam respondeu à solicitação de detalhes do Workshop em um formato que este app não lê."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 창작마당 세부 정보 요청에 이 앱에서 읽을 수 없는 형식으로 응답했습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam answered the request for Workshop details in a form this app does not read."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamからのワークショップの詳細に関する応答は、このAppでは読み取れない形式でした。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 返回的创意工坊详情格式无法识别。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 傳回的工作坊詳細資訊格式無法由此 App 讀取。"}}}
    },
    "Steam did not answer the request for Workshop details. Check your connection and try again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não respondeu à solicitação de detalhes do Workshop. Verifique a sua conexão e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 창작마당 세부 정보 요청에 응답하지 않았습니다. 연결 상태를 확인한 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not answer the request for Workshop details. Check your connection and try again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamがワークショップの詳細のリクエストに応答しませんでした。ネットワーク接続を確認して、もう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未响应创意工坊详情请求。请检查网络连接后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未回應工作坊詳細資訊請求。請檢查網路連線後再試一次。"}}}
    },
    "Couldn’t check the Workshop for updates: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível verificar atualizações no Workshop: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창작마당 업데이트를 확인하지 못했습니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t check the Workshop for updates: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップのアップデートを確認できませんでした：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法检查创意工坊更新：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法檢查工作坊更新：%@"}}}
    },
    "Could not replace Workshop item %@ with its update: %@. The installed version is unchanged." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível substituir o item do Workshop %@ pela atualização: %@. A versão instalada não foi alterada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "창작마당 항목 %@을(를) 업데이트로 교체하지 못했습니다: %@. 설치된 버전은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not replace Workshop item %@ with its update: %@. The installed version is unchanged."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ワークショップアイテム%@をアップデートで置き換えられませんでした：%@。インストール済みのバージョンは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法用更新替换创意工坊项目 %@：%@。已安装的版本保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法以更新取代工作坊項目 %@：%@。已安裝的版本維持不變。"}}}
    },
    "Could not replace %@ with the imported copy: %@ The installed version is unchanged." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível substituir %@ pela cópia importada: %@ A versão instalada não foi alterada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@을(를) 가져온 사본으로 교체하지 못했습니다: %@ 설치된 버전은 변경되지 않았습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not replace %@ with the imported copy: %@ The installed version is unchanged."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@を読み込んだコピーで置き換えられませんでした：%@ インストール済みのバージョンは変更されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法用导入的副本替换 %@：%@ 已安装的版本保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法以匯入的副本取代 %@：%@ 已安裝的版本維持不變。"}}}
    },
    "Its folder in the library has no project.json, so it is not an installed wallpaper." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta dele na biblioteca não tem project.json, então ele não é um papel de parede instalado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함의 해당 폴더에 project.json이 없어 설치된 배경화면이 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Its folder in the library has no project.json, so it is not an installed wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリ内のそのフォルダにはproject.jsonがないため、インストール済みの壁紙ではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "它在壁纸库中的文件夹没有 project.json，因此不是已安装的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "它在桌布庫中的資料夾沒有 project.json，因此不是已安裝的桌布。"}}}
    },
    "Play or pause wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir ou pausar papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재생 또는 일시 정지"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Play or pause wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停桌布"}}}
    },
    "Next wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Próximo papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 배경화면"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Next wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下一张壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下一張桌布"}}}
    },
    "Open the control panel" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir o painel de controle"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제어 패널 열기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Open the control panel"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネルを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开控制面板"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開控制面板"}}}
    },
    "Another app already uses this shortcut. Record a different one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outro app já usa este atalho. Grave um diferente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 앱에서 이미 이 단축키를 사용하고 있습니다. 다른 단축키를 입력하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Another app already uses this shortcut. Record a different one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このショートカットはほかのAppですでに使用されています。別のショートカットを記録してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "其他应用已在使用这个快捷键。请录制另一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另一個 App 已在使用此快速鍵。請錄製其他快速鍵。"}}}
    },
    "macOS did not accept this shortcut (error %lld). Record a different one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O macOS não aceitou este atalho (erro %lld). Grave um diferente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "macOS에서 이 단축키를 허용하지 않았습니다(오류 %lld). 다른 단축키를 기록하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not accept this shortcut (error %lld). Record a different one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "macOSがこのショートカットを受け付けませんでした（エラー%lld）。別のショートカットを記録してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 不接受这个快捷键（错误 %lld）。请录制另一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未接受此快速鍵（錯誤 %lld）。請錄製其他快速鍵。"}}}
    },
    "Hold ⌘, ⌥ or ⌃ with the key, so the shortcut doesn’t take it away from typing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mantenha ⌘, ⌥ ou ⌃ pressionada com a tecla, para que o atalho não interfira na digitação."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일반적인 문자 입력을 방해하지 않도록 키와 함께 ⌘, ⌥ 또는 ⌃ 키를 누르세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Hold ⌘, ⌥ or ⌃ with the key, so the shortcut doesn’t take it away from typing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "通常の文字入力を妨げないよう、キーと一緒に⌘、⌥、または⌃を押してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请与 ⌘、⌥ 或 ⌃ 一起按下按键，以免快捷键占用正常输入。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請同時按住 ⌘、⌥ 或 ⌃ 與該按鍵，以免快速鍵影響一般輸入。"}}}
    },
    "This key can’t be used for a shortcut. Try a letter, a number or a function key." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta tecla não pode ser usada em um atalho. Tente uma letra, um número ou uma tecla de função."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 키는 단축키로 사용할 수 없습니다. 문자, 숫자 또는 기능 키를 사용하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This key can’t be used for a shortcut. Try a letter, a number or a function key."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このキーはショートカットに使用できません。文字、数字、またはファンクションキーを試してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个按键不能用作快捷键。请试试字母、数字或功能键。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此按鍵無法用作快速鍵。請試試字母、數字或功能鍵。"}}}
    },
    "That shortcut is already used for “%@”." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esse atalho já é usado para “%@”."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 단축키는 이미 ‘%@’에 사용되고 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "That shortcut is already used for “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "そのショートカットはすでに「%@」に使用されています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个快捷键已用于“%@”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此快速鍵已用於「%@」。"}}}
    },
    "WallpaperMachine is still starting, or its renderer could not start. Try again in a moment." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine ainda está iniciando, ou o renderizador não pôde ser iniciado. Tente novamente em instantes."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 아직 시작 중이거나 렌더러를 시작하지 못했습니다. 잠시 후 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine is still starting, or its renderer could not start. Try again in a moment."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineが起動中か、レンダラを起動できませんでした。しばらくしてからもう一度お試しください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仍在启动，或其渲染器无法启动。请稍后再试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仍在啟動中，或其渲染器無法啟動。請稍後再試。"}}}
    },
    "No installed wallpaper has the id “%@”." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede instalado tem o ID “%@”."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "ID가 ‘%@’인 설치된 배경화면이 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No installed wallpaper has the id “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ID「%@」のインストール済みの壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有 ID 为“%@”的已安装壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有 ID 為「%@」的已安裝桌布。"}}}
    },
    "No enabled display showing its own wallpaper has the id “%@”." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum monitor ativado exibindo o próprio papel de parede tem o ID “%@”."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "자체 배경화면을 표시하는 활성 디스플레이 중 ID가 ‘%@’인 디스플레이가 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "No enabled display showing its own wallpaper has the id “%@”."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "独自の壁紙を表示している有効なディスプレイに、ID「%@」のものはありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有 ID 为“%@”且显示自身壁纸的已启用显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有 ID 為「%@」且顯示其專屬桌布的已啟用顯示器。"}}}
    },
    "Wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布"}}}
    },
    "Pause Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausar Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 일시 정지"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Pause Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停桌布"}}}
    },
    "Pauses every wallpaper, as Pause in the menu bar does." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausa todos os papéis de parede, como o Pausar na barra de menus."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "메뉴 막대의 ‘일시 정지’와 같이 모든 배경화면을 일시 정지합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Pauses every wallpaper, as Pause in the menu bar does."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューバーの「一時停止」と同様に、すべての壁紙を一時停止します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停所有壁纸，与菜单栏中的“暂停”相同。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停所有桌布，與選單列中的「暫停」相同。"}}}
    },
    "Resume Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Retomar Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재개"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Resume Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再開"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续播放壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "繼續播放桌布"}}}
    },
    "Plays every wallpaper again after a pause." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduz todos os papéis de parede novamente após uma pausa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일시 정지된 모든 배경화면을 다시 재생합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Plays every wallpaper again after a pause."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一時停止後に、すべての壁紙を再び再生します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停后重新播放所有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停後重新播放所有桌布。"}}}
    },
    "Play or Pause Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir ou Pausar Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 재생 또는 일시 정지"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Play or Pause Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停桌布"}}}
    },
    "Pauses wallpapers that are playing, and plays them when paused." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Pausa os papéis de parede em reprodução e os reproduz quando pausados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 중인 배경화면은 일시 정지하고, 일시 정지된 배경화면은 재생합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Pauses wallpapers that are playing, and plays them when paused."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生中の壁紙を一時停止し、一時停止中の場合は再生します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停正在播放的壁纸；已暂停时则开始播放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫停正在播放的桌布；若已暫停則開始播放。"}}}
    },
    "Changes the target display to its next wallpaper: its playlist's next when it rotates, otherwise the next one in your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Muda o monitor de destino para o próximo papel de parede: o próximo da playlist quando ela está em rotação; caso contrário, o próximo da sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "대상 디스플레이를 다음 배경화면으로 변경합니다. 재생목록을 순환 중이면 재생목록의 다음 배경화면으로, 그렇지 않으면 보관함의 다음 배경화면으로 변경합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Changes the target display to its next wallpaper: its playlist's next when it rotates, otherwise the next one in your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "対象ディスプレイを次の壁紙に切り替えます。プレイリストがローテーション中の場合はプレイリストの次の壁紙、それ以外の場合はライブラリの次の壁紙になります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将目标显示器切换到下一张壁纸：若其播放列表在轮换，则为列表中的下一张，否则为壁纸库中的下一张。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將目標顯示器切換至下一張桌布：若其播放列表正在輪播，則為列表中的下一張，否則為桌布庫中的下一張。"}}}
    },
    "Apply Wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Papel de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 적용"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Apply Wallpaper"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用桌布"}}}
    },
    "Applies an installed wallpaper to the target display." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplica um papel de parede instalado ao monitor de destino."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설치된 배경화면을 대상 디스플레이에 적용합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Applies an installed wallpaper to the target display."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "インストール済みの壁紙を対象ディスプレイに適用します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将已安装的壁纸应用到目标显示器。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將已安裝的桌布套用到目標顯示器。"}}}
    },
    "Apply ${wallpaper}" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar ${wallpaper}"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "${wallpaper} 적용"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Apply ${wallpaper}"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "${wallpaper}を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用 ${wallpaper}"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用 ${wallpaper}"}}}
    },
    "Open WallpaperMachine" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abrir WallpaperMachine"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 열기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Open WallpaperMachine"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineを開く"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 WallpaperMachine"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開 WallpaperMachine"}}}
    },
    "Opens the control panel." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abre o painel de controle."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "제어 패널을 엽니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Opens the control panel."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コントロールパネルを開きます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开控制面板。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開控制面板。"}}}
    },
    "Play or Pause" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Reproduzir ou Pausar"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "재생 또는 일시 정지"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Play or Pause"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "再生／一時停止"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放或暂停"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "播放或暫停"}}}
    },
    "Mute Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 음소거"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Mute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を消音"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音"}}}
    },
    "Show Menu" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mostrar Menu"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "메뉴 보기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "メニューを表示"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示菜单"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "顯示選單"}}}
    },
    "Unmute Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativar Som dos Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 소리 켜기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Unmute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の消音を解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消壁纸静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消桌布靜音"}}}
    },
    "Mute or Unmute Wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar ou Ativar Som dos Papéis de Parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 음소거 또는 음소거 해제"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or Unmute Wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を消音／消音を解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音或取消靜音"}}}
    },
    "Silences every wallpaper without changing their saved sound settings." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silencia todos os papéis de parede sem alterar os ajustes de som salvos."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 사운드 설정을 변경하지 않고 모든 배경화면의 소리를 끕니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Silences every wallpaper without changing their saved sound settings."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存されたサウンド設定は変えずに、すべての壁紙を消音します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音，不更改它们已保存的声音设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音，不更改它們已儲存的聲音設定。"}}}
    },
    "Lets every wallpaper play its saved sound again after Mute Wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Permite que todos os papéis de parede voltem a reproduzir o som salvo após Silenciar Papéis de Parede."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘배경화면 음소거’ 후 모든 배경화면이 저장된 사운드 설정대로 다시 소리를 재생하도록 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Lets every wallpaper play its saved sound again after Mute Wallpapers."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「壁紙を消音」のあと、すべての壁紙が保存済みのサウンド設定で再び音を出すようにします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在“壁纸静音”之后，让每个壁纸按已保存的声音设置重新发声。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "在「桌布靜音」之後，讓每個桌布依已儲存的聲音設定重新發聲。"}}}
    },
    "Silences every wallpaper, or lets them play their saved sound again when they are already silenced." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silencia todos os papéis de parede ou, se já estiverem silenciados, permite que voltem a reproduzir o som salvo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "모든 배경화면의 소리를 끕니다. 이미 소리가 꺼져 있다면 저장된 사운드 설정으로 다시 소리를 재생합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Silences every wallpaper, or lets them play their saved sound again when they are already silenced."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "すべての壁紙を消音します。すでに消音している場合は、保存済みのサウンド設定で再び音を出します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "让所有壁纸静音；若已静音，则让它们按已保存的声音设置重新发声。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "讓所有桌布靜音；若已靜音，則讓它們依已儲存的聲音設定重新發聲。"}}}
    },
    "Mute or unmute wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar ou ativar som dos papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 음소거 또는 음소거 해제"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or unmute wallpapers"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の消音／消音解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布靜音或取消靜音"}}}
    },
    "Mute or Unmute" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Silenciar ou Ativar Som"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "음소거 또는 음소거 해제"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Mute or Unmute"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "消音／消音解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "静音或取消静音"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "靜音或取消靜音"}}}
    },
    "Downloads: %lld in progress, %lld%%" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld em andamento, %lld%%"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드: %lld개 진행 중, %lld%%"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld in progress, %lld%%"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード：%lld件を実行中、%lld%%"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载：%lld 项进行中，%lld%%"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載：%lld 項進行中，%lld%%"}}}
    },
    "Downloads: %lld in progress" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld em andamento"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드: %lld개 진행 중"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Downloads: %lld in progress"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロード：%lld件を実行中"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载：%lld 项进行中"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載：%lld 項進行中"}}}
    },
    "A collection can’t be downloaded as one. Open it to download its wallpapers." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Uma coleção não pode ser baixada de uma só vez. Abra-a para baixar os papéis de parede dela."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "컬렉션은 한 번에 다운로드할 수 없습니다. 컬렉션을 열어 배경화면을 다운로드하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A collection can’t be downloaded as one. Open it to download its wallpapers."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コレクションはまとめてダウンロードできません。コレクションを開いて、含まれる壁紙をダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "合集无法整体下载。请打开合集，下载其中的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "收藏集無法整個下載。請打開收藏集以下載其中的桌布。"}}}
    },
    "Every wallpaper you subscribe to is already in your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Todos os papéis de parede em que você está inscrito já estão na sua biblioteca."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "구독 중인 배경화면이 모두 보관함에 있습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Every wallpaper you subscribe to is already in your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サブスクライブ中の壁紙はすべてライブラリにあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "你订阅的每个壁纸都已在库中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "你訂閱的所有桌布都已在桌布庫中。"}}}
    },
    "Import my subscriptions" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Importar minhas inscrições"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "구독 항목 가져오기"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Import my subscriptions"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サブスクライブ中の壁紙を読み込む"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入我的订阅"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯入我的訂閱"}}}
    },
    "Subscribed wallpapers added to Downloads: %lld" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede inscritos adicionados aos Downloads: %lld"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다운로드에 추가된 구독 배경화면: %lld개"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Subscribed wallpapers added to Downloads: %lld"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ダウンロードに追加したサブスクライブ中の壁紙：%lld"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已加入下载的订阅壁纸：%lld"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已加入下載項目的訂閱桌布：%lld"}}}
    },
    "Download the Workshop wallpapers you already subscribe to on Steam into your library." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixe para a sua biblioteca os papéis de parede do Workshop em que você já está inscrito na Steam."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 구독 중인 창작마당 배경화면을 보관함에 다운로드합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Download the Workshop wallpapers you already subscribe to on Steam into your library."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでサブスクライブ中のワークショップ壁紙をライブラリにダウンロードします。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "把你在 Steam 上已订阅的创意工坊壁纸下载到库中。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "把你在 Steam 上已訂閱的工作坊桌布下載到桌布庫。"}}}
    },
    "Download the Workshop wallpapers you already subscribe to on Steam. Steam asks you to sign in to Steam Community once, on its own page." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Baixe os papéis de parede do Workshop em que você já está inscrito na Steam. A Steam pede que você inicie sessão na Comunidade Steam uma vez, na própria página dela."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 구독 중인 창작마당 배경화면을 다운로드합니다. Steam 자체 페이지에서 Steam 커뮤니티에 한 번 로그인해야 합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Download the Workshop wallpapers you already subscribe to on Steam. Steam asks you to sign in to Steam Community once, on its own page."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでサブスクライブ中のワークショップ壁紙をダウンロードします。Steamコミュニティへのサインインを一度だけ、Steam自身のページで求められます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载你在 Steam 上已订阅的创意工坊壁纸。Steam 会在它自己的页面上请你登录一次 Steam 社区。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "下載你在 Steam 上已訂閱的工作坊桌布。Steam 會在它自己的頁面上請你登入一次 Steam 社群。"}}}
    },
    "Import your Steam subscriptions?" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Importar suas inscrições da Steam?"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 구독 항목을 가져오시겠습니까?"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Import your Steam subscriptions?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamでサブスクライブ中の壁紙を読み込みますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入你的 Steam 订阅？"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "匯入你的 Steam 訂閱？"}}}
    },
    "WallpaperMachine can download the Workshop wallpapers you already subscribe to on Steam. Sign in to Steam Community once, on Steam’s own page, and this Mac stays signed in until you sign out." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine pode baixar os papéis de parede do Workshop em que você já está inscrito na Steam. Inicie sessão na Comunidade Steam uma vez, na própria página da Steam, e este Mac permanece com a sessão iniciada até você sair."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine은 Steam에서 이미 구독 중인 창작마당 배경화면을 다운로드할 수 있습니다. Steam의 공식 페이지에서 Steam 커뮤니티에 한 번 로그인하면 로그아웃할 때까지 이 Mac에서 로그인 상태가 유지됩니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine can download the Workshop wallpapers you already subscribe to on Steam. Sign in to Steam Community once, on Steam’s own page, and this Mac stays signed in until you sign out."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは、Steamでサブスクライブ中のワークショップ壁紙をダウンロードできます。Steam自身のページでSteamコミュニティに一度サインインすれば、サインアウトするまでこのMacはサインインしたままです。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 可以下载你在 Steam 上已订阅的创意工坊壁纸。在 Steam 自己的页面上登录一次 Steam 社区，这台 Mac 就会保持登录，直到你退出登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 可以下載你在 Steam 上已訂閱的工作坊桌布。在 Steam 自己的頁面上登入一次 Steam 社群，這台 Mac 就會保持登入，直到你登出。"}}}
    },
    "Opens Steam’s sign-in, then adds them to Downloads." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Abre o início de sessão da Steam e depois os adiciona aos Downloads."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 로그인 창을 연 다음 다운로드 목록에 추가합니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Opens Steam’s sign-in, then adds them to Downloads."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインインを開き、続けてダウンロードに追加します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 Steam 的登录页，然后把它们加入下载。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "打開 Steam 的登入頁，然後把它們加入下載項目。"}}}
    },
    "Sign in to Steam" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Iniciar sessão na Steam"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에 로그인"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Sign in to Steam"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamにサインイン"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录 Steam"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "登入 Steam"}}}
    },
    "Steam asked you to sign in again. Sign in to Steam to see your subscriptions." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam pediu que você inicie sessão novamente. Inicie sessão na Steam para ver as suas inscrições."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam이 다시 로그인하도록 요청했습니다. 구독 항목을 보려면 Steam에 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam asked you to sign in again. Sign in to Steam to see your subscriptions."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamから再度サインインするよう求められました。サブスクライブ中のアイテムを表示するには、Steamにサインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求你重新登录。登录 Steam 后即可查看你的订阅。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 要求你重新登入。登入 Steam 即可查看你的訂閱項目。"}}}
    },
    "Steam no longer serves this collection." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não disponibiliza mais esta coleção."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이 컬렉션을 더 이상 제공하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this collection."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このコレクションはSteamで提供されなくなりました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供这个合集。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此收藏集。"}}}
    },
    "This link is not a Wallpaper Engine item." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este link não é um item do Wallpaper Engine."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 링크는 Wallpaper Engine 항목이 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This link is not a Wallpaper Engine item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このリンクはWallpaper Engineのアイテムではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个链接指向的不是 Wallpaper Engine 的项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此連結指向的不是 Wallpaper Engine 的項目。"}}}
    },
    "Steam no longer serves this Workshop item." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A Steam não disponibiliza mais este item do Workshop."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam에서 이 창작마당 항목을 더 이상 제공하지 않습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam no longer serves this Workshop item."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このワークショップアイテムはSteamで提供されなくなりました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供这个创意工坊项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 已不再提供此工作坊項目。"}}}
    },
    "Application wallpapers run Windows programs and can’t be used on macOS." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papéis de parede de aplicativo executam programas do Windows e não podem ser usados no macOS."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "응용 프로그램 배경화면은 Windows 프로그램을 실행하므로 macOS에서 사용할 수 없습니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Application wallpapers run Windows programs and can’t be used on macOS."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "アプリケーション壁紙はWindowsプログラムを実行するため、macOSでは使用できません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用程序类壁纸需要运行 Windows 程序，无法在 macOS 上使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "應用程式桌布會執行 Windows 程式，無法在 macOS 上使用。"}}}
    },
    "Steam’s sign-in finished without a session this app can use. Try signing in again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O início de sessão da Steam terminou sem uma sessão que este app possa usar. Tente iniciar a sessão novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Steam 로그인이 완료되었지만 이 앱에서 사용할 수 있는 세션을 얻지 못했습니다. 다시 로그인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam’s sign-in finished without a session this app can use. Try signing in again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "Steamのサインインは完了しましたが、このAppで使用できるセッションを取得できませんでした。もう一度サインインしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登录已结束，但没有得到本应用可用的会话。请再试一次登录。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "Steam 登入已完成，但未取得此 App 可用的工作階段。請再次嘗試登入。"}}}
    },
    "This Steam account id is not one Steam uses." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Este ID de conta Steam não é um que a Steam usa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 Steam 계정 ID는 Steam에서 사용하는 ID가 아닙니다."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This Steam account id is not one Steam uses."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このSteamアカウントIDは、Steamで使われているIDではありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这不是 Steam 使用的账户 ID。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此 Steam 帳號 ID 並非 Steam 使用的有效 ID。"}}}
    },
    "The library’s folder for Workshop item %@ holds no project.json, so it is not an installed wallpaper and the new copy was not put in its place. Move the folder out of the library and download the item again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta da biblioteca para o item do Workshop %@ não contém project.json, então não é um papel de parede instalado e a nova cópia não foi colocada no lugar dela. Mova a pasta para fora da biblioteca e baixe o item novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관함에 있는 창작마당 항목 %@의 폴더에 project.json이 없어 설치된 배경화면이 아니므로 새 사본으로 교체하지 않았습니다. 폴더를 보관함 밖으로 옮긴 후 항목을 다시 다운로드하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The library’s folder for Workshop item %@ holds no project.json, so it is not an installed wallpaper and the new copy was not put in its place. Move the folder out of the library and download the item again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ライブラリにあるワークショップアイテム%@のフォルダにはproject.jsonがないため、インストール済みの壁紙ではなく、新しいコピーで置き換えませんでした。フォルダをライブラリの外に移動してから、アイテムをもう一度ダウンロードしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库中创意工坊项目 %@ 的文件夹没有 project.json，因此不是已安装的壁纸，未用新副本替换它。请将该文件夹移出壁纸库，然后重新下载该项目。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布庫中工作坊項目 %@ 的資料夾沒有 project.json，因此不是已安裝的桌布，沒有以新副本取代它。請將該資料夾移出桌布庫，再重新下載該項目。"}}}
    },
    "The wallpaper properties changed while preparing this preset. Refresh and retry." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As propriedades do papel de parede mudaram durante a preparação desta predefinição. Atualize e tente novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 프리셋을 준비하는 동안 배경화면 속성이 변경되었습니다. 새로 고침하고 다시 시도하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper properties changed while preparing this preset. Refresh and retry."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プリセットの準備中に壁紙のプロパティが変更されました。更新してから再試行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备预设时壁纸属性发生了变化。请刷新后重试。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "準備預設時桌布屬性發生了變更。請重新整理後再試。"}}}
    },
    "Property preset applied, but unused retained assets could not be cleaned up: %@." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Predefinição de propriedades aplicada, mas não foi possível limpar os recursos retidos não usados: %@."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "속성 프리셋을 적용했지만 사용하지 않는 보관 에셋을 정리하지 못했습니다: %@."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Property preset applied, but unused retained assets could not be cleaned up: %@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プロパティプリセットは適用されましたが、未使用の保持ファイルを削除できませんでした：%@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "属性预设已应用，但无法清理未使用的保留素材：%@。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "屬性預設已套用，但無法清理未使用的保留素材：%@。"}}}
    },
    "A backup resource has no local authorization or retained copy. Reselect it in the wallpaper’s properties before restoring: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um recurso do backup não tem autorização local nem cópia retida. Selecione-o novamente nas propriedades do papel de parede antes de restaurar: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "백업 리소스에 이 Mac의 접근 권한이나 보관된 사본이 없습니다. 복원하기 전에 배경화면 속성에서 다시 선택하세요: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A backup resource has no local authorization or retained copy. Reselect it in the wallpaper’s properties before restoring: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バックアップのリソースに、このMacでの許可または保持されたコピーがありません。復元前に壁紙のプロパティで選び直してください：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "备份中的资源没有本机授权或保留副本。请在恢复前到壁纸属性中重新选择：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "備份中的資源沒有本機授權或保留副本。請在還原前到桌布屬性中重新選擇：%@"}}}
    },
    "A retained resource will use its backed-up bytes instead of authorizing its original source: %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Um recurso retido usará os bytes do backup em vez de autorizar a origem original: %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관된 리소스는 원본에 접근 권한을 부여하는 대신 백업된 데이터를 사용합니다: %@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "A retained resource will use its backed-up bytes instead of authorizing its original source: %@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されたリソースは元の場所を許可せず、バックアップしたデータを使用します：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留资源将使用备份中的数据，不会授权读取其原始来源：%@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留資源將使用備份中的資料，不會授權讀取其原始來源：%@"}}}
    },
    "The scene assets folder remains the one already selected on this Mac. Reselect it in Settings if needed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A pasta de recursos de cena continua sendo a que já está selecionada neste Mac. Selecione-a novamente nos Ajustes, se necessário."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "장면 리소스 폴더는 이 Mac에서 이미 선택한 위치를 그대로 사용합니다. 필요한 경우 설정에서 다시 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The scene assets folder remains the one already selected on this Mac. Reselect it in Settings if needed."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "シーン素材フォルダは、このMacで選択済みの場所を引き続き使用します。必要なら設定で選び直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景资源文件夹仍使用本机原先选定的位置。如有需要，请在设置中重新选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "場景資源資料夾仍使用本機原先選定的位置。如有需要，請在設定中重新選擇。"}}}
    },
    "The retained resource is unavailable. Select the original resource again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O recurso retido não está disponível. Selecione o recurso original novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관된 리소스를 사용할 수 없습니다. 원본 리소스를 다시 선택하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The retained resource is unavailable. Select the original resource again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持されたリソースを利用できません。元のファイルまたはフォルダを選び直してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留的资源不可用。请重新选择原始文件或文件夹。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保留的資源無法使用。請重新選擇原始檔案或資料夾。"}}}
    },
    "Retained asset permissions could not be read safely. Refresh before continuing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Não foi possível ler com segurança as permissões dos recursos retidos. Atualize antes de continuar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "보관 에셋의 접근 권한을 안전하게 읽지 못했습니다. 계속하기 전에 새로고침하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Retained asset permissions could not be read safely. Refresh before continuing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保持ファイルのアクセス許可を安全に読み取れませんでした。更新してから続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全读取保留素材的访问权限。请刷新后继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法安全讀取保留素材的存取權限。請重新整理後繼續。"}}}
    },
    "The asset selection failed: %@. Its permissions could not be restored: %@. Refresh before continuing." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A seleção do recurso falhou: %@. Não foi possível restaurar as permissões dele: %@. Atualize antes de continuar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "리소스 선택에 실패했습니다: %@. 접근 권한을 복원할 수 없습니다: %@. 새로 고침한 후 계속하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The asset selection failed: %@. Its permissions could not be restored: %@. Refresh before continuing."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "素材の選択に失敗しました：%@。アクセス許可を元に戻せませんでした：%@。更新してから続行してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "素材选择失败：%@。无法恢复其访问权限：%@。请刷新后继续。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "素材選擇失敗：%@。無法還原其存取權限：%@。請重新整理後繼續。"}}}
    },
    "WallpaperMachine is already running" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O WallpaperMachine já está em execução"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine이 이미 실행 중입니다"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine is already running"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineはすでに起動しています"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 已在运行"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 已在執行中"}}}
    },
    "Another copy of WallpaperMachine is using this library. Quit it before opening this one." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Outra cópia do WallpaperMachine está usando esta biblioteca. Encerre-a antes de abrir esta."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다른 WallpaperMachine이 이 보관함을 사용하고 있습니다. 해당 앱을 종료한 후 이 앱을 여세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Another copy of WallpaperMachine is using this library. Quit it before opening this one."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "別のWallpaperMachineが同じライブラリを使用しています。そちらを終了してから、このコピーを開いてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "另一个 WallpaperMachine 副本正在使用同一个壁纸库。请先退出它，再打开这一个。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "另一個 WallpaperMachine 副本正在使用同一個桌布庫。請先結束它，再打開這一個。"}}}
    },
    "The video changed since it was checked. Look for black bars again." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O vídeo mudou desde a verificação. Procure as barras pretas novamente."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "검사 후 동영상이 변경되었습니다. 검은 여백을 다시 확인하세요."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The video changed since it was checked. Look for black bars again."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "確認したあとでビデオが変更されました。もう一度黒帯を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "视频在检查之后发生了变化。请重新检查黑边。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "影片在檢查之後發生了變化。請再次檢查黑邊。"}}}
    },
    "Turn off animated lock-screen wallpaper to use desktop Space choices." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Desative o papel de parede animado da tela bloqueada para usar as escolhas por Space da mesa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 공간별 선택을 사용하려면 움직이는 잠금 화면 배경화면을 끄세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップスペースごとの選択を使うには、動くロック画面の壁紙をオフにしてください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先关闭动态锁屏壁纸，再使用按桌面空间切换。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請先關閉動態鎖定畫面桌布，再使用依桌面空間切換。"}}}
    },
    "Desktop information is unavailable. Refresh Spaces or choose another automatic mode." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "As informações das mesas não estão disponíveis. Atualize os Spaces ou escolha outro modo automático."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 정보를 사용할 수 없습니다. Spaces를 새로 고치거나 다른 자동 모드를 선택하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップ情報を取得できません。スペースを更新するか、別の自動モードを選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂时无法读取桌面信息。请刷新空间列表，或选择其他自动切换模式。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "暫時無法讀取桌面資訊。請重新整理空間列表，或選擇其他自動切換模式。"}}}
    },
    "Desktop %lld (current)" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mesa %lld (atual)"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 %lld (현재)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップ%lld（現在）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "桌面 %lld（当前）"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌面 %lld（目前）"}}}
    },
    "Desktop %lld" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mesa %lld"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 %lld"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップ%lld"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "桌面 %lld"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌面 %lld"}}}
    },
    "Unavailable desktop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mesa indisponível"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용할 수 없는 데스크탑"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "利用できないデスクトップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不可用的桌面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "無法使用的桌面"}}}
    },
    "Forget choice for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esquecer a escolha de %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@에 대한 선택 지우기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の割り当てを解除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "移除 %@ 的关联"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "移除 %@ 的關聯"}}}
    },
    "Different wallpaper for each desktop" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de parede diferente para cada mesa"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑마다 다른 배경화면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップごとに別の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每个桌面使用不同壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個桌面使用不同桌布"}}}
    },
    "Each desktop keeps the wallpaper you apply while you are on it, and only the desktop you are on plays, so Mission Control shows the other desktops as still pictures. A desktop you have visited waits paused where you left it; one you have not visited yet shows a still picture until its first visit. Kept wallpapers use memory and are let go when the Mac runs short of it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Cada mesa mantém o papel de parede que você aplica enquanto está nela, e apenas a mesa em que você está é reproduzida, então o Mission Control mostra as outras mesas como imagens estáticas. Uma mesa que você já visitou fica pausada onde você parou; uma que você ainda não visitou mostra uma imagem estática até a primeira visita. Os papéis de parede mantidos usam memória e são liberados quando o Mac fica com pouca memória."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "각 데스크탑은 그 데스크탑에 있을 때 적용한 배경화면을 유지하며, 현재 데스크탑만 재생되므로 Mission Control에서는 다른 데스크탑이 정지 이미지로 표시됩니다. 방문한 데스크탑은 떠날 때의 화면에서 일시 정지되고, 아직 방문하지 않은 데스크탑은 처음 방문할 때까지 정지 이미지를 표시합니다. 유지된 배경화면은 메모리를 사용하며, Mac의 메모리가 부족해지면 해제됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "各デスクトップは、そのデスクトップにいるときに適用した壁紙を保持し、再生されるのは今いるデスクトップだけなので、Mission Controlではほかのデスクトップが静止画で表示されます。訪れたデスクトップは離れたときの場面で一時停止し、まだ訪れていないデスクトップは最初に訪れるまで静止画を表示します。保持された壁紙はメモリを使い、Macのメモリが不足すると解放されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每个桌面会保留你在该桌面上应用的壁纸，且只有当前桌面会播放，因此调度中心里的其他桌面显示为静态画面。访问过的桌面会暂停在你离开时的画面；尚未访问的桌面在首次访问前显示静态画面。保留的壁纸会占用内存，Mac 内存不足时会被释放。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個桌面會保留你在該桌面上套用的桌布，且只有目前的桌面會播放，因此指揮中心裡的其他桌面顯示為靜態畫面。造訪過的桌面會暫停在你離開時的畫面；尚未造訪的桌面在首次造訪前顯示靜態畫面。保留的桌布會佔用記憶體，Mac 記憶體不足時會被釋放。"}}}
    },
    "Keeps the current wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mantém o papel de parede atual"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 배경화면 유지"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の壁紙のまま"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保持当前壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "保持目前的桌布"}}}
    },
    "Keep the current wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Manter o papel de parede atual"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 배경화면 그대로 두기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在の壁紙を使う"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "沿用当前壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沿用目前的桌布"}}}
    },
    "Same as Desktop 1" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Igual à Mesa 1"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "데스크탑 1과 같음"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "デスクトップ1と同じ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "与桌面 1 相同"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "與桌面 1 相同"}}}
    },
    "This desktop shows Desktop 1’s wallpaper, like every desktop you add." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta mesa mostra o papel de parede da Mesa 1, como todas as mesas que você adicionar."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 데스크탑은 새로 추가하는 모든 데스크탑처럼 데스크탑 1의 배경화면을 표시합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このデスクトップには、追加するすべてのデスクトップと同じく、デスクトップ1の壁紙が表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此桌面和你添加的每个桌面一样，显示桌面 1 的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "此桌面和你加入的每個桌面一樣，顯示桌面 1 的桌布。"}}}
    },
    "Spaces" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Spaces"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "스페이스"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スペース"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "空间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "空間"}}}
    },
    "Turning it on replaces this display’s automatic wallpaper selection." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Ativar substitui a seleção automática de papel de parede deste monitor."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "켜면 이 디스플레이의 배경화면 자동 선택을 대체합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "オンにすると、このディスプレイの壁紙の自動選択の代わりに使われます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "开启后会取代此显示器的“自动选择壁纸”。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟後會取代此顯示器的「自動選擇桌布」。"}}}
    },
    "Each desktop’s wallpaper is chosen above, under Different wallpaper for each desktop." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O papel de parede de cada mesa é escolhido acima, em Papel de parede diferente para cada mesa."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "각 데스크탑의 배경화면은 위의 ‘데스크탑마다 다른 배경화면’에서 선택합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "各デスクトップの壁紙は、上の「デスクトップごとに別の壁紙」で選びます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "每个桌面的壁纸请在上方的“每个桌面使用不同壁纸”中选择。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "每個桌面的桌布請在上方的「每個桌面使用不同桌布」中選擇。"}}}
    },
    "Desktops of %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Mesas de %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 데스크탑"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@のデスクトップ"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的桌面"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的桌面"}}}
    },
    "Choose the wallpaper for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Escolha o papel de parede para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 배경화면 선택"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の壁紙を選択"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "为%@选择壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "為%@選擇桌布"}}}
    },
    "Wallpaper for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de parede para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 배경화면"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@の壁紙"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@的桌布"}}}
    },
    "No wallpapers match." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum papel de parede corresponde."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일치하는 배경화면이 없습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "一致する壁紙はありません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有匹配的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "沒有符合的桌布。"}}}
    },
    "This desktop shows whatever the display plays when you switch to it." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Esta mesa mostra o que o monitor estiver reproduzindo quando você mudar para ela."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 데스크탑으로 전환하면 디스플레이에서 재생 중인 배경화면을 그대로 표시합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このデスクトップに切り替えると、ディスプレイで再生中の壁紙がそのまま表示されます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "切换到此桌面时，会显示该显示器正在播放的壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "切換到此桌面時，會顯示該顯示器正在播放的桌布。"}}}
    },
    "Wallpapers you apply go to %@ of this display" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Os papéis de parede que você aplicar vão para %@ deste monitor"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면을 적용하면 이 디스플레이의 %@에 표시됩니다"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "適用した壁紙はこのディスプレイの%@に表示されます"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用的壁纸会显示在这台显示器的%@上"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用的桌布會顯示在這台顯示器的%@上"}}}
    },
    "Refresh Spaces" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Atualizar Spaces"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "Spaces 새로고침"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スペースを更新"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刷新空间列表"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新整理空間列表"}}}
    },
    "Apply Display Layout restores a saved arrangement across its displays. Choose the layout by name in Shortcuts, or use its saved id in a layout link." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar Layout de Monitores restaura um arranjo salvo em todos os monitores dele. Escolha o layout pelo nome no Atalhos ou use o ID salvo dele em um link de layout."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘디스플레이 레이아웃 적용’은 각 디스플레이에 저장된 배치를 복원합니다. 단축어에서 이름으로 레이아웃을 선택하거나 layout 링크에 저장된 ID를 사용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「ディスプレイの壁紙セットを適用」で、保存した各画面の組み合わせを復元できます。ショートカットで名前から選ぶか、layoutリンクに保存済みのIDを指定してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“应用多屏壁纸方案”可恢复各屏幕的已存搭配。在“快捷指令”中按名称选择方案，或在 layout 链接中使用方案 ID。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「套用多螢幕桌布方案」可還原各螢幕的已存搭配。在「捷徑」中依名稱選擇方案，或在 layout 連結中使用方案 ID。"}}}
    },
    "Random Wallpaper changes a display to a wallpaper other than the one it shows, and goes through all of them before it repeats one. It can draw from your favorites only: choose Favorites in Shortcuts, or use from=favorites in a link." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Papel de Parede Aleatório muda um monitor para um papel de parede diferente do que está sendo exibido e passa por todos antes de repetir algum. Ele pode escolher só entre seus favoritos: escolha Favoritos no Atalhos ou use from=favorites em um link."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘무작위 배경화면’은 디스플레이의 현재 배경화면을 다른 배경화면으로 바꾸며, 모든 배경화면을 한 번씩 표시하기 전에는 같은 배경화면을 반복하지 않습니다. 즐겨찾기에서만 선택할 수도 있습니다. 단축어에서 ‘즐겨찾기’를 선택하거나 링크에 from=favorites를 사용하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ランダムな壁紙は、ディスプレイを表示中とは別の壁紙に切り替え、すべての壁紙を一巡するまで同じ壁紙を繰り返しません。お気に入りだけから選ぶこともでき、ショートカットでは「お気に入り」を選び、リンクではfrom=favoritesを使います。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“随机壁纸”会把显示器换成与当前不同的壁纸，并在全部壁纸都出现过之后才会重复。它也可以只从收藏中选取：在“快捷指令”中选择“收藏”，或在链接中使用 from=favorites。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "「隨機桌布」會把顯示器換成與目前不同的桌布，並在所有桌布都出現過之後才會重複。它也可以只從最愛中選取：在「捷徑」中選擇「最愛」，或在連結中使用 from=favorites。"}}}
    },
    "Display layouts" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Layouts de monitores"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 레이아웃"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの壁紙セット"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "多屏壁纸方案"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "多螢幕桌布方案"}}}
    },
    "Layout name" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nome do layout"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 이름"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セット名"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "方案名称"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "方案名稱"}}}
    },
    "Destination for %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Destino para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 복사 대상"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@からのコピー先"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的目标显示器"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的目標顯示器"}}}
    },
    "Copy or swap wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiar ou trocar papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 복사 또는 맞바꾸기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙のコピー・交換"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "复制或交换壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "複製或交換桌布"}}}
    },
    "Copy wallpaper" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiar papel de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 복사"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙をコピー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "复制壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "複製桌布"}}}
    },
    "Swap wallpapers" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trocar papéis de parede"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 맞바꾸기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙を交換"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "交换壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "交換桌布"}}}
    },
    "Copy wallpaper from %@ to %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Copiar papel de parede de %@ para %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@의 배경화면을 %@에 복사"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@の壁紙を%2$@にコピー"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将 %1$@ 的壁纸复制到 %2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將 %1$@ 的桌布複製到 %2$@"}}}
    },
    "Swap wallpapers on %@ and %@" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Trocar papéis de parede entre %@ e %@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%@ 및 %@의 배경화면 맞바꾸기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@と%2$@の壁紙を交換"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "交换 %1$@ 和 %2$@ 的壁纸"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "交換 %1$@ 和 %2$@ 的桌布"}}}
    },
    "Only wallpaper choices are copied or swapped. Playlists and automatic rules keep running. Swapping needs a wallpaper on both displays." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Somente as escolhas de papel de parede são copiadas ou trocadas. Playlists e regras automáticas continuam funcionando. Para trocar, é preciso ter um papel de parede nos dois monitores."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 선택 내용만 복사하거나 맞바꿉니다. 재생목록과 자동 규칙은 계속 실행됩니다. 맞바꾸려면 양쪽 디스플레이에 모두 배경화면이 있어야 합니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "コピー・交換するのは壁紙の選択だけです。プレイリストと自動ルールは引き続き動作します。交換には両方のディスプレイに壁紙が必要です。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅复制或交换壁纸选择，播放列表和自动规则会继续运行。交换时，两台显示器都必须有壁纸。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "僅複製或交換桌布選擇，播放列表和自動規則會繼續執行。交換時，兩台顯示器都必須有桌布。"}}}
    },
    "Delete layout" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar layout"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 삭제"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットを削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "删除方案"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "刪除方案"}}}
    },
    "Delete “%@”? Current wallpapers stay as they are." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar “%@”? Os papéis de parede atuais continuam como estão."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "‘%@’을(를) 삭제할까요? 현재 배경화면은 그대로 유지됩니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "「%@」を削除しますか？現在の壁紙は変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "删除“%@”？当前壁纸会保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "刪除「%@」？目前的桌布會保持不變。"}}}
    },
    "Apply layout “%@”" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Aplicar layout “%@”"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 ‘%@’ 적용"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セット「%@」を適用"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用方案“%@”"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "套用方案「%@」"}}}
    },
    "Rename layout “%@”" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Renomear layout “%@”"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 ‘%@’ 이름 변경"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セット「%@」の名前を変更"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重命名方案“%@”"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "重新命名方案「%@」"}}}
    },
    "Delete layout “%@”" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Apagar layout “%@”"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 ‘%@’ 삭제"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セット「%@」を削除"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "删除方案“%@”"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "刪除方案「%@」"}}}
    },
    "Save current layout…" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salvar layout atual…"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "현재 레이아웃 저장…"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "現在のセットを保存…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存当前方案…"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存目前方案…"}}}
    },
    "Save wallpaper choices for enabled independent displays. Empty and mirrored displays are left out. Playlists, automatic rules, properties and scaling are not saved in a layout." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Salva as escolhas de papel de parede dos monitores independentes ativados. Monitores vazios e espelhados ficam de fora. Playlists, regras automáticas, propriedades e dimensionamento não são salvos no layout."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "활성화된 독립 디스플레이의 배경화면 선택 내용을 저장합니다. 비어 있거나 미러링된 디스플레이는 제외됩니다. 재생목록, 자동 규칙, 속성 및 크기 조절 설정은 레이아웃에 저장되지 않습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "有効な独立ディスプレイの壁紙の組み合わせを保存します。空の画面とミラーディスプレイは対象外です。プレイリスト、自動ルール、プロパティ、拡大縮小設定はセットに保存されません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保存已启用独立显示器的壁纸搭配，不包含空白屏幕和镜像显示器。方案不保存播放列表、自动规则、属性或缩放设置。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "儲存已啟用獨立顯示器的桌布搭配，不包含空白螢幕和鏡像顯示器。方案不儲存播放列表、自動規則、屬性或縮放設定。"}}}
    },
    "No saved layouts yet. Arrange your wallpapers, then save the layout." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nenhum layout salvo ainda. Organize seus papéis de parede e salve o layout."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "아직 저장된 레이아웃이 없습니다. 배경화면을 배치한 다음 레이아웃을 저장하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存したセットはまだありません。各画面の壁紙を選んでから保存してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "还没有保存的方案。搭配好各屏壁纸后，即可保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "還沒有儲存的方案。搭配好各螢幕桌布後，即可儲存。"}}}
    },
    "The limit of %lld layouts is reached. Delete one before saving another." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O limite de %lld layouts foi atingido. Apague um antes de salvar outro."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 한도인 %lld개에 도달했습니다. 새로 저장하려면 기존 레이아웃을 하나 삭제하세요."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "上限の%lldセットに達しました。新しく保存するには、既存のセットを削除してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已达到 %lld 套方案的上限。请删除一套后再保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已達到 %lld 套方案的上限。請刪除一套後再儲存。"}}}
    },
    "Layout deleted. Current wallpapers are unchanged." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Layout apagado. Os papéis de parede atuais não foram alterados."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃이 삭제되었습니다. 현재 배경화면은 변경되지 않았습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セットを削除しました。現在の壁紙は変わりません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "方案已删除，当前壁纸保持不变。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "方案已刪除，目前的桌布保持不變。"}}}
    },
    "Wallpaper arrangement applied." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Disposição de papéis de parede aplicada."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "배경화면 배치를 적용했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "壁紙の組み合わせを適用しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸搭配已应用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "桌布搭配已套用。"}}}
    },
    "Layout renamed." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Layout renomeado."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "레이아웃 이름이 변경되었습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "セット名を変更しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "方案已重命名。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "方案已重新命名。"}}}
    },
    "Display layout saved." : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Layout de monitores salvo."}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "디스플레이 레이아웃을 저장했습니다."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "ディスプレイの壁紙セットを保存しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "多屏壁纸方案已保存。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "多螢幕桌布方案已儲存。"}}}
    },
    "Time schedule" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Agenda de horários"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시간 예약"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻で切り替え"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "按时间切换"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "依時間切換"}}}
    },
    "Follow system appearance" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Seguir a aparência do sistema"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "시스템 모양 따르기"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "システムの外観に連動"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跟随系统外观"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "跟隨系統外觀"}}}
    },
    "At a time" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Em um horário"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지정 시각"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "指定時刻"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "指定时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "指定時間"}}}
    },
    "Sunrise" : {
      "localizations" : {"pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "Nascer do sol"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "일출"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "日の出"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "日出"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "日出"}}}
    },
    "Sunset" : {
