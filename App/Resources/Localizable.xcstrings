    },
    "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ needs missing or external runtime dependency %@. Complete the official SteamCMD installation."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%@に必要なランタイム依存関係%@が見つからないか、ランタイム外にあります。公式のSteamCMDのインストールを完了してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的运行时依赖 %@ 缺失或位于运行时目录之外。请完成官方 SteamCMD 安装。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%@ 所需的執行環境相依項目 %@ 遺失或位於外部。請完成官方的 SteamCMD 安裝。"}}}
