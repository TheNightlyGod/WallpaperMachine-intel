        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WallpaperMachineは、音声に反応する壁紙を有効にしたときだけシステムオーディオをキャプチャします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
