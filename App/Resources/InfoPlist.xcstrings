{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine은 오디오 반응형 배경화면을 활성화할 때만 시스템 오디오를 캡처합니다."}},
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WallpaperMachine captures system audio only when you enable audio-reactive wallpapers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WallpaperMachineは、音声に反応する壁紙を有効にしたときだけシステムオーディオをキャプチャします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WallpaperMachine 仅在你启用音频响应壁纸时捕获系统音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WallpaperMachine 只會在你啟用音訊反應桌布時擷取系統音訊。"
          }
        }
      }
    },
    "Coordinates" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "좌표"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Coordinates"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "座標"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "经纬度"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "經緯度"}}}
    },
    "Fixed times" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "지정 시각"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Fixed times"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "固定時刻"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "固定时间"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "固定時間"}}}
    },
    "Time source" : {
      "localizations" : {"ko" : {"stringUnit" : {"state" : "translated", "value" : "시각 소스"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Time source"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "時刻の取得元"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "时间来源"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "時間來源"}}}
    },
    "Sunrise time" : {
