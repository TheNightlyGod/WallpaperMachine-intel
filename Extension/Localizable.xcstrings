      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine asks Music and Spotify what is playing, only while you have turned media integration on for a wallpaper."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachineは、壁紙のメディア連携をオンにしている間だけ、MusicとSpotifyで再生中の曲を確認します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 仅在你为壁纸开启媒体集成时，向 Music 和 Spotify 查询正在播放的内容。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "WallpaperMachine 只會在你為桌布開啟媒體整合時，向 Music 和 Spotify 查詢正在播放的內容。"}}}
