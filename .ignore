# Paths ripgrep (and fd) skip by default so searches land in live code and docs.
# They are still tracked and still built; search them deliberately with `rg -u`
# (or `rg --no-ignore`). Everything in .gitignore is skipped already.

# Historical records: hundreds of kilobytes of retired plans and verification entries.
docs/archive/
docs/testing/archive/

# Generated by uniffi-bindgen during scripts/build.py; never edited by hand.
App/Bridge/Generated/

# Vendored third-party code, not this project's. See ThirdParty/provenance.json.
ThirdParty/
